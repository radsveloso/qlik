    '' as [SubacctAccountNoNormalized],
    '' as [TiaraAccountsFile],
    '' as [TiaraAccountsLookupStatus],
    '' as [TiaraSubaccountsFile],
    '' as [TiaraSubaccountsLookupStatus],
    '' as [alert_reason]
AUTOGENERATE 1;

Concatenate ([ALERT_GLCS_UNMAPPED])
LOAD
    0 as row_seed,
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    $(fMoneyTxt([Production Earned])) as [Production Earned],
    $(fMoneyTxt([Payout Earned])) as [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    $(fMoneyTxt([Gross Comms])) as [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE],
    [Acct Short Description] as [LookupAccountShortDescription],
    acct_base as [LookupAccountNormalized],
    'TIARA_ACCOUNTS_DIRECT_THEN_TIARA_SUBACCOUNTS_FALLBACK' as [LookupPathTried],
    '' as [DirectTiaraMatchField],
    '' as [DirectTiaraMatchValue],
    glcs_sub_no as [SubacctNoMatched],
    glcs_sub_account as [SubacctAccountNo],
    '' as [SubacctAccountNoNormalized],
    '$(vTiaraAccName)' as [TiaraAccountsFile],
    '$(vTiaraAccStatus)' as [TiaraAccountsLookupStatus],
    '$(vTiaraSubName)' as [TiaraSubaccountsFile],
    '$(vTiaraSubStatus)' as [TiaraSubaccountsLookupStatus],
    If(glcs_sub_found = 1, 'SUBACCOUNT_FOUND_BUT_PARENT_ACCOUNT_NO_NOT_FOUND_IN_TIARA_ACCOUNTS_ACCOUNTNR', 'NUMERIC_XML_ACCOUNT_SHORT_DESCRIPTION_NOT_FOUND_IN_TIARA_ACCOUNTS_OR_TIARA_SUBACCOUNTS') as [alert_reason]
RESIDENT FINAL_GLCS
WHERE row_seed = 0 and glcs_unmatched = 1
ORDER BY glcs_sub_found, [RR Team], [Salesperson], [Acct Short Description], [Trade Id];

// glcs_code_unmatched_names_email.csv: XML rows still without GLCS CODE whose
// account is only digits.
[ALERT_GLCS_EMAIL]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [Client Short Name],
    '' as [Master Account Number]
AUTOGENERATE 1;

Concatenate ([ALERT_GLCS_EMAIL])
LOAD DISTINCT
    0 as row_seed,
    Trim([Client]) as [Client Short Name],
    Trim([Acct Short Description]) as [Master Account Number]
RESIDENT FINAL_GLCS
WHERE row_seed = 0 and is_xml = 1 and Len(Trim([GLCS CODE])) = 0 and Len(Trim([Acct Short Description])) > 0 and Len(acct_clean) > 0 and Len(KeepChar(acct_clean, '0123456789')) = Len(acct_clean)
ORDER BY [Client], [Acct Short Description];

// glcs_code_suspicious_numeric_alerts.csv: XML rows whose GLCS CODE is only
// digits and longer than 8.
[ALERT_GLCS_SUSPICIOUS]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [Client Short Name],
    '' as [Master Account Number],
    '' as [GLCS CODE],
    '' as [Issue]
AUTOGENERATE 1;

Concatenate ([ALERT_GLCS_SUSPICIOUS])
LOAD DISTINCT
    0 as row_seed,
    Trim([Client]) as [Client Short Name],
    Trim([Acct Short Description]) as [Master Account Number],
    Trim(PurgeChar([GLCS CODE], Chr(39) & '"')) as [GLCS CODE],
    'GLCS code does not appear to be correct in Tiara: numeric and longer than 8 digits' as [Issue]
RESIDENT FINAL_GLCS
WHERE row_seed = 0 and is_xml = 1 and Len(Trim(PurgeChar([GLCS CODE], Chr(39) & '"'))) >= 9 and Len(KeepChar(Trim(PurgeChar([GLCS CODE], Chr(39) & '"')), '0123456789')) = Len(Trim(PurgeChar([GLCS CODE], Chr(39) & '"')))
ORDER BY [Client], [Acct Short Description], [GLCS CODE];

LET vCntGlcsUnmapped   = NoOfRows('ALERT_GLCS_UNMAPPED') - 1;
LET vCntGlcsEmail      = NoOfRows('ALERT_GLCS_EMAIL') - 1;
LET vCntGlcsSuspicious = NoOfRows('ALERT_GLCS_SUSPICIOUS') - 1;
LET vCntFinal          = NoOfRows('FINAL_GLCS') - 1;

TRACE [CASTINE] GLCS CODE unmapped alerts: $(vCntGlcsUnmapped) - unmatched names: $(vCntGlcsEmail) - suspicious numeric: $(vCntGlcsSuspicious);
TRACE [CASTINE] Final appended rows: $(vCntFinal);

///$tab 13_Export
// ============================================================================
// Castine.py main() L3719-3835: final table and files.
//
// Table [Qlik] = final payout, the 23 official columns in the official order.
// Money columns are text with two decimals (the Python writes them with %.2f)
// and are empty when there is no number. They are kept as text on purpose: in
// Qlik a number takes the first text it was given anywhere in the same field,
// so 550.00 could be shown and stored as 550. The fields ending in "Num" hold
// the same amounts as numbers, for charts and sums.
// CompNum is the comparison key used to check the result against the Python.
// ============================================================================

// Money as the Python writes it (to_csv, float_format "%.2f"): the cent nearest
// to the exact value of the number, and an exact half goes to the even cent.
// XML and Repo values were already rounded when they were calculated, so this
// only changes a manual adjustment typed with more than two decimals.
//   x_y     = value * 100 as the processor rounds it
//   x_floor = whole cents below it, x_frac = what is left (0 to 1)
//   x_hi    = upper half of the bits of the value (134217729 = 2^27 + 1)
//   x_err   = exact (value * 100) minus x_y: when x_frac is exactly 0.5 it tells
//             on which side of the half the real value is
[_PAYOUT_NUM]:
NoConcatenate
LOAD
    *,
    If(IsNull(production_num), Null(), If(production_frac > 0.5, production_floor + 1, If(production_frac < 0.5, production_floor, If(production_err > 0, production_floor + 1, If(production_err < 0, production_floor, If(Floor(production_floor / 2) * 2 = production_floor, production_floor, production_floor + 1))))) / 100) as production_r,
    If(IsNull(payout_num), Null(), If(payout_frac > 0.5, payout_floor + 1, If(payout_frac < 0.5, payout_floor, If(payout_err > 0, payout_floor + 1, If(payout_err < 0, payout_floor, If(Floor(payout_floor / 2) * 2 = payout_floor, payout_floor, payout_floor + 1))))) / 100) as payout_r,
    If(IsNull(gross_num), Null(), If(gross_frac > 0.5, gross_floor + 1, If(gross_frac < 0.5, gross_floor, If(gross_err > 0, gross_floor + 1, If(gross_err < 0, gross_floor, If(Floor(gross_floor / 2) * 2 = gross_floor, gross_floor, gross_floor + 1))))) / 100) as gross_r;
LOAD
    *,
    production_y - production_floor as production_frac,
    (production_hi * 100 - production_y) + (production_num - production_hi) * 100 as production_err,
    payout_y - payout_floor as payout_frac,
    (payout_hi * 100 - payout_y) + (payout_num - payout_hi) * 100 as payout_err,
    gross_y - gross_floor as gross_frac,
    (gross_hi * 100 - gross_y) + (gross_num - gross_hi) * 100 as gross_err;
LOAD
    *,
    production_num * 100 as production_y,
    Floor(production_num * 100) as production_floor,
    134217729 * production_num - (134217729 * production_num - production_num) as production_hi,
    payout_num * 100 as payout_y,
    Floor(payout_num * 100) as payout_floor,
    134217729 * payout_num - (134217729 * payout_num - payout_num) as payout_hi,
    gross_num * 100 as gross_y,
    Floor(gross_num * 100) as gross_floor,
    134217729 * gross_num - (134217729 * gross_num - gross_num) as gross_hi;
LOAD
    row_seed,
    row_order,
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    If(IsNum([Production Earned]), [Production Earned] + 0, Null()) as production_num,
    If(IsNum([Payout Earned]), [Payout Earned] + 0, Null()) as payout_num,
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    If(IsNum([Gross Comms]), [Gross Comms] + 0, Null()) as gross_num,
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE]
RESIDENT FINAL_GLCS;

DROP TABLE FINAL_GLCS;

// Seed row first (row_seed = 1); it is not stored and is removed at the end.
[Qlik]:
NoConcatenate
LOAD
    row_seed,
    row_order,
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    If(IsNull(production_r), '', If(production_num < 0 and production_r = 0, Text('-0.00'), Text(Num(production_r, '0.00', '.', ',')))) as [Production Earned],
    production_r as [Production Earned Num],
    If(IsNull(payout_r), '', If(payout_num < 0 and payout_r = 0, Text('-0.00'), Text(Num(payout_r, '0.00', '.', ',')))) as [Payout Earned],
    payout_r as [Payout Earned Num],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    If(IsNull(gross_r), '', If(gross_num < 0 and gross_r = 0, Text('-0.00'), Text(Num(gross_r, '0.00', '.', ',')))) as [Gross Comms],
    gross_r as [Gross Comms Num],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE],
    [As of trade date] & '|' & Upper([Client]) & '|' & [Security] & '|' & [Trade Id] & '|' & [Trader Team Name] & '|' & [ShortDesc] & '|' & [Trade Date] & '|' & [RR Team] & '|' & [Security Description] & '|' & [BuySell] & '|' & [Acct Short Description] & '|' & [TradeAmount] as CompNum,
    [As of trade date] & '|' & Upper([Client]) & '|' & [Security] & '|' & [Trade Id] & '|' & [Trader Team Name] & '|' & [ShortDesc] & '|' & [Trade Date] & '|' & [RR Team] & '|' & [Security Description] & '|' & [BuySell] & '|' & [Acct Short Description] & '|' & [TradeAmount] as CompNum_QLIK
RESIDENT _PAYOUT_NUM
ORDER BY row_order;

DROP TABLE _PAYOUT_NUM;

// --- final payout file ---------------------------------------------------------
LET vPayoutFile = '$(vOutFolder)$(vOutPrefix)PPT_DailyExportOfPayout_$(vPayoutYMD).csv';

IF vStorePayout = 1 THEN

    [_STORE_PAYOUT]:
    NoConcatenate
    LOAD
        [As of trade date],
        [Client],
        [Security],
        [Trade Id],
        [Salesperson],
        [Production Earned],
        [Payout Earned],
        [Trader Team Name],
        [Fidelity #],
        [ShortDesc],
        [TradeType],
        [Trade Date],
        [RR Team],
        [Source],
        [Sec Type],
        [Sec Type Description],
        [Security Description],
        [Gross Comms],
        [Acct Short Description],
        [Currency],
        [BuySell],
        [TradeAmount],
        [GLCS CODE]
    RESIDENT [Qlik]
    WHERE row_seed = 0
    ORDER BY row_order;

    IF Alt(TableNumber('_STORE_PAYOUT'), -1) >= 0 THEN
        STORE _STORE_PAYOUT INTO [$(vPayoutFile)] (txt);
        DROP TABLE _STORE_PAYOUT;
        TRACE [CASTINE] Final payout written: $(vOutPrefix)PPT_DailyExportOfPayout_$(vPayoutYMD).csv - rows: $(vCntFinal);
    ELSE
        TRACE [CASTINE][WARN] Final payout has no rows and could not be written header-only;
    END IF

ELSE
    TRACE [CASTINE][WARN] Final payout not written (vStorePayout = $(vStorePayout), rows = $(vCntFinal));
END IF

// --- alert files (same names as the Python, with the prefix) -------------------
// Every alert is written on every reload, as in Castine.py (header only when empty),
// so a file left by an earlier reload is overwritten.
SUB StoreAlert(pStoreAlertTable, pStoreAlertFile)

    LET vAlertRows = NoOfRows('$(pStoreAlertTable)') - 1;

    IF vStoreAlerts = 1 THEN

        [_ALERT_OUT]:
        NoConcatenate
        LOAD *
        RESIDENT [$(pStoreAlertTable)]
        WHERE row_seed = 0;

        // A LOAD that returns 0 rows may not create a table (not stated in the help).
        IF Alt(TableNumber('_ALERT_OUT'), -1) >= 0 THEN
            DROP FIELD row_seed FROM _ALERT_OUT;
            STORE _ALERT_OUT INTO [$(vOutFolder)$(vOutPrefix)$(pStoreAlertFile)] (txt);
            DROP TABLE _ALERT_OUT;
        ELSE
            TRACE [CASTINE][WARN] Alert $(pStoreAlertFile) has no rows and could not be written header-only;
        END IF

    END IF

    TRACE [CASTINE] Alert $(pStoreAlertFile): $(vAlertRows) row(s);
    DROP TABLE [$(pStoreAlertTable)];

END SUB

CALL StoreAlert('ALERT_SPLIT_UNMAPPED', 'split_unmapped_alerts.csv');
CALL StoreAlert('ALERT_XML_NONUSD', 'xml_nonusd_excluded_alerts.csv');
CALL StoreAlert('ALERT_CROSSYEAR', 'crossyear_gncl_mult_excluded_alerts.csv');
CALL StoreAlert('ALERT_TEAM_MISMATCH', 'split_team_mismatch_alerts.csv');
CALL StoreAlert('ALERT_REPO_UNMAPPED', 'repo_unmapped_alerts.csv');
CALL StoreAlert('SPLIT_ALERTS', 'split_matrix_config_alerts.csv');
CALL StoreAlert('ALERT_BUSINESS_EXCLUDED', 'final_payout_business_excluded_alerts.csv');
CALL StoreAlert('ALERT_GLCS_UNMAPPED', 'glcs_code_unmapped_alerts.csv');
CALL StoreAlert('ALERT_GLCS_EMAIL', 'glcs_code_unmatched_names_email.csv');
CALL StoreAlert('ALERT_GLCS_SUSPICIOUS', 'glcs_code_suspicious_numeric_alerts.csv');

DROP TABLE SPLIT_VALID;

// --- step counters, same names as the Castine.py console log -------------------
[AUDIT_STEPS]:
NoConcatenate
LOAD
    RecNo() as [Audit Order],
    [Audit Step],
    [Audit Value]
INLINE [
Audit Step,Audit Value
payout_date,$(vPayoutYMD)
xml_files_selected,$(vCntXmlFiles)
total_trades_parsed_raw,$(vCntTradesParsed)
rows_after_versioning,$(vCntAfterVersion)
rows_after_remove_cancels,$(vCntAfterCancels)
split_valid_rows,$(vCntSplitValid)
xml_rows_mapped,$(vCntXmlMapped)
xml_rows_dropped_unmapped,$(vCntXmlDropped)
xml_rows_kept,$(vCntXmlKept)
xml_rows_excluded_non_usd,$(vCntXmlNonUsd)
repo_rows_total,$(vCntRepoTotal)
repo_rows_kept,$(vCntRepoKept)
repo_rows_dropped,$(vCntRepoDropped)
crossyear_excluded,$(vCntCrossYear)
adjustments_rows_appended,$(vCntAdjAppended)
business_excluded_235_test,$(vCntBusinessExcl)
glcs_code_unmapped,$(vCntGlcsUnmapped)
final_rows,$(vCntFinal)
];

///$tab 14_Compare
// ============================================================================
// Comparison with the Python export, with the key of the current comparison tab:
//   As of trade date | Client | Security | Trade Id | Trader Team Name |
//   ShortDesc | Trade Date | RR Team | Security Description | BuySell |
//   Acct Short Description | TradeAmount
//
// Tables left in the app:
//   [Qlik]            this reload               (CompNum, CompNum_QLIK)
//   [Python]          PPT_DailyExportOfPayout   (CompNum, CompNum Python)
//   [COMPARE_BY_KEY]  rows and Production Earned of each key on both sides
//   [COMPARE_FULL_ROW] every distinct full row (all 23 columns) and how many times it is on each side
// A key is repeated when a trade is split between salespeople, so the
// comparison is by number of rows and by sum of Production Earned.
// ============================================================================

LET vCmpDate = If(Len('$(vCompareDate)') > 0, '$(vCompareDate)', '$(vPayoutYMD)');
LET vPyFile  = '@none';

IF vRunCompare = 1 THEN

    FOR Each vPyHit in FileList('$(vPythonFolder1)PPT_DailyExportOfPayout_$(vCmpDate).csv')
        LET vPyFile = vPyHit;
    NEXT vPyHit

    IF vPyFile = '@none' THEN
        FOR Each vPyHit in FileList('$(vPythonFolder2)PPT_DailyExportOfPayout_$(vCmpDate).csv')
            LET vPyFile = vPyHit;
        NEXT vPyHit
    END IF

    IF vPyFile = '@none' THEN
        TRACE [COMPARE][WARN] Python file PPT_DailyExportOfPayout_$(vCmpDate).csv not found. No comparison;
    END IF

END IF

IF vPyFile <> '@none' THEN

    // Values of the Python file are compared as written: Verbatim = 1 keeps the
    // blanks at both ends, which only the manual adjustments rows can have.
    SET Verbatim = 1;

    LET vHdrFile = vPyFile;
    SET vHdrFormat = txt, $(vPythonCharSet), embedded labels, delimiter is ',', msq;
    CALL LoadHeader;

    IF vHdrCount > 0 THEN

        LET vPySelect = 'RecNo() as py_row';

        FOR vPyI = 1 to 23
            LET vPyCol  = SubField('$(vOfficialCols)', '|', $(vPyI));
            LET vPyNorm = KeepChar(Lower(vPyCol), 'abcdefghijklmnopqrstuvwxyz0123456789');
            CALL ColumnExpr('$(vPyNorm)');
            LET vPyExpr = If(vColName = '@none', Chr(39) & Chr(39), 'If(IsNull([' & vColName & ']), ' & Chr(39) & Chr(39) & ', Text([' & vColName & ']))');
            LET vPySelect = vPySelect & ', ' & vPyExpr & ' as [' & vPyCol & ' Python]';
        NEXT vPyI

        [Python]:
        NoConcatenate
        LOAD
            py_row,
            [As of trade date Python],
            [Client Python],
            [Security Python],
            [Trade Id Python],
            [Salesperson Python],
            [Production Earned Python],
            [Payout Earned Python],
            [Trader Team Name Python],
            [Fidelity # Python],
            [ShortDesc Python],
            [TradeType Python],
            [Trade Date Python],
            [RR Team Python],
            [Source Python],
            [Sec Type Python],
            [Sec Type Description Python],
            [Security Description Python],
            [Gross Comms Python],
            [Acct Short Description Python],
            [Currency Python],
            [BuySell Python],
            [TradeAmount Python],
            [GLCS CODE Python],
            If(IsNum(Num#([Production Earned Python])), Num#([Production Earned Python]) + 0, Null()) as [Production Earned Python Num],
            If(IsNum(Num#([Payout Earned Python])), Num#([Payout Earned Python]) + 0, Null()) as [Payout Earned Python Num],
            If(IsNum(Num#([Gross Comms Python])), Num#([Gross Comms Python]) + 0, Null()) as [Gross Comms Python Num],
            [As of trade date Python] & '|' & Upper([Client Python]) & '|' & [Security Python] & '|' & [Trade Id Python] & '|' & [Trader Team Name Python] & '|' & [ShortDesc Python] & '|' & [Trade Date Python] & '|' & [RR Team Python] & '|' & [Security Description Python] & '|' & [BuySell Python] & '|' & [Acct Short Description Python] & '|' & [TradeAmount Python] as CompNum,
            [As of trade date Python] & '|' & Upper([Client Python]) & '|' & [Security Python] & '|' & [Trade Id Python] & '|' & [Trader Team Name Python] & '|' & [ShortDesc Python] & '|' & [Trade Date Python] & '|' & [RR Team Python] & '|' & [Security Description Python] & '|' & [BuySell Python] & '|' & [Acct Short Description Python] & '|' & [TradeAmount Python] as [CompNum Python];
        LOAD
            $(vPySelect)
        FROM [$(vPyFile)]
        ($(vHdrFormat));

        LET vPyRows = Alt(NoOfRows('Python'), 0);
        TRACE [COMPARE] Python file: PPT_DailyExportOfPayout_$(vCmpDate).csv - rows: $(vPyRows);

        // one row per key and side (seed row first, so the table always exists)
        [_CMP]:
        NoConcatenate
        LOAD
            1 as cmp_seed,
            '' as CompNum,
            '' as [Compare Source],
            0 as [Rows Qlik],
            0 as [Production Qlik],
            0 as [Rows Python],
            0 as [Production Python]
        AUTOGENERATE 1;

        IF vCntFinal > 0 THEN

            Concatenate ([_CMP])
            LOAD
                0 as cmp_seed,
                CompNum,
                MaxString([Source]) as [Compare Source],
                Count(CompNum) as [Rows Qlik],
                Sum(Alt(Num#([Production Earned]), 0)) as [Production Qlik],
                0 as [Rows Python],
                0 as [Production Python]
            RESIDENT [Qlik]
            WHERE row_seed = 0
            GROUP BY CompNum;

        END IF

        IF vPyRows > 0 THEN

            Concatenate ([_CMP])
            LOAD
                0 as cmp_seed,
                CompNum,
                MaxString([Source Python]) as [Compare Source],
                0 as [Rows Qlik],
                0 as [Production Qlik],
                Count(CompNum) as [Rows Python],
                Sum(Alt(Num#([Production Earned Python]), 0)) as [Production Python]
            RESIDENT [Python]
            GROUP BY CompNum;

        END IF

        LET vCmpInput = NoOfRows('_CMP') - 1;

        IF vCmpInput > 0 THEN

            [COMPARE_BY_KEY]:
            NoConcatenate
            LOAD
                CompNum,
                [Compare Source],
                [Rows Qlik],
                [Rows Python],
                [Production Qlik],
                [Production Python],
                [Production Qlik] - [Production Python] as [Production Difference],
                If([Rows Python] = 0, 'ONLY_QLIK', If([Rows Qlik] = 0, 'ONLY_PYTHON', If([Rows Qlik] <> [Rows Python], 'DIFF_ROWS', If(Fabs([Production Qlik] - [Production Python]) > 0.005, 'DIFF_AMOUNT', 'MATCH')))) as [Compare Status];
            LOAD
                CompNum,
                MaxString([Compare Source]) as [Compare Source],
                Sum([Rows Qlik]) as [Rows Qlik],
                Sum([Rows Python]) as [Rows Python],
                Sum([Production Qlik]) as [Production Qlik],
                Sum([Production Python]) as [Production Python]
            RESIDENT _CMP
            WHERE cmp_seed = 0
            GROUP BY CompNum;

            [COMPARE_SUMMARY]:
            NoConcatenate
            LOAD
                [Compare Source] as [Summary Source],
                [Compare Status] as [Summary Status],
                Count(CompNum) as [Summary Keys],
                Sum([Rows Qlik]) as [Summary Rows Qlik],
                Sum([Rows Python]) as [Summary Rows Python],
                Sum([Production Qlik]) as [Summary Production Qlik],
                Sum([Production Python]) as [Summary Production Python]
            RESIDENT COMPARE_BY_KEY
            GROUP BY [Compare Source], [Compare Status];

            [_CMP_TOTAL]:
            NoConcatenate
            LOAD
                Count(CompNum) as cmp_keys,
                Sum(If([Compare Status] = 'MATCH', 1, 0)) as cmp_match,
                Sum(If([Compare Status] = 'ONLY_QLIK', 1, 0)) as cmp_only_qlik,
                Sum(If([Compare Status] = 'ONLY_PYTHON', 1, 0)) as cmp_only_python,
                Sum(If([Compare Status] = 'DIFF_ROWS', 1, 0)) as cmp_diff_rows,
                Sum(If([Compare Status] = 'DIFF_AMOUNT', 1, 0)) as cmp_diff_amount
            RESIDENT COMPARE_BY_KEY;

            LET vCmpKeys       = Alt(Peek('cmp_keys', 0, '_CMP_TOTAL'), 0);
            LET vCmpMatch      = Alt(Peek('cmp_match', 0, '_CMP_TOTAL'), 0);
            LET vCmpOnlyQlik   = Alt(Peek('cmp_only_qlik', 0, '_CMP_TOTAL'), 0);
            LET vCmpOnlyPython = Alt(Peek('cmp_only_python', 0, '_CMP_TOTAL'), 0);
            LET vCmpDiffRows   = Alt(Peek('cmp_diff_rows', 0, '_CMP_TOTAL'), 0);
            LET vCmpDiffAmount = Alt(Peek('cmp_diff_amount', 0, '_CMP_TOTAL'), 0);
            LET vCmpDiff       = vCmpKeys - vCmpMatch;
            CALL DropIfExists('_CMP_TOTAL');

            TRACE [COMPARE] keys: $(vCmpKeys) - identical: $(vCmpMatch) - different: $(vCmpDiff);
            TRACE [COMPARE] only in Qlik: $(vCmpOnlyQlik) - only in Python: $(vCmpOnlyPython) - different number of rows: $(vCmpDiffRows) - different Production Earned: $(vCmpDiffAmount);


            // --- every column of every row -----------------------------------------
            // CompNum is the key of the validation sheet (12 columns). COMPARE_FULL_ROW
            // also compares the other 11 columns: one row per distinct full row, with
            // the number of times it appears on each side.
            [_CMP_ROW]:
            NoConcatenate
            LOAD
                1 as cmpr_seed,
                '' as CompNum,
                '' as [Cmp Client],
                '' as [Cmp Salesperson],
                '' as [Cmp Production Earned],
                '' as [Cmp Payout Earned],
                '' as [Cmp Fidelity #],
                '' as [Cmp TradeType],
                '' as [Cmp Source],
                '' as [Cmp Sec Type],
                '' as [Cmp Sec Type Description],
                '' as [Cmp Gross Comms],
                '' as [Cmp Currency],
                '' as [Cmp GLCS CODE],
                0 as [Full Rows Qlik],
                0 as [Full Rows Python]
            AUTOGENERATE 1;

            IF vCntFinal > 0 THEN

                Concatenate ([_CMP_ROW])
                LOAD
                    0 as cmpr_seed,
                    CompNum,
                    Text([Client]) as [Cmp Client],
                    Text([Salesperson]) as [Cmp Salesperson],
                    Text([Production Earned]) as [Cmp Production Earned],
                    Text([Payout Earned]) as [Cmp Payout Earned],
                    Text([Fidelity #]) as [Cmp Fidelity #],
                    Text([TradeType]) as [Cmp TradeType],
                    Text([Source]) as [Cmp Source],
                    Text([Sec Type]) as [Cmp Sec Type],
                    Text([Sec Type Description]) as [Cmp Sec Type Description],
                    Text([Gross Comms]) as [Cmp Gross Comms],
                    Text([Currency]) as [Cmp Currency],
                    Text([GLCS CODE]) as [Cmp GLCS CODE],
                    Count(CompNum) as [Full Rows Qlik],
                    0 as [Full Rows Python]
                RESIDENT [Qlik]
                WHERE row_seed = 0
                GROUP BY CompNum, [Client], [Salesperson], [Production Earned], [Payout Earned], [Fidelity #], [TradeType], [Source], [Sec Type], [Sec Type Description], [Gross Comms], [Currency], [GLCS CODE];

            END IF

            IF vPyRows > 0 THEN

                Concatenate ([_CMP_ROW])
                LOAD
                    0 as cmpr_seed,
                    CompNum,
                    Text([Client Python]) as [Cmp Client],
                    Text([Salesperson Python]) as [Cmp Salesperson],
                    Text([Production Earned Python]) as [Cmp Production Earned],
                    Text([Payout Earned Python]) as [Cmp Payout Earned],
                    Text([Fidelity # Python]) as [Cmp Fidelity #],
                    Text([TradeType Python]) as [Cmp TradeType],
                    Text([Source Python]) as [Cmp Source],
                    Text([Sec Type Python]) as [Cmp Sec Type],
                    Text([Sec Type Description Python]) as [Cmp Sec Type Description],
                    Text([Gross Comms Python]) as [Cmp Gross Comms],
                    Text([Currency Python]) as [Cmp Currency],
                    Text([GLCS CODE Python]) as [Cmp GLCS CODE],
                    0 as [Full Rows Qlik],
                    Count(CompNum) as [Full Rows Python]
                RESIDENT [Python]
                GROUP BY CompNum, [Client Python], [Salesperson Python], [Production Earned Python], [Payout Earned Python], [Fidelity # Python], [TradeType Python], [Source Python], [Sec Type Python], [Sec Type Description Python], [Gross Comms Python], [Currency Python], [GLCS CODE Python];

            END IF

            [COMPARE_FULL_ROW]:
            NoConcatenate
            LOAD
                *,
                If([Full Rows Python] = 0, 'ONLY_QLIK', If([Full Rows Qlik] = 0, 'ONLY_PYTHON', If([Full Rows Qlik] <> [Full Rows Python], 'DIFF_ROWS', 'MATCH'))) as [Full Row Status];
            LOAD
                CompNum,
                [Cmp Client],
                [Cmp Salesperson],
                [Cmp Production Earned],
                [Cmp Payout Earned],
                [Cmp Fidelity #],
                [Cmp TradeType],
                [Cmp Source],
                [Cmp Sec Type],
                [Cmp Sec Type Description],
                [Cmp Gross Comms],
                [Cmp Currency],
                [Cmp GLCS CODE],
                Sum([Full Rows Qlik]) as [Full Rows Qlik],
                Sum([Full Rows Python]) as [Full Rows Python]
            RESIDENT _CMP_ROW
            WHERE cmpr_seed = 0
            GROUP BY CompNum, [Cmp Client], [Cmp Salesperson], [Cmp Production Earned], [Cmp Payout Earned], [Cmp Fidelity #], [Cmp TradeType], [Cmp Source], [Cmp Sec Type], [Cmp Sec Type Description], [Cmp Gross Comms], [Cmp Currency], [Cmp GLCS CODE];

            DROP TABLE _CMP_ROW;

            [_CMP_ROW_TOTAL]:
            NoConcatenate
            LOAD
                Count(CompNum) as cmpr_rows,
                Sum(If([Full Row Status] = 'MATCH', 1, 0)) as cmpr_match
            RESIDENT COMPARE_FULL_ROW;

            LET vCmpFull      = Alt(Peek('cmpr_rows', 0, '_CMP_ROW_TOTAL'), 0);
            LET vCmpFullMatch = Alt(Peek('cmpr_match', 0, '_CMP_ROW_TOTAL'), 0);
            LET vCmpFullDiff  = vCmpFull - vCmpFullMatch;
            CALL DropIfExists('_CMP_ROW_TOTAL');

            TRACE [COMPARE] full rows (all 23 columns): $(vCmpFull) - identical: $(vCmpFullMatch) - different: $(vCmpFullDiff);

            // --- row order -----------------------------------------------------------
            // The checks above are by key and ignore the order of the rows. Row n of the
            // stored payout (WHERE row_seed = 0, ORDER BY row_order) is paired with
            // record n of the Python file (py_row = RecNo()).
            LET vCmpPosDiff = 0;

            IF vCntFinal > 0 and vPyRows > 0 THEN

                [_CMP_POS]:
                NoConcatenate
                LOAD
                    RowNo() as cmp_pos,
                    CompNum & '|' & Text([Client]) & '|' & Text([Salesperson]) & '|' & Text([Production Earned]) as pos_qlik
                RESIDENT [Qlik]
                WHERE row_seed = 0
                ORDER BY row_order;

                Outer Join ([_CMP_POS])
                LOAD
                    py_row as cmp_pos,
                    CompNum & '|' & Text([Client Python]) & '|' & Text([Salesperson Python]) & '|' & Text([Production Earned Python]) as pos_python
                RESIDENT [Python];

                [_CMP_POS_TOTAL]:
                NoConcatenate
                LOAD
                    Sum(If(IsNull(pos_qlik) or IsNull(pos_python), 1, If(pos_qlik = pos_python, 0, 1))) as pos_diff
                RESIDENT [_CMP_POS];

                LET vCmpPosDiff = Alt(Peek('pos_diff', 0, '_CMP_POS_TOTAL'), 0);
                CALL DropIfExists('_CMP_POS_TOTAL');
                CALL DropIfExists('_CMP_POS');

            END IF

            TRACE [COMPARE] rows in a different position: $(vCmpPosDiff);

            IF vCmpDiff = 0 and vCmpFullDiff = 0 and vCmpPosDiff = 0 and vCmpKeys > 0 THEN
                TRACE [COMPARE] RESULT: this reload is IDENTICAL to the Python export - every row, all 23 columns;
            ELSEIF vCmpDiff = 0 and vCmpFullDiff = 0 and vCmpKeys > 0 THEN
                TRACE [COMPARE] RESULT: same rows and values, but $(vCmpPosDiff) rows are in a different position than in the Python export;
            ELSEIF vCmpDiff = 0 and vCmpKeys > 0 THEN
                TRACE [COMPARE] RESULT: same keys and same Production Earned, but $(vCmpFullDiff) full rows differ in another column. See COMPARE_FULL_ROW (field Full Row Status);
            ELSE
                TRACE [COMPARE] RESULT: there are differences. See COMPARE_SUMMARY, COMPARE_BY_KEY (field Compare Status) and COMPARE_FULL_ROW (field Full Row Status);
            END IF

        ELSE
            TRACE [COMPARE][WARN] Nothing to compare (no rows on either side);
        END IF

        DROP TABLE _CMP;

    ELSE
        TRACE [COMPARE][WARN] Python file could not be read. No comparison;
    END IF

    CALL DropIfExists('_HDR');

END IF

// --- alert files ------------------------------------------------------------------
// Each alert file written by this reload is compared line by line with the file of
// the same name written by Castine.py. Both files are read the same way (no labels,
// so the header line is compared too); quotes are removed by the reader, so a value
// that one side quotes and the other does not still matches.
SUB ReadAlertLines(pReadAlertLinesFile, pReadAlertLinesTable)

    CALL DropIfExists('_CA_RAW');
    CALL DropIfExists('$(pReadAlertLinesTable)');
    LET vCaLines = -1;

    SET ErrorMode = 0;

    [_CA_RAW]:
    NoConcatenate
    LOAD *
    FROM [$(pReadAlertLinesFile)]
    (txt, utf8, no labels, delimiter is ',', msq);

    LET vCaError = ScriptError + 0;
    SET ErrorMode = 1;

    IF vCaError = 0 and Alt(TableNumber('_CA_RAW'), -1) >= 0 THEN

        LET vCaExpr = Chr(39) & Chr(39);
        FOR vCaF = 1 to NoOfFields('_CA_RAW')
            LET vCaName = FieldName($(vCaF), '_CA_RAW');
            LET vCaExpr = vCaExpr & ' & ' & Chr(39) & '|' & Chr(39) & ' & If(IsNull([' & vCaName & ']), ' & Chr(39) & Chr(39) & ', Text([' & vCaName & ']))';
        NEXT vCaF

        [$(pReadAlertLinesTable)]:
        NoConcatenate
        LOAD
            RecNo() as ca_line,
            Replace($(vCaExpr), Chr(65279), '') as ca_text
        RESIDENT _CA_RAW;

        LET vCaLines = Alt(NoOfRows('$(pReadAlertLinesTable)'), 0);

    END IF

    CALL DropIfExists('_CA_RAW');

END SUB

SUB CompareAlertFile(pCompareAlertFileName)

    LET vCaPy   = '@none';
    LET vCaQlik = '@none';

    FOR Each vCaHit in FileList('$(vPythonAlertFolder)$(pCompareAlertFileName)')
        LET vCaPy = vCaHit;
    NEXT vCaHit
    FOR Each vCaHit in FileList('$(vOutFolder)$(vOutPrefix)$(pCompareAlertFileName)')
        LET vCaQlik = vCaHit;
    NEXT vCaHit

    LET vCaStatus  = 'MATCH';
    LET vCaPyRows  = -1;
    LET vCaQRows   = -1;
    LET vCaDiff    = -1;

    IF vCaPy = '@none' or vCaQlik = '@none' THEN

        LET vCaStatus = If(vCaPy = '@none', 'NO_PYTHON_FILE', 'NO_QLIK_FILE');

    ELSE

        CALL ReadAlertLines(vCaPy, '_CA_PY');
        LET vCaPyRows = vCaLines;
        CALL ReadAlertLines(vCaQlik, '_CA_QLIK');
        LET vCaQRows = vCaLines;

        IF vCaPyRows < 0 or vCaQRows < 0 THEN
            LET vCaStatus = 'NOT_READ';
        ELSE

            [_CA_PAIR]:
            NoConcatenate
            LOAD
                ca_line,
                ca_text as ca_py
            RESIDENT _CA_PY;

            Outer Join ([_CA_PAIR])
            LOAD
                ca_line,
                ca_text as ca_qlik
            RESIDENT _CA_QLIK;

            [_CA_SUM]:
            NoConcatenate
            LOAD
                Sum(If(IsNull(ca_py) or IsNull(ca_qlik), 1, If((Chr(126) & ca_py) = (Chr(126) & ca_qlik), 0, 1))) as ca_diff
            RESIDENT _CA_PAIR;

            LET vCaDiff = Alt(Peek('ca_diff', 0, '_CA_SUM'), 0);
            LET vCaStatus = If(vCaDiff = 0, 'MATCH', 'DIFFERENT');

            [_CA_FIRST]:
            NoConcatenate
            LOAD
                Min(ca_line) as ca_first
            RESIDENT _CA_PAIR
            WHERE IsNull(ca_py) or IsNull(ca_qlik) or (Chr(126) & ca_py) <> (Chr(126) & ca_qlik);

            LET vCaFirst = Alt(Peek('ca_first', 0, '_CA_FIRST'), 0);

            CALL DropIfExists('_CA_FIRST');
            CALL DropIfExists('_CA_SUM');
            CALL DropIfExists('_CA_PAIR');

        END IF

        CALL DropIfExists('_CA_PY');
        CALL DropIfExists('_CA_QLIK');

    END IF

    Concatenate ([COMPARE_ALERTS])
    LOAD
        '$(pCompareAlertFileName)' as [Alert File],
        '$(vCaStatus)' as [Alert Compare Status],
        $(vCaPyRows) as [Alert Lines Python],
        $(vCaQRows) as [Alert Lines Qlik],
        $(vCaDiff) as [Alert Lines Different]
    AUTOGENERATE 1;

    IF vCaStatus = 'DIFFERENT' THEN
        TRACE [COMPARE] alert $(pCompareAlertFileName): $(vCaDiff) lines differ (first at line $(vCaFirst), header = line 1);
    ELSE
        TRACE [COMPARE] alert $(pCompareAlertFileName): $(vCaStatus);
    END IF

END SUB

IF vRunCompare = 1 and vStoreAlerts = 1 THEN

    TRACE [COMPARE] Alert files: valid only when Castine.py last ran for payout date $(vPayoutYMD) (its alert files have no date);

    [COMPARE_ALERTS]:
    NoConcatenate
    LOAD
        '@seed' as [Alert File],
        '' as [Alert Compare Status],
        0 as [Alert Lines Python],
        0 as [Alert Lines Qlik],
        0 as [Alert Lines Different]
    AUTOGENERATE 1;

    CALL CompareAlertFile('split_unmapped_alerts.csv');
    CALL CompareAlertFile('xml_nonusd_excluded_alerts.csv');
    CALL CompareAlertFile('crossyear_gncl_mult_excluded_alerts.csv');
    CALL CompareAlertFile('split_team_mismatch_alerts.csv');
    CALL CompareAlertFile('repo_unmapped_alerts.csv');
    CALL CompareAlertFile('split_matrix_config_alerts.csv');
    CALL CompareAlertFile('final_payout_business_excluded_alerts.csv');
    CALL CompareAlertFile('glcs_code_unmapped_alerts.csv');
    CALL CompareAlertFile('glcs_code_unmatched_names_email.csv');
    CALL CompareAlertFile('glcs_code_suspicious_numeric_alerts.csv');

    // the seed row leaves the table
    [_CA_FINAL]:
    NoConcatenate
    LOAD *
    RESIDENT COMPARE_ALERTS
    WHERE [Alert File] <> '@seed';

    DROP TABLE COMPARE_ALERTS;
    RENAME TABLE _CA_FINAL TO COMPARE_ALERTS;

END IF

// --- the seed row leaves the final table ----------------------------------------
[_QLIK_FINAL]:
NoConcatenate
LOAD *
RESIDENT [Qlik]
WHERE row_seed = 0;

DROP TABLE [Qlik];

IF Alt(NoOfRows('_QLIK_FINAL'), 0) > 0 THEN
    RENAME TABLE _QLIK_FINAL TO [Qlik];
    DROP FIELD row_seed FROM [Qlik];
END IF

// Work tables that an unusual path (empty file, nothing mapped) may leave behind.
CALL DropIfExists('REPO_RAW');
CALL DropIfExists('ADJ_RAW');
CALL DropIfExists('XML_MATCHED');
CALL DropIfExists('REPO_MATCHED');
CALL DropIfExists('_HDR');
CALL DropIfExists('_HDR_PROBE');

TRACE [CASTINE] Done. Payout date $(vPayoutYMD) - final rows $(vCntFinal);
