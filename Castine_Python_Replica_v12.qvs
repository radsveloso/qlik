///$tab 00_Main
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

$(Must_Include=lib://Fldr_QlikShare/SCRIPT/Config_QS.txt);

///$tab 01_Config
// ============================================================================
// Castine_Python_Replica v12 rev 1
//
// Qlik Sense version of Castine.py:
//   Bloomberg XML + Repo (Broadridge) + manual adjustments
//   -> split matrix -> PPT_DailyExportOfPayout_YYYYMMDD.csv
//
// Every tab names the Castine.py function it reproduces, in the order in
// which main() calls them. The only place to edit is this tab.
// ============================================================================
TRACE [CASTINE] Castine_Python_Replica v12 rev 1;

// --- Bloomberg XML (Castine.py: xml_folder, file_glob_pattern, date_limit_token)
SET vXmlFolder       = 'lib://Fldr_SDrive/Trading/bloomberg/ftp/';
SET vXmlPattern      = '*.ext.26*';
// Date limit, same meaning as "python Castine.py --limit-token 260130": only the
// files dated up to that day are read, and that day becomes the payout date.
//   FIRST TEST : 260130  -> reads January only (fast) and is compared with
//                           PPT_DailyExportOfPayout_20260130.csv
//   PRODUCTION : empty   -> reads every file of the pattern, as the Python does
SET vDateLimitToken  = '260130';

// --- Other inputs (same connections the current Qlik script uses)
SET vSalesDataFolder = 'lib://Fldr_SDrive/Qlikview/Sales/Data/';
SET vTiaraFolder     = 'lib://Fldr_SDrive/Qlikview/Sales/Data/Tiara Accounts/';
SET vRepoFolder      = 'lib://Fldr_SDrive/Operations/BroadridgeData/Reports/';
LET vSplitFile       = '$(SDrive_SalesControlData)/RR Teams Split Matrix.xlsx';
SET vSplitSheet      = 'Split_Matrix';

// --- Outputs. UAT folder only, and every file gets the prefix below, so that
// neither the Python export nor the current Qlik export is overwritten.
LET vOutFolder       = '$(SDrive)/UAT/Qlikview/Sales/Data/castine/';
SET vOutPrefix       = 'QLIK_V12_';
SET vStorePayout     = 1;
SET vStoreAlerts     = 1;

// --- Comparison with the Python export (last tab)
SET vRunCompare      = 1;
// Date of the Python file to compare with (YYYYMMDD). Empty = payout date of this reload.
SET vCompareDate     = '';
// Folders where PPT_DailyExportOfPayout_YYYYMMDD.csv is searched, in this order.
SET vPythonFolder1   = 'lib://Fldr_SDrive/qlikview/sales/data/daily files/';
SET vPythonFolder2   = 'lib://Fldr_SDrive/Qlikview/Sales/Data/castine/';
// Folder where Castine.py writes its alert files (alerts_output_folder). They have
// no date in the name: they are compared only when Python ran for the same date.
SET vPythonAlertFolder = 'lib://Fldr_SDrive/UAT/Qlikview/Sales/Data/castine/alerts/';

// --- File formats
// Castine.py tries utf-8 first and then cp1252. Each file is checked (SUB PickCharSet):
// a valid UTF-8 file with non-ASCII characters is read as utf8, any other file with
// the code page below.
SET vTiaraCharSet    = 'codepage is 1252';
SET vRepoCharSet     = 'codepage is 1252';
SET vAdjCharSet      = 'codepage is 1252';
// Castine.py writes PPT_DailyExportOfPayout with encoding utf-8.
SET vPythonCharSet   = 'utf8';
SET vRepoDelimiter   = ',';
SET vAdjDelimiter    = ',';
// Sheet of the adjustments workbook when it is an Excel file. Empty = first sheet.
SET vAdjSheet        = '';

// --- Castine.py constants (lists separated by |)
SET vRepoPrefixes    = 'YTDSalesCommission_|RepoSalesCommission_|YTDSalesComission_|RepoSalesComission_|YTDSalesCommission|RepoSalesCommission|YTDSalesComission|RepoSalesComission';
SET vAdjPrefixes     = 'adjustments DailyExportOfPayout_|adjustments DailyExportOfPayout|adjustments_DailyExportOfPayout_|adjustments_DailyExportOfPayout|adjustmentsDailyExportOfPayout_|adjustmentsDailyExportOfPayout';
// SPLIT_SUM_TOLERANCE
SET vSplitTolerance  = 0.001;
// Year written in exclude_legacy_roll_shortdesc_records
SET vLegacyYear      = 2026;

// --- Version order of a trade (keep_last_version, L1225)
// 1 = as pandas 2 or later reads AsOfTradeDate: the format of the first value
//     is the format of the column, a value in another format has no date there.
//     Nothing changes while every AsOfTradeDate has the same format.
// 0 = every AsOfTradeDate is read on its own (pandas 1.x).
SET vAsOfPandasFormat = 1;

// --- XML file that cannot be read
// 1 = the reload stops with the Qlik error message when the trades or the costs
//     of a file cannot be read (nothing is skipped in silence).
// 0 = the file is skipped with a warning in the log, as Castine.py does.
SET vStopOnXmlError = 1;
// A file up to this size without any trade is an empty feed (not an error).
SET vXmlEmptyBytes  = 600;

// --- Reload speed
// 1 = keep the trades already read from each XML in a QVD, so that the next
// reload only reads the new files. Leave 0 until the first reload is checked.
SET vUseXmlCache     = 0;
SET vXmlCacheName    = 'XML_PARSED_CACHE_v1.qvd';

IF Len('$(SDrive)') = 0 or Len('$(SDrive_SalesControlData)') = 0 THEN
    TRACE [CASTINE][STOP] Config_QS.txt did not define SDrive and SDrive_SalesControlData;
    EXIT SCRIPT;
END IF

// Step counters shown at the end (same names as the Castine.py console log)
LET vCntXmlFiles      = 0;
LET vCntTradesParsed  = 0;
LET vCntAfterVersion  = 0;
LET vCntAfterCancels  = 0;
LET vCntXmlMapped     = 0;
LET vCntXmlDropped    = 0;
LET vCntXmlKept       = 0;
LET vCntXmlNonUsd     = 0;
LET vCntRepoTotal     = 0;
LET vCntRepoKept      = 0;
LET vCntRepoDropped   = 0;
LET vCntCrossYear     = 0;
LET vCntAdjustments   = 0;
LET vCntBusinessExcl  = 0;
LET vCntFinal         = 0;
LET vCntSplitValid    = 0;

///$tab 02_Functions
// ============================================================================
// Expressions kept in variables and reusable routines.
// In every $(f...(x)) call the argument is a plain field name, never an
// expression with commas.
// ============================================================================

// Cell read from a file: NULL -> '', otherwise the text without the white space
// at both ends, as .strip() of the Python does: blank, tab, line feed, carriage
// return and no-break space are removed at the ends only (Trim() of Qlik removes
// blanks only). Text() keeps the value exactly as written in the file (no number
// or date interpretation, so 100.0 and 100 stay different).
SET fTxt = If(IsNull($1), '', Mid(Text($1), Len(Replace(Replace(Replace(Replace(Text($1), Chr(160), ' '), Chr(9), ' '), Chr(10), ' '), Chr(13), ' ')) - Len(LTrim(Replace(Replace(Replace(Replace(Text($1), Chr(160), ' '), Chr(9), ' '), Chr(10), ' '), Chr(13), ' '))) + 1, Len(Trim(Replace(Replace(Replace(Replace(Text($1), Chr(160), ' '), Chr(9), ' '), Chr(10), ' '), Chr(13), ' ')))));

// Value that went through the temporary CSV of Castine.py: pandas.read_csv turns
// these texts into empty values (pandas default NA list). $1 is already text.
SET fNa = If(IsNull($1), '', If(Match($1, '#N/A', '#N/A N/A', '#NA', '-1.#IND', '-1.#QNAN', '-NaN', '-nan', '1.#IND', '1.#QNAN', '<NA>', 'N/A', 'NA', 'NULL', 'NaN', 'None', 'n/a', 'nan', 'null') > 0, '', $1));

// Runs of blanks -> one blank (five passes cover runs of up to 32 blanks).
SET fCollapse = Replace(Replace(Replace(Replace(Replace($1, '  ', ' '), '  ', ' '), '  ', ' '), '  ', ' '), '  ', ' ');

// normalize_team_key (L679): no-break space -> blank, zero-width space and BOM
// removed, trimmed, runs of blanks -> one blank, upper case.
SET fTeamKey = Upper(Trim(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace($1, Chr(160), ' '), Chr(8203), ''), Chr(65279), ''), Chr(9), ' '), Chr(10), ' '), Chr(13), ' '), '  ', ' '), '  ', ' '), '  ', ' '), '  ', ' '), '  ', ' ')));

// normalize_currency (L696): same cleaning, upper case, quotes and every blank removed.
SET fCurrencyKey = PurgeChar(Upper(Replace(Replace(Replace($1, Chr(160), ' '), Chr(8203), ''), Chr(65279), '')), ' "' & Chr(39) & Chr(9) & Chr(10) & Chr(13));

// prefix_apostrophe (L883): a non-empty value starts with exactly one apostrophe.
SET fApos = If(Len(Trim($1)) = 0 or Lower(Trim($1)) = 'nan', '', If(Left(Trim($1), 1) = Chr(39), Trim($1), Chr(39) & Trim($1)));

// fmt_mdy_no_zeros (L646): M/D/YYYY without leading zeros. $1 = date number or NULL.
SET fMDY = If(IsNull($1), '', Num(Month($1)) & '/' & Day($1) & '/' & Year($1));

// Date number for year $1, month $2, day $3, or NULL when it is not a real date.
SET fYMD = If($1 >= 100 and $1 <= 9999 and $2 >= 1 and $2 <= 12 and $3 >= 1 and $3 <= Day(MonthEnd(MakeDate($1, $2, 1))), Num(MakeDate($1, $2, $3)), Null());

// True when $1 has 1 to 4 characters and all of them are digits.
SET fIsNum14 = (Len($1) >= 1 and Len($1) <= 4 and Len(KeepChar($1, '0123456789')) = Len($1));

// True when $1 has 6 to 8 characters and all of them are digits (file date token).
SET fIsTok = (Len($1) >= 6 and Len($1) <= 8 and Len(KeepChar($1, '0123456789')) = Len($1));

// True when $1 starts with YYYY-MM-DD and ends there or goes on with T or a blank
// (2026-01-30, 2026-01-30T10:15:00, 2026-01-30 10:15:00).
SET fIsIso = (Mid($1, 5, 1) = '-' and Mid($1, 8, 1) = '-' and Len(KeepChar(Left($1, 10), '0123456789')) = 8 and (Len($1) = 10 or Match(Mid($1, 11, 1), 'T', ' ') > 0));

// Text with every digit replaced by 9 (2026-01-30T10:15:00 -> 9999-99-99T99:99:99).
SET fDigitMask = Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace($1, '0', '9'), '1', '9'), '2', '9'), '3', '9'), '4', '9'), '5', '9'), '6', '9'), '7', '9'), '8', '9');

// pandas .round(2) and .round(10) = rint(x * 10^n) / 10^n: the scaled value goes
// to the nearest whole number and an exact half goes to the even one.
// (Round() of Qlik rounds a half upwards, which is a different rule. The part
// above 0.5 and the part below 0.5 are tested apart, so nothing is added to a
// number that is already a whole number of 16 digits.)
SET fRound2 = (If(($1) * 100 - Floor(($1) * 100) > 0.5, Floor(($1) * 100) + 1, If(($1) * 100 - Floor(($1) * 100) < 0.5, Floor(($1) * 100), If(Floor(Floor(($1) * 100) / 2) * 2 = Floor(($1) * 100), Floor(($1) * 100), Floor(($1) * 100) + 1))) / 100);
SET fRound10 = (If(($1) * 10000000000 - Floor(($1) * 10000000000) > 0.5, Floor(($1) * 10000000000) + 1, If(($1) * 10000000000 - Floor(($1) * 10000000000) < 0.5, Floor(($1) * 10000000000), If(Floor(Floor(($1) * 10000000000) / 2) * 2 = Floor(($1) * 10000000000), Floor(($1) * 10000000000), Floor(($1) * 10000000000) + 1))) / 10000000000);

// Money written the way Python writes it (to_csv float_format "%.2f"): the cent
// nearest to the exact value of the number, an exact half to the even cent, and
// a negative amount that rounds to zero (or the -0.000001 / -1e-12 markers) as
// -0.00. Same rule as tab 13. $1 = a number or NULL; the result is text.
SET fMoneyTxt = If(IsNull($1), '', If(IsNum($1) = 0, '', If(($1) < 0 and If(($1) * 100 - Floor(($1) * 100) > 0.5, Floor(($1) * 100) + 1, If(($1) * 100 - Floor(($1) * 100) < 0.5, Floor(($1) * 100), If((((134217729 * ($1) - (134217729 * ($1) - ($1))) * 100 - ($1) * 100) + (($1) - (134217729 * ($1) - (134217729 * ($1) - ($1)))) * 100) > 0, Floor(($1) * 100) + 1, If((((134217729 * ($1) - (134217729 * ($1) - ($1))) * 100 - ($1) * 100) + (($1) - (134217729 * ($1) - (134217729 * ($1) - ($1)))) * 100) < 0, Floor(($1) * 100), If(Floor(Floor(($1) * 100) / 2) * 2 = Floor(($1) * 100), Floor(($1) * 100), Floor(($1) * 100) + 1))))) = 0, '-0.00', Text(Num(If(($1) * 100 - Floor(($1) * 100) > 0.5, Floor(($1) * 100) + 1, If(($1) * 100 - Floor(($1) * 100) < 0.5, Floor(($1) * 100), If((((134217729 * ($1) - (134217729 * ($1) - ($1))) * 100 - ($1) * 100) + (($1) - (134217729 * ($1) - (134217729 * ($1) - ($1)))) * 100) > 0, Floor(($1) * 100) + 1, If((((134217729 * ($1) - (134217729 * ($1) - ($1))) * 100 - ($1) * 100) + (($1) - (134217729 * ($1) - (134217729 * ($1) - ($1)))) * 100) < 0, Floor(($1) * 100), If(Floor(Floor(($1) * 100) / 2) * 2 = Floor(($1) * 100), Floor(($1) * 100), Floor(($1) * 100) + 1))))) / 100, '0.00', '.', ',')))));

// ----------------------------------------------------------------------------
// ColumnDateShape: format of a date column as pandas takes it from its first
// value (pd.to_datetime of a whole column, pandas 2 or later).
//   vShape       = pColumnDateShapeShapeFirst with every digit replaced by 9
//   vShapeStrict = 1 when pColumnDateShapeShapeFirst is a real date written as YYYY-MM-DD...:
//                  pandas then reads the other values with that format only.
//                  0 when it is empty or not such a date: every value is read
//                  on its own.
// ----------------------------------------------------------------------------
SUB ColumnDateShape(pColumnDateShapeShapeFirst)

    LET vShape       = '@none';
    LET vShapeStrict = 0;

    IF Len(pColumnDateShapeShapeFirst) > 0 THEN

        LET vShapeY = Num#(Left(pColumnDateShapeShapeFirst, 4));
        LET vShapeM = Num#(Mid(pColumnDateShapeShapeFirst, 6, 2));
        LET vShapeD = Num#(Mid(pColumnDateShapeShapeFirst, 9, 2));

        IF $(fIsIso(pColumnDateShapeShapeFirst)) and Index(pColumnDateShapeShapeFirst, Chr(39)) = 0 and Index(pColumnDateShapeShapeFirst, Chr(59)) = 0 and not IsNull($(fYMD(vShapeY, vShapeM, vShapeD))) THEN
            LET vShape       = $(fDigitMask(pColumnDateShapeShapeFirst));
            LET vShapeStrict = $(vAsOfPandasFormat);
        END IF

    END IF

END SUB

// ----------------------------------------------------------------------------
// DropIfExists: drops a table only when it exists.
// ----------------------------------------------------------------------------
SUB DropIfExists(pDropIfExistsTable)

    IF Alt(TableNumber('$(pDropIfExistsTable)'), -1) >= 0 THEN
        DROP TABLE [$(pDropIfExistsTable)];
    END IF

END SUB

// ----------------------------------------------------------------------------
// ListFiles: files that match pListFilesMask -> table pListFilesTable (lf_path, lf_name).
// vListCount = number of files. The table is not created when there is none.
// The loop only fills a variable; the table is built by one LOAD.
// ----------------------------------------------------------------------------
SUB ListFiles(pListFilesMask, pListFilesTable)

    CALL DropIfExists('$(pListFilesTable)');
    LET vListText  = '|';
    LET vListCount = 0;

    FOR Each vListFile in FileList('$(pListFilesMask)')
        IF Index(vListFile, Chr(39)) = 0 and Index(vListFile, '|') = 0 THEN
            LET vListText  = vListText & vListFile & '|';
            LET vListCount = vListCount + 1;
        ELSE
            TRACE [CASTINE][WARN] File ignored because of a quote in its name;
        END IF
    NEXT vListFile

    IF vListCount > 0 THEN

        LET vListText = Mid(vListText, 2, Len(vListText) - 2);

        [$(pListFilesTable)]:
        NoConcatenate
        LOAD
            lf_path,
            SubField(Replace(lf_path, Chr(92), '/'), '/', -1) as lf_name;
        LOAD
            SubField('$(vListText)', '|') as lf_path
        AUTOGENERATE 1;

    END IF

    LET vListText = '|';

END SUB

// ----------------------------------------------------------------------------
// LoadHeader: reads the column names of the file vHdrFile, read with the
// format vHdrFormat, into table _HDR (hdr_no, hdr_name, hdr_norm).
// hdr_norm = header_norm of Castine.py (L707): lower case, only a-z and 0-9.
// vHdrCount = number of columns (0 when the file cannot be read).
// ----------------------------------------------------------------------------
SUB LoadHeader

    CALL DropIfExists('_HDR_PROBE');
    CALL DropIfExists('_HDR');
    LET vHdrCount = 0;

    SET ErrorMode = 0;

    [_HDR_PROBE]:
    NoConcatenate
    LOAD *
    FROM [$(vHdrFile)]
    ($(vHdrFormat))
    WHERE RecNo() <= 1;

    LET vHdrError = ScriptError + 0;
    SET ErrorMode = 1;

    IF vHdrError = 0 THEN
        LET vHdrCount = Alt(NoOfFields('_HDR_PROBE'), 0);
    ELSE
        TRACE [CASTINE][WARN] Could not read the header of $(vHdrFile) - error code $(vHdrError);
    END IF

    IF vHdrCount > 0 THEN

        [_HDR]:
        NoConcatenate
        LOAD
            hdr_no,
            hdr_name,
            KeepChar(Lower(Replace(hdr_name, Chr(160), ' ')), 'abcdefghijklmnopqrstuvwxyz0123456789') as hdr_norm;
        LOAD
            RecNo() as hdr_no,
            FieldName(RecNo(), '_HDR_PROBE') as hdr_name
        AUTOGENERATE $(vHdrCount);

    END IF

    CALL DropIfExists('_HDR_PROBE');

END SUB

// ----------------------------------------------------------------------------
// LoadLineHeader: column names of the file vHdrFile taken from its first line
// (character set vHdrCharSet, delimiter vHdrDelimiter) into table _HDR
// (hdr_no, hdr_name, hdr_norm). vHdrCount = number of columns (0 = not read).
// Used for the files that are read line by line.
// ----------------------------------------------------------------------------
SUB LoadLineHeader

    CALL DropIfExists('_HDR_LINE');
    CALL DropIfExists('_HDR');
    LET vHdrCount = 0;

    SET ErrorMode = 0;

    [_HDR_LINE]:
    NoConcatenate
    LOAD
        [@1:n] as hdr_line
    FROM [$(vHdrFile)]
    (fix, $(vHdrCharSet), no labels, record is line)
    WHERE RecNo() = 1;

    LET vHdrError = ScriptError + 0;
    SET ErrorMode = 1;

    IF vHdrError = 0 and Alt(NoOfRows('_HDR_LINE'), 0) > 0 THEN

        [_HDR]:
        NoConcatenate
        LOAD
            hdr_no,
            hdr_name,
            KeepChar(Lower(Replace(hdr_name, Chr(160), ' ')), 'abcdefghijklmnopqrstuvwxyz0123456789') as hdr_norm;
        LOAD
            IterNo() as hdr_no,
            Trim(SubField(hdr_line, '$(vHdrDelimiter)', IterNo())) as hdr_name
        RESIDENT _HDR_LINE
        WHILE IterNo() <= SubStringCount(hdr_line, '$(vHdrDelimiter)') + 1;

        LET vHdrCount = Alt(NoOfRows('_HDR'), 0);

    ELSE
        TRACE [CASTINE][WARN] Could not read the first line of $(vHdrFile) - error code $(vHdrError);
    END IF

    CALL DropIfExists('_HDR_LINE');

END SUB

// ----------------------------------------------------------------------------
// PickCharSet: vPickCharSetUtf8 = 1 when the text file pPickCharSetFile is
// UTF-8 with at least one non-ASCII character, otherwise 0 (keep the
// configured code page). Castine.py tries utf-8 first and then cp1252.
// The file is read byte by byte (codepage 28591: byte n is Chr(n)) and the
// bytes 128-255 are counted: continuation bytes 128-191 must be exactly the
// number the lead bytes need (194-223: 1, 224-239: 2, 240-244: 3), and the
// bytes 192, 193 and 245-255 (never valid in UTF-8) must not occur.
// ----------------------------------------------------------------------------
SUB PickCharSet(pPickCharSetFile)

    LET vPickCharSetUtf8 = 0;
    LET vCsCont  = '';
    LET vCsLead2 = '';
    LET vCsLead3 = '';
    LET vCsLead4 = '';
    LET vCsBad   = 'Chr(192)&Chr(193)';

    FOR vCsI = 128 to 191
        LET vCsCont = vCsCont & If(vCsI > 128, '&', '') & 'Chr(' & vCsI & ')';
    NEXT vCsI
    FOR vCsI = 194 to 223
        LET vCsLead2 = vCsLead2 & If(vCsI > 194, '&', '') & 'Chr(' & vCsI & ')';
    NEXT vCsI
    FOR vCsI = 224 to 239
        LET vCsLead3 = vCsLead3 & If(vCsI > 224, '&', '') & 'Chr(' & vCsI & ')';
    NEXT vCsI
    FOR vCsI = 240 to 244
        LET vCsLead4 = vCsLead4 & If(vCsI > 240, '&', '') & 'Chr(' & vCsI & ')';
    NEXT vCsI
    FOR vCsI = 245 to 255
        LET vCsBad = vCsBad & '&Chr(' & vCsI & ')';
    NEXT vCsI

    CALL DropIfExists('_CS_LINES');
    CALL DropIfExists('_CS_SUM');

    SET ErrorMode = 0;

    [_CS_LINES]:
    NoConcatenate
    LOAD
        Len(KeepChar([@1:n], $(vCsCont))) as cs_cont,
        Len(KeepChar([@1:n], $(vCsLead2))) + 2 * Len(KeepChar([@1:n], $(vCsLead3))) + 3 * Len(KeepChar([@1:n], $(vCsLead4))) as cs_need,
        Len(KeepChar([@1:n], $(vCsBad))) as cs_bad
    FROM [$(pPickCharSetFile)]
    (fix, codepage is 28591, no labels, record is line);

    LET vPickCharSetError = ScriptError + 0;
    SET ErrorMode = 1;

    IF vPickCharSetError = 0 and Alt(NoOfRows('_CS_LINES'), 0) > 0 THEN

        [_CS_SUM]:
        NoConcatenate
        LOAD
            Sum(cs_cont) as cs_cont_sum,
            Sum(cs_need) as cs_need_sum,
            Sum(cs_bad) as cs_bad_sum
        RESIDENT _CS_LINES;

        LET vCsContSum = Alt(Peek('cs_cont_sum', 0, '_CS_SUM'), 0);
        LET vCsNeedSum = Alt(Peek('cs_need_sum', 0, '_CS_SUM'), 0);
        LET vCsBadSum  = Alt(Peek('cs_bad_sum', 0, '_CS_SUM'), 1);

        IF vCsBadSum = 0 and vCsNeedSum > 0 and vCsContSum = vCsNeedSum THEN
            LET vPickCharSetUtf8 = 1;
        END IF

    END IF

    TRACE [CASTINE] Character set check of $(pPickCharSetFile): utf8 = $(vPickCharSetUtf8);

    CALL DropIfExists('_CS_SUM');
    CALL DropIfExists('_CS_LINES');

END SUB

// ----------------------------------------------------------------------------
// ColumnExpr: looks in _HDR for the first column whose normalised name is one
// of pColumnExprTargets (separated by |, in priority order).
// vColName = real column name, or @none.
// vColNo   = position of that column in the header, or 0.
// vColExpr = expression that reads that column as text without the white space
//            at both ends (same rule as fTxt), or '' when the
//            column does not exist (Castine.py uses a blank column in that case).
// ----------------------------------------------------------------------------
SUB ColumnExpr(pColumnExprTargets)

    LET vColName = '@none';

    IF vHdrCount > 0 THEN
        FOR vColI = 1 to SubStringCount('$(pColumnExprTargets)', '|') + 1
            LET vColTarget = SubField('$(pColumnExprTargets)', '|', $(vColI));
            LET vColName   = If(vColName = '@none', If(IsNull(Lookup('hdr_name', 'hdr_norm', vColTarget, '_HDR')), '@none', Lookup('hdr_name', 'hdr_norm', vColTarget, '_HDR')), vColName);
        NEXT vColI
    END IF

    IF vColName = '@none' THEN
        LET vColExpr = Chr(39) & Chr(39);
    ELSE
        LET vColW    = 'Replace(Replace(Replace(Replace(Text([' & vColName & ']), Chr(160), Chr(32)), Chr(9), Chr(32)), Chr(10), Chr(32)), Chr(13), Chr(32))';
        LET vColExpr = 'If(IsNull([' & vColName & ']), ' & Chr(39) & Chr(39) & ', Mid(Text([' & vColName & ']), Len(' & vColW & ') - Len(LTrim(' & vColW & ')) + 1, Len(Trim(' & vColW & '))))';
    END IF

    // Position of the column in the header (0 when it does not exist).
    LET vColNo = 0;
    IF vColName <> '@none' THEN
        LET vColNo = Alt(Lookup('hdr_no', 'hdr_name', vColName, '_HDR'), 0);
    END IF

END SUB

// ----------------------------------------------------------------------------
// BuildDateMap: mapping table pBuildDateMapMap with the date of every distinct text of
// pBuildDateMapField in pBuildDateMapTable, read the way parse_date_to_datetime does (L530-642):
//   1. empty, nan, nat, none, null                    -> no date
//   2. whole number (optionally with .0)              -> Excel serial day
//   3. 8 or 6 digits once the separators are removed  -> YYYYMMDD, MMDDYYYY,
//      DDMMYYYY, MMDDYY, DDMMYY, YYMMDD (same order of choice as the Python)
//   4. three numeric parts split by / - .             -> Y/M/D, M/D/Y, D/M/Y
//   5. date followed by a time                        -> the date part
// Key of the map = Chr(126) & text (the prefix keeps 007 and 7 apart).
// ----------------------------------------------------------------------------
SUB BuildDateMap(pBuildDateMapMap, pBuildDateMapTable, pBuildDateMapField)

    CALL DropIfExists('_DM0');
    CALL DropIfExists('_DM1');
    CALL DropIfExists('_DM');

    [_DM0]:
    NoConcatenate
    LOAD DISTINCT
        Text([$(pBuildDateMapField)]) as dm_raw
    RESIDENT [$(pBuildDateMapTable)];

    [_DM1]:
    NoConcatenate
    LOAD
        dm_raw,
        dm_blank,
        dm_s,
        KeepChar(dm_s, '0123456789') as dm_digits,
        Len(KeepChar(dm_s, '0123456789')) as dm_nd,
        If(Left(dm_s, 1) = '-', 1, 0) as dm_neg,
        If(Left(dm_s, 1) = '+' or Left(dm_s, 1) = '-', Mid(dm_s, 2), dm_s) as dm_body,
        Replace(Replace(Replace(Replace(dm_s, ' ', Chr(1)), '-', ' '), '.', ' '), '/', ' ') as dm_sp0,
        If(Index(dm_s, ' ') > 0 and Index(dm_s, ':') > 0, Replace(Replace(Replace(Left(dm_s, Index(dm_s, ' ') - 1), '-', ' '), '.', ' '), '/', ' '), '') as dm_qs0;
    LOAD
        dm_raw,
        If(Len(dm_t2) = 0 or Match(Lower(dm_t2), 'nan', 'nat', 'none', 'null') > 0, 1, 0) as dm_blank,
        Trim($(fCollapse(dm_t3))) as dm_s;
    LOAD
        *,
        Replace(Replace(Replace(Replace(dm_t2, Chr(92), '/'), Chr(9), ' '), Chr(10), ' '), Chr(13), ' ') as dm_t3;
    LOAD
        *,
        Replace(Replace(Trim(Replace(Replace(dm_t1, ' ', Chr(1)), Chr(39), ' ')), ' ', Chr(39)), Chr(1), ' ') as dm_t2;
    LOAD
        *,
        Replace(Replace(Trim(Replace(Replace(dm_t0, ' ', Chr(1)), '"', ' ')), ' ', '"'), Chr(1), ' ') as dm_t1;
    LOAD
        dm_raw,
        Trim(Replace(Replace(Replace(dm_raw, Chr(160), ' '), Chr(8203), ''), Chr(65533), '')) as dm_t0
    RESIDENT _DM0;

    [_DM]:
    NoConcatenate
    LOAD
        dm_raw,
        If(dm_blank = 1, Null(), Alt(dm_serial, dm_compact, dm_parts, dm_iso, dm_usdt, Null())) as dm_date;
    LOAD
        *,
        If(dm_nd = 8, Alt(dm_8ymd, dm_8pick, Null()), If(dm_nd = 6, dm_6pick, Null())) as dm_compact,
        If(dm_pok = 1, Alt(dm_p_ymd, dm_p4pick, dm_p2pick, Null()), Null()) as dm_parts,
        If(dm_qok = 1, Alt(dm_q_mdy, dm_q_dmy, Null()), Null()) as dm_usdt;
    LOAD
        *,
        If(dm_a > 12 and dm_b <= 12 and not IsNull(dm_8dmy), dm_8dmy, If(dm_b > 12 and dm_a <= 12 and not IsNull(dm_8mdy), dm_8mdy, Alt(dm_8mdy, dm_8dmy, Null()))) as dm_8pick,
        If(dm_a > 12 and dm_b <= 12 and not IsNull(dm_6dmy), dm_6dmy, If(dm_b > 12 and dm_a <= 12 and not IsNull(dm_6mdy), dm_6mdy, Alt(dm_6mdy, dm_6dmy, dm_6ymd, Null()))) as dm_6pick,
        If(dm_n1 > 12 and dm_n2 <= 12 and not IsNull(dm_p_dmy4), dm_p_dmy4, If(dm_n2 > 12 and dm_n1 <= 12 and not IsNull(dm_p_mdy4), dm_p_mdy4, Alt(dm_p_mdy4, dm_p_dmy4, Null()))) as dm_p4pick,
        If(dm_n1 > 12 and dm_n2 <= 12 and not IsNull(dm_p_dmy2), dm_p_dmy2, If(dm_n2 > 12 and dm_n1 <= 12 and not IsNull(dm_p_mdy2), dm_p_mdy2, Alt(dm_p_mdy2, dm_p_dmy2, Null()))) as dm_p2pick;
    LOAD
        *,
        If(dm_isint = 1 and dm_neg = 0 and Len(dm_ipz) >= 1 and Len(dm_ipz) <= 7, If(Num#(dm_ipz) <= 2958465, Num#(dm_ipz), Null()), Null()) as dm_serial,
        If(dm_nd = 8 and Match(Left(dm_digits, 2), '19', '20') > 0, $(fYMD(dm_y8, dm_m8, dm_d8)), Null()) as dm_8ymd,
        If(dm_nd = 8, $(fYMD(dm_c8, dm_a, dm_b)), Null()) as dm_8mdy,
        If(dm_nd = 8, $(fYMD(dm_c8, dm_b, dm_a)), Null()) as dm_8dmy,
        If(dm_nd = 6, $(fYMD(dm_yy6, dm_a, dm_b)), Null()) as dm_6mdy,
        If(dm_nd = 6, $(fYMD(dm_yy6, dm_b, dm_a)), Null()) as dm_6dmy,
        If(dm_nd = 6, $(fYMD(dm_yy6b, dm_b, dm_c6)), Null()) as dm_6ymd,
        If(dm_pok = 1 and Len(dm_p1) = 4, $(fYMD(dm_n1, dm_n2, dm_n3)), Null()) as dm_p_ymd,
        If(dm_pok = 1 and Len(dm_p3) = 4, $(fYMD(dm_n3, dm_n1, dm_n2)), Null()) as dm_p_mdy4,
        If(dm_pok = 1 and Len(dm_p3) = 4, $(fYMD(dm_n3, dm_n2, dm_n1)), Null()) as dm_p_dmy4,
        If(dm_pok = 1 and Len(dm_p3) = 2, $(fYMD(dm_py2, dm_n1, dm_n2)), Null()) as dm_p_mdy2,
        If(dm_pok = 1 and Len(dm_p3) = 2, $(fYMD(dm_py2, dm_n2, dm_n1)), Null()) as dm_p_dmy2,
        If(dm_isoshape = 1, $(fYMD(dm_i1, dm_i2, dm_i3)), Null()) as dm_iso,
        If(dm_qok = 1, $(fYMD(dm_qn3, dm_qn1, dm_qn2)), Null()) as dm_q_mdy,
        If(dm_qok = 1, $(fYMD(dm_qn3, dm_qn2, dm_qn1)), Null()) as dm_q_dmy;
    LOAD
        *,
        If(Len(dm_ip) > 0 and Len(KeepChar(dm_ip, '0123456789')) = Len(dm_ip) and (dm_hasdot = 0 or (Len(dm_fp) > 0 and Len(PurgeChar(dm_fp, '0')) = 0)), 1, 0) as dm_isint,
        Replace(LTrim(Replace(dm_ip, '0', ' ')), ' ', '0') as dm_ipz,
        If(dm_c6 <= 79, 2000 + dm_c6, 1900 + dm_c6) as dm_yy6,
        If(dm_a <= 79, 2000 + dm_a, 1900 + dm_a) as dm_yy6b,
        If(dm_np = 3 and $(fIsNum14(dm_p1)) and $(fIsNum14(dm_p2)) and $(fIsNum14(dm_p3)), 1, 0) as dm_pok,
        Num#(dm_p1) as dm_n1,
        Num#(dm_p2) as dm_n2,
        Num#(dm_p3) as dm_n3,
        If(Num#(dm_p3) <= 79, 2000 + Num#(dm_p3), 1900 + Num#(dm_p3)) as dm_py2,
        If(dm_qnp = 3 and $(fIsNum14(dm_q1)) and $(fIsNum14(dm_q2)) and Len(dm_q3) = 4 and $(fIsNum14(dm_q3)), 1, 0) as dm_qok,
        Num#(dm_q1) as dm_qn1,
        Num#(dm_q2) as dm_qn2,
        Num#(dm_q3) as dm_qn3;
    LOAD
        *,
        If(Index(dm_body, '.') > 0, Left(dm_body, Index(dm_body, '.') - 1), dm_body) as dm_ip,
        If(Index(dm_body, '.') > 0, Mid(dm_body, Index(dm_body, '.') + 1), '') as dm_fp,
        If(Index(dm_body, '.') > 0, 1, 0) as dm_hasdot,
        If(Len(dm_sp) = 0, 0, SubStringCount(dm_sp, ' ') + 1) as dm_np,
        SubField(dm_sp, ' ', 1) as dm_p1,
        SubField(dm_sp, ' ', 2) as dm_p2,
        SubField(dm_sp, ' ', 3) as dm_p3,
        Num#(Left(dm_digits, 2)) as dm_a,
        Num#(Mid(dm_digits, 3, 2)) as dm_b,
        Num#(Mid(dm_digits, 5, 2)) as dm_c6,
        Num#(Mid(dm_digits, 5, 4)) as dm_c8,
        Num#(Left(dm_digits, 4)) as dm_y8,
        Num#(Mid(dm_digits, 5, 2)) as dm_m8,
        Num#(Mid(dm_digits, 7, 2)) as dm_d8,
        If(Len(dm_s) > 10 and Mid(dm_s, 5, 1) = '-' and Mid(dm_s, 8, 1) = '-' and Match(Mid(dm_s, 11, 1), 'T', ' ') > 0 and Len(KeepChar(Left(dm_s, 10), '0123456789')) = 8, 1, 0) as dm_isoshape,
        Num#(Left(dm_s, 4)) as dm_i1,
        Num#(Mid(dm_s, 6, 2)) as dm_i2,
        Num#(Mid(dm_s, 9, 2)) as dm_i3,
        If(Len(dm_qs) = 0, 0, SubStringCount(dm_qs, ' ') + 1) as dm_qnp,
        SubField(dm_qs, ' ', 1) as dm_q1,
        SubField(dm_qs, ' ', 2) as dm_q2,
        SubField(dm_qs, ' ', 3) as dm_q3;
    LOAD
        *,
        Trim($(fCollapse(dm_sp0))) as dm_sp,
        Trim($(fCollapse(dm_qs0))) as dm_qs
    RESIDENT _DM1;

    [$(pBuildDateMapMap)]:
    MAPPING
    LOAD
        Chr(126) & dm_raw as dm_key,
        dm_date
    RESIDENT _DM;

    DROP TABLE _DM0;
    DROP TABLE _DM1;
    DROP TABLE _DM;

END SUB

// ----------------------------------------------------------------------------
// BuildNumMap: mapping table pBuildNumMapMap with the number of every distinct text of
// pBuildNumMapField in pBuildNumMapTable, read the way parse_cost_original_to_float does (L814-880):
// only digits . , - + ( ) are kept; parentheses or a leading minus make the
// number negative; the last of . and , is the decimal separator; a single
// comma followed by 1 or 2 digits (or by 3 digits after at most 3) is a decimal
// comma; anything that is not a number afterwards gives no number.
// Key of the map = Chr(126) & text.
// ----------------------------------------------------------------------------
SUB BuildNumMap(pBuildNumMapMap, pBuildNumMapTable, pBuildNumMapField)

    CALL DropIfExists('_NM0');
    CALL DropIfExists('_NM');

    [_NM0]:
    NoConcatenate
    LOAD DISTINCT
        Text([$(pBuildNumMapField)]) as nm_raw
    RESIDENT [$(pBuildNumMapTable)];

    [_NM]:
    NoConcatenate
    LOAD
        nm_raw,
        If(nm_blank = 1 or nm_ok = 0, Null(), If(nm_neg = 1, If(Num#(nm_f) = 0, -0.000000000001, -Fabs(Num#(nm_f))), Num#(nm_f))) as nm_num;
    LOAD
        *,
        If(Len(nm_dig) > 0 and SubStringCount(nm_d, '.') <= 1 and Len(nm_d) - Len(nm_dig) = SubStringCount(nm_d, '.'), 1, 0) as nm_ok,
        If(Right(nm_e, 1) = '.', Left(nm_e, Len(nm_e) - 1), nm_e) as nm_f;
    LOAD
        *,
        KeepChar(nm_d, '0123456789') as nm_dig,
        If(Left(nm_d, 1) = '.', '0' & nm_d, nm_d) as nm_e;
    LOAD
        *,
        If(nm_hasdot = 1 and nm_hascomma = 1, If(Index(nm_c, '.', -1) > Index(nm_c, ',', -1), PurgeChar(nm_c, ','), Replace(PurgeChar(nm_c, '.'), ',', '.')), If(nm_hascomma = 1, If(SubStringCount(nm_c, ',') > 1, PurgeChar(nm_c, ','), If(Len(nm_cf) = 1 or Len(nm_cf) = 2, nm_ci & '.' & nm_cf, If(Len(nm_cf) = 3 and Len(nm_ci) <= 3, nm_ci & '.' & nm_cf, nm_ci & nm_cf))), If(nm_hasdot = 1 and SubStringCount(nm_c, '.') > 1, PurgeChar(Left(nm_c, Index(nm_c, '.', -1) - 1), '.') & '.' & Mid(nm_c, Index(nm_c, '.', -1) + 1), nm_c))) as nm_d;
    LOAD
        *,
        If(Index(nm_c, '.') > 0, 1, 0) as nm_hasdot,
        If(Index(nm_c, ',') > 0, 1, 0) as nm_hascomma,
        If(Index(nm_c, ',') > 0, Left(nm_c, Index(nm_c, ',') - 1), nm_c) as nm_ci,
        If(Index(nm_c, ',') > 0, Mid(nm_c, Index(nm_c, ',') + 1), '') as nm_cf;
    LOAD
        *,
        If(nm_paren = 1 or Left(nm_b, 1) = '-', 1, 0) as nm_neg,
        PurgeChar(If(Left(nm_b, 1) = '-', Mid(nm_b, 2), nm_b), '+-') as nm_c;
    LOAD
        *,
        If(Left(nm_a, 1) = '+', Mid(nm_a, 2), nm_a) as nm_b;
    LOAD
        *,
        If(nm_paren = 1, PurgeChar(nm_k, '()'), nm_k) as nm_a;
    LOAD
        *,
        If(Index(nm_k, '(') > 0 and Index(nm_k, ')') > 0, 1, 0) as nm_paren;
    LOAD
        nm_raw,
        If(Len(Trim(nm_raw)) = 0 or Lower(Trim(nm_raw)) = 'nan', 1, 0) as nm_blank,
        KeepChar(nm_raw, '0123456789.,-+()') as nm_k
    RESIDENT _NM0;

    [$(pBuildNumMapMap)]:
    MAPPING
    LOAD
        Chr(126) & nm_raw as nm_key,
        nm_num
    RESIDENT _NM;

    DROP TABLE _NM0;
    DROP TABLE _NM;

END SUB


// ----------------------------------------------------------------------------
// PickNewest: among the files of table pPickNewestTable (lf_path, lf_name) takes the one
// modified last. Result in vPickPath / vPickName (@none when there is no file).
// The file time is only asked when there is more than one candidate.
// ----------------------------------------------------------------------------
SUB PickNewest(pPickNewestTable)

    LET vPickPath = '@none';
    LET vPickName = '@none';
    LET vPickTime = -1;
    LET vPickRows = Alt(NoOfRows('$(pPickNewestTable)'), 0);

    IF vPickRows > 0 THEN
        FOR vPickI = 0 to vPickRows - 1
            LET vCandPath = Peek('lf_path', $(vPickI), '$(pPickNewestTable)');
            LET vCandName = Peek('lf_name', $(vPickI), '$(pPickNewestTable)');
            LET vCandTime = If(vPickRows = 1, 0, Alt(Num(FileTime('$(vCandPath)')), 0));
            IF vCandTime >= vPickTime THEN
                LET vPickPath = vCandPath;
                LET vPickName = vCandName;
                LET vPickTime = vCandTime;
            END IF
        NEXT vPickI
    END IF

END SUB

// ----------------------------------------------------------------------------
// PickRankedFile: chooses one file among those that match pPickRankedFileMask, the way
// find_repo_daily_file_in_date_folder (L2359) and find_adjustments_file (L2499)
// do:
//   1. exact name  prefix + payout date + extension  (order of the lists)
//   2. exact name  prefix + extension                (only when pPickRankedFileUndated = 1)
//   3. name starting with a prefix and containing the payout date: newest
//   4. name starting with a prefix: newest
// pPickRankedFilePrefixes and pPickRankedFileExts are lists separated by |. In pPickRankedFileExts the entry @ means
// "no extension". Result in vPickPath / vPickName (@none when nothing fits).
// ----------------------------------------------------------------------------
SUB PickRankedFile(pPickRankedFileMask, pPickRankedFilePrefixes, pPickRankedFileExts, pPickRankedFileUndated)

    LET vPickPath = '@none';
    LET vPickName = '@none';

    CALL ListFiles('$(pPickRankedFileMask)', '_PR_ALL');

    IF vListCount > 0 THEN

        CALL DropIfExists('_PR');
        CALL DropIfExists('_PR_BEST');
        CALL DropIfExists('_PR_MIN');
        CALL DropIfExists('_PR_CAND');

        [_PR]:
        NoConcatenate
        LOAD
            lf_path,
            lf_name,
            Lower(lf_name) as pr_lname,
            KeepChar(lf_name, '0123456789') as pr_digits,
            If(Index(lf_name, '.') > 1, '.' & Lower(SubField(lf_name, '.', -1)), '@') as pr_suffix
        RESIDENT _PR_ALL;

        DROP TABLE _PR_ALL;

        // every file x every prefix x every extension
        Join (_PR)
        LOAD
            IterNo() as pr_pno,
            Lower(SubField('$(pPickRankedFilePrefixes)', '|', IterNo())) as pr_pref
        AUTOGENERATE 1
        WHILE IterNo() <= SubStringCount('$(pPickRankedFilePrefixes)', '|') + 1;

        Join (_PR)
        LOAD
            IterNo() as pr_eno,
            If(SubField('$(pPickRankedFileExts)', '|', IterNo()) = '@', '', Lower(SubField('$(pPickRankedFileExts)', '|', IterNo()))) as pr_ext
        AUTOGENERATE 1
        WHILE IterNo() <= SubStringCount('$(pPickRankedFileExts)', '|') + 1;

        [_PR_BEST]:
        NoConcatenate
        LOAD
            lf_path,
            lf_name,
            Min(If(pr_lname = (pr_pref & '$(vPayoutYMD)' & pr_ext), (pr_pno - 1) * 10 + pr_eno, If($(pPickRankedFileUndated) = 1 and pr_lname = (pr_pref & pr_ext), 500 + (pr_pno - 1) * 10 + pr_eno, If(Left(pr_lname, Len(pr_pref)) = pr_pref and Index(pr_digits, '$(vPayoutYMD)') > 0, 1000, If(Left(pr_lname, Len(pr_pref)) = pr_pref, 2000, 999999))))) as pr_best
        RESIDENT _PR
        WHERE Index('|$(pPickRankedFileExts)|', '|' & pr_suffix & '|') > 0
        GROUP BY lf_path, lf_name;

        DROP TABLE _PR;

        IF Alt(NoOfRows('_PR_BEST'), 0) > 0 THEN

            [_PR_MIN]:
            NoConcatenate
            LOAD
                Min(pr_best) as pr_min
            RESIDENT _PR_BEST;

            LET vPrMin = Alt(Peek('pr_min', 0, '_PR_MIN'), 999999);
            DROP TABLE _PR_MIN;

            IF vPrMin < 999999 THEN

                [_PR_CAND]:
                NoConcatenate
                LOAD
                    lf_path,
                    lf_name
                RESIDENT _PR_BEST
                WHERE pr_best = $(vPrMin)
                ORDER BY lf_path;

                CALL PickNewest('_PR_CAND');
                CALL DropIfExists('_PR_CAND');

            END IF

        END IF

        CALL DropIfExists('_PR_BEST');

    END IF

END SUB

// ----------------------------------------------------------------------------
// BuildAcctMaps: for every distinct text of pBuildAcctMapsField in pBuildAcctMapsTable, three mapping
// tables used by the GLCS CODE lookup (key = Chr(126) & text):
//   pBuildAcctMapsMapBase  -> digits of the account (_normalise_numeric_account_for_lookup, L2850)
//   pBuildAcctMapsMapNz    -> the same without leading zeros
//   pBuildAcctMapsMapClean -> the text without quotes (_clean_account_short_description_for_glcs, L2885)
// A value with letters gives an empty pBuildAcctMapsMapBase / pBuildAcctMapsMapNz.
// ----------------------------------------------------------------------------
SUB BuildAcctMaps(pBuildAcctMapsMapBase, pBuildAcctMapsMapNz, pBuildAcctMapsMapClean, pBuildAcctMapsTable, pBuildAcctMapsField)

    CALL DropIfExists('_AK0');
    CALL DropIfExists('_AK');

    [_AK0]:
    NoConcatenate
    LOAD DISTINCT
        Text([$(pBuildAcctMapsField)]) as ak_raw
    RESIDENT [$(pBuildAcctMapsTable)];

    [_AK]:
    NoConcatenate
    LOAD
        ak_raw,
        ak_clean,
        ak_base,
        If(Len(ak_base) = 0, '', If(Len(Replace(LTrim(Replace(ak_base, '0', ' ')), ' ', '0')) = 0, '0', Replace(LTrim(Replace(ak_base, '0', ' ')), ' ', '0'))) as ak_nz;
    LOAD
        ak_raw,
        If(ak_blank = 1, '', ak_t3) as ak_clean,
        If(ak_blank = 1 or ak_alpha = 1, '', If(ak_dotzero = 1, ak_ip, KeepChar(ak_t3, '0123456789'))) as ak_base;
    LOAD
        *,
        If(Len(ak_t3) = 0 or Match(Lower(ak_t3), 'nan', 'none', 'null', 'nat') > 0, 1, 0) as ak_blank,
        If(Len(KeepChar(ak_t3, 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz')) > 0, 1, 0) as ak_alpha,
        If(Index(ak_t3, '.') > 0, Left(ak_t3, Index(ak_t3, '.') - 1), '') as ak_ip,
        If(Index(ak_t3, '.') > 1 and Len(KeepChar(Left(ak_t3, Index(ak_t3, '.') - 1), '0123456789')) = Index(ak_t3, '.') - 1 and Len(ak_t3) > Index(ak_t3, '.') and Len(PurgeChar(Mid(ak_t3, Index(ak_t3, '.') + 1), '0')) = 0, 1, 0) as ak_dotzero;
    LOAD
        *,
        Trim(Replace(Replace(Trim(Replace(Replace(ak_t1, ' ', Chr(1)), Chr(39), ' ')), ' ', Chr(39)), Chr(1), ' ')) as ak_t3;
    LOAD
        *,
        Replace(Replace(Trim(Replace(Replace(ak_t0, ' ', Chr(1)), '"', ' ')), ' ', '"'), Chr(1), ' ') as ak_t1;
    LOAD
        ak_raw,
        Trim(Replace(Replace(Replace(ak_raw, Chr(160), ' '), Chr(8203), ''), Chr(65279), '')) as ak_t0
    RESIDENT _AK0;

    [$(pBuildAcctMapsMapBase)]:
    MAPPING
    LOAD
        Chr(126) & ak_raw as ak_key,
        ak_base
    RESIDENT _AK;

    [$(pBuildAcctMapsMapNz)]:
    MAPPING
    LOAD
        Chr(126) & ak_raw as ak_key,
        ak_nz
    RESIDENT _AK;

    [$(pBuildAcctMapsMapClean)]:
    MAPPING
    LOAD
        Chr(126) & ak_raw as ak_key,
        ak_clean
    RESIDENT _AK;

    DROP TABLE _AK0;
    DROP TABLE _AK;

END SUB

///$tab 03_XML_Files
// ============================================================================
// Castine.py: discover_files (L1957), select_latest_xml_versions (L1934),
// extract_file_date_token (L356), token_to_date (L372),
// determine_output_yyyymmdd_from_files (L414).
//
// File name = prefix.ext.DATE.VERSION (f392fd1.ext.260130.4).
// Only the highest VERSION of each prefix.ext.DATE is read.
// ============================================================================

CALL ListFiles('$(vXmlFolder)$(vXmlPattern)', 'XML_FILES_ALL');

IF vListCount = 0 THEN
    TRACE [CASTINE][STOP] No Bloomberg XML file found. Check vXmlFolder and vXmlPattern in tab 01_Config;
    EXIT SCRIPT;
END IF

// Version (last segment) and date token (segment before it) of every file.
[XML_FILES_NAMED]:
NoConcatenate
LOAD
    lf_path,
    lf_name,
    xf_ver_ok,
    If(xf_ver_ok = 1, Lower(Left(lf_path, Len(lf_path) - Len(xf_ver) - 1)), '') as xf_key,
    If(xf_ver_ok = 1, Num#(xf_ver), Null()) as xf_ver_num,
    If(xf_ver_ok = 1 and $(fIsTok(xf_seg_m2)), xf_seg_m2, If($(fIsTok(xf_seg1)), xf_seg1, If($(fIsTok(xf_seg2)), xf_seg2, If($(fIsTok(xf_seg3)), xf_seg3, If($(fIsTok(xf_seg4)), xf_seg4, If($(fIsTok(xf_seg5)), xf_seg5, If($(fIsTok(xf_seg6)), xf_seg6, ''))))))) as xf_token;
LOAD
    lf_path,
    lf_name,
    SubField(lf_name, '.', -1) as xf_ver,
    If(SubStringCount(lf_name, '.') >= 3 and Len(SubField(lf_name, '.', -1)) > 0 and Len(KeepChar(SubField(lf_name, '.', -1), '0123456789')) = Len(SubField(lf_name, '.', -1)), 1, 0) as xf_ver_ok,
    If(SubStringCount(lf_name, '.') >= 1, SubField(lf_name, '.', -2), '') as xf_seg_m2,
    SubField(lf_name, '.', 1) as xf_seg1,
    SubField(lf_name, '.', 2) as xf_seg2,
    SubField(lf_name, '.', 3) as xf_seg3,
    SubField(lf_name, '.', 4) as xf_seg4,
    SubField(lf_name, '.', 5) as xf_seg5,
    SubField(lf_name, '.', 6) as xf_seg6
RESIDENT XML_FILES_ALL;

DROP TABLE XML_FILES_ALL;

// Date of the token (token_to_date): YYYYMMDD, 26 + YYMMDD, or YYMMDD.
[XML_FILES_DATED]:
NoConcatenate
LOAD
    lf_path,
    lf_name,
    xf_ver_ok,
    xf_key,
    xf_ver_num,
    xf_token,
    If(Len(xf_token) = 8 and Left(xf_token, 2) = '20', $(fYMD(xf_y4, xf_m4, xf_d4)), If(Len(xf_tok6) = 6, $(fYMD(xf_y2, xf_m2, xf_d2)), Null())) as xf_date;
LOAD
    *,
    Num#(Left(xf_token, 4)) as xf_y4,
    Num#(Mid(xf_token, 5, 2)) as xf_m4,
    Num#(Mid(xf_token, 7, 2)) as xf_d4,
    2000 + Num#(Left(xf_tok6, 2)) as xf_y2,
    Num#(Mid(xf_tok6, 3, 2)) as xf_m2,
    Num#(Mid(xf_tok6, 5, 2)) as xf_d2;
LOAD
    *,
    If(Len(xf_token) = 8 and Left(xf_token, 2) = '26', Mid(xf_token, 3), If(Len(xf_token) = 6, xf_token, '')) as xf_tok6
RESIDENT XML_FILES_NAMED;

DROP TABLE XML_FILES_NAMED;

// Files without a numeric version are not read (Castine.py prints a warning).
[_XML_BAD]:
NoConcatenate
LOAD
    Count(lf_name) as bad_count
RESIDENT XML_FILES_DATED
WHERE xf_ver_ok = 0;

LET vXmlBadNames = Alt(Peek('bad_count', 0, '_XML_BAD'), 0);
CALL DropIfExists('_XML_BAD');
TRACE [CASTINE] XML files ignored (no numeric version at the end of the name): $(vXmlBadNames);

// Highest version of each file.
[_XML_MAXVER]:
NoConcatenate
LOAD
    xf_key,
    Max(xf_ver_num) as xf_max_ver
RESIDENT XML_FILES_DATED
WHERE xf_ver_ok = 1
GROUP BY xf_key;

IF Alt(NoOfRows('_XML_MAXVER'), 0) = 0 THEN
    TRACE [CASTINE][STOP] No Bloomberg XML file with a numeric version found;
    EXIT SCRIPT;
END IF

Left Join (XML_FILES_DATED)
LOAD
    xf_key,
    xf_max_ver
RESIDENT _XML_MAXVER;

DROP TABLE _XML_MAXVER;

// Two names with the same version number (.4 and .04): the greater name wins.
[_XML_PICK]:
NoConcatenate
LOAD
    xf_key,
    MaxString(lf_path) as lf_path
RESIDENT XML_FILES_DATED
WHERE xf_ver_ok = 1 and xf_ver_num = xf_max_ver
GROUP BY xf_key;

Inner Join (_XML_PICK)
LOAD
    lf_path,
    lf_name,
    xf_token,
    xf_date,
    xf_ver_num
RESIDENT XML_FILES_DATED;

DROP TABLE XML_FILES_DATED;

// Date limit (same as --limit-token): a file stays when its date is unknown
// or not after the limit.
[_LIMIT]:
NoConcatenate
LOAD
    If(Len(lim_tok) = 8 and Left(lim_tok, 2) = '20', $(fYMD(lim_y4, lim_m4, lim_d4)), If(Len(lim_tok6) = 6, $(fYMD(lim_y2, lim_m2, lim_d2)), Null())) as lim_date;
LOAD
    *,
    Num#(Left(lim_tok, 4)) as lim_y4,
    Num#(Mid(lim_tok, 5, 2)) as lim_m4,
    Num#(Mid(lim_tok, 7, 2)) as lim_d4,
    2000 + Num#(Left(lim_tok6, 2)) as lim_y2,
    Num#(Mid(lim_tok6, 3, 2)) as lim_m2,
    Num#(Mid(lim_tok6, 5, 2)) as lim_d2;
LOAD
    *,
    If(Len(lim_tok) = 8 and Left(lim_tok, 2) = '26', Mid(lim_tok, 3), If(Len(lim_tok) = 6, lim_tok, '')) as lim_tok6;
LOAD
    KeepChar('$(vDateLimitToken)', '0123456789') as lim_tok
AUTOGENERATE 1;

LET vLimitDate = Alt(Peek('lim_date', 0, '_LIMIT'), -1);
DROP TABLE _LIMIT;

[XML_FILES]:
NoConcatenate
LOAD
    lf_path as file_path,
    lf_name as file_name,
    xf_token as file_date_token,
    xf_date as file_date,
    xf_ver_num as file_version
RESIDENT _XML_PICK
WHERE $(vLimitDate) < 0 or IsNull(xf_date) or xf_date <= $(vLimitDate)
ORDER BY lf_path;

DROP TABLE _XML_PICK;

LET vCntXmlFiles = Alt(NoOfRows('XML_FILES'), 0);

IF vCntXmlFiles = 0 THEN
    TRACE [CASTINE][STOP] No Bloomberg XML file left after the date limit $(vDateLimitToken);
    EXIT SCRIPT;
END IF

TRACE [CASTINE] XML files selected (highest version of each): $(vCntXmlFiles);

// Payout date = latest file date. Without any date in the names: previous
// business day (Castine.py previous_business_day).
[_PAYOUT]:
NoConcatenate
LOAD
    Max(file_date) as max_file_date
RESIDENT XML_FILES;

LET vPayoutDate = Alt(Peek('max_file_date', 0, '_PAYOUT'), -1);
DROP TABLE _PAYOUT;

IF vPayoutDate < 0 THEN
    LET vPayoutDate = Floor(Num(Today(1))) - 1;
    LET vPayoutDate = vPayoutDate - If(Mod(vPayoutDate + 5, 7) = 5, 1, If(Mod(vPayoutDate + 5, 7) = 6, 2, 0));
    TRACE [CASTINE][WARN] No date in the XML file names. Using the previous business day;
END IF

LET vPayoutYMD  = Date(vPayoutDate, 'YYYYMMDD');
LET vPayoutDMY  = Date(vPayoutDate, 'DDMMYYYY');
LET vPayoutYear = Year(vPayoutDate);

TRACE [CASTINE] Payout date: $(vPayoutYMD);

///$tab 04_Split_Matrix
// ============================================================================
// Castine.py: load_split_matrix_castine (L1290-1536), parse_split_to_0_1 (L779).
//
// Result: SPLIT_VALID, one row per RR Team + Salesperson + date window, only
// for the versions that pass the checks (split sums to 1, windows of the same
// team do not overlap). SPLIT_ALERTS keeps what was rejected and why.
// ============================================================================

LET vTsMin   = Num(MakeDate(1900, 1, 1));
LET vTsMax   = Num(MakeDate(2262, 4, 11));
LET vSplitOk = 0;

SET ErrorMode = 0;

[SPLIT_RAW]:
NoConcatenate
LOAD
    RecNo() as split_row,
    [RR Team] as rr_cell,
    [Salesperson] as sp_cell,
    [Split] as split_cell,
    [Effective Date] as eff_cell,
    [Expiration Date] as exp_cell
FROM [$(vSplitFile)]
(ooxml, embedded labels, table is [$(vSplitSheet)]);

LET vSplitError = ScriptError + 0;
SET ErrorMode = 1;

LET vSplitRead = If(vSplitError = 0, Alt(NoOfRows('SPLIT_RAW'), 0), 0);

IF vSplitError <> 0 THEN
    TRACE [CASTINE][ERROR] Split matrix could not be read - error code $(vSplitError) - file $(vSplitFile);
END IF

TRACE [CASTINE] Split rows read: $(vSplitRead);

// Always one seed row, so that the tables below exist even when the split
// matrix cannot be used. The seed team matches no trade.
[SPLIT_VALID]:
NoConcatenate
LOAD
    0 as split_row,
    '@seed' as rr_key,
    '@seed' as rr_norm,
    '' as rr_raw,
    '' as split_salesperson,
    '' as split_text,
    0 as split_num,
    $(vTsMax) as eff_cmp,
    $(vTsMax) as exp_cmp,
    '@seed' as version_key
AUTOGENERATE 1;

[SPLIT_ALERTS]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as alert_type,
    '' as [RR Team],
    '' as [Salesperson],
    '' as [Split_raw],
    Null() as [Split_num],
    '' as [Effective Date],
    '' as [Expiration Date],
    '' as [VersionKey],
    '' as [details]
AUTOGENERATE 1;

IF vSplitRead > 0 THEN

    // Cells as text and as numbers.
    [SPLIT_CELLS]:
    // Castine.py reads the sheet with pandas.read_excel (L1361): a cell with one of
    // the pandas NA texts (N/A, NA, NULL, None, nan ...) is an empty cell there.
    NoConcatenate
    LOAD
        split_row,
        $(fNa(rr_txt)) as rr_raw,
        $(fTxt(sp_na)) as split_salesperson,
        Trim($(fNa(split_txt))) as split_text,
        split_cellnum,
        Trim($(fNa(eff_txt))) as eff_text,
        eff_cellnum,
        Trim($(fNa(exp_txt))) as exp_text,
        exp_cellnum;
    // Salesperson: pandas NA texts first, then the .strip() of Castine.py L1411,
    // which also removes tab, CR, LF and no-break space at both ends (fTxt rule).
    LOAD
        *,
        $(fNa(sp_txt)) as sp_na;
    LOAD
        split_row,
        If(IsNull(rr_cell), '', Text(rr_cell)) as rr_txt,
        If(IsNull(sp_cell), '', Text(sp_cell)) as sp_txt,
        If(IsNull(split_cell), '', Text(split_cell)) as split_txt,
        If(IsNum(split_cell), split_cell + 0, Null()) as split_cellnum,
        If(IsNull(eff_cell), '', Text(eff_cell)) as eff_txt,
        If(IsNum(eff_cell), eff_cell + 0, Null()) as eff_cellnum,
        If(IsNull(exp_cell), '', Text(exp_cell)) as exp_txt,
        If(IsNum(exp_cell), exp_cell + 0, Null()) as exp_cellnum
    RESIDENT SPLIT_RAW;

    // Dates written as text go through the Castine.py date reader.
    [_SPLIT_DATE_TEXT]:
    NoConcatenate
    LOAD
        eff_text as sd_text
    RESIDENT SPLIT_CELLS;

    Concatenate ([_SPLIT_DATE_TEXT])
    LOAD
        exp_text as sd_text
    RESIDENT SPLIT_CELLS;

    CALL BuildDateMap('MAP_SPLIT_DATE', '_SPLIT_DATE_TEXT', 'sd_text');
    DROP TABLE _SPLIT_DATE_TEXT;

    [SPLIT_ROWS]:
    NoConcatenate
    LOAD
        split_row,
        rr_raw,
        rr_norm,
        'T|' & rr_norm as rr_key,
        split_salesperson,
        split_text,
        split_num,
        eff_text,
        exp_text,
        eff_date,
        exp_date,
        If(IsNull(eff_cellnum), eff_text, Text(Timestamp(eff_cellnum, 'YYYY-MM-DD hh:mm:ss'))) as eff_out,
        If(IsNull(exp_cellnum), exp_text, Text(Timestamp(exp_cellnum, 'YYYY-MM-DD hh:mm:ss'))) as exp_out,
        Alt(eff_date, $(vTsMin)) as eff_cmp,
        Alt(exp_date, $(vTsMax)) as exp_cmp,
        rr_norm & '||' & Date(Alt(eff_date, $(vTsMin)), 'YYYYMMDD') & '||' & Date(Alt(exp_date, $(vTsMax)), 'YYYYMMDD') as version_key,
        If(Len(rr_norm) = 0, 1, 0) as bad_rr,
        If(Len(split_salesperson) = 0, 1, 0) as bad_sales,
        If(IsNull(split_num), 1, 0) as bad_split,
        If(Len(eff_text) > 0 and IsNull(eff_date), 1, 0) as bad_eff,
        If(Len(exp_text) > 0 and IsNull(exp_date), 1, 0) as bad_exp,
        If(not IsNull(eff_date) and not IsNull(exp_date) and eff_date > exp_date, 1, 0) as bad_order;
    LOAD
        *,
        $(fTeamKey(rr_raw)) as rr_norm,
        If(split_v1 < 0 or split_v1 > 1, Null(), split_v1) as split_num,
        If(not IsNull(eff_cellnum) and eff_cellnum > 0 and eff_cellnum <= 2958465, Floor(eff_cellnum), ApplyMap('MAP_SPLIT_DATE', Chr(126) & eff_text, Null())) as eff_date,
        If(not IsNull(exp_cellnum) and exp_cellnum > 0 and exp_cellnum <= 2958465, Floor(exp_cellnum), ApplyMap('MAP_SPLIT_DATE', Chr(126) & exp_text, Null())) as exp_date;
    LOAD
        *,
        If(not IsNull(split_cellnum), If(split_cellnum > 1, split_cellnum / 100, split_cellnum), If(split_tok = 1, If(split_pct = 1 or split_tval > 1, split_tval / 100, split_tval), Null())) as split_v1;
    LOAD
        *,
        If(split_tok = 1, If(Left(split_t2, 1) = '-', -1, 1) * Num#(split_t4), Null()) as split_tval;
    LOAD
        *,
        If(Len(KeepChar(split_t3, '0123456789')) > 0 and Index(split_t3, '-') = 0 and SubStringCount(split_t3, '.') <= 1, 1, 0) as split_tok,
        If(Left(split_t3, 1) = '.', '0', '') & If(Right(split_t3, 1) = '.', Left(split_t3, Len(split_t3) - 1), split_t3) as split_t4;
    LOAD
        *,
        If(Left(split_t2, 1) = '-', Mid(split_t2, 2), split_t2) as split_t3;
    LOAD
        *,
        If(Index(split_text, '%') > 0, 1, 0) as split_pct,
        KeepChar(Replace(split_text, ',', '.'), '0123456789.-') as split_t2
    RESIDENT SPLIT_CELLS;

    DROP TABLE SPLIT_CELLS;

    // Split sum of each version, counting only the rows that passed the row checks.
    [_SPLIT_SUM]:
    NoConcatenate
    LOAD
        '@seed' as version_key,
        0 as version_sum
    AUTOGENERATE 1;

    Concatenate ([_SPLIT_SUM])
    LOAD
        version_key,
        Sum(split_num) as version_sum
    RESIDENT SPLIT_ROWS
    WHERE bad_rr = 0 and bad_sales = 0 and bad_split = 0 and bad_eff = 0 and bad_exp = 0 and bad_order = 0
    GROUP BY version_key;

    Left Join (SPLIT_ROWS)
    LOAD
        version_key,
        version_sum
    RESIDENT _SPLIT_SUM;

    DROP TABLE _SPLIT_SUM;

    // Versions of the same team whose date windows overlap.
    [_SPLIT_WIN]:
    NoConcatenate
    LOAD DISTINCT
        rr_key as win_team,
        version_key as win_key,
        eff_cmp as win_eff,
        exp_cmp as win_exp
    RESIDENT SPLIT_ROWS
    WHERE bad_rr = 0 and bad_sales = 0 and bad_split = 0 and bad_eff = 0 and bad_exp = 0 and bad_order = 0;

    [_SPLIT_OVERLAP]:
    NoConcatenate
    LOAD
        '@seed' as version_key,
        0 as version_overlap
    AUTOGENERATE 1;

    IF Alt(NoOfRows('_SPLIT_WIN'), 0) > 0 THEN

        Left Join (_SPLIT_WIN)
        LOAD
            win_team,
            win_key as win_key2,
            win_eff as win_eff2,
            win_exp as win_exp2
        RESIDENT _SPLIT_WIN;

        Concatenate ([_SPLIT_OVERLAP])
        LOAD DISTINCT
            win_key as version_key,
            1 as version_overlap
        RESIDENT _SPLIT_WIN
        WHERE win_key <> win_key2 and win_eff <= win_exp2 and win_eff2 <= win_exp;

    END IF

    CALL DropIfExists('_SPLIT_WIN');

    Left Join (SPLIT_ROWS)
    LOAD
        version_key,
        version_overlap
    RESIDENT _SPLIT_OVERLAP;

    DROP TABLE _SPLIT_OVERLAP;

    [SPLIT_CHECKED]:
    NoConcatenate
    LOAD
        *,
        If(bad_rr = 0 and bad_sales = 0 and bad_split = 0 and bad_eff = 0 and bad_exp = 0 and bad_order = 0, 1, 0) as row_ok,
        If(Fabs(Alt(version_sum, 0) - 1) > $(vSplitTolerance), 1, 0) as bad_sum,
        If(Alt(version_overlap, 0) = 1, 1, 0) as bad_overlap
    RESIDENT SPLIT_ROWS;

    DROP TABLE SPLIT_ROWS;

    Concatenate ([SPLIT_VALID])
    LOAD
        split_row,
        rr_key,
        rr_norm,
        rr_raw,
        split_salesperson,
        split_text,
        split_num,
        eff_cmp,
        exp_cmp,
        version_key
    RESIDENT SPLIT_CHECKED
    WHERE row_ok = 1 and bad_sum = 0 and bad_overlap = 0
    ORDER BY split_row;

    // split_matrix_config_alerts.csv
    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'MISSING_RR_TEAM' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'RR Team is blank.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE bad_rr = 1;

    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'MISSING_SALESPERSON' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'Salesperson is blank.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE bad_sales = 1;

    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'INVALID_SPLIT' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'Split could not be parsed to a decimal between 0 and 1.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE bad_split = 1;

    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'INVALID_EFFECTIVE_DATE' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'Effective Date could not be parsed.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE bad_eff = 1;

    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'INVALID_EXPIRATION_DATE' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'Expiration Date could not be parsed.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE bad_exp = 1;

    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'INVALID_DATE_RANGE' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'Effective Date is later than Expiration Date.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE bad_order = 1;

    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'CHECK_SPLIT_SUM' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'For a given RR Team and the same Effective Date + Expiration Date window, split must sum to 1.00 (100%) within tolerance.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE row_ok = 1 and bad_sum = 1;

    Concatenate ([SPLIT_ALERTS])
    LOAD
        0 as row_seed,
        'OVERLAPPING_DATE_WINDOWS' as alert_type,
        rr_raw as [RR Team],
        split_salesperson as [Salesperson],
        split_text as [Split_raw],
        If(IsNull(split_num), '', Text(Num(split_num, '0.000000', '.', ','))) as [Split_num],
        eff_out as [Effective Date],
        exp_out as [Expiration Date],
        version_key as [VersionKey],
        'More than one split version is active for the same RR Team/date range.' as [details]
    RESIDENT SPLIT_CHECKED
    WHERE row_ok = 1 and bad_overlap = 1;

    DROP TABLE SPLIT_CHECKED;

    // Castine.py sorts the alerts by alert_type, RR Team, Salesperson (L1521) as
    // text; rows that tie keep the order in which they were added.
    [_SPLIT_ALERTS_SORT]:
    NoConcatenate
    LOAD
        *,
        RecNo() as sa_seq,
        Text(alert_type) as sa_k1,
        Text([RR Team]) as sa_k2,
        Text([Salesperson]) as sa_k3
    RESIDENT SPLIT_ALERTS;

    DROP TABLE SPLIT_ALERTS;

    [SPLIT_ALERTS]:
    NoConcatenate
    LOAD
        row_seed,
        alert_type,
        [RR Team],
        [Salesperson],
        [Split_raw],
        [Split_num],
        [Effective Date],
        [Expiration Date],
        [VersionKey],
        [details]
    RESIDENT _SPLIT_ALERTS_SORT
    ORDER BY row_seed desc, sa_k1, sa_k2, sa_k3, sa_seq;

    DROP TABLE _SPLIT_ALERTS_SORT;

END IF

CALL DropIfExists('SPLIT_RAW');

// The seed row is the first row, so valid rows = rows - 1.
LET vCntSplitValid = NoOfRows('SPLIT_VALID') - 1;
LET vSplitOk       = If(vCntSplitValid > 0, 1, 0);

TRACE [CASTINE] Split matrix valid rows after the version checks: $(vCntSplitValid);

IF vSplitOk = 0 THEN
    TRACE [CASTINE][ERROR] Split matrix has no valid row. No XML or Repo row will map - the payout keeps only the adjustments;
END IF

///$tab 05_Tiara
// ============================================================================
// Castine.py: _find_tiara_file (L2738), load_tiara_accounts_glcs_lookup (L2917),
// load_tiara_subaccounts_parent_lookup (L3024).
//
// Result: mapping tables used by the GLCS CODE step
//   MAP_GLCS_DIRECT : account key (ACCOUNTNR or BLOOMBERG_MASTER_ACCOUNT_NO) -> ENTITY_CODE
//   MAP_GLCS_ACCNR  : account key (ACCOUNTNR only)                          -> ENTITY_CODE
//   MAP_SUB_*       : SUBACCT_NO key -> ACCOUNT_NO (text, key, key without zeros)
// When two rows give the same key, the first row of the file wins.
// ============================================================================

// ----------------------------------------------------------------------------
// PickTiaraFile: tiara.<family>* file for the payout date.
//   1. name with the payout date (DDMMYYYY)         -> newest
//   2. latest date in the name not after the payout -> newest of that date
//   3. any tiara.<family> file                      -> newest
// Result in vPickPath / vPickName (@none when there is no file).
// ----------------------------------------------------------------------------
SUB PickTiaraFile(pPickTiaraFileFamily)

    LET vPickPath = '@none';
    LET vPickName = '@none';

    CALL ListFiles('$(vTiaraFolder)tiara.$(pPickTiaraFileFamily)*', '_TF_ALL');

    IF vListCount > 0 THEN

        CALL DropIfExists('_TF');
        CALL DropIfExists('_TF_BEST');
        CALL DropIfExists('_TF_CAND');

        [_TF]:
        NoConcatenate
        LOAD
            lf_path,
            lf_name,
            tf_date,
            If(tf_exact = 1, 1, If(not IsNull(tf_date) and tf_date <= $(vPayoutDate), 2, 3)) as tf_group;
        LOAD
            *,
            If(Len(tf_tok) = 8 and Len(KeepChar(tf_tok, '0123456789')) = 8, $(fYMD(tf_y, tf_m, tf_d)), Null()) as tf_date;
        LOAD
            *,
            Num#(Mid(tf_tok, 5, 4)) as tf_y,
            Num#(Mid(tf_tok, 3, 2)) as tf_m,
            Num#(Left(tf_tok, 2)) as tf_d;
        LOAD
            *,
            If(Index(tf_rest, '$(vPayoutDMY)') > 0, 1, 0) as tf_exact,
            Left(LTrim(Replace(Replace(Replace(tf_rest, '_', ' '), '-', ' '), '.', ' ')), 8) as tf_tok;
        LOAD
            lf_path,
            lf_name,
            Mid(Lower(lf_name), Len('tiara.$(pPickTiaraFileFamily)') + 1) as tf_rest
        RESIDENT _TF_ALL;

        DROP TABLE _TF_ALL;

        [_TF_BEST]:
        NoConcatenate
        LOAD
            Min(tf_group) as tf_best_group
        RESIDENT _TF;

        LET vTfGroup = Alt(Peek('tf_best_group', 0, '_TF_BEST'), 3);
        DROP TABLE _TF_BEST;

        [_TF_BEST]:
        NoConcatenate
        LOAD
            Max(tf_date) as tf_best_date
        RESIDENT _TF
        WHERE tf_group = 2;

        LET vTfDate = Alt(Peek('tf_best_date', 0, '_TF_BEST'), -1);
        CALL DropIfExists('_TF_BEST');

        [_TF_CAND]:
        NoConcatenate
        LOAD
            lf_path,
            lf_name
        RESIDENT _TF
        WHERE tf_group = $(vTfGroup) and ($(vTfGroup) <> 2 or tf_date = $(vTfDate))
        ORDER BY lf_path;

        DROP TABLE _TF;

        CALL PickNewest('_TF_CAND');
        CALL DropIfExists('_TF_CAND');

    END IF

END SUB

// --- tiara.accounts ---------------------------------------------------------
LET vTiaraAccStatus = 'FILE_NOT_FOUND';
LET vTiaraAccName   = '';

// Seed rows: the tables and the maps below always exist.
[TIARA_ACC]:
NoConcatenate
LOAD
    0 as ta_row,
    '' as ta_entity,
    '' as ta_accountnr,
    '' as ta_bbg
AUTOGENERATE 1;

CALL PickTiaraFile('accounts');

IF vPickPath <> '@none' THEN

    LET vTiaraAccFile = vPickPath;
    LET vTiaraAccName = vPickName;
    TRACE [CASTINE] Tiara accounts file: $(vTiaraAccName);

    // The file is read line by line (Castine.py: sep "|", no quoting). A line
    // with more fields than the header is left out, as pandas does
    // (on_bad_lines="warn", L2825); it never shifts the columns.
    LET vHdrFile      = vTiaraAccFile;
    LET vTiaraAccCharSet = vTiaraCharSet;
    CALL PickCharSet('$(vTiaraAccFile)');
    IF vPickCharSetUtf8 = 1 THEN
        SET vTiaraAccCharSet = utf8;
    END IF
    SET vHdrCharSet   = $(vTiaraAccCharSet);
    SET vHdrDelimiter = '|';
    CALL LoadLineHeader;

    CALL ColumnExpr('entitycode');
    LET vTiaraEntityCol = vColName;
    LET vTiaraEntityNo  = vColNo;
    CALL ColumnExpr('accountnr|accountno');
    LET vTiaraAccNrCol  = vColName;
    LET vTiaraAccNrNo   = vColNo;
    CALL ColumnExpr('bloombergmasteraccountno|masterbloombergaccount');
    LET vTiaraBbgCol    = vColName;
    LET vTiaraBbgNo     = vColNo;

    IF vHdrCount = 0 THEN
        LET vTiaraAccStatus = 'READ_ERROR';
    ELSEIF vTiaraEntityCol = '@none' THEN
        LET vTiaraAccStatus = 'MISSING_ENTITY_CODE_COLUMN';
    ELSEIF vTiaraAccNrCol = '@none' and vTiaraBbgCol = '@none' THEN
        LET vTiaraAccStatus = 'MISSING_LOOKUP_COLUMNS';
    ELSE

        [_TIARA_LINES]:
        NoConcatenate
        LOAD
            RecNo() - 1 as tl_row,
            [@1:n] as tl_line,
            If(SubStringCount([@1:n], '|') >= $(vHdrCount), 1, 0) as tl_long
        FROM [$(vTiaraAccFile)]
        (fix, $(vTiaraAccCharSet), no labels, record is line)
        WHERE RecNo() > 1;

        Concatenate ([TIARA_ACC])
        LOAD
            ta_row,
            $(fTxt(ta_f_entity)) as ta_entity,
            $(fTxt(ta_f_accountnr)) as ta_accountnr,
            $(fTxt(ta_f_bbg)) as ta_bbg;
        LOAD
            tl_row as ta_row,
            If($(vTiaraEntityNo) > 0, SubField(tl_line, '|', $(vTiaraEntityNo)), Null()) as ta_f_entity,
            If($(vTiaraAccNrNo) > 0, SubField(tl_line, '|', $(vTiaraAccNrNo)), Null()) as ta_f_accountnr,
            If($(vTiaraBbgNo) > 0, SubField(tl_line, '|', $(vTiaraBbgNo)), Null()) as ta_f_bbg
        RESIDENT _TIARA_LINES
        WHERE tl_long = 0
        ORDER BY tl_row;

        [_TIARA_LONG]:
        NoConcatenate
        LOAD
            Sum(tl_long) as long_count
        RESIDENT _TIARA_LINES;

        LET vTiaraAccLong = Alt(Peek('long_count', 0, '_TIARA_LONG'), 0);
        CALL DropIfExists('_TIARA_LONG');
        CALL DropIfExists('_TIARA_LINES');
        TRACE [CASTINE] Tiara accounts lines left out (more fields than the header): $(vTiaraAccLong);

        LET vTiaraAccStatus = 'OK';

    END IF

ELSE
    TRACE [CASTINE][WARN] No tiara.accounts file found in $(vTiaraFolder);
END IF

// --- tiara.subaccounts ------------------------------------------------------
LET vTiaraSubStatus = 'FILE_NOT_FOUND';
LET vTiaraSubName   = '';

[TIARA_SUB]:
NoConcatenate
LOAD
    0 as ts_row,
    '' as ts_subacct,
    '' as ts_account
AUTOGENERATE 1;

CALL PickTiaraFile('subaccounts');

IF vPickPath <> '@none' THEN

    LET vTiaraSubFile = vPickPath;
    LET vTiaraSubName = vPickName;
    TRACE [CASTINE] Tiara subaccounts file: $(vTiaraSubName);

    LET vHdrFile      = vTiaraSubFile;
    LET vTiaraSubCharSet = vTiaraCharSet;
    CALL PickCharSet('$(vTiaraSubFile)');
    IF vPickCharSetUtf8 = 1 THEN
        SET vTiaraSubCharSet = utf8;
    END IF
    SET vHdrCharSet   = $(vTiaraSubCharSet);
    SET vHdrDelimiter = '|';
    CALL LoadLineHeader;

    CALL ColumnExpr('accountno|accountnr');
    LET vTiaraSubAccCol = vColName;
    LET vTiaraSubAccNo  = vColNo;
    CALL ColumnExpr('subacctno|subaccountno|subaccountnr');
    LET vTiaraSubNoCol  = vColName;
    LET vTiaraSubNoNo   = vColNo;

    IF vHdrCount = 0 THEN
        LET vTiaraSubStatus = 'READ_ERROR';
    ELSEIF vTiaraSubNoCol = '@none' THEN
        LET vTiaraSubStatus = 'MISSING_SUBACCT_NO_COLUMN';
    ELSEIF vTiaraSubAccCol = '@none' THEN
        LET vTiaraSubStatus = 'MISSING_ACCOUNT_NO_COLUMN';
    ELSE

        [_TIARA_LINES]:
        NoConcatenate
        LOAD
            RecNo() - 1 as tl_row,
            [@1:n] as tl_line,
            If(SubStringCount([@1:n], '|') >= $(vHdrCount), 1, 0) as tl_long
        FROM [$(vTiaraSubFile)]
        (fix, $(vTiaraSubCharSet), no labels, record is line)
        WHERE RecNo() > 1;

        Concatenate ([TIARA_SUB])
        LOAD
            ts_row,
            $(fTxt(ts_f_subacct)) as ts_subacct,
            $(fTxt(ts_f_account)) as ts_account;
        LOAD
            tl_row as ts_row,
            If($(vTiaraSubNoNo) > 0, SubField(tl_line, '|', $(vTiaraSubNoNo)), Null()) as ts_f_subacct,
            If($(vTiaraSubAccNo) > 0, SubField(tl_line, '|', $(vTiaraSubAccNo)), Null()) as ts_f_account
        RESIDENT _TIARA_LINES
        WHERE tl_long = 0
        ORDER BY tl_row;

        [_TIARA_LONG]:
        NoConcatenate
        LOAD
            Sum(tl_long) as long_count
        RESIDENT _TIARA_LINES;

        LET vTiaraSubLong = Alt(Peek('long_count', 0, '_TIARA_LONG'), 0);
        CALL DropIfExists('_TIARA_LONG');
        CALL DropIfExists('_TIARA_LINES');
        TRACE [CASTINE] Tiara subaccounts lines left out (more fields than the header): $(vTiaraSubLong);

        LET vTiaraSubStatus = 'OK';

    END IF

ELSE
    TRACE [CASTINE][WARN] No tiara.subaccounts file found in $(vTiaraFolder);
END IF

CALL DropIfExists('_HDR');

// --- account keys of every Tiara value --------------------------------------
[_TIARA_TEXT]:
NoConcatenate
LOAD
    ta_accountnr as tt_text
RESIDENT TIARA_ACC;

Concatenate ([_TIARA_TEXT])
LOAD
    ta_bbg as tt_text
RESIDENT TIARA_ACC;

Concatenate ([_TIARA_TEXT])
LOAD
    ts_subacct as tt_text
RESIDENT TIARA_SUB;

Concatenate ([_TIARA_TEXT])
LOAD
    ts_account as tt_text
RESIDENT TIARA_SUB;

CALL BuildAcctMaps('MAP_TIARA_BASE', 'MAP_TIARA_NZ', 'MAP_TIARA_CLEAN', '_TIARA_TEXT', 'tt_text');
DROP TABLE _TIARA_TEXT;

// --- accounts: key -> ENTITY_CODE, first row of the file wins ----------------
// Order inside one row: ACCOUNTNR, ACCOUNTNR without zeros, BLOOMBERG_MASTER_ACCOUNT_NO,
// BLOOMBERG_MASTER_ACCOUNT_NO without zeros.
[_TIARA_KEYS]:
NoConcatenate
LOAD
    '@seed' as tk_key,
    '' as tk_entity,
    0 as tk_seq,
    1 as tk_from_accountnr
AUTOGENERATE 1;

Concatenate ([_TIARA_KEYS])
LOAD
    ApplyMap('MAP_TIARA_BASE', Chr(126) & ta_accountnr, '') as tk_key,
    ta_entity as tk_entity,
    ta_row * 4 + 1 as tk_seq,
    1 as tk_from_accountnr
RESIDENT TIARA_ACC
WHERE ta_row > 0 and Len(ta_entity) > 0;

Concatenate ([_TIARA_KEYS])
LOAD
    ApplyMap('MAP_TIARA_NZ', Chr(126) & ta_accountnr, '') as tk_key,
    ta_entity as tk_entity,
    ta_row * 4 + 2 as tk_seq,
    1 as tk_from_accountnr
RESIDENT TIARA_ACC
WHERE ta_row > 0 and Len(ta_entity) > 0;

Concatenate ([_TIARA_KEYS])
LOAD
    ApplyMap('MAP_TIARA_BASE', Chr(126) & ta_bbg, '') as tk_key,
    ta_entity as tk_entity,
    ta_row * 4 + 3 as tk_seq,
    0 as tk_from_accountnr
RESIDENT TIARA_ACC
WHERE ta_row > 0 and Len(ta_entity) > 0;

Concatenate ([_TIARA_KEYS])
LOAD
    ApplyMap('MAP_TIARA_NZ', Chr(126) & ta_bbg, '') as tk_key,
    ta_entity as tk_entity,
    ta_row * 4 + 4 as tk_seq,
    0 as tk_from_accountnr
RESIDENT TIARA_ACC
WHERE ta_row > 0 and Len(ta_entity) > 0;

[_TIARA_DIRECT]:
NoConcatenate
LOAD
    tk_key,
    FirstSortedValue(tk_entity, tk_seq) as tk_entity
RESIDENT _TIARA_KEYS
WHERE Len(tk_key) > 0
GROUP BY tk_key;

[MAP_GLCS_DIRECT]:
MAPPING
LOAD
    Chr(126) & tk_key as map_key,
    tk_entity
RESIDENT _TIARA_DIRECT;

DROP TABLE _TIARA_DIRECT;

[_TIARA_ACCNR]:
NoConcatenate
LOAD
    tk_key,
    FirstSortedValue(tk_entity, tk_seq) as tk_entity
RESIDENT _TIARA_KEYS
WHERE Len(tk_key) > 0 and tk_from_accountnr = 1
GROUP BY tk_key;

[MAP_GLCS_ACCNR]:
MAPPING
LOAD
    Chr(126) & tk_key as map_key,
    tk_entity
RESIDENT _TIARA_ACCNR;

DROP TABLE _TIARA_ACCNR;
DROP TABLE _TIARA_KEYS;

// --- subaccounts: SUBACCT_NO key -> ACCOUNT_NO, first row of the file wins ----
// A row is used only when its ACCOUNT_NO gives a key (digits, no letters).
[_SUB_KEYS]:
NoConcatenate
LOAD
    '@seed' as sk_key,
    '' as sk_subacct,
    '' as sk_account,
    '' as sk_account_base,
    '' as sk_account_nz,
    0 as sk_seq
AUTOGENERATE 1;

Concatenate ([_SUB_KEYS])
LOAD
    ApplyMap('MAP_TIARA_BASE', Chr(126) & ts_subacct, '') as sk_key,
    ts_subacct as sk_subacct,
    ts_account as sk_account,
    ApplyMap('MAP_TIARA_BASE', Chr(126) & ts_account, '') as sk_account_base,
    ApplyMap('MAP_TIARA_NZ', Chr(126) & ts_account, '') as sk_account_nz,
    ts_row * 2 + 1 as sk_seq
RESIDENT TIARA_SUB
WHERE ts_row > 0 and Len(ApplyMap('MAP_TIARA_BASE', Chr(126) & ts_account, '')) > 0;

Concatenate ([_SUB_KEYS])
LOAD
    ApplyMap('MAP_TIARA_NZ', Chr(126) & ts_subacct, '') as sk_key,
    ts_subacct as sk_subacct,
    ts_account as sk_account,
    ApplyMap('MAP_TIARA_BASE', Chr(126) & ts_account, '') as sk_account_base,
    ApplyMap('MAP_TIARA_NZ', Chr(126) & ts_account, '') as sk_account_nz,
    ts_row * 2 + 2 as sk_seq
RESIDENT TIARA_SUB
WHERE ts_row > 0 and Len(ApplyMap('MAP_TIARA_BASE', Chr(126) & ts_account, '')) > 0;

[_SUB_FIRST]:
NoConcatenate
LOAD
    sk_key,
    Min(sk_seq) as sk_seq
RESIDENT _SUB_KEYS
WHERE Len(sk_key) > 0
GROUP BY sk_key;

Left Join (_SUB_FIRST)
LOAD
    sk_key,
    sk_seq,
    sk_subacct,
    sk_account,
    sk_account_base,
    sk_account_nz
RESIDENT _SUB_KEYS;

DROP TABLE _SUB_KEYS;

[MAP_SUB_FOUND]:
MAPPING
LOAD
    Chr(126) & sk_key as map_key,
    1 as map_value
RESIDENT _SUB_FIRST;

[MAP_SUB_SUBACCT]:
MAPPING
LOAD
    Chr(126) & sk_key as map_key,
    sk_subacct
RESIDENT _SUB_FIRST;

[MAP_SUB_ACCOUNT]:
MAPPING
LOAD
    Chr(126) & sk_key as map_key,
    sk_account
RESIDENT _SUB_FIRST;

[MAP_SUB_ACCOUNT_BASE]:
MAPPING
LOAD
    Chr(126) & sk_key as map_key,
    sk_account_base
RESIDENT _SUB_FIRST;

[MAP_SUB_ACCOUNT_NZ]:
MAPPING
LOAD
    Chr(126) & sk_key as map_key,
    sk_account_nz
RESIDENT _SUB_FIRST;

DROP TABLE _SUB_FIRST;

LET vTiaraAccRows = NoOfRows('TIARA_ACC') - 1;
LET vTiaraSubRows = NoOfRows('TIARA_SUB') - 1;
TRACE [CASTINE] Tiara accounts rows: $(vTiaraAccRows) ($(vTiaraAccStatus)) - subaccounts rows: $(vTiaraSubRows) ($(vTiaraSubStatus));

DROP TABLE TIARA_ACC;
DROP TABLE TIARA_SUB;

///$tab 06_Repo_Read
// ============================================================================
// Castine.py: find_repo_daily_file_in_date_folder (L2359),
// _read_repo_csv_with_fallbacks (L2046), detect_repo_columns (L2085).
//
// The repo file is searched only in <repo folder>/<payout date>/.
// Result: REPO_RAW with the eleven columns the Python uses, as trimmed text.
// A column that the file does not have is loaded empty, as in the Python.
// ============================================================================

LET vRepoFound = 0;
LET vRepoName  = '';

CALL PickRankedFile('$(vRepoFolder)$(vPayoutYMD)/*', '$(vRepoPrefixes)', '@|.csv|.txt', 0);

IF vPickPath <> '@none' THEN

    LET vRepoFile = vPickPath;
    LET vRepoName = vPickName;
    TRACE [CASTINE] Repo file: $(vRepoName);

    LET vHdrFile = vRepoFile;
    CALL PickCharSet('$(vRepoFile)');
    IF vPickCharSetUtf8 = 1 THEN
        SET vRepoCharSet = utf8;
    END IF
    SET vHdrFormat = txt, $(vRepoCharSet), embedded labels, delimiter is '$(vRepoDelimiter)', msq;
    CALL LoadHeader;

    IF vHdrCount > 0 THEN

        CALL ColumnExpr('td|tradedate|asoftradedate');
        LET vRepoTd = vColExpr;
        CALL ColumnExpr('account|acct|accountname');
        LET vRepoAccount = vColExpr;
        CALL ColumnExpr('cusip');
        LET vRepoCusip = vColExpr;
        CALL ColumnExpr('trans|transno|transnum|transnumber');
        LET vRepoTrans = vColExpr;
        CALL ColumnExpr('salesperson|salespersonname');
        LET vRepoSales = vColExpr;
        CALL ColumnExpr('trader|tradername');
        LET vRepoTrader = vColExpr;
        CALL ColumnExpr('trtype|tradetype');
        LET vRepoTrType = vColExpr;
        CALL ColumnExpr('assetclass|assettype');
        LET vRepoAsset = vColExpr;
        CALL ColumnExpr('securitydescription|securitydesc');
        LET vRepoSecDesc = vColExpr;
        CALL ColumnExpr('netcredit|commission|grosscommission');
        LET vRepoNetCredit = vColExpr;
        CALL ColumnExpr('principal|tradeamount|paramount');
        LET vRepoPrincipal = vColExpr;

        [REPO_RAW]:
        NoConcatenate
        LOAD
            RecNo() as repo_row,
            $(vRepoTd) as repo_td,
            $(vRepoAccount) as repo_account,
            $(vRepoCusip) as repo_cusip,
            $(vRepoTrans) as repo_trans,
            $(vRepoSales) as repo_salesperson,
            $(vRepoTrader) as repo_trader,
            $(vRepoTrType) as repo_trtype,
            $(vRepoAsset) as repo_assetclass,
            $(vRepoSecDesc) as repo_secdesc,
            $(vRepoNetCredit) as repo_netcredit,
            $(vRepoPrincipal) as repo_principal
        FROM [$(vRepoFile)]
        ($(vHdrFormat));

        LET vCntRepoTotal = Alt(NoOfRows('REPO_RAW'), 0);
        LET vRepoFound    = If(vCntRepoTotal > 0, 1, 0);

    ELSE
        TRACE [CASTINE][WARN] Repo file could not be read. The payout will have no repo rows;
    END IF

ELSE
    TRACE [CASTINE][WARN] No repo file found in $(vRepoFolder)$(vPayoutYMD);
END IF

CALL DropIfExists('_HDR');
TRACE [CASTINE] Repo rows read: $(vCntRepoTotal);

///$tab 07_Adjustments_Read
// ============================================================================
// Castine.py: find_adjustments_file (L2499), _read_adjustments_file_with_fallbacks
// (L2551), align_dataframe_to_final_output_columns (L2576).
//
// The manual adjustments file already has the layout of the final payout.
// Its columns are matched to the 23 official columns by normalised name;
// a missing column is loaded empty. Values are kept exactly as written.
// Result: ADJ_RAW (adj_row + the 23 columns with the prefix "adj ").
// ============================================================================

LET vAdjFound = 0;
LET vAdjName  = '';
SET vOfficialCols = 'As of trade date|Client|Security|Trade Id|Salesperson|Production Earned|Payout Earned|Trader Team Name|Fidelity #|ShortDesc|TradeType|Trade Date|RR Team|Source|Sec Type|Sec Type Description|Security Description|Gross Comms|Acct Short Description|Currency|BuySell|TradeAmount|GLCS CODE';

CALL PickRankedFile('$(vSalesDataFolder)adjustments*', '$(vAdjPrefixes)', '@|.csv|.txt|.xlsx|.xlsm|.xls', 1);

IF vPickPath <> '@none' THEN

    LET vAdjFile = vPickPath;
    LET vAdjName = vPickName;
    LET vAdjExt  = If(Index(vAdjName, '.') > 1, Lower(SubField(vAdjName, '.', -1)), '@');
    LET vAdjIsExcel = If(Match(vAdjExt, 'xlsx', 'xlsm', 'xls') > 0, 1, 0);
    TRACE [CASTINE] Adjustments file: $(vAdjName);

    // Castine.py keeps the adjustments values exactly as written (dtype=str,
    // na_filter=False), blanks at both ends included. Qlik removes those blanks
    // when it reads a file, unless Verbatim is 1. Header and rows are read with
    // the same setting, so the column names found in the header match the rows.
    SET Verbatim = 1;

    LET vHdrFile = vAdjFile;
    IF vAdjIsExcel = 1 THEN
        IF vAdjExt = 'xls' THEN
            SET vAdjBook = biff;
        ELSE
            SET vAdjBook = ooxml;
        END IF
        IF Len('$(vAdjSheet)') > 0 THEN
            SET vHdrFormat = $(vAdjBook), embedded labels, table is [$(vAdjSheet)];
        ELSE
            SET vHdrFormat = $(vAdjBook), embedded labels;
        END IF
    ELSE
        CALL PickCharSet('$(vAdjFile)');
        IF vPickCharSetUtf8 = 1 THEN
            SET vAdjCharSet = utf8;
        END IF
        SET vHdrFormat = txt, $(vAdjCharSet), embedded labels, delimiter is '$(vAdjDelimiter)', msq;
    END IF
    CALL LoadHeader;

    IF vHdrCount > 0 THEN

        // One expression per official column, in the official order.
        LET vAdjSelect = 'RecNo() as adj_row';
        LET vAdjAsOfCol = '@none';
        LET vAdjTdCol   = '@none';

        FOR vAdjI = 1 to 23
            LET vAdjCol  = SubField('$(vOfficialCols)', '|', $(vAdjI));
            LET vAdjNorm = KeepChar(Lower(vAdjCol), 'abcdefghijklmnopqrstuvwxyz0123456789');
            CALL ColumnExpr('$(vAdjNorm)');
            LET vAdjExpr = If(vColName = '@none', Chr(39) & Chr(39), 'If(IsNull([' & vColName & ']), ' & Chr(39) & Chr(39) & ', Text([' & vColName & ']))');
            LET vAdjSelect = vAdjSelect & ', ' & vAdjExpr & ' as [adj ' & vAdjCol & ']';
            IF vAdjI = 1 THEN
                LET vAdjAsOfCol = vColName;
            END IF
            IF vAdjI = 12 THEN
                LET vAdjTdCol = vColName;
            END IF
        NEXT vAdjI

        // Excel only: a date cell reaches the Python as text YYYY-MM-DD hh:mm:ss.
        LET vAdjAsOfNum = If(vAdjIsExcel = 1 and vAdjAsOfCol <> '@none', 'If(IsNum([' & vAdjAsOfCol & ']), [' & vAdjAsOfCol & '] + 0, Null())', 'Null()');
        LET vAdjTdNum   = If(vAdjIsExcel = 1 and vAdjTdCol <> '@none', 'If(IsNum([' & vAdjTdCol & ']), [' & vAdjTdCol & '] + 0, Null())', 'Null()');

        // Excel only: Castine.py drops a row only when every named column of the
        // sheet is empty (dropna how="all" before the 23 columns are aligned), so a
        // row with a value only in an extra column (Comments, ...) is kept as a blank
        // payout row. Columns named Unnamed... are left out, as pandas drops them.
        LET vAdjAny = Chr(39) & Chr(39);
        FOR vAdjH = 0 to $(vHdrCount) - 1
            LET vAdjHName = Peek('hdr_name', $(vAdjH), '_HDR');
            IF Index(Lower(Trim(vAdjHName)), 'unnamed') <> 1 THEN
                LET vAdjAny = vAdjAny & ' & If(IsNull([' & vAdjHName & ']), ' & Chr(39) & Chr(39) & ', Text([' & vAdjHName & ']))';
            END IF
        NEXT vAdjH

        // Excel only: pd.read_excel of Castine.py keeps the default pandas NA list
        // (no na_filter=False there), so N/A, NA, NULL, None, nan ... become empty
        // values. The CSV branch keeps them as written (na_filter=False).
        [ADJ_RAW]:
        NoConcatenate
        LOAD
            adj_row,
            If($(vAdjIsExcel) = 1, $(fNa([adj As of trade date])), [adj As of trade date]) as [adj As of trade date],
            If($(vAdjIsExcel) = 1, $(fNa([adj Client])), [adj Client]) as [adj Client],
            If($(vAdjIsExcel) = 1, $(fNa([adj Security])), [adj Security]) as [adj Security],
            If($(vAdjIsExcel) = 1, $(fNa([adj Trade Id])), [adj Trade Id]) as [adj Trade Id],
            If($(vAdjIsExcel) = 1, $(fNa([adj Salesperson])), [adj Salesperson]) as [adj Salesperson],
            If($(vAdjIsExcel) = 1, $(fNa([adj Production Earned])), [adj Production Earned]) as [adj Production Earned],
            If($(vAdjIsExcel) = 1, $(fNa([adj Payout Earned])), [adj Payout Earned]) as [adj Payout Earned],
            If($(vAdjIsExcel) = 1, $(fNa([adj Trader Team Name])), [adj Trader Team Name]) as [adj Trader Team Name],
            If($(vAdjIsExcel) = 1, $(fNa([adj Fidelity #])), [adj Fidelity #]) as [adj Fidelity #],
            If($(vAdjIsExcel) = 1, $(fNa([adj ShortDesc])), [adj ShortDesc]) as [adj ShortDesc],
            If($(vAdjIsExcel) = 1, $(fNa([adj TradeType])), [adj TradeType]) as [adj TradeType],
            If($(vAdjIsExcel) = 1, $(fNa([adj Trade Date])), [adj Trade Date]) as [adj Trade Date],
            If($(vAdjIsExcel) = 1, $(fNa([adj RR Team])), [adj RR Team]) as [adj RR Team],
            If($(vAdjIsExcel) = 1, $(fNa([adj Source])), [adj Source]) as [adj Source],
            If($(vAdjIsExcel) = 1, $(fNa([adj Sec Type])), [adj Sec Type]) as [adj Sec Type],
            If($(vAdjIsExcel) = 1, $(fNa([adj Sec Type Description])), [adj Sec Type Description]) as [adj Sec Type Description],
            If($(vAdjIsExcel) = 1, $(fNa([adj Security Description])), [adj Security Description]) as [adj Security Description],
            If($(vAdjIsExcel) = 1, $(fNa([adj Gross Comms])), [adj Gross Comms]) as [adj Gross Comms],
            If($(vAdjIsExcel) = 1, $(fNa([adj Acct Short Description])), [adj Acct Short Description]) as [adj Acct Short Description],
            If($(vAdjIsExcel) = 1, $(fNa([adj Currency])), [adj Currency]) as [adj Currency],
            If($(vAdjIsExcel) = 1, $(fNa([adj BuySell])), [adj BuySell]) as [adj BuySell],
            If($(vAdjIsExcel) = 1, $(fNa([adj TradeAmount])), [adj TradeAmount]) as [adj TradeAmount],
            If($(vAdjIsExcel) = 1, $(fNa([adj GLCS CODE])), [adj GLCS CODE]) as [adj GLCS CODE],
            adj_asof_num,
            adj_td_num,
            adj_any_len;
        LOAD
            $(vAdjSelect),
            $(vAdjAsOfNum) as adj_asof_num,
            $(vAdjTdNum) as adj_td_num,
            Len($(vAdjAny)) as adj_any_len
        FROM [$(vAdjFile)]
        ($(vHdrFormat));

        LET vCntAdjustments = Alt(NoOfRows('ADJ_RAW'), 0);
        LET vAdjFound       = If(vCntAdjustments > 0, 1, 0);

    ELSE
        TRACE [CASTINE][WARN] Adjustments file could not be read. For an Excel file set vAdjSheet in tab 01_Config;
    END IF

    SET Verbatim = 0;

ELSE
    TRACE [CASTINE][WARN] No adjustments file found in $(vSalesDataFolder). The payout will have only XML and Repo rows;
END IF

CALL DropIfExists('_HDR');
TRACE [CASTINE] Adjustments rows read: $(vCntAdjustments);

///$tab 08_XML_Read
// ============================================================================
// Castine.py: parse_file_to_temp_csv (L1135), parse_tradefeed_to_row (L1087),
// extract_transaction_cost_items (L928), find_primary_cost_tradefeed (L1010),
// find_add_on_tradefeed (L1037).
//
// Each file is read with the XML reader of Qlik (XmlSimple), one LOAD per XML
// table, with the table and field names the current Qlik script already uses:
//   BatchFeed/TradeFeed                                  one row per trade
//   BatchFeed/TradeFeed/TransactionCosts/TransactionCost one row per cost
//   BatchFeed/TradeFeed/ExtendedFields/Field             one row per extended field
// The first two are the tables of the Qlik script in production. The third one
// is not read by that script, so its layout is confirmed on the first files (see
// ReadExtFields below).
//
// Cost rules of the Python:
//   Add On       = sum of the Cost of every TransactionCost whose Code is R
//   primary Cost = Cost of the first TransactionCost whose Code is not R
// Result: XML_PARSED, one row per trade, the same columns as PARSED_SCHEMA.
// ============================================================================

LET vCacheFile     = '$(vOutFolder)$(vOutPrefix)$(vXmlCacheName)';
LET vCacheFound    = 0;
LET vCacheUsed     = 0;
LET vCacheNew      = 0;
LET vCacheUseText  = '|';
LET vCacheNewText  = '|';
LET vXmlFilesError = 0;
LET vXmlCostError  = 0;
LET vXmlExtError   = 0;
LET vXmlFilesEmpty = 0;
LET vXmlCostFolded = 0;
LET vCostLayout    = 0;
LET vExtLayout     = 0;
LET vExtMiss       = 0;
LET vExtMaxMiss    = 5;
LET vErrTrades     = 0;
LET vErrCosts      = 0;
LET vErrExt        = 0;

// Seed rows (file_no = 0): the three tables exist even if a file cannot be read.
[XML_TRADES]:
NoConcatenate
LOAD
    0 as file_no,
    0 as feed_no,
    0 as feed_key,
    '' as source_file,
    '' as file_date_token,
    '' as TransactionNumber,
    '' as OriginalTktId,
    '' as SecurityIdentifier,
    '' as SecurityCurrencyISOCode,
    '' as Ticker,
    '' as MaturityDateExpirationDate,
    '' as BuySellCoverShortFlag,
    '' as TradeDate,
    '' as AsOfTradeDate,
    '' as Price,
    '' as TradeAmount,
    '' as CustomerAccountCounterparty,
    '' as AccountCounterpartyShortName,
    '' as MasterAccountName,
    '' as TraderAccountName,
    '' as TraderAccountNumber,
    '' as SalespersonName,
    '' as TransactionType,
    '' as OMReasonCode
AUTOGENERATE 1;

[XML_COSTS]:
NoConcatenate
LOAD
    0 as file_no,
    0 as feed_key,
    0 as cost_no,
    '' as cost_code,
    '' as cost_text
AUTOGENERATE 1;

[XML_EXT]:
NoConcatenate
LOAD
    0 as file_no,
    0 as feed_key,
    0 as ext_no,
    '' as ext_name,
    '' as ext_value
AUTOGENERATE 1;

[XML_CACHE_IDS]:
NoConcatenate
LOAD
    '@seed' as cache_id
AUTOGENERATE 1;

// Result of each file (error codes of the three reads), shown in AUDIT_XML_FILES.
[_XML_FILE_STATUS]:
NoConcatenate
LOAD
    0 as file_no,
    0 as status_trades,
    0 as status_costs,
    0 as status_ext,
    0 as status_bytes,
    '' as status_text
AUTOGENERATE 1;

// --- optional cache of the trades already read (vUseXmlCache = 1) ------------
IF vUseXmlCache = 1 THEN

    FOR Each vCacheHit in FileList('$(vCacheFile)')
        LET vCacheFound = 1;
    NEXT vCacheHit

    IF vCacheFound = 1 THEN

        [XML_CACHE]:
        NoConcatenate
        LOAD
            cache_id,
            feed_no,
            source_file,
            file_date_token,
            TransactionNumber,
            OriginalTktId,
            SecurityIdentifier,
            SecurityCurrencyISOCode,
            Ticker,
            MaturityDateExpirationDate,
            BuySellCoverShortFlag,
            TradeDate,
            AsOfTradeDate,
            Price,
            TradeAmount,
            CustomerAccountCounterparty,
            AccountCounterpartyShortName,
            MasterAccountName,
            TraderAccountName,
            TraderAccountNumber,
            SalespersonName,
            TransactionType,
            OMReasonCode,
            SECURITY_TYP,
            MARKET_SECTOR_DES,
            Cost_original,
            AddOn_original
        FROM [$(vCacheFile)]
        (qvd);

        Concatenate ([XML_CACHE_IDS])
        LOAD DISTINCT
            cache_id
        RESIDENT XML_CACHE;

    END IF

END IF

// --- trades of one file -------------------------------------------------------
// One row per <TradeFeed>, the fields of <Common> that Castine.py keeps
// (COMMON_FIELDS_NEEDED). Same table and field names as the script in production.
// Result: rows added to XML_TRADES and vErrTrades = 0, or vErrTrades <> 0.
SUB ReadTrades

    Concatenate ([XML_TRADES])
    LOAD
        file_no,
        feed_no,
        feed_key,
        source_file,
        file_date_token,
        $(fNa(xTransactionNumber)) as TransactionNumber,
        $(fNa(xOriginalTktId)) as OriginalTktId,
        $(fNa(xSecurityIdentifier)) as SecurityIdentifier,
        $(fNa(xSecurityCurrencyISOCode)) as SecurityCurrencyISOCode,
        $(fNa(xTicker)) as Ticker,
        $(fNa(xMaturityDateExpirationDate)) as MaturityDateExpirationDate,
        $(fNa(xBuySellCoverShortFlag)) as BuySellCoverShortFlag,
        $(fNa(xTradeDate)) as TradeDate,
        $(fNa(xAsOfTradeDate)) as AsOfTradeDate,
        $(fNa(xPrice)) as Price,
        $(fNa(xTradeAmount)) as TradeAmount,
        $(fNa(xCustomerAccountCounterparty)) as CustomerAccountCounterparty,
        $(fNa(xAccountCounterpartyShortName)) as AccountCounterpartyShortName,
        $(fNa(xMasterAccountName)) as MasterAccountName,
        $(fNa(xTraderAccountName)) as TraderAccountName,
        $(fNa(xTraderAccountNumber)) as TraderAccountNumber,
        $(fNa(xSalespersonName)) as SalespersonName,
        $(fNa(xTransactionType)) as TransactionType,
        $(fNa(xOMReasonCode)) as OMReasonCode;
    LOAD
        $(vFileNo) as file_no,
        RecNo() as feed_no,
        [%Key_TradeFeed_F33642C080CBA825] as feed_key,
        '$(vFileName)' as source_file,
        '$(vFileToken)' as file_date_token,
        $(fTxt([Common/TransactionNumber])) as xTransactionNumber,
        $(fTxt([Common/OriginalTktId])) as xOriginalTktId,
        $(fTxt([Common/SecurityIdentifier])) as xSecurityIdentifier,
        $(fTxt([Common/SecurityCurrencyISOCode])) as xSecurityCurrencyISOCode,
        $(fTxt([Common/Ticker])) as xTicker,
        $(fTxt([Common/MaturityDateExpirationDate])) as xMaturityDateExpirationDate,
        $(fTxt([Common/BuySellCoverShortFlag])) as xBuySellCoverShortFlag,
        $(fTxt([Common/TradeDate])) as xTradeDate,
        $(fTxt([Common/AsOfTradeDate])) as xAsOfTradeDate,
        $(fTxt([Common/Price])) as xPrice,
        $(fTxt([Common/TradeAmount])) as xTradeAmount,
        $(fTxt([Common/CustomerAccountCounterparty])) as xCustomerAccountCounterparty,
        $(fTxt([Common/AccountCounterpartyShortName])) as xAccountCounterpartyShortName,
        $(fTxt([Common/MasterAccountName])) as xMasterAccountName,
        $(fTxt([Common/TraderAccountName])) as xTraderAccountName,
        $(fTxt([Common/TraderAccountNumber])) as xTraderAccountNumber,
        $(fTxt([Common/SalespersonName])) as xSalespersonName,
        $(fTxt([Common/TransactionType])) as xTransactionType,
        $(fTxt([Common/OMReasonCode])) as xOMReasonCode
    FROM [$(vFile)]
    (XmlSimple, table is [BatchFeed/TradeFeed]);

    LET vErrTrades = ScriptError + 0;

END SUB

// --- trades of one file, tag by tag ---------------------------------------------
// Fallback after ReadTrades failed on a non-empty file. XmlSimple may create no field
// for a <Common> tag that no trade of the file carries, and the single LOAD then
// fails. Castine.py leaves such a column empty and keeps the trades. Here each tag
// is read alone: a tag that cannot be read stays empty for every trade of the file.
// If the trades themselves cannot be read, vErrTrades stays <> 0.
SUB ReadTradesByTag

    CALL DropIfExists('_TR');

    [_TR]:
    NoConcatenate
    LOAD
        RecNo() as feed_no,
        [%Key_TradeFeed_F33642C080CBA825] as feed_key
    FROM [$(vFile)]
    (XmlSimple, table is [BatchFeed/TradeFeed]);

    LET vErrTrades = ScriptError + 0;

    IF vErrTrades = 0 THEN

        LET vMissTags = '';

        FOR Each vTag in 'TransactionNumber', 'OriginalTktId', 'SecurityIdentifier', 'SecurityCurrencyISOCode', 'Ticker', 'MaturityDateExpirationDate', 'BuySellCoverShortFlag', 'TradeDate', 'AsOfTradeDate', 'Price', 'TradeAmount', 'CustomerAccountCounterparty', 'AccountCounterpartyShortName', 'MasterAccountName', 'TraderAccountName', 'TraderAccountNumber', 'SalespersonName', 'TransactionType', 'OMReasonCode'

            // Seed row: the column exists after the join even when the tag is absent.
            [_TAG]:
            NoConcatenate
            LOAD
                -1 as feed_no,
                -1 as feed_key,
                '' as tag_raw
            AUTOGENERATE 1;

            // Text() here, while reading the file, so that 100.0 and 100 stay different.
            Concatenate ([_TAG])
            LOAD
                RecNo() as feed_no,
                [%Key_TradeFeed_F33642C080CBA825] as feed_key,
                Text([Common/$(vTag)]) as tag_raw
            FROM [$(vFile)]
            (XmlSimple, table is [BatchFeed/TradeFeed]);

            LET vErrTag = ScriptError + 0;

            IF vErrTag <> 0 THEN
                LET vMissTags = vMissTags & vTag & '|';
            END IF

            Left Join ([_TR])
            LOAD
                feed_no,
                feed_key,
                $(fTxt(tag_raw)) as [x$(vTag)]
            RESIDENT _TAG;

            DROP TABLE _TAG;

        NEXT vTag

        TRACE [CASTINE][WARN] $(vFileName) read tag by tag. Tags not found (left empty): $(vMissTags);

        Concatenate ([XML_TRADES])
        LOAD
            $(vFileNo) as file_no,
            feed_no,
            feed_key,
            '$(vFileName)' as source_file,
            '$(vFileToken)' as file_date_token,
            $(fNa(xTransactionNumber)) as TransactionNumber,
            $(fNa(xOriginalTktId)) as OriginalTktId,
            $(fNa(xSecurityIdentifier)) as SecurityIdentifier,
            $(fNa(xSecurityCurrencyISOCode)) as SecurityCurrencyISOCode,
            $(fNa(xTicker)) as Ticker,
            $(fNa(xMaturityDateExpirationDate)) as MaturityDateExpirationDate,
            $(fNa(xBuySellCoverShortFlag)) as BuySellCoverShortFlag,
            $(fNa(xTradeDate)) as TradeDate,
            $(fNa(xAsOfTradeDate)) as AsOfTradeDate,
            $(fNa(xPrice)) as Price,
            $(fNa(xTradeAmount)) as TradeAmount,
            $(fNa(xCustomerAccountCounterparty)) as CustomerAccountCounterparty,
            $(fNa(xAccountCounterpartyShortName)) as AccountCounterpartyShortName,
            $(fNa(xMasterAccountName)) as MasterAccountName,
            $(fNa(xTraderAccountName)) as TraderAccountName,
            $(fNa(xTraderAccountNumber)) as TraderAccountNumber,
            $(fNa(xSalespersonName)) as SalespersonName,
            $(fNa(xTransactionType)) as TransactionType,
            $(fNa(xOMReasonCode)) as OMReasonCode
        RESIDENT _TR;

        LET vErrTrades = ScriptError + 0;

    END IF

    CALL DropIfExists('_TR');

END SUB

// --- costs of one file --------------------------------------------------------
// One row per <TransactionCost> (Code and Cost), keyed by the trade. Same table
// and field names as the script in production.
// Result: rows added to XML_COSTS and vErrCosts = 0, or vErrCosts <> 0.
SUB ReadCosts

    Concatenate ([XML_COSTS])
    LOAD
        $(vFileNo) as file_no,
        [%Key_TradeFeed_F33642C080CBA825] as feed_key,
        RecNo() as cost_no,
        $(fTxt([Code])) as cost_code,
        $(fTxt([Cost])) as cost_text
    FROM [$(vFile)]
    (XmlSimple, table is [BatchFeed/TradeFeed/TransactionCosts/TransactionCost]);

    LET vErrCosts = ScriptError + 0;

END SUB

// --- extended fields of one file ---------------------------------------------
// Castine.py reads every <Field name="..."> below <ExtendedFields> of the trade
// and accepts the attribute written as name, NAME or Name (L1119-1125).
// XmlSimple shows those elements as the table BatchFeed/TradeFeed/ExtendedFields/Field:
// the attribute is a field with the name of the attribute, the text of the element
// is the field Field%Table.
//   pReadExtFieldsLayout 1, 2, 3 : the Field rows carry the key of the trade; attribute name, NAME, Name
//   pReadExtFieldsLayout 4       : the Field rows carry the key of ExtendedFields, and the table
//                     BatchFeed/TradeFeed/ExtendedFields carries the key of the trade
// Result: rows added to XML_EXT and vErrExt = 0, or vErrExt <> 0 and nothing added.
SUB ReadExtFields(pReadExtFieldsLayout)

    LET vExtAttr = Pick(pReadExtFieldsLayout, 'name', 'NAME', 'Name', 'name');
    LET vErrExt  = -1;

    IF pReadExtFieldsLayout <= 3 THEN

        Concatenate ([XML_EXT])
        LOAD
            $(vFileNo) as file_no,
            [%Key_TradeFeed_F33642C080CBA825] as feed_key,
            RecNo() as ext_no,
            Text([$(vExtAttr)]) as ext_name,
            $(fTxt([Field%Table])) as ext_value
        FROM [$(vFile)]
        (XmlSimple, table is [BatchFeed/TradeFeed/ExtendedFields/Field])
        WHERE Match(Text([$(vExtAttr)]), 'SECURITY_TYP', 'MARKET_SECTOR_DES') > 0;

        LET vErrExt = ScriptError + 0;

    ELSE

        CALL DropIfExists('_EXT_PARENT');
        CALL DropIfExists('_EXT_ALT');

        [_EXT_PARENT]:
        NoConcatenate
        LOAD
            [%Key_ExtendedFields_E99A6E793AF763EC] as ext_parent_key,
            [%Key_TradeFeed_F33642C080CBA825] as ext_feed_key
        FROM [$(vFile)]
        (XmlSimple, table is [BatchFeed/TradeFeed/ExtendedFields]);

        LET vErrExtParent = ScriptError + 0;

        [_EXT_ALT]:
        NoConcatenate
        LOAD
            [%Key_ExtendedFields_E99A6E793AF763EC] as ext_parent_key,
            RecNo() as ext_no,
            Text([$(vExtAttr)]) as ext_name,
            $(fTxt([Field%Table])) as ext_value
        FROM [$(vFile)]
        (XmlSimple, table is [BatchFeed/TradeFeed/ExtendedFields/Field])
        WHERE Match(Text([$(vExtAttr)]), 'SECURITY_TYP', 'MARKET_SECTOR_DES') > 0;

        LET vErrExtAlt = ScriptError + 0;

        IF vErrExtParent = 0 and vErrExtAlt = 0 and Alt(TableNumber('_EXT_PARENT'), -1) >= 0 and Alt(TableNumber('_EXT_ALT'), -1) >= 0 THEN

            Left Join (_EXT_ALT)
            LOAD
                ext_parent_key,
                ext_feed_key
            RESIDENT _EXT_PARENT;

            Concatenate ([XML_EXT])
            LOAD
                $(vFileNo) as file_no,
                ext_feed_key as feed_key,
                ext_no,
                ext_name,
                ext_value
            RESIDENT _EXT_ALT;

            LET vErrExt = 0;

        END IF

        CALL DropIfExists('_EXT_PARENT');
        CALL DropIfExists('_EXT_ALT');

    END IF

END SUB

// --- one pass per file -----------------------------------------------------
FOR vI = 0 to vCntXmlFiles - 1

    LET vFile       = Peek('file_path', $(vI), 'XML_FILES');
    LET vFileName   = Peek('file_name', $(vI), 'XML_FILES');
    LET vFileToken  = Peek('file_date_token', $(vI), 'XML_FILES');
    LET vFileNo     = $(vI) + 1;
    LET vFileCached = 0;
    LET vFileId     = '@none';

    IF vUseXmlCache = 1 THEN
        LET vFileId = vFileName & '*' & FileSize('$(vFile)') & '*' & Num(FileTime('$(vFile)'));
        IF vCacheFound = 1 THEN
            LET vFileCached = If(IsNull(Lookup('cache_id', 'cache_id', vFileId, 'XML_CACHE_IDS')), 0, 1);
        END IF
    END IF

    IF vFileCached = 1 THEN

        LET vCacheUseText = vCacheUseText & vFileId & '>' & vFileNo & '|';
        LET vCacheUsed    = vCacheUsed + 1;

    ELSE

        SET ErrorMode = 0;

        CALL ReadTrades;

        // A file whose trades cannot be read is never skipped in silence. An empty
        // feed (a few bytes, no <TradeFeed>) is the only accepted case. For any
        // other file the same LOAD runs again with ErrorMode = 1, so the reload
        // stops there with the Qlik message that names the table or the field.
        LET vFileBytes = Alt(FileSize('$(vFile)'), 0);

        // A tag missing from every trade of the file: read the file tag by tag.
        IF vErrTrades <> 0 and vFileBytes > vXmlEmptyBytes THEN
            CALL ReadTradesByTag;
        END IF

        IF vErrTrades <> 0 THEN
            IF vFileBytes > vXmlEmptyBytes and vStopOnXmlError = 1 THEN
                TRACE [CASTINE][ERROR] Trades of $(vFileName) not read (error code $(vErrTrades), $(vFileBytes) bytes). Reading again so that the reload stops with the Qlik message;
                SET ErrorMode = 1;
                CALL ReadTrades;
                SET ErrorMode = 0;
            END IF
        END IF

        LET vErrCosts  = 0;
        LET vErrExt    = 0;

        // Costs and extended fields only for a file whose trades were read.
        IF vErrTrades = 0 THEN

            CALL ReadCosts;
            LET vCostLayout = 1;

            // When no trade of the file has two cost entries, XmlSimple has no table
            // for TransactionCost: the single entry is shown as columns of the trade,
            // the way <Common> is (TransactionCosts/TransactionCost/Code and .../Cost).
            IF vErrCosts <> 0 THEN

                Concatenate ([XML_COSTS])
                LOAD
                    $(vFileNo) as file_no,
                    [%Key_TradeFeed_F33642C080CBA825] as feed_key,
                    RecNo() as cost_no,
                    $(fTxt([TransactionCosts/TransactionCost/Code])) as cost_code,
                    $(fTxt([TransactionCosts/TransactionCost/Cost])) as cost_text
                FROM [$(vFile)]
                (XmlSimple, table is [BatchFeed/TradeFeed]);

                LET vErrCostsFolded = ScriptError + 0;

                IF vErrCostsFolded = 0 THEN
                    LET vErrCosts      = 0;
                    LET vCostLayout    = 2;
                    LET vXmlCostFolded = vXmlCostFolded + 1;
                END IF

            END IF

            // A file with no <Cost> element at all: Castine.py gives Cost '' to its trades
            // and goes on. Decided on the raw text of the file, so that the result does not
            // depend on which tables XmlSimple creates for an element that never occurs.
            // vCostTagLines: lines with '<Cost', or -1 when the file could not be read as text.
            LET vCostTagLines = 0;

            IF vErrCosts <> 0 THEN

                CALL DropIfExists('_COST_PROBE');

                [_COST_PROBE]:
                NoConcatenate
                LOAD
                    probe_line
                WHERE probe_pos > 0;
                LOAD
                    RecNo() as probe_line,
                    Index([@1:n], '<Cost') as probe_pos
                FROM [$(vFile)]
                (fix, utf8, no labels, record is line);

                LET vErrCostProbe = ScriptError + 0;
                LET vCostTagLines = If(vErrCostProbe <> 0, -1, Alt(NoOfRows('_COST_PROBE'), 0));

                CALL DropIfExists('_COST_PROBE');

                IF vCostTagLines = 0 THEN
                    TRACE [CASTINE][WARN] No Cost element in $(vFileName): Cost and Add On stay empty for its trades, as in Castine.py;
                END IF

            END IF

            // No cost read in a file that has trades and has Cost elements: not accepted
            // in silence, because every amount of the file would be zero. The LOAD of the
            // production script runs again with ErrorMode = 1 and the reload stops there.
            IF vErrCosts <> 0 and vStopOnXmlError = 1 and vCostTagLines <> 0 THEN
                TRACE [CASTINE][ERROR] Costs of $(vFileName) not read (error code $(vErrCosts)). Reading again so that the reload stops with the Qlik message;
                SET ErrorMode = 1;
                CALL ReadCosts;
                SET ErrorMode = 0;
            END IF

            IF vExtLayout > 0 THEN

                // Layout already confirmed on an earlier file: one LOAD.
                CALL ReadExtFields(vExtLayout);

            ELSEIF vExtLayout = 0 THEN

                // Layout not confirmed yet: try each one until a LOAD runs.
                LET vErrExt = -1;

                FOR vExtTry = 1 to 4
                    IF vErrExt <> 0 THEN
                        CALL ReadExtFields(vExtTry);
                        IF vErrExt = 0 THEN
                            LET vExtLayout = vExtTry;
                        END IF
                    END IF
                NEXT vExtTry

                IF vExtLayout = 0 THEN
                    LET vExtMiss = vExtMiss + 1;
                    IF vExtMiss >= vExtMaxMiss THEN
                        LET vExtLayout = -1;
                        TRACE [CASTINE][WARN] ExtendedFields not readable in the first $(vExtMaxMiss) files with trades - it is not tried again in this reload;
                    END IF
                END IF

            ELSE

                // Layout search given up: layout 1 is still tried on each file, so that a later file with ExtendedFields is read.
                CALL ReadExtFields(1);
                IF vErrExt = 0 THEN
                    LET vExtLayout = 1;
                END IF

            END IF

        END IF

        SET ErrorMode = 1;

        Concatenate ([_XML_FILE_STATUS])
        LOAD
            $(vFileNo) as file_no,
            $(vErrTrades) as status_trades,
            $(vErrCosts) as status_costs,
            $(vErrExt) as status_ext,
            $(vFileBytes) as status_bytes,
            If($(vErrTrades) <> 0, If($(vFileBytes) <= $(vXmlEmptyBytes), 'EMPTY FEED', 'TRADES NOT READ'), If($(vErrCosts) <> 0, 'NO COST READ', If($(vErrExt) <> 0, 'NO EXTENDED FIELD READ', 'OK'))) as status_text
        AUTOGENERATE 1;

        IF vErrTrades <> 0 and vFileBytes <= vXmlEmptyBytes THEN
            LET vXmlFilesEmpty = vXmlFilesEmpty + 1;
            TRACE [CASTINE] $(vFileName) is an empty feed ($(vFileBytes) bytes): no trade;
        ELSEIF vErrTrades <> 0 THEN
            LET vXmlFilesError = vXmlFilesError + 1;
            TRACE [CASTINE][WARN] No trade read from $(vFileName) - error code $(vErrTrades);
        ELSE
            IF vErrCosts <> 0 THEN
                LET vXmlCostError = vXmlCostError + 1;
                TRACE [CASTINE][WARN] TransactionCost not read from $(vFileName) - error code $(vErrCosts);
            END IF
            IF vErrExt <> 0 THEN
                LET vXmlExtError = vXmlExtError + 1;
                TRACE [CASTINE][WARN] ExtendedFields not read from $(vFileName) - error code $(vErrExt);
            END IF
            IF vUseXmlCache = 1 and vErrCosts = 0 and vErrExt = 0 THEN
                LET vCacheNewText = vCacheNewText & vFileId & '>' & vFileNo & '|';
                LET vCacheNew     = vCacheNew + 1;
            END IF
        END IF

    END IF

NEXT vI

TRACE [CASTINE] XML files - empty feed: $(vXmlFilesEmpty) - trades not read: $(vXmlFilesError) - no cost read: $(vXmlCostError) - cost read from the trade columns: $(vXmlCostFolded) - no extended field read: $(vXmlExtError);

IF vXmlFilesError > 0 or vXmlCostError > 0 THEN
    TRACE [CASTINE][WARN] Some files were not read completely: the payout can differ from the Python. See the table AUDIT_XML_FILES (field XML Read Status);
END IF

IF vExtLayout > 0 THEN
    TRACE [CASTINE] ExtendedFields layout in use: $(vExtLayout) (1, 2, 3 = Field rows keyed by the trade with attribute name, NAME, Name - 4 = keyed by ExtendedFields);
ELSEIF vCntXmlFiles - vCacheUsed - vXmlFilesError - vXmlFilesEmpty > 0 THEN
    TRACE [CASTINE][WARN] ExtendedFields was not read from any file: Sec Type and Sec Type Description stay empty in the Bloomberg XML rows. Open one XML file in the data wizard, select the table BatchFeed/TradeFeed/ExtendedFields/Field and send the field names it shows;
END IF

// --- costs of each trade -----------------------------------------------------
CALL BuildNumMap('MAP_XML_COST', 'XML_COSTS', 'cost_text');

[_COST_PRIMARY]:
NoConcatenate
LOAD
    0 as file_no,
    0 as feed_key,
    '' as Cost_original
AUTOGENERATE 1;

Concatenate ([_COST_PRIMARY])
LOAD
    file_no,
    feed_key,
    FirstSortedValue(cost_text, cost_no) as Cost_original
RESIDENT XML_COSTS
WHERE file_no > 0 and Len(cost_text) > 0 and Upper(cost_code) <> 'R'
GROUP BY file_no, feed_key;

[_COST_ADDON]:
NoConcatenate
LOAD
    0 as file_no,
    0 as feed_key,
    0 as addon_sum,
    0 as addon_count
AUTOGENERATE 1;

Concatenate ([_COST_ADDON])
LOAD
    file_no,
    feed_key,
    Sum(ApplyMap('MAP_XML_COST', Chr(126) & cost_text, Null())) as addon_sum,
    Count(ApplyMap('MAP_XML_COST', Chr(126) & cost_text, Null())) as addon_count
RESIDENT XML_COSTS
WHERE file_no > 0 and Len(cost_text) > 0 and Upper(cost_code) = 'R'
GROUP BY file_no, feed_key;

DROP TABLE XML_COSTS;

// --- extended fields of each trade: the last Field with that name wins -------
[_EXT_SECTYPE]:
NoConcatenate
LOAD
    0 as file_no,
    0 as feed_key,
    '' as SECURITY_TYP
AUTOGENERATE 1;

Concatenate ([_EXT_SECTYPE])
LOAD
    file_no,
    feed_key,
    FirstSortedValue(ext_value, -ext_no) as SECURITY_TYP
RESIDENT XML_EXT
WHERE file_no > 0 and ext_name = 'SECURITY_TYP'
GROUP BY file_no, feed_key;

[_EXT_SECTOR]:
NoConcatenate
LOAD
    0 as file_no,
    0 as feed_key,
    '' as MARKET_SECTOR_DES
AUTOGENERATE 1;

Concatenate ([_EXT_SECTOR])
LOAD
    file_no,
    feed_key,
    FirstSortedValue(ext_value, -ext_no) as MARKET_SECTOR_DES
RESIDENT XML_EXT
WHERE file_no > 0 and ext_name = 'MARKET_SECTOR_DES'
GROUP BY file_no, feed_key;

DROP TABLE XML_EXT;

Left Join (XML_TRADES)
LOAD
    file_no,
    feed_key,
    Cost_original
RESIDENT _COST_PRIMARY;

Left Join (XML_TRADES)
LOAD
    file_no,
    feed_key,
    addon_sum,
    addon_count
RESIDENT _COST_ADDON;

Left Join (XML_TRADES)
LOAD
    file_no,
    feed_key,
    SECURITY_TYP
RESIDENT _EXT_SECTYPE;

Left Join (XML_TRADES)
LOAD
    file_no,
    feed_key,
    MARKET_SECTOR_DES
RESIDENT _EXT_SECTOR;

DROP TABLE _COST_PRIMARY;
DROP TABLE _COST_ADDON;
DROP TABLE _EXT_SECTYPE;
DROP TABLE _EXT_SECTOR;

// --- one row per trade, as the Python parser writes it -----------------------
// Seed row first (file_no = 0), removed in the next tab.
[XML_PARSED]:
NoConcatenate
LOAD
    file_no,
    feed_no,
    source_file,
    file_date_token,
    TransactionNumber,
    OriginalTktId,
    SecurityIdentifier,
    SecurityCurrencyISOCode,
    Ticker,
    MaturityDateExpirationDate,
    BuySellCoverShortFlag,
    TradeDate,
    AsOfTradeDate,
    Price,
    TradeAmount,
    CustomerAccountCounterparty,
    AccountCounterpartyShortName,
    MasterAccountName,
    TraderAccountName,
    TraderAccountNumber,
    SalespersonName,
    TransactionType,
    OMReasonCode,
    $(fNa(SECURITY_TYP)) as SECURITY_TYP,
    $(fNa(MARKET_SECTOR_DES)) as MARKET_SECTOR_DES,
    $(fNa(Cost_original)) as Cost_original,
    If(Alt(addon_count, 0) > 0, Text(Num($(fRound10(addon_sum)), '0.##########', '.', ',')), '') as AddOn_original
RESIDENT XML_TRADES;

DROP TABLE XML_TRADES;

// --- cache: add the trades kept from earlier reloads, store the new ones -----
IF vUseXmlCache = 1 THEN

    IF vCacheNew > 0 THEN

        [_CACHE_NEW]:
        NoConcatenate
        LOAD
            SubField(cn_item, '>', 1) as cache_id,
            Num#(SubField(cn_item, '>', 2)) as file_no;
        LOAD
            SubField(Mid('$(vCacheNewText)', 2, Len('$(vCacheNewText)') - 2), '|') as cn_item
        AUTOGENERATE 1;

        Inner Join (_CACHE_NEW)
        LOAD
            file_no,
            feed_no,
            source_file,
            file_date_token,
            TransactionNumber,
            OriginalTktId,
            SecurityIdentifier,
            SecurityCurrencyISOCode,
            Ticker,
            MaturityDateExpirationDate,
            BuySellCoverShortFlag,
            TradeDate,
            AsOfTradeDate,
            Price,
            TradeAmount,
            CustomerAccountCounterparty,
            AccountCounterpartyShortName,
            MasterAccountName,
            TraderAccountName,
            TraderAccountNumber,
            SalespersonName,
            TransactionType,
            OMReasonCode,
            SECURITY_TYP,
            MARKET_SECTOR_DES,
            Cost_original,
            AddOn_original
        RESIDENT XML_PARSED;

        DROP FIELD file_no FROM _CACHE_NEW;

    END IF

    IF vCacheUsed > 0 THEN

        [_CACHE_USE]:
        NoConcatenate
        LOAD
            SubField(cu_item, '>', 1) as cache_id,
            Num#(SubField(cu_item, '>', 2)) as file_no;
        LOAD
            SubField(Mid('$(vCacheUseText)', 2, Len('$(vCacheUseText)') - 2), '|') as cu_item
        AUTOGENERATE 1;

        Inner Join (_CACHE_USE)
        LOAD
            cache_id,
            feed_no,
            source_file,
            file_date_token,
            TransactionNumber,
            OriginalTktId,
            SecurityIdentifier,
            SecurityCurrencyISOCode,
            Ticker,
            MaturityDateExpirationDate,
            BuySellCoverShortFlag,
            TradeDate,
            AsOfTradeDate,
            Price,
            TradeAmount,
            CustomerAccountCounterparty,
            AccountCounterpartyShortName,
            MasterAccountName,
            TraderAccountName,
            TraderAccountNumber,
            SalespersonName,
            TransactionType,
            OMReasonCode,
            SECURITY_TYP,
            MARKET_SECTOR_DES,
            Cost_original,
            AddOn_original
        RESIDENT XML_CACHE;

        Concatenate ([XML_PARSED])
        LOAD
            file_no,
            feed_no,
            source_file,
            file_date_token,
            TransactionNumber,
            OriginalTktId,
            SecurityIdentifier,
            SecurityCurrencyISOCode,
            Ticker,
            MaturityDateExpirationDate,
            BuySellCoverShortFlag,
            TradeDate,
            AsOfTradeDate,
            Price,
            TradeAmount,
            CustomerAccountCounterparty,
            AccountCounterpartyShortName,
            MasterAccountName,
            TraderAccountName,
            TraderAccountNumber,
            SalespersonName,
            TransactionType,
            OMReasonCode,
            SECURITY_TYP,
            MARKET_SECTOR_DES,
            Cost_original,
            AddOn_original
        RESIDENT _CACHE_USE;

        DROP TABLE _CACHE_USE;

    END IF

    IF vCacheNew > 0 THEN

        IF vCacheFound = 1 THEN
            Concatenate ([XML_CACHE])
            LOAD *
            RESIDENT _CACHE_NEW;
            DROP TABLE _CACHE_NEW;
        ELSE
            RENAME TABLE _CACHE_NEW TO XML_CACHE;
        END IF

        STORE XML_CACHE INTO [$(vCacheFile)] (qvd);
        TRACE [CASTINE] XML cache updated: $(vCacheNew) new file(s), $(vCacheUsed) taken from the cache;

    END IF

    CALL DropIfExists('XML_CACHE');

END IF

DROP TABLE XML_CACHE_IDS;

// Seed row is not a trade.
LET vCntTradesParsed = NoOfRows('XML_PARSED') - 1;
TRACE [CASTINE] total_trades_parsed_raw: $(vCntTradesParsed);

IF vCntTradesParsed <= 0 THEN
    TRACE [CASTINE][STOP] Parsed 0 trades. Check the XML files and the table BatchFeed/TradeFeed;
    EXIT SCRIPT;
END IF

// Trades read per file (kept in the app for checking).
[AUDIT_XML_FILES]:
NoConcatenate
LOAD
    RowNo() as [XML File No],
    file_name as [XML File],
    file_date_token as [XML File Date Token],
    file_version as [XML File Version]
RESIDENT XML_FILES;

Left Join ([AUDIT_XML_FILES])
LOAD
    file_no as [XML File No],
    Count(feed_no) as [XML Trades Read]
RESIDENT XML_PARSED
WHERE file_no > 0
GROUP BY file_no;

Left Join ([AUDIT_XML_FILES])
LOAD
    file_no as [XML File No],
    status_text as [XML Read Status],
    status_bytes as [XML File Bytes],
    status_trades as [XML Error Code Trades],
    status_costs as [XML Error Code Costs],
    status_ext as [XML Error Code Extended Fields]
RESIDENT _XML_FILE_STATUS
WHERE file_no > 0;

DROP TABLE _XML_FILE_STATUS;

DROP TABLE XML_FILES;

///$tab 09_XML_Versions
// ============================================================================
// Castine.py: keep_last_version (L1199), remove_cancels (L1274).
//
// Same trade in several files: the last version stays (order: file date of the
// file name, then AsOfTradeDate, then reading order). The TradeDate of the
// first version is carried to the row that stays. Then trades whose
// TransactionType contains X are removed.
// ============================================================================

// Dates that are not written as YYYY-MM-DD... go through the Castine.py date reader.
[_XML_DATE_TEXT]:
NoConcatenate
LOAD
    '@seed' as xd_text
AUTOGENERATE 1;

Concatenate ([_XML_DATE_TEXT])
LOAD DISTINCT
    AsOfTradeDate as xd_text
RESIDENT XML_PARSED
WHERE file_no > 0 and Len(AsOfTradeDate) > 0 and not $(fIsIso(AsOfTradeDate));

Concatenate ([_XML_DATE_TEXT])
LOAD DISTINCT
    TradeDate as xd_text
RESIDENT XML_PARSED
WHERE file_no > 0 and Len(TradeDate) > 0 and not $(fIsIso(TradeDate));

CALL BuildDateMap('MAP_XML_DATE', '_XML_DATE_TEXT', 'xd_text');
DROP TABLE _XML_DATE_TEXT;

// Version order by AsOfTradeDate as pandas does it (pd.to_datetime, L1225):
// the format of the first value that is not empty is the format of the column,
// and a value written in another format has no date in the order (it goes
// first). vAsOfShape = that first value with every digit replaced by 9.
// With one format in every trade (2026-01-30T10:15:00) nothing changes.
LET vAsOfShape  = '@none';
LET vAsOfStrict = 0;
LET vAsOfMixed  = 0;

[_ASOF_FIRST]:
NoConcatenate
LOAD
    FirstSortedValue(AsOfTradeDate, file_no * 100000000 + feed_no) as first_asof
RESIDENT XML_PARSED
WHERE file_no > 0 and Len(AsOfTradeDate) > 0 and Match(AsOfTradeDate, 'NaT', 'nat', 'NAT', 'NAN') = 0;

LET vAsOfFirst = Peek('first_asof', 0, '_ASOF_FIRST');
CALL DropIfExists('_ASOF_FIRST');

CALL ColumnDateShape(vAsOfFirst);
LET vAsOfShape  = vShape;
LET vAsOfStrict = vShapeStrict;

// Group key of the trade: TransactionNumber, else OriginalTktId, else
// SecurityIdentifier||TradeDate||TradeAmount. Chr(126) keeps the key as text.
[_XML_KEYED]:
NoConcatenate
LOAD
    *,
    AutoNumber(grp_key, 'xmlgrp') as grp_id,
    If(IsNull(asof_date) or ($(vAsOfStrict) = 1 and asof_shape <> '$(vAsOfShape)'), -999999999, asof_date + asof_time) as asof_order;
LOAD
    *,
    Chr(126) & If(Len(TransactionNumber) > 0, TransactionNumber, If(Len(OriginalTktId) > 0, OriginalTktId, SecurityIdentifier & '||' & TradeDate & '||' & TradeAmount)) as grp_key,
    Alt(Num#(file_date_token), 0) as token_order,
    file_no * 100000000 + feed_no as read_order,
    If(asof_iso = 1, $(fYMD(asof_y, asof_m, asof_d)), ApplyMap('MAP_XML_DATE', Chr(126) & AsOfTradeDate, Null())) as asof_date,
    If(asof_iso = 1, Alt(Time#(Mid(AsOfTradeDate, 12, 8), 'hh:mm:ss') + 0, 0), 0) as asof_time;
LOAD
    *,
    If($(fIsIso(AsOfTradeDate)), 1, 0) as asof_iso,
    $(fDigitMask(AsOfTradeDate)) as asof_shape,
    Num#(Left(AsOfTradeDate, 4)) as asof_y,
    Num#(Mid(AsOfTradeDate, 6, 2)) as asof_m,
    Num#(Mid(AsOfTradeDate, 9, 2)) as asof_d
RESIDENT XML_PARSED
WHERE file_no > 0;

DROP TABLE XML_PARSED;

IF vAsOfStrict = 1 THEN

    [_ASOF_MIX]:
    NoConcatenate
    LOAD
        Count(feed_no) as mix_count
    RESIDENT _XML_KEYED
    WHERE not IsNull(asof_date) and asof_shape <> '$(vAsOfShape)';

    LET vAsOfMixed = Alt(Peek('mix_count', 0, '_ASOF_MIX'), 0);
    CALL DropIfExists('_ASOF_MIX');

    IF vAsOfMixed > 0 THEN
        TRACE [CASTINE][WARN] AsOfTradeDate is written in more than one format: $(vAsOfMixed) trades take no date in the version order, as in pandas. Format of the first value: $(vAsOfShape);
    END IF

END IF

// Versions of each trade in order, carrying the first non-empty TradeDate.
[_XML_VERSIONS]:
NoConcatenate
LOAD
    *,
    If(grp_id = Previous(grp_id), Peek('version_no') + 1, 1) as version_no,
    If(grp_id = Previous(grp_id) and Len(Peek('first_trade_date')) > 0, Peek('first_trade_date'), If(Match(Lower(TradeDate), 'nan', 'nat', 'none', 'null') > 0, '', TradeDate)) as first_trade_date
RESIDENT _XML_KEYED
ORDER BY grp_id, token_order, asof_order, read_order;

DROP TABLE _XML_KEYED;

// Last version of each trade (first row when the versions are read backwards).
[XML_LATEST]:
NoConcatenate
LOAD *
RESIDENT _XML_VERSIONS
WHERE IsNull(Previous(grp_id)) or grp_id <> Previous(grp_id)
ORDER BY grp_id asc, version_no desc;

DROP TABLE _XML_VERSIONS;

LET vCntAfterVersion = Alt(NoOfRows('XML_LATEST'), 0);
TRACE [CASTINE] rows_after_versioning: $(vCntAfterVersion);

IF vCntAfterVersion = 0 THEN
    TRACE [CASTINE][STOP] Versioning produced 0 rows;
    EXIT SCRIPT;
END IF

// remove_cancels: TransactionType with an X (any case) is a cancelled trade.
// trade_date_out = date shown as Trade Date (TradeDate of the first version when
//                  it has one, else the TradeDate of the row that stayed)
// trade_date_row = date of the TradeDate of the row that stayed (used when the
//                  split date cannot come from AsOfTradeDate)
[XML_ACTIVE]:
NoConcatenate
LOAD
    *,
    If(tdo_iso = 1, $(fYMD(tdo_y, tdo_m, tdo_d)), ApplyMap('MAP_XML_DATE', Chr(126) & trade_date_text, Null())) as trade_date_out,
    If(tdr_iso = 1, $(fYMD(tdr_y, tdr_m, tdr_d)), ApplyMap('MAP_XML_DATE', Chr(126) & TradeDate, Null())) as trade_date_row;
LOAD
    *,
    If($(fIsIso(trade_date_text)), 1, 0) as tdo_iso,
    Num#(Left(trade_date_text, 4)) as tdo_y,
    Num#(Mid(trade_date_text, 6, 2)) as tdo_m,
    Num#(Mid(trade_date_text, 9, 2)) as tdo_d,
    If($(fIsIso(TradeDate)), 1, 0) as tdr_iso,
    Num#(Left(TradeDate, 4)) as tdr_y,
    Num#(Mid(TradeDate, 6, 2)) as tdr_m,
    Num#(Mid(TradeDate, 9, 2)) as tdr_d;
LOAD
    *,
    If(Len(first_trade_date) > 0, first_trade_date, TradeDate) as trade_date_text
RESIDENT XML_LATEST
WHERE Index(Lower(TransactionType), 'x') = 0;

LET vCntAfterCancels = Alt(NoOfRows('XML_ACTIVE'), 0);
LET vCntCancels      = vCntAfterVersion - vCntAfterCancels;
TRACE [CASTINE] rows_after_remove_cancels: $(vCntAfterCancels) (removed=$(vCntCancels));

DROP TABLE XML_LATEST;

IF vCntAfterCancels = 0 THEN
    TRACE [CASTINE][STOP] Cancels removal produced 0 rows;
    EXIT SCRIPT;
END IF

///$tab 10_XML_Split
// ============================================================================
// Castine.py: merge_split_and_compute (L1599), build_team_mismatch_alerts
// (L1543), build_official_output (L1701), exclude_xml_nonusd_from_output (L1781).
//
// RR Team = SalespersonName of the XML. Each trade takes the split rows of its
// team that are active on the split date (one output row per salesperson).
// Production Earned = round((Cost + Add On) * Split, 2).
// A trade without team, or without an active split, goes to the alert table.
// Rows that are not in USD go to their own alert table.
// ============================================================================

// Numbers of Cost_original and AddOn_original (parse_cost_original_to_float).
[_COST_TEXT]:
NoConcatenate
LOAD
    Cost_original as ct_text
RESIDENT XML_ACTIVE;

Concatenate ([_COST_TEXT])
LOAD
    AddOn_original as ct_text
RESIDENT XML_ACTIVE;

CALL BuildNumMap('MAP_TRADE_COST', '_COST_TEXT', 'ct_text');
DROP TABLE _COST_TEXT;

// Split date as pandas reads it (merge_split_and_compute, L1613-1615):
// AsOfTradeDate, else TradeDate, else the payout date. The two fields are read
// as columns of the trades in key order: the format of the first value that is
// not empty is the format of the column, and a value written in another format
// has no date there. With one format in every trade nothing changes.
LET vSplitAsOfShape  = '@none';
LET vSplitAsOfStrict = 0;
LET vSplitTdShape    = '@none';
LET vSplitTdStrict   = 0;

[_SPLIT_FIRST_ASOF]:
NoConcatenate
LOAD
    AsOfTradeDate as sfa_text
RESIDENT XML_ACTIVE
WHERE Len(AsOfTradeDate) > 0 and Match(AsOfTradeDate, 'NaT', 'nat', 'NAT', 'NAN') = 0
ORDER BY grp_key;

LET vSplitAsOfFirst = Peek('sfa_text', 0, '_SPLIT_FIRST_ASOF');
CALL DropIfExists('_SPLIT_FIRST_ASOF');

CALL ColumnDateShape(vSplitAsOfFirst);
LET vSplitAsOfShape  = vShape;
LET vSplitAsOfStrict = vShapeStrict;

[_SPLIT_FIRST_TD]:
NoConcatenate
LOAD
    TradeDate as sft_text
RESIDENT XML_ACTIVE
WHERE Len(TradeDate) > 0 and Match(TradeDate, 'NaT', 'nat', 'NAT', 'NAN') = 0
ORDER BY grp_key;

LET vSplitTdFirst = Peek('sft_text', 0, '_SPLIT_FIRST_TD');
CALL DropIfExists('_SPLIT_FIRST_TD');

CALL ColumnDateShape(vSplitTdFirst);
LET vSplitTdShape  = vShape;
LET vSplitTdStrict = vShapeStrict;

[XML_BASE]:
NoConcatenate
LOAD
    RowNo() as xml_row_id,
    SalespersonName as rr_team,
    'T|' & $(fTeamKey(SalespersonName)) as rr_key,
    Alt(If($(vSplitAsOfStrict) = 1 and asof_shape <> '$(vSplitAsOfShape)', Null(), asof_date), If($(vSplitTdStrict) = 1 and $(fDigitMask(TradeDate)) <> '$(vSplitTdShape)', Null(), trade_date_row), $(vPayoutDate)) as split_date,
    ApplyMap('MAP_TRADE_COST', Chr(126) & Cost_original, Null()) as cost_num,
    ApplyMap('MAP_TRADE_COST', Chr(126) & AddOn_original, Null()) as addon_num,
    version_no,
    asof_date,
    trade_date_out,
    TransactionNumber,
    SecurityIdentifier,
    SecurityCurrencyISOCode,
    Ticker,
    MaturityDateExpirationDate,
    BuySellCoverShortFlag,
    TradeAmount,
    CustomerAccountCounterparty,
    AccountCounterpartyShortName,
    MasterAccountName,
    TraderAccountName,
    TraderAccountNumber,
    OMReasonCode,
    SECURITY_TYP,
    MARKET_SECTOR_DES,
    Cost_original,
    AddOn_original,
    source_file,
    file_date_token
RESIDENT XML_ACTIVE
ORDER BY grp_key;

DROP TABLE XML_ACTIVE;

// --- teams of the split matrix and teams of the XML -------------------------
[MAP_SPLIT_TEAM]:
MAPPING
LOAD DISTINCT
    rr_key,
    1 as team_found
RESIDENT SPLIT_VALID;

[_XML_TEAMS]:
NoConcatenate
LOAD
    '@seed' as xt_key,
    '' as xt_example,
    0 as xt_count
AUTOGENERATE 1;

Concatenate ([_XML_TEAMS])
LOAD
    rr_key as xt_key,
    FirstSortedValue(rr_team, xml_row_id) as xt_example,
    Count(xml_row_id) as xt_count
RESIDENT XML_BASE
WHERE Len(rr_team) > 0
GROUP BY rr_key;

[MAP_XML_TEAM]:
MAPPING
LOAD
    xt_key,
    1 as team_found
RESIDENT _XML_TEAMS;

// split_team_mismatch_alerts.csv
[ALERT_TEAM_MISMATCH]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [side],
    '' as [key],
    '' as [example_original],
    0 as [count_rows]
AUTOGENERATE 1;

// Both sides go to a temporary table first, so that the alert can be sorted
// by side, then key, as Castine.py does (SPLIT_ONLY rows before XML_ONLY rows).
// NoConcatenate is required: the field set equals ALERT_TEAM_MISMATCH.
[_TEAM_MISMATCH]:
NoConcatenate
LOAD
    0 as row_seed,
    'XML_ONLY' as [side],
    Mid(xt_key, 3) as [key],
    xt_example as [example_original],
    xt_count as [count_rows]
RESIDENT _XML_TEAMS
WHERE xt_count > 0 and ApplyMap('MAP_SPLIT_TEAM', xt_key, 0) = 0;

Concatenate ([_TEAM_MISMATCH])
LOAD
    0 as row_seed,
    'SPLIT_ONLY' as [side],
    rr_norm as [key],
    FirstSortedValue(rr_raw, split_row) as [example_original],
    Count(split_row) as [count_rows]
RESIDENT SPLIT_VALID
WHERE split_row > 0 and ApplyMap('MAP_XML_TEAM', rr_key, 0) = 0
GROUP BY rr_norm;

Concatenate ([ALERT_TEAM_MISMATCH])
LOAD
    row_seed,
    [side],
    [key],
    [example_original],
    [count_rows]
RESIDENT _TEAM_MISMATCH
ORDER BY [side], [key];

DROP TABLE _TEAM_MISMATCH;

DROP TABLE _XML_TEAMS;

// --- every trade before the split, for the alert of the dropped ones ---------
[_XML_ALL]:
NoConcatenate
LOAD
    xml_row_id,
    rr_team,
    rr_key,
    TransactionNumber,
    Cost_original,
    AddOn_original,
    CustomerAccountCounterparty,
    MasterAccountName,
    Ticker,
    MaturityDateExpirationDate,
    source_file,
    file_date_token,
    // 0 = empty RR Team: Castine.py writes these rows first in the alert
    If(Len(rr_team) = 0, 0, 1) as drop_group
RESIDENT XML_BASE;

// --- split rows of the team, then only the ones active on the split date -----
Inner Join (XML_BASE)
LOAD
    rr_key,
    split_row,
    split_salesperson,
    split_text,
    split_num,
    eff_cmp,
    exp_cmp
RESIDENT SPLIT_VALID;

// The Inner Join can leave XML_BASE with no rows (split matrix not usable,
// or no XML team in the matrix). Read it only when it still has rows.
IF Alt(NoOfRows('XML_BASE'), 0) > 0 THEN

    [XML_MATCHED]:
    NoConcatenate
    LOAD
        *,
        If(commission_total < 0 and $(fRound2(production_raw)) = 0, -0.000001, $(fRound2(production_raw))) as production_earned,
        If(commission_total < 0 and $(fRound2(commission_total)) = 0, -0.000001, $(fRound2(commission_total))) as gross_comms;
    LOAD
        *,
        commission_total * split_num as production_raw;
    LOAD
        *,
        $(fRound10(commission_raw)) as commission_total;
    LOAD
        *,
        Alt(cost_num, 0) + Alt(addon_num, 0) as commission_raw
    RESIDENT XML_BASE
    WHERE Len(rr_team) > 0 and split_date >= eff_cmp and split_date <= exp_cmp
    ORDER BY xml_row_id, split_row;

END IF

CALL DropIfExists('XML_BASE');
LET vCntXmlMapped = Alt(NoOfRows('XML_MATCHED'), 0);

// --- trades that did not get a split row -------------------------------------
[_XML_MATCHED_IDS]:
NoConcatenate
LOAD
    0 as matched_id
AUTOGENERATE 1;

IF vCntXmlMapped > 0 THEN

    Concatenate ([_XML_MATCHED_IDS])
    LOAD DISTINCT
        xml_row_id as matched_id
    RESIDENT XML_MATCHED;

END IF

[MAP_XML_MATCHED]:
MAPPING
LOAD
    matched_id,
    1 as matched_flag
RESIDENT _XML_MATCHED_IDS;

DROP TABLE _XML_MATCHED_IDS;

// split_unmapped_alerts.csv
[ALERT_SPLIT_UNMAPPED]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [TransactionNumber],
    '' as [RR Team],
    '' as [Salesperson],
    '' as [Split_raw],
    Null() as [Split_num],
    '' as [Cost_original],
    '' as [AddOn_original],
    Null() as [Cost_original_numeric],
    Null() as [AddOn_numeric],
    Null() as [Commission_total_numeric],
    '' as [CustomerAccountCounterparty],
    '' as [MasterAccountName],
    '' as [Ticker],
    '' as [MaturityDateExpirationDate],
    '' as [source_file],
    '' as [file_date_token],
    '' as [drop_reason]
AUTOGENERATE 1;

Concatenate ([ALERT_SPLIT_UNMAPPED])
LOAD
    0 as row_seed,
    TransactionNumber as [TransactionNumber],
    rr_team as [RR Team],
    '' as [Salesperson],
    '' as [Split_raw],
    Null() as [Split_num],
    Cost_original as [Cost_original],
    AddOn_original as [AddOn_original],
    Null() as [Cost_original_numeric],
    Null() as [AddOn_numeric],
    Null() as [Commission_total_numeric],
    $(fApos(CustomerAccountCounterparty)) as [CustomerAccountCounterparty],
    MasterAccountName as [MasterAccountName],
    Ticker as [Ticker],
    MaturityDateExpirationDate as [MaturityDateExpirationDate],
    source_file as [source_file],
    file_date_token as [file_date_token],
    If(Len(rr_team) = 0, 'RRTEAM_EMPTY', If($(vSplitOk) = 0, 'SPLIT_MATRIX_NOT_USABLE', If(ApplyMap('MAP_SPLIT_TEAM', rr_key, 0) = 1, 'NO_ACTIVE_SPLIT_FOR_DATE', 'RRTEAM_NOT_MAPPED_IN_SPLIT_MATRIX'))) as [drop_reason]
RESIDENT _XML_ALL
WHERE ApplyMap('MAP_XML_MATCHED', xml_row_id, 0) = 0
ORDER BY drop_group, xml_row_id;

DROP TABLE _XML_ALL;

LET vCntXmlDropped = NoOfRows('ALERT_SPLIT_UNMAPPED') - 1;
TRACE [CASTINE] rows_mapped (kept for payout export): $(vCntXmlMapped) - rows_dropped_unmapped: $(vCntXmlDropped);

// --- official layout of the XML rows -----------------------------------------
// CORE = XML rows + Repo rows, before the cross-year rule. Seed row first.
[CORE]:
NoConcatenate
LOAD
    1 as row_seed,
    0 as row_order,
    '' as [As of trade date],
    '' as [Client],
    '' as [Security],
    '' as [Trade Id],
    '' as [Salesperson],
    Null() as [Production Earned],
    Null() as [Payout Earned],
    '' as [Trader Team Name],
    '' as [Fidelity #],
    '' as [ShortDesc],
    '' as [TradeType],
    '' as [Trade Date],
    '' as [RR Team],
    '' as [Source],
    '' as [Sec Type],
    '' as [Sec Type Description],
    '' as [Security Description],
    Null() as [Gross Comms],
    '' as [Acct Short Description],
    '' as [Currency],
    '' as [BuySell],
    '' as [TradeAmount],
    '' as [GLCS CODE],
    0 as xml_modified
AUTOGENERATE 1;

// xml_nonusd_excluded_alerts.csv
[ALERT_XML_NONUSD]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [As of trade date],
    '' as [Client],
    '' as [Security],
    '' as [Trade Id],
    '' as [Salesperson],
    Null() as [Production Earned],
    Null() as [Payout Earned],
    '' as [Trader Team Name],
    '' as [Fidelity #],
    '' as [ShortDesc],
    '' as [TradeType],
    '' as [Trade Date],
    '' as [RR Team],
    '' as [Source],
    '' as [Sec Type],
    '' as [Sec Type Description],
    '' as [Security Description],
    Null() as [Gross Comms],
    '' as [Acct Short Description],
    '' as [Currency],
    '' as [BuySell],
    '' as [TradeAmount],
    '' as [GLCS CODE],
    '' as [Currency_norm],
    '' as [alert_reason]
AUTOGENERATE 1;

IF vCntXmlMapped > 0 THEN

    [XML_OFFICIAL]:
    NoConcatenate
    LOAD
        xml_row_id,
        split_row,
        $(fMDY(asof_date)) as [As of trade date],
        If(Len(MasterAccountName) > 0, MasterAccountName, AccountCounterpartyShortName) as [Client],
        SecurityIdentifier as [Security],
        TransactionNumber as [Trade Id],
        split_salesperson as [Salesperson],
        production_earned as [Production Earned],
        production_earned as [Payout Earned],
        TraderAccountNumber as [Trader Team Name],
        '' as [Fidelity #],
        TraderAccountName as [ShortDesc],
        OMReasonCode as [TradeType],
        $(fMDY(trade_date_out)) as [Trade Date],
        rr_team as [RR Team],
        'Bloomberg XML' as [Source],
        SECURITY_TYP as [Sec Type],
        MARKET_SECTOR_DES as [Sec Type Description],
        Trim(Ticker & ' ' & MaturityDateExpirationDate) as [Security Description],
        gross_comms as [Gross Comms],
        $(fApos(CustomerAccountCounterparty)) as [Acct Short Description],
        SecurityCurrencyISOCode as [Currency],
        BuySellCoverShortFlag as [BuySell],
        TradeAmount as [TradeAmount],
        '' as [GLCS CODE],
        If(version_no > 1, 1, 0) as xml_modified,
        $(fCurrencyKey(SecurityCurrencyISOCode)) as currency_norm
    RESIDENT XML_MATCHED;

    DROP TABLE XML_MATCHED;

    Concatenate ([CORE])
    LOAD
        0 as row_seed,
        RowNo() as row_order,
        [As of trade date],
        [Client],
        [Security],
        [Trade Id],
        [Salesperson],
        [Production Earned],
        [Payout Earned],
        [Trader Team Name],
        [Fidelity #],
        [ShortDesc],
        [TradeType],
        [Trade Date],
        [RR Team],
        [Source],
        [Sec Type],
        [Sec Type Description],
        [Security Description],
        [Gross Comms],
        [Acct Short Description],
        [Currency],
        [BuySell],
        [TradeAmount],
        [GLCS CODE],
        xml_modified
    RESIDENT XML_OFFICIAL
    WHERE (Chr(126) & currency_norm) = (Chr(126) & 'USD')
    ORDER BY xml_row_id, split_row;

    // Money columns are written as text with two decimals (Python float_format='%.2f');
    // the -0.000001 sentinel of a negative amount that rounds to zero is written as -0.00.
    // xml_row_id, split_row keep payout order for ties (pandas sort_values is stable).
    Concatenate ([ALERT_XML_NONUSD])
    LOAD
        0 as row_seed,
        [As of trade date],
        [Client],
        [Security],
        [Trade Id],
        [Salesperson],
        If(IsNull([Production Earned]), '', If([Production Earned] < 0 and [Production Earned] > -0.005, Text('-0.00'), Text(Num([Production Earned], '0.00', '.', ',')))) as [Production Earned],
        If(IsNull([Payout Earned]), '', If([Payout Earned] < 0 and [Payout Earned] > -0.005, Text('-0.00'), Text(Num([Payout Earned], '0.00', '.', ',')))) as [Payout Earned],
        [Trader Team Name],
        [Fidelity #],
        [ShortDesc],
        [TradeType],
        [Trade Date],
        [RR Team],
        [Source],
        [Sec Type],
        [Sec Type Description],
        [Security Description],
        If(IsNull([Gross Comms]), '', If([Gross Comms] < 0 and [Gross Comms] > -0.005, Text('-0.00'), Text(Num([Gross Comms], '0.00', '.', ',')))) as [Gross Comms],
        [Acct Short Description],
        [Currency],
        [BuySell],
        [TradeAmount],
        [GLCS CODE],
        currency_norm as [Currency_norm],
        If(Len(currency_norm) = 0, 'XML_CURRENCY_BLANK_EXCLUDED', 'XML_CURRENCY_NONUSD_EXCLUDED') as [alert_reason]
    RESIDENT XML_OFFICIAL
    WHERE (Chr(126) & currency_norm) <> (Chr(126) & 'USD')
    ORDER BY [RR Team], [Salesperson], [As of trade date], [Security], xml_row_id, split_row;

    DROP TABLE XML_OFFICIAL;

ELSE
    TRACE [CASTINE][WARN] 0 XML rows mapped to the split matrix. The XML part of the payout is empty;
END IF

CALL DropIfExists('XML_MATCHED');

LET vCntXmlKept   = NoOfRows('CORE') - 1;
LET vCntXmlNonUsd = NoOfRows('ALERT_XML_NONUSD') - 1;
TRACE [CASTINE] XML rows kept: $(vCntXmlKept) - XML rows excluded NON-USD: $(vCntXmlNonUsd);

///$tab 11_Repo_Output
// ============================================================================
// Castine.py: build_repo_official_output (L2178), build_repo_dropped_alerts (L2126).
//
// RR Team of a repo row = SalesPerson of the file. Split date = T/D (read with
// the Castine.py date reader), or the payout date when T/D is not a date.
// Production Earned = round(Net Credit * Split, 2).
// ============================================================================

// repo_unmapped_alerts.csv
[ALERT_REPO_UNMAPPED]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [Trade Id],
    '' as [RR Team],
    '' as [Salesperson],
    '' as [Split_raw],
    Null() as [Split_num],
    '' as [Net Credit],
    Null() as [Net Credit numeric],
    '' as [Account],
    '' as [Cusip],
    '' as [Trader],
    '' as [T/D],
    '' as [TR/TYPE],
    '' as [AssetClass],
    '' as [SecurityDescription],
    '' as [Principal],
    '' as [repo_source_file],
    '' as [drop_reason]
AUTOGENERATE 1;

LET vCntRepoKept = 0;

IF vRepoFound = 1 THEN

    CALL BuildDateMap('MAP_REPO_DATE', 'REPO_RAW', 'repo_td');
    CALL BuildNumMap('MAP_REPO_NUM', 'REPO_RAW', 'repo_netcredit');

    [REPO_BASE]:
    NoConcatenate
    LOAD
        *,
        $(fMDY(repo_split_date)) as repo_td_out;
    LOAD
        repo_row,
        repo_td,
        repo_account,
        repo_cusip,
        repo_trans,
        repo_salesperson as repo_rr_team,
        repo_trader,
        repo_trtype,
        repo_assetclass,
        repo_secdesc,
        repo_netcredit,
        repo_principal,
        'T|' & $(fTeamKey(repo_salesperson)) as rr_key,
        ApplyMap('MAP_REPO_NUM', Chr(126) & repo_netcredit, Null()) as repo_netcredit_num,
        Alt(ApplyMap('MAP_REPO_DATE', Chr(126) & repo_td, Null()), $(vPayoutDate)) as repo_split_date
    RESIDENT REPO_RAW;

    DROP TABLE REPO_RAW;

    // every repo row before the split, for the alert of the dropped ones
    [_REPO_ALL]:
    NoConcatenate
    LOAD
        repo_row,
        repo_rr_team,
        rr_key,
        repo_trans,
        repo_netcredit,
        repo_netcredit_num,
        repo_account,
        repo_cusip,
        repo_trader,
        repo_td_out,
        repo_trtype,
        repo_assetclass,
        repo_secdesc,
        repo_principal,
        If(Len(repo_rr_team) = 0, 0, 1) as repo_has_team
    RESIDENT REPO_BASE;

    Inner Join (REPO_BASE)
    LOAD
        rr_key,
        split_row,
        split_salesperson,
        split_text,
        split_num,
        eff_cmp,
        exp_cmp
    RESIDENT SPLIT_VALID;

    // The Inner Join can leave REPO_BASE with no rows (split matrix not usable,
    // or no repo team in the matrix). Read it only when it still has rows.
    IF Alt(NoOfRows('REPO_BASE'), 0) > 0 THEN

        [REPO_MATCHED]:
        NoConcatenate
        LOAD
            *,
            If(repo_netcredit_num < 0 and $(fRound2(repo_production_raw)) = 0, -0.000001, $(fRound2(repo_production_raw))) as repo_production,
            If(repo_netcredit_num < 0 and $(fRound2(repo_netcredit_num)) = 0, -0.000001, $(fRound2(repo_netcredit_num))) as repo_gross;
        LOAD
            *,
            repo_netcredit_num * split_num as repo_production_raw
        RESIDENT REPO_BASE
        WHERE Len(repo_rr_team) > 0 and repo_split_date >= eff_cmp and repo_split_date <= exp_cmp
        ORDER BY repo_row, split_row;

    END IF

    CALL DropIfExists('REPO_BASE');
    LET vCntRepoKept = Alt(NoOfRows('REPO_MATCHED'), 0);

    [_REPO_MATCHED_IDS]:
    NoConcatenate
    LOAD
        0 as matched_id
    AUTOGENERATE 1;

    IF vCntRepoKept > 0 THEN

        Concatenate ([_REPO_MATCHED_IDS])
        LOAD DISTINCT
            repo_row as matched_id
        RESIDENT REPO_MATCHED;

    END IF

    [MAP_REPO_MATCHED]:
    MAPPING
    LOAD
        matched_id,
        1 as matched_flag
    RESIDENT _REPO_MATCHED_IDS;

    DROP TABLE _REPO_MATCHED_IDS;

    Concatenate ([ALERT_REPO_UNMAPPED])
    LOAD
        0 as row_seed,
        repo_trans as [Trade Id],
        repo_rr_team as [RR Team],
        '' as [Salesperson],
        '' as [Split_raw],
        Null() as [Split_num],
        repo_netcredit as [Net Credit],
        $(fMoneyTxt(repo_netcredit_num)) as [Net Credit numeric],
        repo_account as [Account],
        $(fApos(repo_cusip)) as [Cusip],
        repo_trader as [Trader],
        repo_td_out as [T/D],
        repo_trtype as [TR/TYPE],
        repo_assetclass as [AssetClass],
        repo_secdesc as [SecurityDescription],
        repo_principal as [Principal],
        '$(vRepoName)' as [repo_source_file],
        If(Len(repo_rr_team) = 0, 'RRTEAM_EMPTY', If($(vSplitOk) = 0, 'SPLIT_MATRIX_NOT_USABLE', If(ApplyMap('MAP_SPLIT_TEAM', rr_key, 0) = 1, 'NO_ACTIVE_SPLIT_FOR_DATE', 'RRTEAM_NOT_MAPPED_IN_SPLIT_MATRIX'))) as [drop_reason]
    RESIDENT _REPO_ALL
    WHERE ApplyMap('MAP_REPO_MATCHED', repo_row, 0) = 0
    ORDER BY repo_has_team, repo_row;

    DROP TABLE _REPO_ALL;

    IF vCntRepoKept > 0 THEN

        Concatenate ([CORE])
        LOAD
            0 as row_seed,
            RowNo() as row_order,
            repo_td_out as [As of trade date],
            repo_account as [Client],
            repo_cusip as [Security],
            repo_trans as [Trade Id],
            split_salesperson as [Salesperson],
            repo_production as [Production Earned],
            repo_production as [Payout Earned],
            repo_trader as [Trader Team Name],
            '' as [Fidelity #],
            repo_trader as [ShortDesc],
            repo_trtype as [TradeType],
            repo_td_out as [Trade Date],
            repo_rr_team as [RR Team],
            'Repo' as [Source],
            repo_assetclass as [Sec Type],
            repo_assetclass as [Sec Type Description],
            repo_secdesc as [Security Description],
            repo_gross as [Gross Comms],
            $(fApos(repo_account)) as [Acct Short Description],
            'USD' as [Currency],
            'B' as [BuySell],
            repo_principal as [TradeAmount],
            '' as [GLCS CODE],
            0 as xml_modified
        RESIDENT REPO_MATCHED
        ORDER BY repo_row, split_row;

    END IF

    CALL DropIfExists('REPO_MATCHED');

END IF

LET vCntRepoDropped = NoOfRows('ALERT_REPO_UNMAPPED') - 1;
TRACE [CASTINE] Repo rows kept: $(vCntRepoKept) - repo rows dropped: $(vCntRepoDropped);

///$tab 12_Final
// ============================================================================
// Castine.py main() L3667-3724, in this order:
//   1. exclude_legacy_roll_shortdesc_records (L1813)  XML + Repo rows
//   2. manual adjustments appended                    (L3681)
//   3. force_modified_bloomberg_xml_trade_date_equal_asof (L1878)
//   4. exclude_rrteam_235_and_client_test (L2646)
//   5. populate_glcs_code (L3098) and the two GLCS tables of the alert e-mail
// ============================================================================

// --- 1. cross-year rule ------------------------------------------------------
// A row leaves when: As of trade date is not in the year vLegacyYear (or has no
// date), Trade Date is in vLegacyYear, and ShortDesc is GNCL, MULT or GNPL.
// The Python reads the two dates again from the output text, so the same
// reader is used here.
[_OUT_DATE_TEXT]:
NoConcatenate
LOAD
    [As of trade date] as od_text
RESIDENT CORE;

Concatenate ([_OUT_DATE_TEXT])
LOAD
    [Trade Date] as od_text
RESIDENT CORE;

CALL BuildDateMap('MAP_OUT_DATE', '_OUT_DATE_TEXT', 'od_text');
DROP TABLE _OUT_DATE_TEXT;

// FINAL = payout rows being assembled. Seed row first.
[FINAL]:
NoConcatenate
LOAD
    1 as row_seed,
    0 as row_order,
    '' as [As of trade date],
    '' as [Client],
    '' as [Security],
    '' as [Trade Id],
    '' as [Salesperson],
    Null() as [Production Earned],
    Null() as [Payout Earned],
    '' as [Trader Team Name],
    '' as [Fidelity #],
    '' as [ShortDesc],
    '' as [TradeType],
    '' as [Trade Date],
    '' as [RR Team],
    '' as [Source],
    '' as [Sec Type],
    '' as [Sec Type Description],
    '' as [Security Description],
    Null() as [Gross Comms],
    '' as [Acct Short Description],
    '' as [Currency],
    '' as [BuySell],
    '' as [TradeAmount],
    '' as [GLCS CODE],
    0 as xml_modified
AUTOGENERATE 1;

// crossyear_gncl_mult_excluded_alerts.csv
[ALERT_CROSSYEAR]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [As of trade date],
    '' as [Client],
    '' as [Security],
    '' as [Trade Id],
    '' as [Salesperson],
    Null() as [Production Earned],
    Null() as [Payout Earned],
    '' as [Trader Team Name],
    '' as [Fidelity #],
    '' as [ShortDesc],
    '' as [TradeType],
    '' as [Trade Date],
    '' as [RR Team],
    '' as [Source],
    '' as [Sec Type],
    '' as [Sec Type Description],
    '' as [Security Description],
    Null() as [Gross Comms],
    '' as [Acct Short Description],
    '' as [Currency],
    '' as [BuySell],
    '' as [TradeAmount],
    '' as [GLCS CODE],
    '' as [AsOfTradeDate_parsed],
    '' as [TradeDate_parsed],
    Null() as [AsOfTradeDate_year],
    Null() as [TradeDate_year],
    '' as [ShortDesc_norm],
    '' as [alert_reason]
AUTOGENERATE 1;

LET vCoreRows = NoOfRows('CORE') - 1;

IF vCoreRows > 0 THEN

    [_CORE_CHECK]:
    NoConcatenate
    LOAD
        *,
        If((IsNull(asof_parsed) or Year(asof_parsed) <> $(vLegacyYear)) and Year(td_parsed) = $(vLegacyYear) and Match(shortdesc_norm, 'GNCL', 'MULT', 'GNPL') > 0, 1, 0) as legacy_excluded;
    LOAD
        *,
        ApplyMap('MAP_OUT_DATE', Chr(126) & [As of trade date], Null()) as asof_parsed,
        ApplyMap('MAP_OUT_DATE', Chr(126) & [Trade Date], Null()) as td_parsed,
        Upper(Trim([ShortDesc])) as shortdesc_norm
    RESIDENT CORE
    WHERE row_seed = 0;

    Concatenate ([FINAL])
    LOAD
        0 as row_seed,
        RowNo() as row_order,
        [As of trade date],
        [Client],
        [Security],
        [Trade Id],
        [Salesperson],
        [Production Earned],
        [Payout Earned],
        [Trader Team Name],
        [Fidelity #],
        [ShortDesc],
        [TradeType],
        [Trade Date],
        [RR Team],
        [Source],
        [Sec Type],
        [Sec Type Description],
        [Security Description],
        [Gross Comms],
        [Acct Short Description],
        [Currency],
        [BuySell],
        [TradeAmount],
        [GLCS CODE],
        xml_modified
    RESIDENT _CORE_CHECK
    WHERE legacy_excluded = 0
    ORDER BY row_order;

    // pandas gives the year columns a float type when some row has no date, and
    // to_csv then writes 2026.00 instead of 2026 (float_format "%.2f").
    [_YR]:
    NoConcatenate
    LOAD
        Sum(If(IsNull(asof_parsed), 1, 0)) as n_asof_null,
        Sum(If(IsNull(td_parsed), 1, 0)) as n_td_null
    RESIDENT _CORE_CHECK;

    LET vAsofYrFmt = If(Alt(Peek('n_asof_null', 0, '_YR'), 0) > 0, '0.00', '0');
    LET vTdYrFmt   = If(Alt(Peek('n_td_null', 0, '_YR'), 0) > 0, '0.00', '0');
    DROP TABLE _YR;

    Concatenate ([ALERT_CROSSYEAR])
    LOAD
        0 as row_seed,
        [As of trade date],
        [Client],
        [Security],
        [Trade Id],
        [Salesperson],
        $(fMoneyTxt([Production Earned])) as [Production Earned],
        $(fMoneyTxt([Payout Earned])) as [Payout Earned],
        [Trader Team Name],
        [Fidelity #],
        [ShortDesc],
        [TradeType],
        [Trade Date],
        [RR Team],
        [Source],
        [Sec Type],
        [Sec Type Description],
        [Security Description],
        $(fMoneyTxt([Gross Comms])) as [Gross Comms],
        [Acct Short Description],
        [Currency],
        [BuySell],
        [TradeAmount],
        [GLCS CODE],
        If(IsNull(asof_parsed), '', Text(Date(asof_parsed, 'YYYY-MM-DD'))) as [AsOfTradeDate_parsed],
        If(IsNull(td_parsed), '', Text(Date(td_parsed, 'YYYY-MM-DD'))) as [TradeDate_parsed],
        If(IsNull(asof_parsed), Null(), Text(Num(Year(asof_parsed), '$(vAsofYrFmt)', '.', ','))) as [AsOfTradeDate_year],
        If(IsNull(td_parsed), Null(), Text(Num(Year(td_parsed), '$(vTdYrFmt)', '.', ','))) as [TradeDate_year],
        shortdesc_norm as [ShortDesc_norm],
        'ASOF_NOT_2026_TRADEDATE_2026_SHORTDESC_GNCL_MULT_GNPL_EXCLUDED' as [alert_reason]
    RESIDENT _CORE_CHECK
    WHERE legacy_excluded = 1
    ORDER BY [Source], [RR Team], [Salesperson], [ShortDesc], [As of trade date], [Trade Date];

    CALL DropIfExists('_CORE_CHECK');

END IF

DROP TABLE CORE;

LET vCntCrossYear = NoOfRows('ALERT_CROSSYEAR') - 1;
LET vCntCoreKept  = NoOfRows('FINAL') - 1;
TRACE [CASTINE] Core rows after GNCL/MULT/GNPL filter: $(vCntCoreKept) - cross-year excluded: $(vCntCrossYear);

// --- 2. manual adjustments ---------------------------------------------------
// Appended as they are. Only the three money columns are turned into numbers
// (parse_cost_original_to_float); a text that is not a number becomes empty.
// Adjustment values keep the blanks at both ends (Castine.py does), also in the
// resident loads below. Verbatim stays 1 until the end of the script: after this
// point the only file read is the Python export, which wants Verbatim = 1 too.
SET Verbatim = 1;

IF vAdjFound = 1 THEN

    [_ADJ_MONEY]:
    NoConcatenate
    LOAD
        [adj Production Earned] as am_text
    RESIDENT ADJ_RAW;

    Concatenate ([_ADJ_MONEY])
    LOAD
        [adj Payout Earned] as am_text
    RESIDENT ADJ_RAW;

    Concatenate ([_ADJ_MONEY])
    LOAD
        [adj Gross Comms] as am_text
    RESIDENT ADJ_RAW;

    CALL BuildNumMap('MAP_ADJ_NUM', '_ADJ_MONEY', 'am_text');
    DROP TABLE _ADJ_MONEY;

    Concatenate ([FINAL])
    LOAD
        0 as row_seed,
        RowNo() as row_order,
        If(not IsNull(adj_asof_num) and (Index([adj As of trade date], '/') > 0 or Index(Mid([adj As of trade date], 2), '-') > 0), Text(Timestamp(adj_asof_num, 'YYYY-MM-DD hh:mm:ss')), [adj As of trade date]) as [As of trade date],
        [adj Client] as [Client],
        [adj Security] as [Security],
        [adj Trade Id] as [Trade Id],
        [adj Salesperson] as [Salesperson],
        ApplyMap('MAP_ADJ_NUM', Chr(126) & [adj Production Earned], Null()) as [Production Earned],
        ApplyMap('MAP_ADJ_NUM', Chr(126) & [adj Payout Earned], Null()) as [Payout Earned],
        [adj Trader Team Name] as [Trader Team Name],
        [adj Fidelity #] as [Fidelity #],
        [adj ShortDesc] as [ShortDesc],
        [adj TradeType] as [TradeType],
        If(not IsNull(adj_td_num) and (Index([adj Trade Date], '/') > 0 or Index(Mid([adj Trade Date], 2), '-') > 0), Text(Timestamp(adj_td_num, 'YYYY-MM-DD hh:mm:ss')), [adj Trade Date]) as [Trade Date],
        [adj RR Team] as [RR Team],
        [adj Source] as [Source],
        [adj Sec Type] as [Sec Type],
        [adj Sec Type Description] as [Sec Type Description],
        [adj Security Description] as [Security Description],
        ApplyMap('MAP_ADJ_NUM', Chr(126) & [adj Gross Comms], Null()) as [Gross Comms],
        [adj Acct Short Description] as [Acct Short Description],
        [adj Currency] as [Currency],
        [adj BuySell] as [BuySell],
        [adj TradeAmount] as [TradeAmount],
        [adj GLCS CODE] as [GLCS CODE],
        0 as xml_modified
    RESIDENT ADJ_RAW
    WHERE $(vAdjIsExcel) = 0 or adj_any_len > 0
    ORDER BY adj_row;

    DROP TABLE ADJ_RAW;

END IF

LET vCntAdjAppended = NoOfRows('FINAL') - 1 - vCntCoreKept;
TRACE [CASTINE] Adjustments rows appended: $(vCntAdjAppended);

// --- 3 and 4. Trade Date of modified XML trades, RR Team 235 and Client TEST --
// 3: a Bloomberg XML trade that had more than one version shows Trade Date =
//    As of trade date.
// 4: rows with RR Team 235 or Client TEST leave the payout, whatever the Source.
//    Chr(126) makes the comparison textual (235.0 is not 235).
[_FINAL_RULES]:
NoConcatenate
LOAD
    *,
    If((Chr(126) & rr_team_norm) = (Chr(126) & '235') or (Chr(126) & client_norm) = (Chr(126) & 'TEST'), 1, 0) as business_excluded,
    // Rank of alert_reason in Python text order: CLIENT_TEST_EXCLUDED (1) <
    // RRTEAM_235_EXCLUDED (2) < RRTEAM_235_EXCLUDED;CLIENT_TEST_EXCLUDED (3).
    If((Chr(126) & rr_team_norm) = (Chr(126) & '235'), If((Chr(126) & client_norm) = (Chr(126) & 'TEST'), 3, 2), If((Chr(126) & client_norm) = (Chr(126) & 'TEST'), 1, 0)) as business_reason_rank;
LOAD
    row_seed,
    row_order,
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    [Production Earned],
    [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    If(Upper(Trim([Source])) = 'BLOOMBERG XML' and xml_modified = 1, [As of trade date], [Trade Date]) as [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE],
    $(fTeamKey([RR Team])) as rr_team_norm,
    $(fTeamKey([Client])) as client_norm
RESIDENT FINAL;

DROP TABLE FINAL;

// final_payout_business_excluded_alerts.csv
[ALERT_BUSINESS_EXCLUDED]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [As of trade date],
    '' as [Client],
    '' as [Security],
    '' as [Trade Id],
    '' as [Salesperson],
    Null() as [Production Earned],
    Null() as [Payout Earned],
    '' as [Trader Team Name],
    '' as [Fidelity #],
    '' as [ShortDesc],
    '' as [TradeType],
    '' as [Trade Date],
    '' as [RR Team],
    '' as [Source],
    '' as [Sec Type],
    '' as [Sec Type Description],
    '' as [Security Description],
    Null() as [Gross Comms],
    '' as [Acct Short Description],
    '' as [Currency],
    '' as [BuySell],
    '' as [TradeAmount],
    '' as [GLCS CODE],
    '' as [RRTeam_norm_for_filter],
    '' as [Client_norm_for_filter],
    '' as [alert_reason]
AUTOGENERATE 1;

Concatenate ([ALERT_BUSINESS_EXCLUDED])
LOAD
    0 as row_seed,
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    $(fMoneyTxt([Production Earned])) as [Production Earned],
    $(fMoneyTxt([Payout Earned])) as [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    $(fMoneyTxt([Gross Comms])) as [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE],
    rr_team_norm as [RRTeam_norm_for_filter],
    client_norm as [Client_norm_for_filter],
    If((Chr(126) & rr_team_norm) = (Chr(126) & '235'), 'RRTEAM_235_EXCLUDED', '') & If((Chr(126) & rr_team_norm) = (Chr(126) & '235') and (Chr(126) & client_norm) = (Chr(126) & 'TEST'), Chr(59), '') & If((Chr(126) & client_norm) = (Chr(126) & 'TEST'), 'CLIENT_TEST_EXCLUDED', '') as [alert_reason]
RESIDENT _FINAL_RULES
WHERE row_seed = 0 and business_excluded = 1
ORDER BY business_reason_rank, [Source], [RR Team], [Client], [Salesperson], [Trade Id];

LET vCntBusinessExcl = NoOfRows('ALERT_BUSINESS_EXCLUDED') - 1;
TRACE [CASTINE] Rows excluded by RR Team 235 or Client TEST: $(vCntBusinessExcl);

// Rows that stay (the seed row stays too, so the table always exists).
[FINAL_KEPT]:
NoConcatenate
LOAD
    row_seed,
    row_order,
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    [Production Earned],
    [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE]
RESIDENT _FINAL_RULES
WHERE row_seed = 1 or business_excluded = 0;

DROP TABLE _FINAL_RULES;

// --- 5. GLCS CODE --------------------------------------------------------------
// Only for rows whose Source is Bloomberg XML:
//   account with letters -> GLCS CODE = the account itself (without the apostrophe)
//   numeric account      -> tiara.accounts (ACCOUNTNR or BLOOMBERG_MASTER_ACCOUNT_NO);
//                           if not there, tiara.subaccounts SUBACCT_NO -> ACCOUNT_NO
//                           and then tiara.accounts ACCOUNTNR
//   not found            -> GLCS CODE keeps what it had; the row goes to the alert.
// Each key is tried as written and then without leading zeros.
CALL BuildAcctMaps('MAP_PAY_BASE', 'MAP_PAY_NZ', 'MAP_PAY_CLEAN', 'FINAL_KEPT', 'Acct Short Description');

[FINAL_GLCS]:
NoConcatenate
LOAD
    row_seed,
    row_order,
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    [Production Earned],
    [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    If(is_xml = 0, glcs_in, If(acct_alpha = 1, acct_clean, If(Len(acct_base) = 0, glcs_in, If(Len(glcs_direct) > 0, glcs_direct, If(Len(glcs_sub1) > 0, glcs_sub1, If(Len(glcs_sub2) > 0, glcs_sub2, glcs_in)))))) as [GLCS CODE],
    is_xml,
    acct_clean,
    acct_base,
    If(is_xml = 1 and acct_alpha = 0 and Len(acct_base) > 0 and Len(glcs_direct) = 0 and Len(glcs_sub1) = 0 and Len(glcs_sub2) = 0, 1, 0) as glcs_unmatched,
    If(sub2_found = 1, ApplyMap('MAP_SUB_SUBACCT', Chr(126) & acct_nz, ''), If(sub1_found = 1, ApplyMap('MAP_SUB_SUBACCT', Chr(126) & acct_base, ''), '')) as glcs_sub_no,
    If(sub2_found = 1, ApplyMap('MAP_SUB_ACCOUNT', Chr(126) & acct_nz, ''), If(sub1_found = 1, ApplyMap('MAP_SUB_ACCOUNT', Chr(126) & acct_base, ''), '')) as glcs_sub_account,
    If(sub1_found = 1 or sub2_found = 1, 1, 0) as glcs_sub_found;
LOAD
    *,
    If(sub1_found = 1, If(Len(ApplyMap('MAP_GLCS_ACCNR', Chr(126) & sub1_acc_base, '')) > 0, ApplyMap('MAP_GLCS_ACCNR', Chr(126) & sub1_acc_base, ''), ApplyMap('MAP_GLCS_ACCNR', Chr(126) & sub1_acc_nz, '')), '') as glcs_sub1,
    If(sub2_found = 1, If(Len(ApplyMap('MAP_GLCS_ACCNR', Chr(126) & sub2_acc_base, '')) > 0, ApplyMap('MAP_GLCS_ACCNR', Chr(126) & sub2_acc_base, ''), ApplyMap('MAP_GLCS_ACCNR', Chr(126) & sub2_acc_nz, '')), '') as glcs_sub2;
LOAD
    *,
    If(Len(acct_base) > 0, If(Len(ApplyMap('MAP_GLCS_DIRECT', Chr(126) & acct_base, '')) > 0, ApplyMap('MAP_GLCS_DIRECT', Chr(126) & acct_base, ''), ApplyMap('MAP_GLCS_DIRECT', Chr(126) & acct_nz, '')), '') as glcs_direct,
    If(Len(acct_base) > 0, ApplyMap('MAP_SUB_FOUND', Chr(126) & acct_base, 0), 0) as sub1_found,
    ApplyMap('MAP_SUB_ACCOUNT_BASE', Chr(126) & acct_base, '') as sub1_acc_base,
    ApplyMap('MAP_SUB_ACCOUNT_NZ', Chr(126) & acct_base, '') as sub1_acc_nz,
    If(Len(acct_base) > 0, ApplyMap('MAP_SUB_FOUND', Chr(126) & acct_nz, 0), 0) as sub2_found,
    ApplyMap('MAP_SUB_ACCOUNT_BASE', Chr(126) & acct_nz, '') as sub2_acc_base,
    ApplyMap('MAP_SUB_ACCOUNT_NZ', Chr(126) & acct_nz, '') as sub2_acc_nz;
LOAD
    *,
    If(Len(KeepChar(acct_clean, 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz')) > 0, 1, 0) as acct_alpha;
LOAD
    *,
    If(Upper(Trim([Source])) = 'BLOOMBERG XML', 1, 0) as is_xml,
    If(IsNull([GLCS CODE]), '', Text([GLCS CODE])) as glcs_in,
    ApplyMap('MAP_PAY_CLEAN', Chr(126) & [Acct Short Description], '') as acct_clean,
    ApplyMap('MAP_PAY_BASE', Chr(126) & [Acct Short Description], '') as acct_base,
    ApplyMap('MAP_PAY_NZ', Chr(126) & [Acct Short Description], '') as acct_nz
RESIDENT FINAL_KEPT;

DROP TABLE FINAL_KEPT;

// glcs_code_unmapped_alerts.csv
[ALERT_GLCS_UNMAPPED]:
NoConcatenate
LOAD
    1 as row_seed,
    '' as [As of trade date],
    '' as [Client],
    '' as [Security],
    '' as [Trade Id],
    '' as [Salesperson],
    Null() as [Production Earned],
    Null() as [Payout Earned],
    '' as [Trader Team Name],
    '' as [Fidelity #],
    '' as [ShortDesc],
    '' as [TradeType],
    '' as [Trade Date],
    '' as [RR Team],
    '' as [Source],
    '' as [Sec Type],
    '' as [Sec Type Description],
    '' as [Security Description],
    Null() as [Gross Comms],
    '' as [Acct Short Description],
    '' as [Currency],
    '' as [BuySell],
    '' as [TradeAmount],
    '' as [GLCS CODE],
    '' as [LookupAccountShortDescription],
    '' as [LookupAccountNormalized],
    '' as [LookupPathTried],
    '' as [DirectTiaraMatchField],
    '' as [DirectTiaraMatchValue],
    '' as [SubacctNoMatched],
