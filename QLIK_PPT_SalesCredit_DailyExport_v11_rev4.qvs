///$tab 00_Main
// ============================================================================
// QLIK_PPT_SalesCredit_DailyExport v11 rev 4 (2026-11-11)
// The analyst script QLIK_PPT_SalesCredit_DailyExport 2026Jan.qvs, updated so that
// the Qlik export is identical to Castine.py (Bloomberg XML + Repo + Adjustments
// -> Split Matrix -> PPT_DailyExportOfPayout).
// Kept from the analyst script: locale SETs, Config_QS include, real connections
// and paths, XmlSimple read of the Bloomberg XML, the Qlik x Python comparison.
// Never reloaded in a Qlik engine at creation time. Change log: CHANGES_v11.md.
//
// WHERE THE PROBLEM WAS. Every fix is tagged [FIX-nn] in the tab where it is
// applied (WAS = analyst script line, NOW = Castine.py function). Tab 11b writes
// the measured effect of each fix to the reload log and to the table FIX_LOG.
//   [FIX-01] Script flow: EXIT SCRIPT at L151 stopped the reload after the comparison   -> tab 13
//   [FIX-02] XML files: fixed prefix f392fd1, fixed version .4, January, day <= 30       -> tab 02
//   [FIX-03] Filters applied while reading the XML (TEST, X, Salesperson, split, year)   -> tab 03
//   [FIX-04] Versioning by OriginalTktId + MAX(TradeDate) instead of TransactionNumber   -> tab 04
//   [FIX-05] Cancels removed before versioning instead of after                          -> tab 04
//   [FIX-06] Gross Comms = sum of every USD TransactionCost (Type) instead of Cost+AddOn -> tab 03
//   [FIX-07] Split matrix loaded without validation, split parse or open-ended dates     -> tab 05
//   [FIX-08] Split joined by raw RR Team only, no date window, unmapped rows kept        -> tab 06
//   [FIX-09] Production Earned not rounded (half-to-even, 2 decimals)                    -> tab 06
//   [FIX-10] Currency: cost lines filtered instead of excluding non-USD trades           -> tab 07
//   [FIX-11] Trade Date: latest version date instead of original / As-of for modified    -> tabs 07, 10
//   [FIX-12] Final exclusions missing: GNCL/MULT/GNPL cross-year, RR Team 235, TEST      -> tab 10
//   [FIX-13] Repo: RR Team commented out (no split), fixed file path                     -> tab 08
//   [FIX-14] Manual adjustments file not loaded                                          -> tab 09
//   [FIX-15] GLCS CODE: Tiara mappings built but never applied; FROM without brackets    -> tab 10b
//   [FIX-16] Output layout: 23 official columns, 2 decimals, Sec Type, Currency          -> tabs 07, 11
//   [FIX-17] ISO dates with T (2026-01-15T10:22:00) left to automatic interpretation     -> tab 01
//   [FIX-18] Comparison read the UTF-8 Python file as Latin-1; Bloomberg XML only        -> tab 13
// ============================================================================
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

// Shared config (defines SDrive, SDrive_SalesControlData, vToday, vT_Year,
// vLastWorkDate_Year, vLastWorkDate_PriorYear)
$(Must_Include=lib://Fldr_QlikShare/SCRIPT/Config_QS.txt);

TRACE [CASTINE] Script QLIK_PPT_SalesCredit_DailyExport v11 rev 4;

///$tab 00b_Parameters
// ============================================================================
// SINGLE PLACE to change folders and switches.
// Folders come from the analyst script (same connections and paths).
// ============================================================================
SET vLibXML       = 'lib://Fldr_SDrive/Trading/bloomberg/ftp/';                 // Bloomberg XML (Castine.py xml_folder)
SET vLibSalesData = 'lib://Fldr_SDrive/Qlikview/Sales/Data/';                   // adjustments_folder
SET vLibTiara     = 'lib://Fldr_SDrive/Qlikview/Sales/Data/Tiara Accounts/';    // tiara_accounts_folder
SET vLibRepo      = 'lib://Fldr_SDrive/Operations/BroadridgeData/Reports/';     // repo_folder (YYYYMMDD subfolders)
LET vLibSplit     = '$(SDrive_SalesControlData)/';                              // split matrix folder (Config_QS)
LET vLibOutput    = '$(SDrive)/UAT/Qlikview/Sales/Data/castine/';               // STORE folder used by the analyst (L638). UAT ONLY
// Prefix of every stored file. QLIK_V11_ keeps the current analyst export
// (QLIK_PPT_DailyExportOfPayout_<date>.csv) untouched, so tab 13 can compare
// Current x New x Python. After validation set it to 'QLIK_' to replace that export.
SET vOutTag       = 'QLIK_V11_';
IF Len('$(SDrive)') = 0 or Len('$(SDrive_SalesControlData)') = 0 THEN
  TRACE [CASTINE][ERROR] Config_QS.txt did not define SDrive / SDrive_SalesControlData: split matrix and STORE paths are wrong.;
END IF

// Comparison with the Python export (tab 13). 1 = run it after the export.
SET vRunCompare     = 1;
SET vPythonExportLibs = 'lib://Fldr_SDrive/qlikview/sales/data/daily files/;lib://Fldr_SDrive/Qlikview/Sales/Data/castine/';  // folders tried in order for the Python PPT_DailyExportOfPayout_YYYYMMDD.csv (analyst L147; Castine.py production_output_folder)
SET vCompare_Date   = '';                                                       // '' = payout date of this reload; or 'YYYYMMDD'

// Analyst rule NOT present in Castine.py: keep AsOf in the current year, or in the
// prior year only for traders listed in Sales_Mapping.xlsx. 0 = off (Python parity).
SET vApplySalesMappingYearFilter = 0;
SET vSalesMappingFile = 'lib://QlikView SDrive/Qlikview/Sales/Data/Qlik Control Data/Sales_Mapping.xlsx';

// XmlSimple path of one trade inside the Bloomberg file (from the analyst script)
SET vXmlTradeFeedPath = 'BatchFeed/TradeFeed';

// --- Castine.py CONFIG (L74-185) -------------------------------------------
SET vXmlPattern            = '*.ext.26*';                   // file_glob_pattern (last segment = version; only the highest is kept)
SET vDateLimitToken        = '';                            // date_limit_token ('' = None). The analyst January test = '260130'
SET vSplitMatrixFile       = 'RR Teams Split Matrix.xlsx';  // same file as Castine.py "split matrix Castine V2.xlsx" (confirmed by the business)
SET vSplitSheetCandidates  = 'Split_Matrix;Split;Sheet1;Plan1;Matrix;split matrix;Castine'; // Qlik does not enumerate xlsx sheets (Python scans all of them)
SET vApplySplit            = 1;                             // apply_split = True
LET vSplitSumTolerance     = 0.001;                         // SPLIT_SUM_TOLERANCE
SET vRepoPrefixes          = 'YTDSalesCommission_;RepoSalesCommission_;YTDSalesComission_;RepoSalesComission_;YTDSalesCommission;RepoSalesCommission;YTDSalesComission;RepoSalesComission';
SET vRepoSource            = 'Repo';                        // repo_source_hardcoded
SET vRepoCurrency          = 'USD';                         // repo_currency_hardcoded
SET vRepoBuySell           = 'B';                           // repo_buysell_hardcoded
SET vAdjPrefixes           = 'adjustments DailyExportOfPayout_;adjustments DailyExportOfPayout;adjustments_DailyExportOfPayout_;adjustments_DailyExportOfPayout;adjustmentsDailyExportOfPayout_;adjustmentsDailyExportOfPayout';
SET vLegacyTradeYear       = 2026;                          // fixed year of the GNCL/MULT/GNPL rule (exclude_legacy_roll_shortdesc_records L1841-1843)
SET vPreferCostOutsideTxc  = 1;                             // PREFER_COST_OUTSIDE_TRANSACTIONCOSTS
SET vAllowTxcFallback      = 1;                             // ALLOW_TRANSACTIONCOST_FALLBACK
SET vStoreOutputs          = 1;                             // 1 = STORE final table + alerts in vLibOutput
SET vKeepAlertTables       = 0;                             // 1 = keep alerts in the model (qualified)

// Audit counter defaults (overwritten during the load)
SET vTotalTradesParsed=0;
SET vRowsAfterVersioning=0;
SET vRowsAfterCancels=0;
SET vCancelsRemoved=0;
SET vXmlRowsMapped=0;
SET vXmlRowsDropped=0;
SET vXmlRowsKept=0;
SET vXmlNonUsdExcluded=0;
SET vCoreRows=0;
SET vGnclExcluded=0;
SET vBusinessExcluded=0;
SET vAdjRows=0;
SET vFinalRows=0;
SET vSplitValidRows=0;
SET vNumXmlFiles=0;
SET vTiaraAccountsStatus='NOT_LOADED';
SET vTiaraSubStatus='NOT_LOADED';
SET vTiaraAccountsFile='';
SET vTiaraSubFile='';

// Comparison date sentinels (load_split_matrix_castine L1421-1422)
LET vTsMin = Num(MakeDate(1900,1,1));       // pd.Timestamp('1900-01-01')
LET vTsMax = Num(MakeDate(2262,4,11));      // pd.Timestamp('2262-04-11')
LET vTsFloorMin = -81183;                  // date serial of 1677-09-21 = pd.Timestamp.min (versioning sort order, L1225)

// Ready-made lists for FOR EACH
LET vSplitSheetList = Chr(39) & Replace('$(vSplitSheetCandidates)', ';', Chr(39) & ',' & Chr(39)) & Chr(39);
LET vRepoPrefixList = Chr(39) & Replace('$(vRepoPrefixes)', ';', Chr(39) & ',' & Chr(39)) & Chr(39);
LET vAdjPrefixList  = Chr(39) & Replace('$(vAdjPrefixes)', ';', Chr(39) & ',' & Chr(39)) & Chr(39);
LET vAdjSheetList   = Chr(39) & Replace('Sheet1;Plan1;$(vSplitSheetCandidates)', ';', Chr(39) & ',' & Chr(39)) & Chr(39);
///$tab 01 — Functions
// [FIX-17] ISO DATES WITH 'T'
//   WAS (analyst L384-390, L420-421): SubField(...,'T',1) for the date, NUM() and
//        YEAR() on the raw text, relying on the automatic interpretation.
//   NOW: fPdDate and ParseDateColumn parse YYYY-MM-DDThh:mm:ss explicitly, as
//        pd.to_datetime / dateutil do in Castine.py (L1225, L530-642).
// ============================================================================
// 01 — FUNCTIONS (variable functions; $1 = text argument)
// Each one mirrors 1 Python function cited in the comment.
// ============================================================================

// normalize_team_key (L679-693): NBSP/zero-width/BOM -> space/nothing, trim,
// collapses spaces (re \s+ -> ' '), UPPER. 5 passes of '  '->' ' cover runs <= 32.
SET fNormTeam = Upper(Trim(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Text($1) & '', Chr(160),' '), Chr(8203),''), Chr(65279),''), Chr(9),' '), Chr(10),' '), Chr(13),' '), '  ',' '), '  ',' '), '  ',' '), '  ',' '), '  ',' ')));

// normalize_currency (L696-704): NBSP etc, trim, UPPER, remove quotes, remove ALL spaces
SET fNormCurrency = PurgeChar(Upper(Replace(Replace(Replace(Text($1) & '', Chr(160),' '), Chr(8203),''), Chr(65279),'')), '"' & Chr(39) & ' ' & Chr(9) & Chr(10) & Chr(13));

// header_norm (L707-711): lower + only [a-z0-9]
SET fHeaderNorm = KeepChar(Lower(Text($1)), 'abcdefghijklmnopqrstuvwxyz0123456789');

// prefix_apostrophe (L883-893): a non-empty value gets a single leading apostrophe
SET fPrefixApos = If(Len(Trim(Text($1)))=0 or Lower(Trim(Text($1)))='nan', '', If(Left(Trim(Text($1)),1)=Chr(39), Trim(Text($1)), Chr(39) & Trim(Text($1))));

// HALF-TO-EVEN rounding (numpy .round() semantics: scale, rint, unscale)
// pandas Series.round(2) == np.round: multiply by 100, round half to even, divide.
SET fRint = If(Frac($1)=0.5, If(Even(Floor($1)), Floor($1), Floor($1)+1), Round($1));
SET fRound2  = (If(Frac(($1)*100)=0.5, If(Even(Floor(($1)*100)), Floor(($1)*100), Floor(($1)*100)+1), Round(($1)*100))/100);
SET fRound10 = (If(Frac(($1)*10000000000)=0.5, If(Even(Floor(($1)*10000000000)), Floor(($1)*10000000000), Floor(($1)*10000000000)+1), Round(($1)*10000000000))/10000000000);

// fmt_mdy_no_zeros (L646-650): M/D/YYYY without leading zeros; null -> ''
// ($1 = Qlik numeric date or null)
SET fFmtMDY = If(Len($1 & '')=0, '', Num(Month($1)) & '/' & Num(Day($1)) & '/' & Num(Year($1)));

// --- Dates -------------------------------------------------------------------
// fPdDate: mirrors pd.to_datetime(errors='coerce') for the feed formats
// (used in keep_last_version L1225 and SplitApplyDate L1614-1616 / L2195).
// Order: ISO timestamp with 'T' (real Bloomberg feed), compact ISO, ISO, US, ISO timestamp.
SET fPdDate = Alt(Timestamp#(Left(Replace(Trim(Text($1)),'T',' '),19),'YYYY-MM-DD hh:mm:ss'), Date#(Trim(Text($1)),'YYYYMMDD'), Date#(Trim(Text($1)),'YYYY-MM-DD'), Date#(Trim(Text($1)),'MM/DD/YYYY'), Date#(Trim(Text($1)),'M/D/YYYY'), Timestamp#(Trim(Text($1)),'YYYY-MM-DD hh:mm:ss'), Timestamp#(Trim(Text($1)),'YYYY-MM-DD hh:mm:ss.fff'), Date#(Trim(Text($1)),'YYYY/MM/DD'));

// ---------------------------------------------------------------------------
// SUB ParseDateColumn: mirrors parse_date_to_datetime (L530-642) — custom parser.
// Creates pOut (Qlik numeric date; null if not parseable) from pIn in pTable.
// EXACT Python ORDER:
//   (0) empty/nan/nat/none/null -> null
//   (1) pure integer string (optional .0+) -> EXCEL SERIAL (base 1899-12-30 ==
//       Qlik native serial). FAITHFUL QUIRK: '261030' becomes year 2614; a serial above
//       9999-12-31 (2958465) overflows datetime in Python -> None -> moves on.
//   (2) compact digits: 8 digits starting 19/20 -> YYYYMMDD; else MMDDYYYY vs
//       DDMMYYYY (a>12 => DMY; b>12 => MDY; else MDY; else 1st valid);
//       6 digits: MMDDYY vs DDMMYY vs YYMMDD, century pivot <=79 => 20xx.
//   (3) 3 parts separated by / - . : 1st with 4 digits -> Y/M/D; 3rd with 4 digits ->
//       MDY vs DMY (same disambiguation); 3rd with 2 digits -> same with pivot.
//   (4) dateutil-style fallback (MDY default) for the remaining common formats.
// Input already numeric (Excel date cell) -> uses the serial directly
// (same as Python parsing pandas' ISO str(datetime)).
// ---------------------------------------------------------------------------
// SUB DetectCodepage: mirrors the Python encoding fallback
// (*_encoding_candidates = utf-8-sig, utf-8, cp1252, latin-1): a file that is not
// valid UTF-8 shows the replacement character U+FFFD when read as 65001; then it
// is read as 1252. The analyst script reads Repo and Tiara as 28591 (Latin-1).
// pOutVar receives the character-set item of the file format: utf8 or codepage is 1252.
SUB DetectCodepage(pFile, pOutVar)
  LET $(pOutVar) = 'utf8';
  [__cp0]:
  NoConcatenate
  LOAD
      @1:n as __cp_line
  FROM [$(pFile)]
  (fix, utf8, no labels, record is line);
  [__cp]:
  NoConcatenate
  LOAD
      Sum(If(Index(__cp_line, Chr(65533)) > 0, 1, 0)) as __cp_bad
  RESIDENT __cp0;
  DROP TABLE __cp0;
  IF Alt(Peek('__cp_bad', 0, '__cp'), 0) > 0 THEN
    LET $(pOutVar) = 'codepage is 1252';
    TRACE [CASTINE] Not valid UTF-8, reading as cp1252: $(pFile);
  END IF
  DROP TABLE __cp;
END SUB

// Builds in pOutVar the list Text([c]) as [c] of a file, to read everything as text.
SUB BuildTextSel(pFile, pSpec, pOutVar)
  LET $(pOutVar) = '';
  [__probe]:
  NoConcatenate FIRST 1
  LOAD *
  FROM [$(pFile)]
  ($(pSpec));
  FOR _bi = 1 to Alt(NoOfFields('__probe'), 0)
    LET _bf = FieldName($(_bi), '__probe');
    LET $(pOutVar) = If(Len('$($(pOutVar))')>0, '$($(pOutVar)), ', '') & 'Text([$(_bf)]) as [$(_bf)]';
  NEXT _bi
  IF Alt(TableNumber('__probe'), -1) >= 0 THEN
    DROP TABLE __probe;
  END IF
END SUB

SUB ParseDateColumn(pTable, pIn, pOut)
  [__pd_tmp]:
  NoConcatenate
  LOAD
      *,
      If(__pd_isnum=1, __pd_rawnum,
         If(__pd_nan=1, Null(),
            Alt(__pd_serial, __pd_c8, __pd_c6, __pd_sep, __pd_fb))) AS [$(pOut)];
  LOAD
      *,
      // (4) dateutil-like fallback
      // ISO 8601 with 'T' (2026-01-15T10:22:00[.fff][+-hh:mm]) as dateutil does
      Alt(If(Mid(__pd_s,11,1)='T', Timestamp#(Left(Replace(__pd_s,'T',' '),19),'YYYY-MM-DD hh:mm:ss')),
          If(Mid(__pd_s,11,1)='T', Timestamp#(Left(Replace(__pd_s,'T',' '),16),'YYYY-MM-DD hh:mm')),
          Floor(Timestamp#(__pd_s,'YYYY-MM-DD hh:mm:ss')) + Frac(Timestamp#(__pd_s,'YYYY-MM-DD hh:mm:ss')),
          Timestamp#(__pd_s,'YYYY-MM-DD hh:mm:ss.ffffff'),
          Date#(__pd_s,'MMM D YYYY'), Date#(__pd_s,'D MMM YYYY'), Date#(__pd_s,'MMMM D, YYYY'),
          Timestamp#(__pd_s,'M/D/YYYY h:mm:ss'), Timestamp#(__pd_s,'M/D/YYYY h:mm'),
          Date#(__pd_s,'DD-MMM-YY'), Date#(__pd_s,'DD-MMM-YYYY')) AS __pd_fb;
  LOAD
      *,
      // (3) separators: exactly 3 numeric parts of 1-4 digits
      If(__pd_p_ok=1,
         If(Len(__pd_p1)=4,
            Date#(Num(Num#(__pd_p2),'00')&'/'&Num(Num#(__pd_p3),'00')&'/'&__pd_p1,'MM/DD/YYYY'),
         If(Len(__pd_p3)=4,
            If(Num#(__pd_p1)>12 and Num#(__pd_p2)<=12 and Len(Date#(Num(Num#(__pd_p2),'00')&'/'&Num(Num#(__pd_p1),'00')&'/'&__pd_p3,'MM/DD/YYYY'))>0,
               Date#(Num(Num#(__pd_p2),'00')&'/'&Num(Num#(__pd_p1),'00')&'/'&__pd_p3,'MM/DD/YYYY'),
            If(Num#(__pd_p2)>12 and Num#(__pd_p1)<=12 and Len(Date#(Num(Num#(__pd_p1),'00')&'/'&Num(Num#(__pd_p2),'00')&'/'&__pd_p3,'MM/DD/YYYY'))>0,
               Date#(Num(Num#(__pd_p1),'00')&'/'&Num(Num#(__pd_p2),'00')&'/'&__pd_p3,'MM/DD/YYYY'),
               Alt(Date#(Num(Num#(__pd_p1),'00')&'/'&Num(Num#(__pd_p2),'00')&'/'&__pd_p3,'MM/DD/YYYY'),
                   Date#(Num(Num#(__pd_p2),'00')&'/'&Num(Num#(__pd_p1),'00')&'/'&__pd_p3,'MM/DD/YYYY')))),
         If(Len(__pd_p3)=2,
            If(Num#(__pd_p1)>12 and Num#(__pd_p2)<=12 and Len(Date#(Num(Num#(__pd_p2),'00')&'/'&Num(Num#(__pd_p1),'00')&'/'&Text(If(Num#(__pd_p3)<=79,2000,1900)+Num#(__pd_p3)),'MM/DD/YYYY'))>0,
               Date#(Num(Num#(__pd_p2),'00')&'/'&Num(Num#(__pd_p1),'00')&'/'&Text(If(Num#(__pd_p3)<=79,2000,1900)+Num#(__pd_p3)),'MM/DD/YYYY'),
            If(Num#(__pd_p2)>12 and Num#(__pd_p1)<=12 and Len(Date#(Num(Num#(__pd_p1),'00')&'/'&Num(Num#(__pd_p2),'00')&'/'&Text(If(Num#(__pd_p3)<=79,2000,1900)+Num#(__pd_p3)),'MM/DD/YYYY'))>0,
               Date#(Num(Num#(__pd_p1),'00')&'/'&Num(Num#(__pd_p2),'00')&'/'&Text(If(Num#(__pd_p3)<=79,2000,1900)+Num#(__pd_p3)),'MM/DD/YYYY'),
               Alt(Date#(Num(Num#(__pd_p1),'00')&'/'&Num(Num#(__pd_p2),'00')&'/'&Text(If(Num#(__pd_p3)<=79,2000,1900)+Num#(__pd_p3)),'MM/DD/YYYY'),
                   Date#(Num(Num#(__pd_p2),'00')&'/'&Num(Num#(__pd_p1),'00')&'/'&Text(If(Num#(__pd_p3)<=79,2000,1900)+Num#(__pd_p3)),'MM/DD/YYYY')))))))) AS __pd_sep;
  LOAD
      *,
      If(SubStringCount(__pd_sx,'/')=2
         and Len(__pd_p1)>0 and Len(__pd_p1)<=4 and Len(KeepChar(__pd_p1,'0123456789'))=Len(__pd_p1)
         and Len(__pd_p2)>0 and Len(__pd_p2)<=4 and Len(KeepChar(__pd_p2,'0123456789'))=Len(__pd_p2)
         and Len(__pd_p3)>0 and Len(__pd_p3)<=4 and Len(KeepChar(__pd_p3,'0123456789'))=Len(__pd_p3), 1, 0) AS __pd_p_ok;
  LOAD
      *,
      SubField(__pd_sx,'/',1) AS __pd_p1,
      SubField(__pd_sx,'/',2) AS __pd_p2,
      SubField(__pd_sx,'/',3) AS __pd_p3;
  LOAD
      *,
      Replace(Replace(__pd_s,'-','/'),'.','/') AS __pd_sx,
      // (2) compact
      If(Len(__pd_dg)=8,
         If(Match(Left(__pd_dg,2),'19','20')>0 and Len(Date#(__pd_dg,'YYYYMMDD'))>0, Date#(__pd_dg,'YYYYMMDD'),
         If(Num#(Left(__pd_dg,2))>12 and Num#(Mid(__pd_dg,3,2))<=12 and Len(Date#(Mid(__pd_dg,3,2)&'/'&Left(__pd_dg,2)&'/'&Right(__pd_dg,4),'MM/DD/YYYY'))>0,
            Date#(Mid(__pd_dg,3,2)&'/'&Left(__pd_dg,2)&'/'&Right(__pd_dg,4),'MM/DD/YYYY'),
         If(Num#(Mid(__pd_dg,3,2))>12 and Num#(Left(__pd_dg,2))<=12 and Len(Date#(Left(__pd_dg,2)&'/'&Mid(__pd_dg,3,2)&'/'&Right(__pd_dg,4),'MM/DD/YYYY'))>0,
            Date#(Left(__pd_dg,2)&'/'&Mid(__pd_dg,3,2)&'/'&Right(__pd_dg,4),'MM/DD/YYYY'),
            Alt(Date#(Left(__pd_dg,2)&'/'&Mid(__pd_dg,3,2)&'/'&Right(__pd_dg,4),'MM/DD/YYYY'),
                Date#(Mid(__pd_dg,3,2)&'/'&Left(__pd_dg,2)&'/'&Right(__pd_dg,4),'MM/DD/YYYY')))))) AS __pd_c8,
      If(Len(__pd_dg)=6,
         If(Num#(Left(__pd_dg,2))>12 and Num#(Mid(__pd_dg,3,2))<=12 and Len(Date#(Mid(__pd_dg,3,2)&'/'&Left(__pd_dg,2)&'/'&Text(If(Num#(Right(__pd_dg,2))<=79,2000,1900)+Num#(Right(__pd_dg,2))),'MM/DD/YYYY'))>0,
            Date#(Mid(__pd_dg,3,2)&'/'&Left(__pd_dg,2)&'/'&Text(If(Num#(Right(__pd_dg,2))<=79,2000,1900)+Num#(Right(__pd_dg,2))),'MM/DD/YYYY'),
         If(Num#(Mid(__pd_dg,3,2))>12 and Num#(Left(__pd_dg,2))<=12 and Len(Date#(Left(__pd_dg,2)&'/'&Mid(__pd_dg,3,2)&'/'&Text(If(Num#(Right(__pd_dg,2))<=79,2000,1900)+Num#(Right(__pd_dg,2))),'MM/DD/YYYY'))>0,
            Date#(Left(__pd_dg,2)&'/'&Mid(__pd_dg,3,2)&'/'&Text(If(Num#(Right(__pd_dg,2))<=79,2000,1900)+Num#(Right(__pd_dg,2))),'MM/DD/YYYY'),
            Alt(Date#(Left(__pd_dg,2)&'/'&Mid(__pd_dg,3,2)&'/'&Text(If(Num#(Right(__pd_dg,2))<=79,2000,1900)+Num#(Right(__pd_dg,2))),'MM/DD/YYYY'),
                Date#(Mid(__pd_dg,3,2)&'/'&Left(__pd_dg,2)&'/'&Text(If(Num#(Right(__pd_dg,2))<=79,2000,1900)+Num#(Right(__pd_dg,2))),'MM/DD/YYYY'),
                Date#(Mid(__pd_dg,3,2)&'/'&Right(__pd_dg,2)&'/'&Text(If(Num#(Left(__pd_dg,2))<=79,2000,1900)+Num#(Left(__pd_dg,2))),'MM/DD/YYYY'))))) AS __pd_c6;
  LOAD
      *,
      KeepChar(__pd_s,'0123456789') AS __pd_dg,
      // (1) excel serial: pure integer (optional sign, optional .0+ suffix), >0, <=2958465
      If(Len(__pd_core)>0
         and Len(KeepChar(__pd_core,'0123456789'))=Len(__pd_core)
         and Num#(__pd_sgn & __pd_core) > 0
         and Num#(__pd_sgn & __pd_core) <= 2958465,
         Num#(__pd_sgn & __pd_core)) AS __pd_serial;
  LOAD
      *,
      // splits the sign and removes the .0+ suffix if present (regex [+-]?\d+(\.0+)?)
      If(Left(__pd_s,1)='-','-','') AS __pd_sgn,
      If(SubStringCount(__pd_sr,'.')=1
         and Len(SubField(__pd_sr,'.',2))>0 and Len(PurgeChar(SubField(__pd_sr,'.',2),'0'))=0
         and Len(KeepChar(SubField(__pd_sr,'.',1),'0123456789'))=Len(SubField(__pd_sr,'.',1)),
         SubField(__pd_sr,'.',1),
         If(SubStringCount(__pd_sr,'.')=0, __pd_sr, '§NOTINT§')) AS __pd_core;
  LOAD
      *,
      If(Match(Left(__pd_s,1),'+','-')>0, Mid(__pd_s,2), __pd_s) AS __pd_sr;
  LOAD
      *,
      If(Len(Trim(__pd_s0))=0 or Match(Lower(Trim(__pd_s0)),'nan','nat','none','null')>0, 1, 0) AS __pd_nan,
      // Python cleanup: nbsp->' ', zwsp/ufffd removed, outer quotes stripped, \ -> /, \s+ -> ' '
      Trim(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(PurgeChar(Replace(__pd_s0, Chr(160),' '), Chr(8203)&Chr(65533)), '\','/'), Chr(9),' '), Chr(10),' '), Chr(13),' '), '  ',' '), '  ',' '), '  ',' '), '  ',' ')) AS __pd_s;
  LOAD
      *,
      // valid serial only: IsNum accepts numeric text, and '20261028' would become year 57000
      If(IsNum([$(pIn)]) and Len(Text([$(pIn)]))>0 and Num([$(pIn)])>0 and Num([$(pIn)])<=2958465, 1, 0) AS __pd_isnum,
      If(IsNum([$(pIn)]), Num([$(pIn)])) AS __pd_rawnum,
      // strip outer quotes as in Python: s.strip().strip('"').strip("'")
      Trim(PurgeChar(Trim(Text([$(pIn)])), '"' & Chr(39))) AS __pd_s0
  RESIDENT [$(pTable)];
  DROP TABLE [$(pTable)];
  RENAME TABLE [__pd_tmp] TO [$(pTable)];
  DROP FIELDS __pd_isnum, __pd_rawnum, __pd_s0, __pd_nan, __pd_s, __pd_sr, __pd_sgn, __pd_core,
              __pd_serial, __pd_dg, __pd_c8, __pd_c6, __pd_sx, __pd_p1, __pd_p2, __pd_p3, __pd_p_ok,
              __pd_sep, __pd_fb FROM [$(pTable)];
END SUB

// ---------------------------------------------------------------------------
// SUB ParseCostColumn: mirrors parse_cost_original_to_float (L814-880).
//   1,234.56 | 1.234,56 | (123.45) | signs | symbols | quirks:
//   '1,234'(frac=3,int<=3) -> 1.234 ; >1 comma -> thousands ; >1 dot -> last one is decimal.
// Creates numeric pOut (null if not convertible) in pTable from pIn.
// ---------------------------------------------------------------------------
SUB ParseCostColumn(pTable, pIn, pOut)
  [__pc_tmp]:
  NoConcatenate
  LOAD
      *,
      If(__pc_bad=1, Null(), If(__pc_neg=1, -Fabs(__pc_v), __pc_v)) AS [$(pOut)];
  LOAD
      *,
      If(Len(__pc_s4)=0 or not IsNum(Num#(__pc_s4,'0.##########','.',',')), 1, 0) AS __pc_bad,
      Num#(__pc_s4,'0.##########','.',',') AS __pc_v;
  LOAD
      *,
      // decimal disambiguation (same order as Python)
      If(Index(__pc_s3,'.')>0 and Index(__pc_s3,',')>0,
         If(Index(__pc_s3,'.',-1) > Index(__pc_s3,',',-1), Replace(__pc_s3,',',''),
            Replace(Replace(__pc_s3,'.',''),',','.')),
        If(Index(__pc_s3,',')>0 and Index(__pc_s3,'.')=0,
         If(SubStringCount(__pc_s3,',')>1, Replace(__pc_s3,',',''),
            If(Len(SubField(__pc_s3,',',2))>=1 and Len(SubField(__pc_s3,',',2))<=2, Replace(__pc_s3,',','.'),
            If(Len(SubField(__pc_s3,',',2))=3,
               If(Len(SubField(__pc_s3,',',1))<=3, Replace(__pc_s3,',','.'), Replace(__pc_s3,',','')),
               Replace(__pc_s3,',','')))),
        If(Index(__pc_s3,'.')>0 and Index(__pc_s3,',')=0 and SubStringCount(__pc_s3,'.')>1,
         Replace(Left(__pc_s3, Index(__pc_s3,'.',-1)-1),'.','') & '.' & Mid(__pc_s3, Index(__pc_s3,'.',-1)+1),
         __pc_s3))) AS __pc_s4;
  LOAD
      *,
      Replace(Replace(__pc_s2c,'+',''),'-','') AS __pc_s3,
      If(__pc_neg0=1 or Left(__pc_s2c,1)='-', 1, 0) AS __pc_neg;
  LOAD
      *,
      If(Left(__pc_s2b,1)='+', Mid(__pc_s2b,2), __pc_s2b) AS __pc_s2c;
  LOAD
      *,
      If((Index(__pc_s2a,'(')>0) = (Index(__pc_s2a,')')>0), Trim(Replace(Replace(__pc_s2a,'(',''),')','')), '') AS __pc_s2b,
      If(Index(__pc_s2a,'(')>0 and Index(__pc_s2a,')')>0, 1, 0) AS __pc_neg0;
  LOAD
      *,
      KeepChar(__pc_s1, '0123456789.,-+()') AS __pc_s2a;
  LOAD
      *,
      If(Len(Trim(Text([$(pIn)])))=0 or Lower(Trim(Text([$(pIn)])))='nan', '',
         Replace(Trim(Text([$(pIn)])), Chr(160), ' ')) AS __pc_s1
  RESIDENT [$(pTable)];
  DROP TABLE [$(pTable)];
  RENAME TABLE [__pc_tmp] TO [$(pTable)];
  DROP FIELDS __pc_s1, __pc_s2a, __pc_s2b, __pc_s2c, __pc_neg0, __pc_s3, __pc_neg, __pc_s4, __pc_bad, __pc_v FROM [$(pTable)];
END SUB

// parse_split_to_0_1 (L779-811): 0.25 | 25% | 25 | 0,25 | '25 %'
// %, or value >1 => /100 ; outside [0,1] => null
SET fParseSplit = If(Len(Trim(Text($1)))=0 or Lower(Trim(Text($1)))='nan', Null(),
  If(not IsNum(Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')), Null(),
  If( (If(Index(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%')>0, 1, 0)=1
       or Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')>1),
      If(Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')/100 < 0
         or Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')/100 > 1, Null(),
         Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')/100),
      If(Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')<0
         or Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')>1, Null(),
         Num#(KeepChar(Replace(Replace(PurgeChar(Replace(Text($1),Chr(160),' '),' '&Chr(9)&Chr(10)&Chr(13)),'%',''),',','.'),'0123456789.-'),'0.##########','.',',')))));

// GLCS — _normalise_numeric_account_for_lookup (L2809-2830):
// strips apostrophe/quotes/.0 artifact ; if it has a LETTER -> '' ; else digits only
SET fAcctClean = If(Len(Trim(Text($1)))=0 or Match(Lower(Trim(Text($1))),'nan','none','null','nat')>0, '',
                    Trim(PurgeChar(Trim(Replace(Replace(Replace(Text($1),Chr(160),' '),Chr(8203),''),Chr(65279),'')), '"'&Chr(39))));
// SUB NormAcctColumns: creates pOutBase (digits; '' if it has a letter) and pOutNoZ
// (no leading zeros; '0' if all zeros — Python's lstrip('0') or '0') in pTable.
// Mirrors _normalise_numeric_account_for_lookup + _numeric_account_lookup_variants
// (L2809-2841): the '\d+\.0+' artifact loses the suffix; other non-digits are removed
// (e.g. '12345.50' -> '1234550', faithful to Python's re.sub(r'\D','')).
SUB NormAcctColumns(pTable, pIn, pOutBase, pOutNoZ)
  [__na_tmp]:
  NoConcatenate
  LOAD
      *,
      If(Len(__na_base)=0, '',
         If(FindOneOf(__na_base,'123456789')=0, '0', Mid(__na_base, FindOneOf(__na_base,'123456789')))) AS [$(pOutNoZ)];
  LOAD
      *,
      If(Len(__na_c)=0 or Len(KeepChar(Upper(__na_c),'ABCDEFGHIJKLMNOPQRSTUVWXYZ'))>0, '',
         KeepChar(
           If(SubStringCount(__na_c,'.')=1
              and Len(SubField(__na_c,'.',1))>0
              and Len(KeepChar(SubField(__na_c,'.',1),'0123456789'))=Len(SubField(__na_c,'.',1))
              and Len(SubField(__na_c,'.',2))>0
              and Len(PurgeChar(SubField(__na_c,'.',2),'0'))=0,
              SubField(__na_c,'.',1), __na_c),
           '0123456789')) AS __na_base;
  LOAD
      *,
      If(Len(Trim(Text([$(pIn)])))=0 or Match(Lower(Trim(Text([$(pIn)]))),'nan','none','null','nat')>0, '',
         Trim(PurgeChar(Trim(Replace(Replace(Replace(Text([$(pIn)]),Chr(160),' '),Chr(8203),''),Chr(65279),'')), '"'&Chr(39)))) AS __na_c
  RESIDENT [$(pTable)];
  DROP TABLE [$(pTable)];
  RENAME TABLE [__na_tmp] TO [$(pTable)];
  RENAME FIELD __na_base TO [$(pOutBase)];
  DROP FIELDS __na_c FROM [$(pTable)];
END SUB

// token_to_date (L372-404): 8 digits '20'->YYYYMMDD ; 8 digits '26'->drop 26 then YYMMDD ; 6 digits->20YY MMDD
SET fTokenToDate = If(Len(KeepChar(Text($1),'0123456789'))=8 and Left(KeepChar(Text($1),'0123456789'),2)='20',
                      Date#(KeepChar(Text($1),'0123456789'),'YYYYMMDD'),
                   If(Len(KeepChar(Text($1),'0123456789'))=8 and Left(KeepChar(Text($1),'0123456789'),2)='26',
                      Date#('20' & Mid(KeepChar(Text($1),'0123456789'),3),'YYYYMMDD'),
                   If(Len(KeepChar(Text($1),'0123456789'))=6,
                      Date#('20' & KeepChar(Text($1),'0123456789'),'YYYYMMDD'), Null())));

// --- XML -------------------------------------------------------------------
// The textual extraction of the TradeFeeds (keeping the DOCUMENT ORDER, which
// XmlSimple loses) is implemented in section 03 through occurrence tables
// (While/IterNo), without nested variable functions. Mirrored rules:
//   find_first_text_by_local_name (L335-353)  -> 1st NON-EMPTY occurrence in the tree
//   _dfs_find_first_cost_excluding_branches   -> 1st non-empty <Cost> OUTSIDE TransactionCosts
//   extract_transaction_cost_items (L928-988) -> Code 'R' BEFORE the 1st non-empty Cost = AddOn
//   parse_tradefeed_to_row (L1087-1132)       -> Common fields: LAST occurrence wins
//                                                (even if empty); Salesperson: 1st non-empty alias.
///$tab 02 — XML Discovery & Payout Date
// [FIX-02] XML FILE SELECTION
//   WAS (analyst L320, L339): FILELIST('...ftp/f392fd1.ext.$(vT_Year_YY)01*.4') and
//        RIGHT(File_Date, 2) <= '30': fixed prefix, fixed version .4, January only.
//   PROBLEM: a file sent again with a higher version (.5, .10) or with another
//        prefix was never read; the payout date came from that reduced list.
//   NOW (Castine.py discover_files L1957, select_latest_xml_versions L1934,
//        determine_output_yyyymmdd_from_files L414): *.ext.26*, only the highest
//        version of each file, optional vDateLimitToken; payout date = latest file date.
// ============================================================================
// 02 — XML DISCOVERY + PAYOUT DATE
// Mirrors: discover_files (L1916-1936), extract_file_date_token (L356-369),
//          token_to_date (L372-404), previous_business_day (L407-411),
//          determine_output_yyyymmdd_from_files (L414-432).
// ============================================================================

// SUB ExtractFileToken: mirrors extract_file_date_token (L356-369).
//   regex1: \.(\d{6,8})\.\d+$ -> second-to-last '.' segment if it has 6-8 digits
//                               and the last one (version) is digits only
//   regex2: \b(\d{6,8})\b    -> first RUN of digits with length 6-8
// Result in vToken ('' if none).
SUB ExtractFileToken(pName)
  LET vToken = '';
  LET _nParts = SubStringCount('$(pName)', '.') + 1;
  LET _last = SubField('$(pName)', '.', -1);
  IF Len('$(_last)') > 0 and Len(KeepChar('$(_last)', '0123456789')) = Len('$(_last)') and $(_nParts) >= 3 THEN
    LET _cand = SubField('$(pName)', '.', $(_nParts) - 1);
    IF Len('$(_cand)') >= 6 and Len('$(_cand)') <= 8 and Len(KeepChar('$(_cand)', '0123456789')) = Len('$(_cand)') THEN
      LET vToken = '$(_cand)';
    END IF
  END IF
  IF Len('$(vToken)') = 0 THEN
    LET _run = '';
    FOR _i = 1 to Len('$(pName)') + 1
      LET _ch = Mid('$(pName)', $(_i), 1);
      IF Len('$(_ch)') > 0 and Index('0123456789', '$(_ch)') > 0 THEN
        LET _run = '$(_run)$(_ch)';
      ELSE
        IF Len('$(_run)') >= 6 and Len('$(_run)') <= 8 THEN
          LET vToken = '$(_run)';
          EXIT FOR
        END IF
        LET _run = '';
      END IF
    NEXT _i
  END IF
  LET _nParts =;
  LET _cand =;
  LET _run =;
  LET _i =;
  LET _ch =;
  LET _last =;
END SUB

// --- file list (glob + highest version per file + date_limit_token filter) ---
// Mirrors split_xml_version / select_latest_xml_versions:
//   version = last segment, digits only; name needs >= 4 parts
//   (prefix.ext.date.version). Key = path without the version, lowercased.
// sentinel -1 = "no date" (avoids an empty $() expansion inside expressions)
LET vLimitDateNum = Alt(If(Len('$(vDateLimitToken)')>0, Num($(fTokenToDate(vDateLimitToken)))), -1);

FOR Each _vF in FileList('$(vLibXML)$(vXmlPattern)')
  // A file name with an apostrophe would break every '$(_vF)' below.
  // It is tested by variable NAME (no expansion) and the file is ignored.
  IF Index(_vF, Chr(39)) = 0 THEN
    LET _vBase = SubField(SubField('$(_vF)','\',-1),'/',-1);
    LET _vVer = SubField('$(_vBase)', '.', -1);
    // A Qlik control IF cannot span lines: keep the condition on one line
    IF SubStringCount('$(_vBase)', '.') >= 3 and Len('$(_vVer)') > 0 and Len(KeepChar('$(_vVer)', '0123456789')) = Len('$(_vVer)') THEN
      LET _vKey = Lower(Left('$(_vF)', Len('$(_vF)') - Len('$(_vVer)') - 1));
      CALL ExtractFileToken('$(_vBase)');                       // -> vToken
      LET _vTokDate = Alt(Num($(fTokenToDate(vToken))), -1);
      // L1924-1934: with a limit, keep tok_dt NULL or tok_dt <= limit (faithful!)
      // (the version does not change the date, so filtering before or after versioning is the same)
      IF $(vLimitDateNum) = -1 or $(_vTokDate) = -1 or $(_vTokDate) <= $(vLimitDateNum) THEN
        IF Alt(TableNumber('XML_FILES'), -1) < 0 THEN
          [XML_FILES]:
          NoConcatenate
          LOAD
              '$(_vF)' as file_path,
              '$(_vBase)' as file_name,
              '$(vToken)' as file_date_token,
              If($(_vTokDate) <> -1, $(_vTokDate), Null()) as token_date_num,
              '$(_vKey)' as __file_key,
              Num#('$(_vVer)') as __file_version
          AUTOGENERATE 1;
        ELSE
          Concatenate(XML_FILES)
          LOAD
              '$(_vF)' as file_path,
              '$(_vBase)' as file_name,
              '$(vToken)' as file_date_token,
              If($(_vTokDate) <> -1, $(_vTokDate), Null()) as token_date_num,
              '$(_vKey)' as __file_key,
              Num#('$(_vVer)') as __file_version
          AUTOGENERATE 1;
        END IF
      END IF
    ELSE
      TRACE [CASTINE][WARN] Ignoring XML without numeric version suffix: $(_vBase);
    END IF
  ELSE
    TRACE [CASTINE][WARN] File ignored, apostrophe in its name: $(_vF);
  END IF
NEXT _vF
LET _vVer =;
LET _vKey =;

LET vNumXmlFiles = If(Alt(TableNumber('XML_FILES'),-1) < 0, 0, NoOfRows('XML_FILES'));
IF $(vNumXmlFiles) > 0 THEN
  // highest version per file: sort by key + version DESC and keep the 1st row of each key
  [_XML_FILES_LATEST]:
  NoConcatenate
  LOAD
      file_path,
      file_name,
      file_date_token,
      token_date_num,
      __file_version
  RESIDENT XML_FILES
  WHERE IsNull(Previous(__file_key)) or __file_key <> Previous(__file_key)
  ORDER BY __file_key ASC, __file_version DESC, file_path DESC;
  DROP TABLE XML_FILES;
  // Python: sorted(matches) — sorts by full path (L1936)
  [XML_FILES]:
  NoConcatenate
  LOAD
      file_path,
      file_name,
      file_date_token,
      token_date_num
  RESIDENT _XML_FILES_LATEST
  ORDER BY file_path ASC;
  // FOR ... NEXT, never DO WHILE $(var): Qlik expands a $() in a DO WHILE
  // condition only once, so the condition never changes and the loop never ends.
  FOR _i = 0 to NoOfRows('_XML_FILES_LATEST') - 1
    LET _vSelName = Peek('file_name', $(_i), '_XML_FILES_LATEST');
    LET _vSelVer  = Peek('__file_version', $(_i), '_XML_FILES_LATEST');
    TRACE [CASTINE] XML selected (latest version $(_vSelVer)): $(_vSelName);
  NEXT _i
  DROP TABLE _XML_FILES_LATEST;
  LET _i =;
  LET _vSelName =;
  LET _vSelVer =;
  LET vNumXmlFiles = NoOfRows('XML_FILES');
END IF
TRACE [CASTINE] XML files discovered: $(vNumXmlFiles);
IF $(vNumXmlFiles) = 0 THEN
  TRACE [CASTINE][EXIT] No Bloomberg XML files found. (main L3413-3415);
  // Does not report success: aborts with an explicit error
  CALL AbortNoFiles_UndefinedSub_ForcesScriptError;
END IF

// determine_output_yyyymmdd_from_files (L414-432): date = MAX token_date;
// fallback = business day before today (no holidays — faithful to Python L407-411)
[_TMPMAX]:
NoConcatenate
LOAD
    Max(token_date_num) as _maxd
RESIDENT XML_FILES;
LET vPayoutDateNum = Peek('_maxd', 0, '_TMPMAX');
DROP TABLE _TMPMAX;
IF Len('$(vPayoutDateNum)') = 0 THEN
  // previous_business_day (L407-411) without a loop. Mod(d + 5, 7) is the Python
  // weekday() of a Qlik date serial d (Mon=0 .. Sun=6): Saturday goes back 1 day,
  // Sunday goes back 2 days.
  LET vPayoutDateNum = Num(Today()) - 1;
  LET vPayoutDateNum = $(vPayoutDateNum) - If(Mod($(vPayoutDateNum) + 5, 7) = 5, 1, If(Mod($(vPayoutDateNum) + 5, 7) = 6, 2, 0));
  TRACE [CASTINE][WARN] Token-based date unavailable. Using previous business day.;
END IF
LET vPayoutYYYYMMDD = Date($(vPayoutDateNum), 'YYYYMMDD');
LET vPayoutDateDDMMYYYY = Date($(vPayoutDateNum), 'DDMMYYYY');
TRACE [CASTINE] Payout date: $(vPayoutYYYYMMDD);
///$tab 03_Load_BBGXML_TradeData
// ============================================================================
// 03 — BLOOMBERG XML READ WITH XmlSimple (analyst approach)
// Produces _RAW: one row per TradeFeed with the Castine.py PARSED_SCHEMA fields,
// in file order (source_file asc, feed_no asc), which is what tabs 04+ expect.
// Mirrors parse_tradefeed_to_row (L1087-1132), extract_transaction_cost_items
// (L928-988), find_primary_cost_tradefeed (L1010-1034), find_add_on_tradefeed (L1037-1050).
//
// [FIX-03] READ-TIME FILTERS REMOVED
//   WAS (analyst L415-422): WHERE MasterAccountName <> 'TEST' AND no 'X' in
//        TransactionType AND SalespersonName filled AND Exists in split matrix
//        AND (AsOf year = current OR (prior year AND trader in Sales_Mapping.xlsx)).
//   PROBLEM: Castine.py reads every TradeFeed and applies its rules later, in
//        another order. Filtering cancels first keeps the previous version of a
//        cancelled trade; TEST is tested on the final Client (MasterAccountName or,
//        when empty, AccountCounterpartyShortName); the year rule does not exist
//        in Castine.py.
//   NOW (parse_tradefeed_to_row L1087): no filter here. Cancels: tab 04. Empty
//        Salesperson / unmapped RR Team: tab 06. TEST and 235: tab 10.
// [FIX-06] GROSS COMMS
//   WAS (analyst L431-447, L470-515): Gross = SUM(Cost) of every TransactionCost
//        with Currency = 'USD', split by Type = 'R' / <> 'R'; LOAD DISTINCT merged
//        identical cost lines; a Cost outside TransactionCosts was ignored.
//   PROBLEM: Castine.py takes ONE primary cost and adds only the AddOn items.
//   NOW (find_primary_cost_tradefeed L1010, find_add_on_tradefeed L1037):
//        Cost = 1st non-empty <Cost> outside TransactionCosts, else the 1st
//        non-AddOn TransactionCost; AddOn = sum of the TransactionCosts whose
//        <Code> is 'R' BEFORE their <Cost>. No currency filter on cost lines.
//  - Fields are read as text (Text()) so '007' stays '007' as in the Python.
//
// HOW THE FILE IS READ (rev 3)
//  - LOAD * is not allowed for XML files ("Load all (*) is not allowed in this
//    file type"), so XmlSimple is read with an EXPLICIT field list, with the
//    names the analyst script uses ("Common/<tag>", L371-411).
//  - A field that no trade of the file has cannot be listed (it is not in the
//    XmlSimple table of that file): the list is built per file, from the tags
//    found in the file text.
//  - What depends on the ORDER of the nodes cannot come from XmlSimple and is
//    taken from the file text, one TradeFeed at a time: TransactionCost items
//    (Code R before Cost), Cost outside TransactionCosts, the 1st non-empty
//    MasterAccountName of the tree, ExtendedFields (Sec Type).
//  - Both readers are compared on every file: same number of TradeFeeds and same
//    TransactionNumber row by row. When they do not agree, or XmlSimple fails,
//    the fields of that file come from the file text and a WARN is written.
// ============================================================================

// read_csv of the Python temp file turns these texts into empty (main L3454).
// (VAZIO) is a sentinel because INLINE does not load an empty string.
[MapPandasNA]:
Mapping
LOAD *
INLINE [
__k|__v
#N/A|(VAZIO)
#N/A N/A|(VAZIO)
#NA|(VAZIO)
-1.#IND|(VAZIO)
-1.#QNAN|(VAZIO)
-NaN|(VAZIO)
-nan|(VAZIO)
1.#IND|(VAZIO)
1.#QNAN|(VAZIO)
<NA>|(VAZIO)
N/A|(VAZIO)
NA|(VAZIO)
NULL|(VAZIO)
NaN|(VAZIO)
None|(VAZIO)
n/a|(VAZIO)
nan|(VAZIO)
null|(VAZIO)
] (delimiter is '|');
SET fNA = Replace(ApplyMap('MapPandasNA', $1 & '', $1 & ''), '(VAZIO)', '');

// The Python XML parser decodes entities; the text reader has to do it too.
SET fXmlDec = Replace(Replace(Replace(Replace(Replace($1 & '', '&lt;','<'), '&gt;','>'), '&quot;','"'), '&apos;',Chr(39)), '&amp;','&');
SET fXmlVal = Replace(ApplyMap('MapPandasNA', $(fXmlDec($1)), $(fXmlDec($1))), '(VAZIO)', '');

// TradeFeed tags of the file text, from the XmlSimple path (BatchFeed/TradeFeed -> <TradeFeed>)
LET vXmlFeedOpen    = '<' & SubField('$(vXmlTradeFeedPath)', '/', -1) & '>';
LET vXmlFeedClose   = '</' & SubField('$(vXmlTradeFeedPath)', '/', -1) & '>';
LET vXmlFeedOpenLen = Len('$(vXmlFeedOpen)');
LET vXmlFeedName    = Mid('$(vXmlFeedOpen)', 2, Len('$(vXmlFeedOpen)') - 2);   // TradeFeed

// Castine.py COMMON_FIELDS_NEEDED (L1053-1073) + SalespersonName + MasterAccountName:
// the fields read from the XmlSimple table, as "Common/<tag>" (analyst L371-411).
LET vCommonFieldList = Chr(39) & Replace('TransactionNumber;OriginalTktId;SecurityIdentifier;SecurityCurrencyISOCode;Ticker;MaturityDateExpirationDate;BuySellCoverShortFlag;TradeDate;AsOfTradeDate;Price;TradeAmount;CustomerAccountCounterparty;AccountCounterpartyShortName;TraderAccountName;TraderAccountNumber;TransactionType;OMReasonCode;SalespersonName;MasterAccountName', ';', Chr(39) & ',' & Chr(39)) & Chr(39);

// vXs_<tag>: expression that reads the tag from XmlSimple. Set per file to
// Trim(Text([Common/<tag>])) when the tag exists in that file, else Null().
SET vXs_TransactionNumber = Null();
SET vXs_OriginalTktId = Null();
SET vXs_SecurityIdentifier = Null();
SET vXs_SecurityCurrencyISOCode = Null();
SET vXs_Ticker = Null();
SET vXs_MaturityDateExpirationDate = Null();
SET vXs_BuySellCoverShortFlag = Null();
SET vXs_TradeDate = Null();
SET vXs_AsOfTradeDate = Null();
SET vXs_Price = Null();
SET vXs_TradeAmount = Null();
SET vXs_CustomerAccountCounterparty = Null();
SET vXs_AccountCounterpartyShortName = Null();
SET vXs_TraderAccountName = Null();
SET vXs_TraderAccountNumber = Null();
SET vXs_TransactionType = Null();
SET vXs_OMReasonCode = Null();
SET vXs_SalespersonName = Null();
SET vXs_MasterAccountName = Null();

// SUB DropIfExists: DROP TABLE only when the table exists (a load that returns
// no row may leave no table behind).
SUB DropIfExists(pT)
  IF Alt(TableNumber('$(pT)'), -1) >= 0 THEN
    DROP TABLE [$(pT)];
  END IF
END SUB

// TransactionCost items of every file. The seed row keeps the table and its
// fields alive when no file has a TransactionCost.
[_TXC]:
NoConcatenate
LOAD
    '__SEED__' as source_file,
    0 as feed_no,
    0 as txc_no,
    '' as txc_cost_text,
    0 as txc_is_addon,
    '' as txc_currency
AUTOGENERATE 1;

SET vFeedAttrTags = 0;
SET vXmlFilesNoFeed = 0;
SET vXmlFilesXs = 0;
SET vXmlFilesTextOnly = 0;
SET vXmlCellDiff = 0;

// One file at a time: read, split in TradeFeeds, extract, append, drop the text.
FOR _i = 0 to NoOfRows('XML_FILES') - 1
  LET _vF   = Peek('file_path', $(_i), 'XML_FILES');
  LET _vB   = Peek('file_name', $(_i), 'XML_FILES');
  LET _vTok = Peek('file_date_token', $(_i), 'XML_FILES');

  // --- (1) the file as text lines. UTF-8 first; a file that is not valid UTF-8
  //     shows U+FFFD after decoding and is read again as cp1252.
  //     Fixed-record read with an explicit field (@1:n = the whole line):
  //     LOAD * is not allowed for fix and xml files.
  [_XL1]:
  NoConcatenate
  LOAD
      RecNo() as line_no,
      @1:n as Line
  FROM [$(_vF)]
  (fix, utf8, no labels, record is line);
  [_XLB]:
  NoConcatenate
  LOAD
      Sum(If(Index(Line, Chr(65533)) > 0, 1, 0)) as __bad
  RESIDENT _XL1;
  LET _vBad = Alt(Peek('__bad', 0, '_XLB'), 0);
  DROP TABLE _XLB;
  IF $(_vBad) > 0 THEN
    TRACE [CASTINE] XML not valid UTF-8, reading as cp1252: $(_vB);
    DROP TABLE _XL1;
    [_XL1]:
    NoConcatenate
    LOAD
        RecNo() as line_no,
        @1:n as Line
    FROM [$(_vF)]
    (fix, codepage is 1252, no labels, record is line);
  END IF

  // --- (2) one text per file. A TradeFeed opening tag with attributes
  //     (<TradeFeed id="1">) is rewritten as <TradeFeed><!-- id="1">, so that it
  //     matches vXmlFeedOpen; the leftover text is ignored by the field extraction.
  [_XMLBLOB]:
  NoConcatenate
  LOAD
      blob,
      __feed_attr_tags,
      SubStringCount(blob, '$(vXmlFeedClose)') as __n_close,
      SubStringCount(Lower(blob), Lower('$(vXmlFeedName)')) as __n_any;
  LOAD
      Replace(Concat(Line, Chr(10), line_no), Left('$(vXmlFeedOpen)', Len('$(vXmlFeedOpen)') - 1) & ' ', '$(vXmlFeedOpen)<!-- ') as blob,
      Sum(SubStringCount(Line, Left('$(vXmlFeedOpen)', Len('$(vXmlFeedOpen)') - 1) & ' ')) as __feed_attr_tags
  RESIDENT _XL1;
  DROP TABLE _XL1;
  LET vFeedAttrTags = $(vFeedAttrTags) + Alt(Peek('__feed_attr_tags', 0, '_XMLBLOB'), 0);
  LET _vNClose = Alt(Peek('__n_close', 0, '_XMLBLOB'), 0);
  LET _vNAny   = Alt(Peek('__n_any', 0, '_XMLBLOB'), 0);

  // --- (3) one row per TradeFeed, in file order (feed_no). SubField without a
  //     field number returns one row per piece: the text is cut at every closing
  //     tag in a single pass. The piece after the last closing tag is not a trade.
  [_SEG]:
  NoConcatenate
  LOAD
      SubField(blob, '$(vXmlFeedClose)') as __seg
  RESIDENT _XMLBLOB;
  DROP TABLE _XMLBLOB;
  LET _vSegRows = Alt(NoOfRows('_SEG'), 0);
  [_FEEDS]:
  NoConcatenate
  LOAD
      RowNo() as feed_no,
      Mid(__seg, Index(__seg, '$(vXmlFeedOpen)') + $(vXmlFeedOpenLen)) as feed_blob
  RESIDENT _SEG
  WHERE RecNo() < $(_vSegRows) and Index(__seg, '$(vXmlFeedOpen)') > 0;
  DROP TABLE _SEG;
  LET _vNText = Alt(NoOfRows('_FEEDS'), 0);

  // --- (4) integrity of the text reader. Every closing tag must give one TradeFeed,
  //     and a file that mentions the tag must give at least one. If not, the tags
  //     of the file are not the ones in vXmlFeedOpen / vXmlFeedClose (namespace
  //     prefix, other letter case) and trades would be lost without an error.
  IF $(_vNText) <> $(_vNClose) or ($(_vNText) = 0 and $(_vNAny) > 0) THEN
    TRACE [CASTINE][EXIT] $(_vB): $(_vNClose) closing tag(s), $(_vNText) TradeFeed(s) read, $(_vNAny) mention(s) of $(vXmlFeedName). The tags of this file do not match vXmlFeedOpen / vXmlFeedClose.;
    CALL AbortXmlTagsNotRecognised_UndefinedSub_ForcesScriptError;
  END IF

  IF $(_vNText) = 0 THEN
    TRACE [CASTINE] $(_vB): no $(vXmlFeedOpen) in the file - nothing to read.;
    LET vXmlFilesNoFeed = $(vXmlFilesNoFeed) + 1;
  ELSE
    // ---- TransactionCost: 1 row per item, with the order flags ----------------
    // extract_transaction_cost_items (L928-988): per item, Cost = 1st NON-EMPTY
    // occurrence; AddOn (CodeR_before_Cost) = a <Code> with value R (trim/upper)
    // comes BEFORE the 1st non-empty <Cost>, or the item has no non-empty Cost.
    Concatenate(_TXC)
    LOAD
        source_file,
        feed_no,
        txc_no,
        If(Len(_cost_occ)>0, Trim(TextBetween(txc_blob,'<Cost>','</Cost>',_cost_occ)), '') as txc_cost_text,
        If(Len(_coder_occ)>0 and (Len(_cost_occ)=0 or Index(txc_blob,'<Code>',_coder_occ) < Index(txc_blob,'<Cost>',_cost_occ)), 1, 0) as txc_is_addon,
        txc_currency;
    LOAD
        source_file,
        feed_no,
        txc_no,
        txc_blob,
        // 1st non-empty occurrence of <Cost>
        Alt(If(Len(Trim(TextBetween(txc_blob,'<Cost>','</Cost>',1)))>0, 1),
            If(Len(Trim(TextBetween(txc_blob,'<Cost>','</Cost>',2)))>0, 2),
            If(Len(Trim(TextBetween(txc_blob,'<Cost>','</Cost>',3)))>0, 3),
            If(Len(Trim(TextBetween(txc_blob,'<Cost>','</Cost>',4)))>0, 4)) as _cost_occ,
        // 1st occurrence of <Code> with value R (trim/upper)
        Alt(If(Upper(Trim(TextBetween(txc_blob,'<Code>','</Code>',1)))='R', 1),
            If(Upper(Trim(TextBetween(txc_blob,'<Code>','</Code>',2)))='R', 2),
            If(Upper(Trim(TextBetween(txc_blob,'<Code>','</Code>',3)))='R', 3),
            If(Upper(Trim(TextBetween(txc_blob,'<Code>','</Code>',4)))='R', 4)) as _coder_occ,
        Upper(Trim(TextBetween(txc_blob,'<Currency>','</Currency>',1))) & '' as txc_currency;
    LOAD
        '$(_vB)' as source_file,
        feed_no,
        IterNo() as txc_no,
        TextBetween(feed_blob, '<TransactionCost>', '</TransactionCost>', IterNo()) as txc_blob
    RESIDENT _FEEDS
    WHILE IterNo() <= SubStringCount(feed_blob, '</TransactionCost>');

    // ---- Fields of every TradeFeed from the file text (PARSED_SCHEMA, L224-250)
    // Regular Common fields: the LAST occurrence wins, EVEN IF EMPTY (L1113-1116).
    // Salesperson: 1st NON-EMPTY alias (L1107-1111), fixed preference order.
    [_P1]:
    NoConcatenate
    LOAD
        source_file,
        file_date_token,
        feed_no,
        $(fXmlVal(TransactionNumber)) as TransactionNumber,
        $(fXmlVal(OriginalTktId)) as OriginalTktId,
        $(fXmlVal(SecurityIdentifier)) as SecurityIdentifier,
        $(fXmlVal(SecurityCurrencyISOCode)) as SecurityCurrencyISOCode,
        $(fXmlVal(Ticker)) as Ticker,
        $(fXmlVal(MaturityDateExpirationDate)) as MaturityDateExpirationDate,
        $(fXmlVal(BuySellCoverShortFlag)) as BuySellCoverShortFlag,
        $(fXmlVal(TradeDate)) as TradeDate,
        $(fXmlVal(AsOfTradeDate)) as AsOfTradeDate,
        $(fXmlVal(Price)) as Price,
        $(fXmlVal(TradeAmount)) as TradeAmount,
        $(fXmlVal(CustomerAccountCounterparty)) as CustomerAccountCounterparty,
        $(fXmlVal(AccountCounterpartyShortName)) as AccountCounterpartyShortName,
        $(fXmlVal(MasterAccountName)) as MasterAccountName,
        $(fXmlVal(TraderAccountName)) as TraderAccountName,
        $(fXmlVal(TraderAccountNumber)) as TraderAccountNumber,
        $(fXmlVal(SalespersonName)) as SalespersonName,
        $(fXmlVal(TransactionType)) as TransactionType,
        $(fXmlVal(OMReasonCode)) as OMReasonCode,
        $(fXmlVal(SECURITY_TYP)) as SECURITY_TYP,
        $(fXmlVal(MARKET_SECTOR_DES)) as MARKET_SECTOR_DES,
        __cost_out,
        $(fXmlVal(__man_deep)) as __man_deep,
        _n_txcs_blocks,
        __sp_case_risk,
        __sp_multi_alias,
        __ext_mixed_attr;
    LOAD
        source_file,
        file_date_token,
        feed_no,
        TransactionNumber,
        OriginalTktId,
        SecurityIdentifier,
        SecurityCurrencyISOCode,
        Ticker,
        MaturityDateExpirationDate,
        BuySellCoverShortFlag,
        TradeDate,
        AsOfTradeDate,
        Price,
        TradeAmount,
        CustomerAccountCounterparty,
        AccountCounterpartyShortName,
        If(Len(MasterAccountName)=0, __man_deep, MasterAccountName) as MasterAccountName,  // tree fallback (L1127-1128)
        TraderAccountName,
        TraderAccountNumber,
        SalespersonName,
        TransactionType,
        OMReasonCode,
        SECURITY_TYP,
        MARKET_SECTOR_DES,
        __cost_out,  // cost outside TransactionCosts (consolidated in _RAW)
        __man_deep,
        _n_txcs_blocks,
        __sp_case_risk,
        __sp_multi_alias,
        __ext_mixed_attr;
    LOAD
        *,
        // ExtendedFields: Field name=SECURITY_TYP / MARKET_SECTOR_DES — last node wins
        // (iteration L1118-1125 overwrites). Attribute variants: name/NAME/Name, " and '.
        If(SubStringCount(__eb,'<Field name="SECURITY_TYP">')>0,
           Trim(TextBetween(__eb,'<Field name="SECURITY_TYP">','</Field>',SubStringCount(__eb,'<Field name="SECURITY_TYP">'))),
          If(SubStringCount(__eb,'<Field NAME="SECURITY_TYP">')>0,
           Trim(TextBetween(__eb,'<Field NAME="SECURITY_TYP">','</Field>',SubStringCount(__eb,'<Field NAME="SECURITY_TYP">'))),
          If(SubStringCount(__eb,'<Field Name="SECURITY_TYP">')>0,
           Trim(TextBetween(__eb,'<Field Name="SECURITY_TYP">','</Field>',SubStringCount(__eb,'<Field Name="SECURITY_TYP">'))),
          If(SubStringCount(__eb,'<Field name=' & Chr(39) & 'SECURITY_TYP' & Chr(39) & '>')>0,
           Trim(TextBetween(__eb,'<Field name=' & Chr(39) & 'SECURITY_TYP' & Chr(39) & '>','</Field>',SubStringCount(__eb,'<Field name=' & Chr(39) & 'SECURITY_TYP' & Chr(39) & '>'))),
           '')))) as SECURITY_TYP,
        If(SubStringCount(__eb,'<Field name="MARKET_SECTOR_DES">')>0,
           Trim(TextBetween(__eb,'<Field name="MARKET_SECTOR_DES">','</Field>',SubStringCount(__eb,'<Field name="MARKET_SECTOR_DES">'))),
          If(SubStringCount(__eb,'<Field NAME="MARKET_SECTOR_DES">')>0,
           Trim(TextBetween(__eb,'<Field NAME="MARKET_SECTOR_DES">','</Field>',SubStringCount(__eb,'<Field NAME="MARKET_SECTOR_DES">'))),
          If(SubStringCount(__eb,'<Field Name="MARKET_SECTOR_DES">')>0,
           Trim(TextBetween(__eb,'<Field Name="MARKET_SECTOR_DES">','</Field>',SubStringCount(__eb,'<Field Name="MARKET_SECTOR_DES">'))),
          If(SubStringCount(__eb,'<Field name=' & Chr(39) & 'MARKET_SECTOR_DES' & Chr(39) & '>')>0,
           Trim(TextBetween(__eb,'<Field name=' & Chr(39) & 'MARKET_SECTOR_DES' & Chr(39) & '>','</Field>',SubStringCount(__eb,'<Field name=' & Chr(39) & 'MARKET_SECTOR_DES' & Chr(39) & '>'))),
           '')))) as MARKET_SECTOR_DES,
        If((If(SubStringCount(__eb,'name="SECURITY_TYP"')>0,1,0) + If(SubStringCount(__eb,'NAME="SECURITY_TYP"')>0,1,0) + If(SubStringCount(__eb,'Name="SECURITY_TYP"')>0,1,0)) > 1, 1, 0) as __ext_mixed_attr,
        // Deep MasterAccountName: 1st NON-EMPTY occurrence in the whole tree (L335-353)
        If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',1)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',1)), If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',2)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',2)), If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',3)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',3)), If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',4)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',4)), If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',5)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',5)), If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',6)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',6)), If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',7)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',7)), If(Len(Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',8)))>0, Trim(TextBetween(feed_blob,'<MasterAccountName>','</MasterAccountName>',8)), '')))))))) as __man_deep,
        // cost outside TransactionCosts: 1st NON-EMPTY <Cost> in the feed without the TXC block
        If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',1)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',1)), If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',2)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',2)), If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',3)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',3)), If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',4)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',4)), If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',5)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',5)), If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',6)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',6)), If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',7)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',7)), If(Len(Trim(TextBetween(__wo,'<Cost>','</Cost>',8)))>0, Trim(TextBetween(__wo,'<Cost>','</Cost>',8)), '')))))))) as __cost_out;
    LOAD
        *,
        // Salesperson: 1st non-empty alias (up to 3 occurrences per alias)
        If(Len(Trim(TextBetween(__cb,'<SalespersonName>','</SalespersonName>',1)))>0, Trim(TextBetween(__cb,'<SalespersonName>','</SalespersonName>',1)), If(Len(Trim(TextBetween(__cb,'<SalespersonName>','</SalespersonName>',2)))>0, Trim(TextBetween(__cb,'<SalespersonName>','</SalespersonName>',2)), If(Len(Trim(TextBetween(__cb,'<Salesperson>','</Salesperson>',1)))>0, Trim(TextBetween(__cb,'<Salesperson>','</Salesperson>',1)), If(Len(Trim(TextBetween(__cb,'<Salesperson>','</Salesperson>',2)))>0, Trim(TextBetween(__cb,'<Salesperson>','</Salesperson>',2)), If(Len(Trim(TextBetween(__cb,'<SalespersonFullName>','</SalespersonFullName>',1)))>0, Trim(TextBetween(__cb,'<SalespersonFullName>','</SalespersonFullName>',1)), If(Len(Trim(TextBetween(__cb,'<Salesperson_Name>','</Salesperson_Name>',1)))>0, Trim(TextBetween(__cb,'<Salesperson_Name>','</Salesperson_Name>',1)), If(Len(Trim(TextBetween(__cb,'<Sales_Person_Name>','</Sales_Person_Name>',1)))>0, Trim(TextBetween(__cb,'<Sales_Person_Name>','</Sales_Person_Name>',1)), ''))))))) as SalespersonName,
        If((If(Len(Trim(TextBetween(__cb,'<SalespersonName>','</SalespersonName>',1)))>0,1,0)
           +If(Len(Trim(TextBetween(__cb,'<Salesperson>','</Salesperson>',1)))>0,1,0)
           +If(Len(Trim(TextBetween(__cb,'<SalespersonFullName>','</SalespersonFullName>',1)))>0,1,0)
           +If(Len(Trim(TextBetween(__cb,'<Salesperson_Name>','</Salesperson_Name>',1)))>0,1,0)
           +If(Len(Trim(TextBetween(__cb,'<Sales_Person_Name>','</Sales_Person_Name>',1)))>0,1,0)) > 1, 1, 0) as __sp_multi_alias,
        If(SubStringCount(__cb,'<SalespersonName>')=0 and SubStringCount(__cb,'<Salesperson>')=0
           and SubStringCount(__cb,'<SalespersonFullName>')=0 and SubStringCount(__cb,'<Salesperson_Name>')=0
           and SubStringCount(__cb,'<Sales_Person_Name>')=0
           and Index(Upper(__cb),'SALESPERSON')>0, 1, 0) as __sp_case_risk,
        // regular Common fields — LAST occurrence wins (even if empty)
        If(SubStringCount(__cb,'<TransactionNumber>')=0,'',Trim(TextBetween(__cb,'<TransactionNumber>','</TransactionNumber>',SubStringCount(__cb,'<TransactionNumber>')))) as TransactionNumber,
        If(SubStringCount(__cb,'<OriginalTktId>')=0,'',Trim(TextBetween(__cb,'<OriginalTktId>','</OriginalTktId>',SubStringCount(__cb,'<OriginalTktId>')))) as OriginalTktId,
        If(SubStringCount(__cb,'<SecurityIdentifier>')=0,'',Trim(TextBetween(__cb,'<SecurityIdentifier>','</SecurityIdentifier>',SubStringCount(__cb,'<SecurityIdentifier>')))) as SecurityIdentifier,
        If(SubStringCount(__cb,'<SecurityCurrencyISOCode>')=0,'',Trim(TextBetween(__cb,'<SecurityCurrencyISOCode>','</SecurityCurrencyISOCode>',SubStringCount(__cb,'<SecurityCurrencyISOCode>')))) as SecurityCurrencyISOCode,
        If(SubStringCount(__cb,'<Ticker>')=0,'',Trim(TextBetween(__cb,'<Ticker>','</Ticker>',SubStringCount(__cb,'<Ticker>')))) as Ticker,
        If(SubStringCount(__cb,'<MaturityDateExpirationDate>')=0,'',Trim(TextBetween(__cb,'<MaturityDateExpirationDate>','</MaturityDateExpirationDate>',SubStringCount(__cb,'<MaturityDateExpirationDate>')))) as MaturityDateExpirationDate,
        If(SubStringCount(__cb,'<BuySellCoverShortFlag>')=0,'',Trim(TextBetween(__cb,'<BuySellCoverShortFlag>','</BuySellCoverShortFlag>',SubStringCount(__cb,'<BuySellCoverShortFlag>')))) as BuySellCoverShortFlag,
        If(SubStringCount(__cb,'<TradeDate>')=0,'',Trim(TextBetween(__cb,'<TradeDate>','</TradeDate>',SubStringCount(__cb,'<TradeDate>')))) as TradeDate,
        If(SubStringCount(__cb,'<AsOfTradeDate>')=0,'',Trim(TextBetween(__cb,'<AsOfTradeDate>','</AsOfTradeDate>',SubStringCount(__cb,'<AsOfTradeDate>')))) as AsOfTradeDate,
        If(SubStringCount(__cb,'<Price>')=0,'',Trim(TextBetween(__cb,'<Price>','</Price>',SubStringCount(__cb,'<Price>')))) as Price,
        If(SubStringCount(__cb,'<TradeAmount>')=0,'',Trim(TextBetween(__cb,'<TradeAmount>','</TradeAmount>',SubStringCount(__cb,'<TradeAmount>')))) as TradeAmount,
        If(SubStringCount(__cb,'<CustomerAccountCounterparty>')=0,'',Trim(TextBetween(__cb,'<CustomerAccountCounterparty>','</CustomerAccountCounterparty>',SubStringCount(__cb,'<CustomerAccountCounterparty>')))) as CustomerAccountCounterparty,
        If(SubStringCount(__cb,'<AccountCounterpartyShortName>')=0,'',Trim(TextBetween(__cb,'<AccountCounterpartyShortName>','</AccountCounterpartyShortName>',SubStringCount(__cb,'<AccountCounterpartyShortName>')))) as AccountCounterpartyShortName,
        If(SubStringCount(__cb,'<MasterAccountName>')=0,'',Trim(TextBetween(__cb,'<MasterAccountName>','</MasterAccountName>',SubStringCount(__cb,'<MasterAccountName>')))) as MasterAccountName,
        If(SubStringCount(__cb,'<TraderAccountName>')=0,'',Trim(TextBetween(__cb,'<TraderAccountName>','</TraderAccountName>',SubStringCount(__cb,'<TraderAccountName>')))) as TraderAccountName,
        If(SubStringCount(__cb,'<TraderAccountNumber>')=0,'',Trim(TextBetween(__cb,'<TraderAccountNumber>','</TraderAccountNumber>',SubStringCount(__cb,'<TraderAccountNumber>')))) as TraderAccountNumber,
        If(SubStringCount(__cb,'<TransactionType>')=0,'',Trim(TextBetween(__cb,'<TransactionType>','</TransactionType>',SubStringCount(__cb,'<TransactionType>')))) as TransactionType,
        If(SubStringCount(__cb,'<OMReasonCode>')=0,'',Trim(TextBetween(__cb,'<OMReasonCode>','</OMReasonCode>',SubStringCount(__cb,'<OMReasonCode>')))) as OMReasonCode;
    LOAD
        '$(_vB)' as source_file,
        '$(_vTok)' as file_date_token,
        feed_no,
        feed_blob,
        SubStringCount(feed_blob, '<TransactionCosts>') as _n_txcs_blocks,
        TextBetween(feed_blob, '<Common>', '</Common>', 1) & '' as __cb,
        TextBetween(feed_blob, '<ExtendedFields>', '</ExtendedFields>', 1) & '' as __eb,
        If(Index(feed_blob,'<TransactionCosts>')>0 and Index(feed_blob,'</TransactionCosts>')>0,
           Left(feed_blob, Index(feed_blob,'<TransactionCosts>')-1) & Mid(feed_blob, Index(feed_blob,'</TransactionCosts>') + 19),
           If(Index(feed_blob,'<TransactionCosts>')>0,
              Left(feed_blob, Index(feed_blob,'<TransactionCosts>')-1),
              feed_blob)) as __wo
    RESIDENT _FEEDS;

    // ---- Which Common tags exist in THIS file (they decide the XmlSimple list)
    // __has_<tag> = 1 when at least one TradeFeed has <tag>, <tag/> or <tag attr> in <Common>
    [_TAGS]:
    NoConcatenate
    LOAD
        Max(If(Index(__cb, '<TransactionNumber>') + Index(__cb, '<TransactionNumber/>') + Index(__cb, '<TransactionNumber ') > 0, 1, 0)) as __has_TransactionNumber,
        Max(If(Index(__cb, '<OriginalTktId>') + Index(__cb, '<OriginalTktId/>') + Index(__cb, '<OriginalTktId ') > 0, 1, 0)) as __has_OriginalTktId,
        Max(If(Index(__cb, '<SecurityIdentifier>') + Index(__cb, '<SecurityIdentifier/>') + Index(__cb, '<SecurityIdentifier ') > 0, 1, 0)) as __has_SecurityIdentifier,
        Max(If(Index(__cb, '<SecurityCurrencyISOCode>') + Index(__cb, '<SecurityCurrencyISOCode/>') + Index(__cb, '<SecurityCurrencyISOCode ') > 0, 1, 0)) as __has_SecurityCurrencyISOCode,
        Max(If(Index(__cb, '<Ticker>') + Index(__cb, '<Ticker/>') + Index(__cb, '<Ticker ') > 0, 1, 0)) as __has_Ticker,
        Max(If(Index(__cb, '<MaturityDateExpirationDate>') + Index(__cb, '<MaturityDateExpirationDate/>') + Index(__cb, '<MaturityDateExpirationDate ') > 0, 1, 0)) as __has_MaturityDateExpirationDate,
        Max(If(Index(__cb, '<BuySellCoverShortFlag>') + Index(__cb, '<BuySellCoverShortFlag/>') + Index(__cb, '<BuySellCoverShortFlag ') > 0, 1, 0)) as __has_BuySellCoverShortFlag,
        Max(If(Index(__cb, '<TradeDate>') + Index(__cb, '<TradeDate/>') + Index(__cb, '<TradeDate ') > 0, 1, 0)) as __has_TradeDate,
        Max(If(Index(__cb, '<AsOfTradeDate>') + Index(__cb, '<AsOfTradeDate/>') + Index(__cb, '<AsOfTradeDate ') > 0, 1, 0)) as __has_AsOfTradeDate,
        Max(If(Index(__cb, '<Price>') + Index(__cb, '<Price/>') + Index(__cb, '<Price ') > 0, 1, 0)) as __has_Price,
        Max(If(Index(__cb, '<TradeAmount>') + Index(__cb, '<TradeAmount/>') + Index(__cb, '<TradeAmount ') > 0, 1, 0)) as __has_TradeAmount,
        Max(If(Index(__cb, '<CustomerAccountCounterparty>') + Index(__cb, '<CustomerAccountCounterparty/>') + Index(__cb, '<CustomerAccountCounterparty ') > 0, 1, 0)) as __has_CustomerAccountCounterparty,
        Max(If(Index(__cb, '<AccountCounterpartyShortName>') + Index(__cb, '<AccountCounterpartyShortName/>') + Index(__cb, '<AccountCounterpartyShortName ') > 0, 1, 0)) as __has_AccountCounterpartyShortName,
        Max(If(Index(__cb, '<TraderAccountName>') + Index(__cb, '<TraderAccountName/>') + Index(__cb, '<TraderAccountName ') > 0, 1, 0)) as __has_TraderAccountName,
        Max(If(Index(__cb, '<TraderAccountNumber>') + Index(__cb, '<TraderAccountNumber/>') + Index(__cb, '<TraderAccountNumber ') > 0, 1, 0)) as __has_TraderAccountNumber,
        Max(If(Index(__cb, '<TransactionType>') + Index(__cb, '<TransactionType/>') + Index(__cb, '<TransactionType ') > 0, 1, 0)) as __has_TransactionType,
        Max(If(Index(__cb, '<OMReasonCode>') + Index(__cb, '<OMReasonCode/>') + Index(__cb, '<OMReasonCode ') > 0, 1, 0)) as __has_OMReasonCode,
        Max(If(Index(__cb, '<SalespersonName>') + Index(__cb, '<SalespersonName/>') + Index(__cb, '<SalespersonName ') > 0, 1, 0)) as __has_SalespersonName,
        Max(If(Index(__cb, '<MasterAccountName>') + Index(__cb, '<MasterAccountName/>') + Index(__cb, '<MasterAccountName ') > 0, 1, 0)) as __has_MasterAccountName;
    LOAD
        TextBetween(feed_blob, '<Common>', '</Common>', 1) & '' as __cb
    RESIDENT _FEEDS;
    FOR Each _cf in $(vCommonFieldList)
      LET vXs_$(_cf) = If(Alt(Peek('__has_$(_cf)', 0, '_TAGS'), 0) > 0, 'Trim(Text([Common/$(_cf)]))', 'Null()');
    NEXT _cf
    DROP TABLE _TAGS;

    // ---- The same TradeFeeds through XmlSimple, EXPLICIT field list (no LOAD *).
    // ErrorMode 0 only around this statement: if XmlSimple cannot read the file,
    // the fields of this file come from the file text and a WARN is written.
    SET ErrorMode = 0;
    [_TF_raw]:
    NoConcatenate
    LOAD
        RecNo() as feed_no,
        $(vXs_TransactionNumber) as xs_TransactionNumber,
        $(vXs_OriginalTktId) as xs_OriginalTktId,
        $(vXs_SecurityIdentifier) as xs_SecurityIdentifier,
        $(vXs_SecurityCurrencyISOCode) as xs_SecurityCurrencyISOCode,
        $(vXs_Ticker) as xs_Ticker,
        $(vXs_MaturityDateExpirationDate) as xs_MaturityDateExpirationDate,
        $(vXs_BuySellCoverShortFlag) as xs_BuySellCoverShortFlag,
        $(vXs_TradeDate) as xs_TradeDate,
        $(vXs_AsOfTradeDate) as xs_AsOfTradeDate,
        $(vXs_Price) as xs_Price,
        $(vXs_TradeAmount) as xs_TradeAmount,
        $(vXs_CustomerAccountCounterparty) as xs_CustomerAccountCounterparty,
        $(vXs_AccountCounterpartyShortName) as xs_AccountCounterpartyShortName,
        $(vXs_TraderAccountName) as xs_TraderAccountName,
        $(vXs_TraderAccountNumber) as xs_TraderAccountNumber,
        $(vXs_TransactionType) as xs_TransactionType,
        $(vXs_OMReasonCode) as xs_OMReasonCode,
        $(vXs_SalespersonName) as xs_SalespersonName,
        $(vXs_MasterAccountName) as xs_MasterAccountName
    FROM [$(_vF)]
    (XmlSimple, table is [$(vXmlTradeFeedPath)]);
    SET ErrorMode = 1;

    LET _vXsOk = 0;
    LET _vCellDiff = 0;
    LET _vXsWhy = 'XmlSimple could not read the file';
    IF Alt(TableNumber('_TF_raw'), -1) >= 0 THEN
      LET _vXsRows = Alt(NoOfRows('_TF_raw'), 0);
      IF $(_vXsRows) = $(_vNText) THEN
        // feed_no is the only common field: one XmlSimple row per text row
        Left Join(_P1)
        LOAD
            feed_no,
            $(fNA(xs_TransactionNumber)) as xs_TransactionNumber,
            $(fNA(xs_OriginalTktId)) as xs_OriginalTktId,
            $(fNA(xs_SecurityIdentifier)) as xs_SecurityIdentifier,
            $(fNA(xs_SecurityCurrencyISOCode)) as xs_SecurityCurrencyISOCode,
            $(fNA(xs_Ticker)) as xs_Ticker,
            $(fNA(xs_MaturityDateExpirationDate)) as xs_MaturityDateExpirationDate,
            $(fNA(xs_BuySellCoverShortFlag)) as xs_BuySellCoverShortFlag,
            $(fNA(xs_TradeDate)) as xs_TradeDate,
            $(fNA(xs_AsOfTradeDate)) as xs_AsOfTradeDate,
            $(fNA(xs_Price)) as xs_Price,
            $(fNA(xs_TradeAmount)) as xs_TradeAmount,
            $(fNA(xs_CustomerAccountCounterparty)) as xs_CustomerAccountCounterparty,
            $(fNA(xs_AccountCounterpartyShortName)) as xs_AccountCounterpartyShortName,
            $(fNA(xs_TraderAccountName)) as xs_TraderAccountName,
            $(fNA(xs_TraderAccountNumber)) as xs_TraderAccountNumber,
            $(fNA(xs_TransactionType)) as xs_TransactionType,
            $(fNA(xs_OMReasonCode)) as xs_OMReasonCode,
            $(fNA(xs_SalespersonName)) as xs_SalespersonName,
            $(fNA(xs_MasterAccountName)) as xs_MasterAccountName
        RESIDENT _TF_raw;
        // Chr(126) in front forces a text comparison ('007' and '7' are different)
        [_XCHK]:
        NoConcatenate
        LOAD
            Sum(If((Chr(126) & xs_TransactionNumber) <> (Chr(126) & TransactionNumber), 1, 0)) as __tn_diff,
            Sum(If((Chr(126) & xs_OriginalTktId) <> (Chr(126) & OriginalTktId), 1, 0)
                + If((Chr(126) & xs_SecurityIdentifier) <> (Chr(126) & SecurityIdentifier), 1, 0)
                + If((Chr(126) & xs_SecurityCurrencyISOCode) <> (Chr(126) & SecurityCurrencyISOCode), 1, 0)
                + If((Chr(126) & xs_Ticker) <> (Chr(126) & Ticker), 1, 0)
                + If((Chr(126) & xs_MaturityDateExpirationDate) <> (Chr(126) & MaturityDateExpirationDate), 1, 0)
                + If((Chr(126) & xs_BuySellCoverShortFlag) <> (Chr(126) & BuySellCoverShortFlag), 1, 0)
                + If((Chr(126) & xs_TradeDate) <> (Chr(126) & TradeDate), 1, 0)
                + If((Chr(126) & xs_AsOfTradeDate) <> (Chr(126) & AsOfTradeDate), 1, 0)
                + If((Chr(126) & xs_Price) <> (Chr(126) & Price), 1, 0)
                + If((Chr(126) & xs_TradeAmount) <> (Chr(126) & TradeAmount), 1, 0)
                + If((Chr(126) & xs_CustomerAccountCounterparty) <> (Chr(126) & CustomerAccountCounterparty), 1, 0)
                + If((Chr(126) & xs_AccountCounterpartyShortName) <> (Chr(126) & AccountCounterpartyShortName), 1, 0)
                + If((Chr(126) & xs_TraderAccountName) <> (Chr(126) & TraderAccountName), 1, 0)
                + If((Chr(126) & xs_TraderAccountNumber) <> (Chr(126) & TraderAccountNumber), 1, 0)
                + If((Chr(126) & xs_TransactionType) <> (Chr(126) & TransactionType), 1, 0)
                + If((Chr(126) & xs_OMReasonCode) <> (Chr(126) & OMReasonCode), 1, 0)) as __cell_diff
        RESIDENT _P1;
        LET _vTnDiff = Alt(Peek('__tn_diff', 0, '_XCHK'), 0);
        LET _vCellDiff = Alt(Peek('__cell_diff', 0, '_XCHK'), 0);
        DROP TABLE _XCHK;
        IF $(_vTnDiff) = 0 THEN
          LET _vXsOk = 1;
        ELSE
          LET _vXsWhy = 'TransactionNumber differs from the file text on $(_vTnDiff) row(s)';
        END IF
      ELSE
        LET _vXsWhy = 'XmlSimple returned $(_vXsRows) row(s) and the file text has $(_vNText) TradeFeed(s)';
      END IF
      DROP TABLE _TF_raw;
    END IF

    IF $(_vXsOk) = 1 THEN
      // Common fields from XmlSimple. Salesperson aliases and the tree search of
      // MasterAccountName (L1127-1128) only exist in the text reader.
      LET vXmlFilesXs = $(vXmlFilesXs) + 1;
      LET vXmlCellDiff = $(vXmlCellDiff) + $(_vCellDiff);
      IF $(_vCellDiff) > 0 THEN
        TRACE [CASTINE][WARN] $(_vB): XmlSimple and the file text differ in $(_vCellDiff) cell(s) - XmlSimple values kept.;
      END IF
      [_P2]:
      NoConcatenate
      LOAD
          source_file,
          file_date_token,
          feed_no,
          xs_TransactionNumber as TransactionNumber,
          xs_OriginalTktId as OriginalTktId,
          xs_SecurityIdentifier as SecurityIdentifier,
          xs_SecurityCurrencyISOCode as SecurityCurrencyISOCode,
          xs_Ticker as Ticker,
          xs_MaturityDateExpirationDate as MaturityDateExpirationDate,
          xs_BuySellCoverShortFlag as BuySellCoverShortFlag,
          xs_TradeDate as TradeDate,
          xs_AsOfTradeDate as AsOfTradeDate,
          xs_Price as Price,
          xs_TradeAmount as TradeAmount,
          xs_CustomerAccountCounterparty as CustomerAccountCounterparty,
          xs_AccountCounterpartyShortName as AccountCounterpartyShortName,
          xs_TraderAccountName as TraderAccountName,
          xs_TraderAccountNumber as TraderAccountNumber,
          xs_TransactionType as TransactionType,
          xs_OMReasonCode as OMReasonCode,
          If(Len(xs_SalespersonName) > 0, xs_SalespersonName, SalespersonName) as SalespersonName,
          If(Len(xs_MasterAccountName) > 0, xs_MasterAccountName, __man_deep) as MasterAccountName,
          SECURITY_TYP,
          MARKET_SECTOR_DES,
          __cost_out,
          _n_txcs_blocks
      RESIDENT _P1;
    ELSE
      LET vXmlFilesTextOnly = $(vXmlFilesTextOnly) + 1;
      TRACE [CASTINE][WARN] $(_vB): fields taken from the file text ($(_vXsWhy)).;
      [_P2]:
      NoConcatenate
      LOAD
          source_file,
          file_date_token,
          feed_no,
          TransactionNumber,
          OriginalTktId,
          SecurityIdentifier,
          SecurityCurrencyISOCode,
          Ticker,
          MaturityDateExpirationDate,
          BuySellCoverShortFlag,
          TradeDate,
          AsOfTradeDate,
          Price,
          TradeAmount,
          CustomerAccountCounterparty,
          AccountCounterpartyShortName,
          TraderAccountName,
          TraderAccountNumber,
          TransactionType,
          OMReasonCode,
          SalespersonName,
          MasterAccountName,
          SECURITY_TYP,
          MARKET_SECTOR_DES,
          __cost_out,
          _n_txcs_blocks
      RESIDENT _P1;
    END IF

    IF Alt(TableNumber('_PARSED'), -1) < 0 THEN
      [_PARSED]:
      NoConcatenate
      LOAD *
      RESIDENT _P2;
    ELSE
      Concatenate(_PARSED)
      LOAD *
      RESIDENT _P2;
    END IF
    CALL DropIfExists('_P2');
    CALL DropIfExists('_P1');
  END IF
  CALL DropIfExists('_FEEDS');
NEXT _i
LET _vF =;
LET _vB =;
LET _vTok =;
LET _vBad =;
LET _vSegRows =;
LET _vNText =;
LET _vNClose =;
LET _vNAny =;
LET _vXsOk =;
LET _vXsWhy =;
LET _vXsRows =;
LET _vTnDiff =;
LET _vCellDiff =;
LET _cf =;

LET vTotalTradesParsed = If(Alt(TableNumber('_PARSED'), -1) < 0, 0, Alt(NoOfRows('_PARSED'), 0));
TRACE [CASTINE] total_trades_parsed_raw: $(vTotalTradesParsed);
TRACE [CASTINE] XML reader: $(vXmlFilesXs) file(s) with XmlSimple, $(vXmlFilesTextOnly) from the file text only, $(vXmlFilesNoFeed) without TradeFeed, $(vXmlCellDiff) cell difference(s) between both readers;
IF $(vTotalTradesParsed) = 0 THEN
  TRACE [CASTINE][EXIT] Parsed 0 trades. Check XML inputs and vXmlTradeFeedPath. (main L3446-3449);
  CALL AbortNoTrades_UndefinedSub_ForcesScriptError;
END IF
IF $(vFeedAttrTags) > 0 THEN
  TRACE [CASTINE] TradeFeed opening tags with attributes normalised: $(vFeedAttrTags);
END IF

// --- per-feed cost aggregates (L1010-1050) ---
CALL ParseCostColumn('_TXC', 'txc_cost_text', 'txc_cost_num');

//  - AddOn: sum of the parseable costs of the addon items; '' if none;
//    text formatted as f'{total:.10f}'.rstrip('0').rstrip('.')
//  - primary fallback: 1st NON-addon item with a non-empty Cost
[_TXC_ADDON]:
NoConcatenate
LOAD
    source_file,
    feed_no,
    If(Count(If(txc_is_addon=1 and Len(txc_cost_text)>0 and Len(txc_cost_num)>0, 1))>0,
       Num($(fRound10(Sum(txc_is_addon * txc_cost_num))), '0.##########', '.', ','),
       '') as addon_sum_text,
    Min(If(txc_is_addon=0 and Len(txc_cost_text)>0, txc_no)) as _first_nonaddon_no
RESIDENT _TXC
GROUP BY source_file, feed_no;

Left Join(_TXC_ADDON)
LOAD
    source_file,
    feed_no,
    txc_no as _first_nonaddon_no,
    txc_cost_text as fallback_cost_text
RESIDENT _TXC;

// [FIX-06] diagnostic only: Gross Comms as the analyst script computed it
// (L470-515: sum of every TransactionCost whose Currency is USD)
[_TXC_OLD]:
NoConcatenate
LOAD
    source_file,
    feed_no,
    Sum(If(txc_currency = 'USD', txc_cost_num)) as __old_gross
RESIDENT _TXC
GROUP BY source_file, feed_no;
DROP TABLE _TXC;

Left Join(_PARSED)
LOAD
    source_file,
    feed_no,
    addon_sum_text,
    fallback_cost_text
RESIDENT _TXC_ADDON;
DROP TABLE _TXC_ADDON;

// audit of the reader assumptions
[_AX]:
NoConcatenate
LOAD
    Sum(If(_n_txcs_blocks > 1, 1, 0)) as __n
RESIDENT _PARSED;
LET vAuditTxcBlocks = Alt(Peek('__n', 0, '_AX'), 0);
DROP TABLE _AX;
IF $(vAuditTxcBlocks) > 0 THEN
  TRACE [CASTINE][WARN] $(vAuditTxcBlocks) feed(s) with >1 TransactionCosts block - reader assumption violated, review parity.;
END IF

[AUDIT_XML_SCAN]:
NoConcatenate
LOAD
    $(vNumXmlFiles)      as audit_xml_files,
    $(vXmlFilesNoFeed)   as audit_files_without_tradefeed,
    $(vXmlFilesXs)       as audit_files_read_with_xmlsimple,
    $(vXmlFilesTextOnly) as audit_files_read_from_text_only,
    $(vXmlCellDiff)      as audit_xmlsimple_vs_text_cell_differences,
    $(vFeedAttrTags)     as audit_tradefeed_tags_with_attributes,
    $(vAuditTxcBlocks)   as audit_feeds_multi_txcs_blocks
AUTOGENERATE 1;

// Fixed contract of _PARSED at this point (also read by scripts/qvs_validate.py):
// @fields _PARSED: source_file, file_date_token, feed_no, TransactionNumber, OriginalTktId, SecurityIdentifier, SecurityCurrencyISOCode, Ticker, MaturityDateExpirationDate, BuySellCoverShortFlag, TradeDate, AsOfTradeDate, Price, TradeAmount, CustomerAccountCounterparty, AccountCounterpartyShortName, TraderAccountName, TraderAccountNumber, TransactionType, OMReasonCode, SalespersonName, MasterAccountName, __cost_out, addon_sum_text, fallback_cost_text, SECURITY_TYP, MARKET_SECTOR_DES
// --- fixed schema + pandas NA texts -> '' + primary cost pick (L1010-1034) ---
// deterministic read order (file asc, feed asc) = documented tie-break.
[_RAW]:
NoConcatenate
LOAD
    *,
    $(fNA(__cost_pick)) as Cost_original,
    If(Len(addon_sum_text)>0, addon_sum_text, '') as AddOn_original,
    RowNo() as __raw_row_id;
LOAD
    source_file,
    file_date_token,
    feed_no,
    $(fNA(TransactionNumber)) as TransactionNumber,
    $(fNA(OriginalTktId)) as OriginalTktId,
    $(fNA(SecurityIdentifier)) as SecurityIdentifier,
    $(fNA(SecurityCurrencyISOCode)) as SecurityCurrencyISOCode,
    $(fNA(Ticker)) as Ticker,
    $(fNA(MaturityDateExpirationDate)) as MaturityDateExpirationDate,
    $(fNA(BuySellCoverShortFlag)) as BuySellCoverShortFlag,
    $(fNA(TradeDate)) as TradeDate,
    $(fNA(AsOfTradeDate)) as AsOfTradeDate,
    $(fNA(Price)) as Price,
    $(fNA(TradeAmount)) as TradeAmount,
    $(fNA(CustomerAccountCounterparty)) as CustomerAccountCounterparty,
    $(fNA(AccountCounterpartyShortName)) as AccountCounterpartyShortName,
    $(fNA(MasterAccountName)) as MasterAccountName,
    $(fNA(TraderAccountName)) as TraderAccountName,
    $(fNA(TraderAccountNumber)) as TraderAccountNumber,
    $(fNA(SalespersonName)) as SalespersonName,
    $(fNA(TransactionType)) as TransactionType,
    $(fNA(OMReasonCode)) as OMReasonCode,
    $(fNA(SECURITY_TYP)) as SECURITY_TYP,
    $(fNA(MARKET_SECTOR_DES)) as MARKET_SECTOR_DES,
    addon_sum_text,
    If('$(vPreferCostOutsideTxc)'='1',
       If(Len(__cost_out & '')>0, __cost_out,
          If('$(vAllowTxcFallback)'='1' and Len(fallback_cost_text & '')>0, fallback_cost_text, '')),
       If(Len(fallback_cost_text & '')>0, fallback_cost_text, '')) as __cost_pick
RESIDENT _PARSED
ORDER BY source_file ASC, feed_no ASC;
DROP TABLE _PARSED;
DROP FIELDS __cost_pick, addon_sum_text FROM _RAW;

// numeric cost parsing (same strings as Python -> same values)
CALL ParseCostColumn('_RAW', 'Cost_original', 'Cost_original_numeric');
CALL ParseCostColumn('_RAW', 'AddOn_original', 'AddOn_numeric');

// --- diagnostics: what the old read-time rules did on THIS data (reported in tab 11b) ---
[_DG3]:
NoConcatenate
LOAD
    Count(If(Len(Trim(OriginalTktId)) = 0, 1))                    as n_no_orig,
    Count(If(Index(Upper(TransactionType & ''), 'X') > 0, 1))     as n_cancel_rows,
    Count(If(Len(Trim(SalespersonName)) = 0, 1))                  as n_no_sp,
    Count(If(Upper(Trim(MasterAccountName)) = 'TEST', 1))         as n_test,
    Count(If(Len(Trim(MasterAccountName)) = 0, 1))                as n_no_master
RESIDENT _RAW;
LET vDiagNoOrigTkt    = Alt(Peek('n_no_orig', 0, '_DG3'), 0);
LET vDiagCancelRows   = Alt(Peek('n_cancel_rows', 0, '_DG3'), 0);
LET vDiagNoSalesperson = Alt(Peek('n_no_sp', 0, '_DG3'), 0);
LET vDiagTestMaster   = Alt(Peek('n_test', 0, '_DG3'), 0);
LET vDiagNoMaster     = Alt(Peek('n_no_master', 0, '_DG3'), 0);
DROP TABLE _DG3;

// [FIX-04] diagnostic only: rows the analyst versioning rule would keep
// (L415-418 filters first, then L455-460: MAX(TradeDate) per OriginalTktId)
[_DG4]:
NoConcatenate
LOAD
    Trim(OriginalTktId) as __dg_ot,
    $(fPdDate(TradeDate)) as __dg_ts
RESIDENT _RAW
WHERE Index(Upper(TransactionType & ''), 'X') = 0 and Len(Trim(SalespersonName)) > 0;
LET vDiagOldRuleInput = Alt(NoOfRows('_DG4'), 0);
LET vDiagOldRuleRows = 0;
IF $(vDiagOldRuleInput) > 0 THEN
  Inner Join(_DG4)
  LOAD
      __dg_ot,
      Max(__dg_ts) as __dg_ts
  RESIDENT _DG4
  GROUP BY __dg_ot;
  LET vDiagOldRuleRows = Alt(NoOfRows('_DG4'), 0);
END IF
IF Alt(TableNumber('_DG4'), -1) >= 0 THEN
  DROP TABLE _DG4;
END IF

[_DG6]:
NoConcatenate
LOAD
    source_file as __dg_file,
    feed_no as __dg_feed,
    RangeSum(Cost_original_numeric, AddOn_numeric) as __new_gross
RESIDENT _RAW;
Left Join(_DG6)
LOAD
    source_file as __dg_file,
    feed_no as __dg_feed,
    __old_gross
RESIDENT _TXC_OLD;
[_DG6S]:
NoConcatenate
LOAD
    Count(If(Fabs(Alt(__old_gross, 0) - __new_gross) > 0.005, 1)) as n_diff,
    Num(Sum(Alt(__old_gross, 0)), '0.00', '.', '') as old_tot,
    Num(Sum(__new_gross), '0.00', '.', '') as new_tot
RESIDENT _DG6;
LET vDiagGrossDiff = Alt(Peek('n_diff', 0, '_DG6S'), 0);
LET vDiagGrossOld  = Peek('old_tot', 0, '_DG6S');
LET vDiagGrossNew  = Peek('new_tot', 0, '_DG6S');
DROP TABLES _DG6, _DG6S, _TXC_OLD;

// --- OPTIONAL analyst rule (NOT in Castine.py; vApplySalesMappingYearFilter=1) ---
// Analyst L420-422: AsOf in the current year, or in the prior year only for
// traders listed in Sales_Mapping.xlsx. Off by default to keep Python parity.
IF '$(vApplySalesMappingYearFilter)' = '1' THEN
  [TraderTeamName_PY]:
  NoConcatenate
  LOAD
      Upper(TraderTeamName_PY) as TraderTeamName_Exists
  FROM [$(vSalesMappingFile)]
  (ooxml, embedded labels, table is TraderTeamName_PY);
  [_RAW_F]:
  NoConcatenate
  LOAD *
  RESIDENT _RAW
  WHERE Year($(fPdDate(AsOfTradeDate))) = $(vLastWorkDate_Year)
     or (Year($(fPdDate(AsOfTradeDate))) = $(vLastWorkDate_PriorYear)
         and Exists(TraderTeamName_Exists, Upper(TraderAccountNumber)));
  TRACE [CASTINE][WARN] Sales_Mapping year filter ON (not a Castine.py rule): $(vTotalTradesParsed) -> rows kept below.;
  DROP TABLES _RAW, TraderTeamName_PY;
  RENAME TABLE _RAW_F TO _RAW;
  LET vTotalTradesParsed = NoOfRows('_RAW');
  TRACE [CASTINE] trades after Sales_Mapping year filter: $(vTotalTradesParsed);
END IF
///$tab 04 — Versioning & Cancels
// [FIX-04] VERSIONING
//   WAS (analyst L455-460): INNER JOIN on OriginalTktId keeping MAX(NUM(TradeDate)).
//   PROBLEM: Castine.py versions by TransactionNumber, not OriginalTktId. With the
//        old key, every ticket without OriginalTktId fell in one group (only the
//        latest survived), the same ticket repeated in two daily files with the
//        same TradeDate stayed duplicated, and a ticket and its correction (same
//        OriginalTktId, different TransactionNumber) were merged into one.
//   NOW (keep_last_version L1199): key = TransactionNumber, else OriginalTktId,
//        else SecurityIdentifier+TradeDate+TradeAmount; order = file date, then
//        AsOfTradeDate; the LAST version is kept, with the 1st non-empty TradeDate
//        of the chain (original Trade Date) and the version count.
// [FIX-05] CANCELS AFTER VERSIONING
//   WAS (analyst L416): INDEX(UPPER(TransactionType),'X') = 0 in the XML WHERE,
//        i.e. BEFORE versioning.
//   PROBLEM: when the last version of a trade is a cancel, the old rule dropped
//        only that row and kept the previous version: a cancelled trade was paid.
//   NOW (remove_cancels L1274, called after keep_last_version in main L3517):
//        the cancel is removed after versioning, so the whole trade leaves.
// ============================================================================
// 04 — keep_last_version (L1199-1271) + remove_cancels (L1274-1283)
// Group key: TransactionNumber -> OriginalTktId -> SecId||TradeDate||Amount.
// Stable sort by (key, token_int, asof_dt); keeps the LAST one; carries
// OriginalVersionTradeDate (1st non-empty TradeDate of the chain) and VersionCount.
// ============================================================================
[_V0]:
NoConcatenate
LOAD
    *,
    // prefix: without it Qlik compares '007' = '7' as numbers
    'K|' & If(Len(Trim(TransactionNumber))>0, Trim(TransactionNumber),
       If(Len(Trim(OriginalTktId))>0, Trim(OriginalTktId),
          Trim(SecurityIdentifier) & '||' & Trim(TradeDate) & '||' & Trim(TradeAmount))) as __group_key,
    Alt(Num#(file_date_token), 0) as __token_int
RESIDENT _RAW;
DROP TABLE _RAW;

// _asof_dt for sorting: pd.to_datetime(errors='coerce') -> NaT = Timestamp.min (L1225)
// (uses fPdDate — mirror of pd.to_datetime; NOT the custom parser, which has the
//  Excel serial quirk. Deliberate distinction, see 02_BUSINESS_RULES_MAPPING R-S07.)
[_V1]:
NoConcatenate
LOAD
    *,
    Alt($(fPdDate(AsOfTradeDate)), $(vTsFloorMin)) as __asof_ord
RESIDENT _V0;
DROP TABLE _V0;

[_V2]:
NoConcatenate
LOAD
    *,
    RowNo() as __ord,
    // carries the 1st non-empty TradeDate of the chain (ASC order) — L1250-1261
    If(__group_key <> Previous(__group_key),
       If(Len(Trim(TradeDate))>0 and Match(Lower(Trim(TradeDate)),'nan','nat','none','null')=0, Trim(TradeDate), ''),
       If(Len(Peek('__orig_td'))>0, Peek('__orig_td'),
          If(Len(Trim(TradeDate))>0 and Match(Lower(Trim(TradeDate)),'nan','nat','none','null')=0, Trim(TradeDate), ''))) as __orig_td
RESIDENT _V1
ORDER BY __group_key ASC, __token_int ASC, __asof_ord ASC, __raw_row_id ASC;
DROP TABLE _V1;

[_VLAST]:
NoConcatenate
LOAD
    __group_key,
    Max(__ord) as __ord,
    Count(__ord) as VersionCount
RESIDENT _V2
GROUP BY __group_key;

Inner Join(_V2)
LOAD
    __group_key,
    __ord,
    VersionCount
RESIDENT _VLAST;
DROP TABLE _VLAST;

[XML_V]:
NoConcatenate
LOAD
    *,
    __orig_td as OriginalVersionTradeDate,
    If(VersionCount > 1, 1, 0) as IsModifiedVersionChain
RESIDENT _V2;
DROP TABLE _V2;
DROP FIELDS __orig_td, __ord, __asof_ord, __token_int FROM XML_V;

LET vRowsAfterVersioning = NoOfRows('XML_V');
TRACE [CASTINE] rows_after_versioning: $(vRowsAfterVersioning);

// remove_cancels (L1274-1283): TransactionType contains 'x' (case-insensitive) -> out
[XML_NC]:
NoConcatenate
LOAD *
RESIDENT XML_V
WHERE Index(Upper(TransactionType & ''), 'X') = 0;
// [FIX-05] diagnostic for tab 11b: cancelled trades that had earlier versions
[_DG5]:
NoConcatenate
LOAD
    Count(If(Index(Upper(TransactionType & ''), 'X') > 0 and VersionCount > 1, 1)) as n_cancel_hist,
    Count(If(VersionCount > 1, 1)) as n_modified
RESIDENT XML_V;
LET vDiagCancelWithHistory = Alt(Peek('n_cancel_hist', 0, '_DG5'), 0);
LET vDiagModifiedTrades    = Alt(Peek('n_modified', 0, '_DG5'), 0);
DROP TABLE _DG5;
DROP TABLE XML_V;

LET vRowsAfterCancels = Alt(NoOfRows('XML_NC'), 0);
IF $(vRowsAfterCancels) = 0 THEN
  TRACE [CASTINE][EXIT] Cancels removal produced 0 rows. (main L3479-3481);
  CALL AbortNoRowsAfterCancels_UndefinedSub_ForcesScriptError;
END IF
LET vCancelsRemoved = $(vRowsAfterVersioning) - $(vRowsAfterCancels);
TRACE [CASTINE] rows_after_remove_cancels: $(vRowsAfterCancels) (removed=$(vCancelsRemoved));
///$tab 05 — Split Matrix
// [FIX-07] SPLIT MATRIX LOAD
//   WAS (analyst L298-311): plain LOAD of RR Team, Salesperson, Split and dates;
//        blank Expiration = today + 10 years; "Version Status" loaded but not used.
//   PROBLEM: no validation at all. A version whose splits do not sum 100% or
//        whose date windows overlap was still paid; Split written as 25 or 25%
//        was used as is; RR Team compared without normalisation.
//   NOW (load_split_matrix_castine L1290, parse_split_to_0_1 L779,
//        normalize_team_key L679): row checks (blank team/salesperson, invalid
//        split or dates), split as 0-1, blank Effective/Expiration = open window,
//        sum = 1.00 +- 0.001 per version, overlapping windows rejected. Rejected
//        rows go to split_matrix_config_alerts.csv. Same file as the Python
//        (RR Teams Split Matrix.xlsx = split matrix Castine V2.xlsx).
// ============================================================================
// 05 — SPLIT MATRIX (load_split_matrix_castine L1290-1536)
// Scans sheet candidates × header 0..4 (Python scans ALL sheets; Qlik does not
// enumerate xlsx sheets in script — documented limitation; configure
// vSplitSheetCandidates). Column detection mirrors detect_split_columns
// (L720-775): EXACT match (the LAST exact one wins) else CONTAINS (the 1st wins).
// Validations: invalid rows -> SPLIT_CONFIG_ALERTS; per-version sum outside
// 1±tolerance and overlapping windows -> whole versions invalidated.
// ============================================================================
SET vSplitOK = 0;
SET vSplitRowsRead = 0;
SET vSplitUsableRows = 0;
LET vSplitSheet = '';
LET vSplitHeader = -1;
SET vColRR = '';
SET vColSplit = '';
SET vColSales = '';
SET vColEff = '';
SET vColExp = '';

IF '$(vApplySplit)' = '1' THEN
  LET _nSplitFile = 0;
  FOR Each _f in FileList('$(vLibSplit)$(vSplitMatrixFile)')
    LET _nSplitFile = $(_nSplitFile) + 1;
  NEXT _f
  IF $(_nSplitFile) = 0 THEN
    TRACE [CASTINE][ERROR] Split Matrix NOT FOUND (L1338-1340). XML/Repo payout will be empty after drop-unmapped.;
  ELSE
    FOR Each _vSheet in $(vSplitSheetList)
      FOR _vH = 0 to 4
        IF $(vSplitHeader) = -1 THEN
          SET ErrorMode = 0;
          IF $(_vH) = 0 THEN
            [_TRY_SPLIT]:
            NoConcatenate First 1
            LOAD *
            FROM [$(vLibSplit)$(vSplitMatrixFile)]
            (ooxml, embedded labels, table is [$(_vSheet)]);
          ELSE
            [_TRY_SPLIT]:
            NoConcatenate First 1
            LOAD *
            FROM [$(vLibSplit)$(vSplitMatrixFile)]
            (ooxml, embedded labels, header is $(_vH) lines, table is [$(_vSheet)]);
          END IF
          SET ErrorMode = 1;
          IF Alt(NoOfFields('_TRY_SPLIT'),0) > 0 THEN
            // detect_split_columns in column order
            SET _rrX='';
            SET _rrC='';
            SET _spX='';
            SET _spC='';
            SET _saX='';
            SET _saC='';
            SET _efX='';
            SET _efC='';
            SET _exX='';
            SET _exC='';
            FOR _ci = 1 to NoOfFields('_TRY_SPLIT')
              LET _cn = FieldName($(_ci), '_TRY_SPLIT');
              LET _nn = KeepChar(Lower('$(_cn)'), 'abcdefghijklmnopqrstuvwxyz0123456789');
              IF '$(_nn)' = 'rrteam' THEN
                LET _rrX = '$(_cn)';            // exact: last one wins (insert(0))
              ELSEIF Index('$(_nn)','rr')>0 and Index('$(_nn)','team')>0 and Len('$(_rrC)')=0 THEN
                LET _rrC = '$(_cn)';            // contains: first one wins
              END IF
              IF '$(_nn)' = 'split' THEN
                LET _spX = '$(_cn)';
              ELSEIF Index('$(_nn)','split')>0 and Index('$(_nn)','sum')=0 and Index('$(_nn)','status')=0 and Index('$(_nn)','check')=0 and Len('$(_spC)')=0 THEN
                LET _spC = '$(_cn)';
              END IF
              IF '$(_nn)' = 'salesperson' THEN
                LET _saX = '$(_cn)';
              ELSEIF Index('$(_nn)','salesperson')>0 and Len('$(_saC)')=0 THEN
                LET _saC = '$(_cn)';
              END IF
              IF Match('$(_nn)','effectivedate','effectivefrom','startdate','validfrom','fromdate')>0 THEN
                LET _efX = '$(_cn)';
              ELSEIF ((Index('$(_nn)','effective')>0 and Index('$(_nn)','date')>0) or (Index('$(_nn)','valid')>0 and Index('$(_nn)','from')>0)) and Len('$(_efC)')=0 THEN
                LET _efC = '$(_cn)';
              END IF
              IF Match('$(_nn)','expirationdate','expirydate','effectiveto','enddate','validto','todate','expiration')>0 THEN
                LET _exX = '$(_cn)';
              ELSEIF ((Index('$(_nn)','expir')>0 and Index('$(_nn)','date')>0) or Index('$(_nn)','expiry')>0 or (Index('$(_nn)','valid')>0 and Index('$(_nn)','to')>0)) and Len('$(_exC)')=0 THEN
                LET _exC = '$(_cn)';
              END IF
            NEXT _ci
            LET _rr = If(Len('$(_rrX)')>0, '$(_rrX)', '$(_rrC)');
            LET _sp = If(Len('$(_spX)')>0, '$(_spX)', '$(_spC)');
            LET _sa = If(Len('$(_saX)')>0, '$(_saX)', '$(_saC)');
            LET _ef = If(Len('$(_efX)')>0, '$(_efX)', '$(_efC)');
            LET _ex = If(Len('$(_exX)')>0, '$(_exX)', '$(_exC)');
            IF Len('$(_rr)')>0 and Len('$(_sp)')>0 and Len('$(_sa)')>0 and '$(_rr)' <> '$(_sp)' and '$(_rr)' <> '$(_sa)' and '$(_sp)' <> '$(_sa)' THEN
              LET vSplitSheet = '$(_vSheet)';
              LET vSplitHeader = $(_vH);
              LET vColRR = '$(_rr)';
              LET vColSplit = '$(_sp)';
              LET vColSales = '$(_sa)';
              LET vColEff = '$(_ef)';
              LET vColExp = '$(_ex)';
            END IF
          END IF
          IF Alt(TableNumber('_TRY_SPLIT'), -1) >= 0 THEN
            DROP TABLE _TRY_SPLIT;
          END IF
        END IF
      NEXT _vH
    NEXT _vSheet
  END IF
END IF

// seed '__SEED__' prevents dropping an empty table; filtered out on export
[SPLIT_CONFIG_ALERTS]:
NoConcatenate
LOAD
    '__SEED__' as alert_type,
    '' as [RR Team],
    '' as Salesperson,
    '' as Split_raw,
    Null() as Split_num,
    '' as [Effective Date],
    '' as [Expiration Date],
    '' as VersionKey,
    '' as details
AUTOGENERATE 1;

IF $(vSplitHeader) >= 0 THEN
  TRACE [CASTINE] Split: sheet='$(vSplitSheet)' header_row=$(vSplitHeader) RR='$(vColRR)' Split='$(vColSplit)' Sales='$(vColSales)' Eff='$(vColEff)' Exp='$(vColExp)';

  [_SPLIT0]:
  NoConcatenate
  LOAD
      If(Len(Text([$(vColRR)]))=0, '', Text([$(vColRR)])) as RRTeam_raw,
      Trim(If(Len(Text([$(vColSales)]))=0, '', Text([$(vColSales)]))) as Salesperson_split_raw,
      If(Len(Text([$(vColSplit)]))=0, '', If(IsNum([$(vColSplit)]), Text(Num([$(vColSplit)], '0.##############', '.', '')), Text([$(vColSplit)]))) as Split_raw
        $(=If(Len('$(vColEff)')>0, ', [' & '$(vColEff)' & '] as __eff_raw0', ''))
        $(=If(Len('$(vColExp)')>0, ', [' & '$(vColExp)' & '] as __exp_raw0', ''))
  FROM [$(vLibSplit)$(vSplitMatrixFile)]
  (ooxml, embedded labels, $(=If($(vSplitHeader)>0, 'header is $(vSplitHeader) lines,', '')) table is [$(vSplitSheet)]);

  // ensures date columns even when missing from the sheet (resident rebuild)
  IF Alt(FieldNumber('__eff_raw0', '_SPLIT0'), 0) = 0 THEN
    [_SPLIT0E]:
    NoConcatenate
    LOAD
        *,
        '' as __eff_raw0
    RESIDENT _SPLIT0;
    DROP TABLE _SPLIT0;
    RENAME TABLE _SPLIT0E TO _SPLIT0;
  END IF
  IF Alt(FieldNumber('__exp_raw0', '_SPLIT0'), 0) = 0 THEN
    [_SPLIT0X]:
    NoConcatenate
    LOAD
        *,
        '' as __exp_raw0
    RESIDENT _SPLIT0;
    DROP TABLE _SPLIT0;
    RENAME TABLE _SPLIT0X TO _SPLIT0;
  END IF

  [_SPLIT1]:
  NoConcatenate
  LOAD
      RRTeam_raw,
      Salesperson_split_raw,
      Split_raw,
      If(Len(__eff_raw0)>0, Text(__eff_raw0), '') as EffectiveDate_raw,
      If(Len(__exp_raw0)>0, Text(__exp_raw0), '') as ExpirationDate_raw,
      __eff_raw0,
      __exp_raw0,
      $(fNormTeam(RRTeam_raw)) as RRTeam_norm,
      $(fParseSplit(Split_raw)) as Split_num
  RESIDENT _SPLIT0;
  DROP TABLE _SPLIT0;

  // parse_date_to_date (L715-717) on the windows — CUSTOM parser + Floor (.date())
  CALL ParseDateColumn('_SPLIT1', '__eff_raw0', '__eff_dt0');
  CALL ParseDateColumn('_SPLIT1', '__exp_raw0', '__exp_dt0');

  [SPLIT_ALL]:
  NoConcatenate
  LOAD
      *,
      Alt(EffectiveDate_dt, $(vTsMin)) as EffectiveDate_cmp,
      Alt(ExpirationDate_dt, $(vTsMax)) as ExpirationDate_cmp,
      RRTeam_norm & '||' & Date(Alt(EffectiveDate_dt, $(vTsMin)),'YYYYMMDD') & '||' & Date(Alt(ExpirationDate_dt, $(vTsMax)),'YYYYMMDD') as VersionKey;
  LOAD
      RRTeam_raw,
      Salesperson_split_raw,
      Split_raw,
      EffectiveDate_raw,
      ExpirationDate_raw,
      RRTeam_norm,
      Split_num,
      If(Len(__eff_dt0)>0, Floor(__eff_dt0)) as EffectiveDate_dt,
      If(Len(__exp_dt0)>0, Floor(__exp_dt0)) as ExpirationDate_dt
  RESIDENT _SPLIT1;
  DROP TABLE _SPLIT1;

  LET vSplitRowsRead = NoOfRows('SPLIT_ALL');

  // per-row validation flags (L1450-1468)
  [_SPLITF]:
  NoConcatenate
  LOAD
      *,
      If(RRTeam_norm='',1,0) as __f_blank_rr,
      If(Salesperson_split_raw='',1,0) as __f_blank_sales,
      If(Len(Split_num & '')=0,1,0) as __f_invalid_split,
      If(Len(Trim(EffectiveDate_raw))>0 and Len(EffectiveDate_dt & '')=0,1,0) as __f_invalid_eff,
      If(Len(Trim(ExpirationDate_raw))>0 and Len(ExpirationDate_dt & '')=0,1,0) as __f_invalid_exp,
      If(Len(EffectiveDate_dt)>0 and Len(ExpirationDate_dt)>0 and EffectiveDate_dt > ExpirationDate_dt,1,0) as __f_invalid_order
  RESIDENT SPLIT_ALL;
  DROP TABLE SPLIT_ALL;

  // alerts by type (same type order as Python)
  FOR Each _at in 'MISSING_RR_TEAM','MISSING_SALESPERSON','INVALID_SPLIT','INVALID_EFFECTIVE_DATE','INVALID_EXPIRATION_DATE','INVALID_DATE_RANGE'
    LET _fld = Pick(Match('$(_at)','MISSING_RR_TEAM','MISSING_SALESPERSON','INVALID_SPLIT','INVALID_EFFECTIVE_DATE','INVALID_EXPIRATION_DATE','INVALID_DATE_RANGE'),
                    '__f_blank_rr','__f_blank_sales','__f_invalid_split','__f_invalid_eff','__f_invalid_exp','__f_invalid_order');
    LET _dt = Pick(Match('$(_at)','MISSING_RR_TEAM','MISSING_SALESPERSON','INVALID_SPLIT','INVALID_EFFECTIVE_DATE','INVALID_EXPIRATION_DATE','INVALID_DATE_RANGE'),
                   'RR Team is blank.','Salesperson is blank.','Split could not be parsed to a decimal between 0 and 1.','Effective Date could not be parsed.','Expiration Date could not be parsed.','Effective Date is later than Expiration Date.');
    Concatenate(SPLIT_CONFIG_ALERTS)
    LOAD
        '$(_at)' as alert_type,
        RRTeam_raw as [RR Team],
        Salesperson_split_raw as Salesperson,
        Split_raw,
        Split_num,
        EffectiveDate_raw as [Effective Date],
        ExpirationDate_raw as [Expiration Date],
        VersionKey,
        '$(_dt)' as details
    RESIDENT _SPLITF
    WHERE [$(_fld)] = 1;
  NEXT _at

  // usable = no flag at all (L1468-1469)
  [SPLIT_USABLE]:
  NoConcatenate
  LOAD
      RowNo() as __split_row_id,
      RRTeam_raw,
      Salesperson_split_raw,
      Split_raw,
      Split_num,
      EffectiveDate_raw,
      ExpirationDate_raw,
      EffectiveDate_dt,
      ExpirationDate_dt,
      EffectiveDate_cmp,
      ExpirationDate_cmp,
      RRTeam_norm,
      VersionKey
  RESIDENT _SPLITF
  WHERE __f_blank_rr=0 and __f_blank_sales=0 and __f_invalid_split=0
    and __f_invalid_eff=0 and __f_invalid_exp=0 and __f_invalid_order=0;
  DROP TABLE _SPLITF;

  LET vSplitUsableRows = NoOfRows('SPLIT_USABLE');

  IF $(vSplitUsableRows) > 0 THEN
    // split sum per version (L1476-1483)
    [_VSUM]:
    NoConcatenate
    LOAD
        VersionKey,
        Sum(Split_num) as VersionSplitSum
    RESIDENT SPLIT_USABLE
    GROUP BY VersionKey;
    Left Join(SPLIT_USABLE)
    LOAD
        VersionKey,
        VersionSplitSum
    RESIDENT _VSUM;
    DROP TABLE _VSUM;

    [_BADSUM]:
    NoConcatenate
    LOAD
        '§none§' as __bad_vk
    AUTOGENERATE 1;
    Concatenate(_BADSUM)
    LOAD Distinct
        VersionKey as __bad_vk
    RESIDENT SPLIT_USABLE
    WHERE Fabs(VersionSplitSum - 1.0) > $(vSplitSumTolerance);
    Concatenate(SPLIT_CONFIG_ALERTS)
    LOAD
        'CHECK_SPLIT_SUM' as alert_type,
        RRTeam_raw as [RR Team],
        Salesperson_split_raw as Salesperson,
        Split_raw,
        Split_num,
        EffectiveDate_raw as [Effective Date],
        ExpirationDate_raw as [Expiration Date],
        VersionKey,
        'For a given RR Team and the same Effective Date + Expiration Date window, split must sum to 1.00 (100%) within tolerance.' as details
    RESIDENT SPLIT_USABLE
    WHERE Exists(__bad_vk, VersionKey);

    // overlapping windows per team (L1485-1515): pairs with inclusive intersection
    [_WIN]:
    NoConcatenate
    LOAD Distinct
        RRTeam_norm as __w_team,
        VersionKey as __w_vk,
        EffectiveDate_cmp as __w_eff,
        ExpirationDate_cmp as __w_exp
    RESIDENT SPLIT_USABLE;
    [_PAIR]:
    NoConcatenate
    LOAD
        __w_team as __p_team,
        __w_vk as __p_vkA,
        __w_eff as __p_effA,
        __w_exp as __p_expA
    RESIDENT _WIN;
    Left Join(_PAIR)
    LOAD
        __w_team as __p_team,
        __w_vk as __p_vkB,
        __w_eff as __p_effB,
        __w_exp as __p_expB
    RESIDENT _WIN;
    [_OVK]:
    NoConcatenate
    LOAD
        '§none§' as __ovl_vk
    AUTOGENERATE 1;
    Concatenate(_OVK)
    LOAD Distinct
        __p_vkA as __ovl_vk
    RESIDENT _PAIR
    WHERE __p_vkA <> __p_vkB and __p_effB <= __p_expA and __p_effA <= __p_expB;
    DROP TABLES _WIN, _PAIR;

    Concatenate(SPLIT_CONFIG_ALERTS)
    LOAD
        'OVERLAPPING_DATE_WINDOWS' as alert_type,
        RRTeam_raw as [RR Team],
        Salesperson_split_raw as Salesperson,
        Split_raw,
        Split_num,
        EffectiveDate_raw as [Effective Date],
        ExpirationDate_raw as [Expiration Date],
        VersionKey,
        'More than one split version is active for the same RR Team/date range.' as details
    RESIDENT SPLIT_USABLE
    WHERE Exists(__ovl_vk, VersionKey);

    // valid = usable without invalid versions (L1517-1518)
    [SPLIT_VALID]:
    NoConcatenate
    LOAD *
    RESIDENT SPLIT_USABLE
    WHERE not Exists(__bad_vk, VersionKey) and not Exists(__ovl_vk, VersionKey);
    DROP TABLES _BADSUM, _OVK;

    LET vSplitValidRows = Alt(NoOfRows('SPLIT_VALID'), 0);
    IF $(vSplitValidRows) > 0 THEN
      SET vSplitOK = 1;
    ELSE
      TRACE [CASTINE][ERROR] Split Matrix: 0 valid rows after sum/overlap checks (L1532-1534).;
      IF Alt(TableNumber('SPLIT_VALID'), -1) >= 0 THEN
        DROP TABLE SPLIT_VALID;
      END IF
    END IF
  ELSE
    TRACE [CASTINE][ERROR] Split Matrix: 0 usable rows after validation (L1471-1474).;
  END IF
  IF Alt(TableNumber('SPLIT_USABLE'), -1) >= 0 THEN
    DROP TABLE SPLIT_USABLE;
  END IF
ELSE
  IF '$(vApplySplit)' = '1' THEN
    TRACE [CASTINE][ERROR] Could not detect RR Team/Salesperson/Split columns in the Split Matrix (L1380-1387). Configure vSplitSheetCandidates.;
  END IF
END IF

LET vSplitValidRows = If('$(vSplitOK)'='1', Alt(NoOfRows('SPLIT_VALID'),0), 0);
LET vSplitConfigAlerts = NoOfRows('SPLIT_CONFIG_ALERTS');
TRACE [CASTINE] Split valid rows: $(vSplitValidRows) | config alerts: $(vSplitConfigAlerts) | split_ok=$(vSplitOK);
///$tab 06 — XML Split Merge
// [FIX-08] SPLIT MERGE
//   WAS (analyst L419, L578-585): EXISTS on UPPER(RR Team) at read time, then
//        LEFT JOIN on the raw RR Team bringing Salesperson, Split and both dates.
//   PROBLEM: the join never used Effective/Expiration Date, so a team with two
//        date windows got every trade multiplied by both versions; the join is
//        case and space sensitive while the EXISTS was not; trades without a
//        split stayed in the export with an empty Salesperson.
//   NOW (merge_split_and_compute L1599): join on the normalised team key, split
//        version valid on AsOfTradeDate (else TradeDate, else payout date),
//        inclusive window; rows without a match are dropped to an alert file.
// [FIX-09] PRODUCTION EARNED
//   WAS (analyst L603-604): [Gross Comms] * Split, no rounding.
//   NOW (L1679-1690): Commission = round(Cost + AddOn, 10); Production Earned =
//        round(Commission * Split, 2), half-to-even as numpy does.
// ============================================================================
// 06 — XML × SPLIT MERGE (merge_split_and_compute L1599-1694)
//      + team mismatch (build_team_mismatch_alerts L1543-1592, called at L3493-3496)
// RR Team = SalespersonName.strip(); SplitApplyDate = AsOf -> Trade -> process
// date (pd.to_datetime + normalize = Floor); LEFT JOIN on RRTeam_norm
// keeping 1-to-N; INCLUSIVE window filter; drops with a reason.
// ============================================================================

[XML_BASE]:
NoConcatenate
LOAD
    *,
    Trim(SalespersonName) as [RR Team],
    Alt(Floor($(fPdDate(AsOfTradeDate))), Floor($(fPdDate(TradeDate))), $(vPayoutDateNum)) as SplitApplyDateNum
RESIDENT XML_NC;
DROP TABLE XML_NC;

// --- team mismatch: XML (RR Team <> '') vs SPLIT_VALID — unique keys -------
[_MM_XML]:
NoConcatenate
LOAD
    __mm_key,
    FirstValue(__mm_rr) as __mm_example,
    Count(__mm_rr) as __mm_count
GROUP BY __mm_key;
LOAD
    $(fNormTeam([RR Team])) as __mm_key,
    [RR Team] as __mm_rr
RESIDENT XML_BASE
WHERE Len(Trim([RR Team])) > 0;

// valid teams for the drop reason (seed '§none§' guarantees the field)
[_VTEAMS]:
NoConcatenate
LOAD
    '§none§' as __valid_team
AUTOGENERATE 1;
IF '$(vSplitOK)' = '1' THEN
  Concatenate(_VTEAMS)
  LOAD Distinct
      RRTeam_norm as __valid_team
  RESIDENT SPLIT_VALID;
END IF

IF Alt(TableNumber('_MM_XML'), -1) < 0 THEN
  [_MM_XML]:
  NoConcatenate
  LOAD
      '§none§' as __mm_key,
      '' as __mm_example,
      0 as __mm_count
  AUTOGENERATE 1;
END IF
[TEAM_MISMATCH]:
NoConcatenate
LOAD
    '__SEED__' as side,
    '' as key,
    '' as example_original,
    0 as count_rows
AUTOGENERATE 1;
Concatenate(TEAM_MISMATCH)
LOAD
    'XML_ONLY' as side,
    __mm_key as key,
    __mm_example as example_original,
    __mm_count as count_rows
RESIDENT _MM_XML
WHERE __mm_key <> '§none§' and not Exists(__valid_team, __mm_key);

IF '$(vSplitOK)' = '1' THEN
  [_MM_SPLIT]:
  NoConcatenate
  LOAD
      RRTeam_norm as __ms_key,
      FirstValue(RRTeam_raw) as __ms_example,
      Count(RRTeam_raw) as __ms_count
  RESIDENT SPLIT_VALID
  GROUP BY RRTeam_norm;

  Concatenate(TEAM_MISMATCH)
  LOAD
      'SPLIT_ONLY' as side,
      __ms_key as key,
      __ms_example as example_original,
      __ms_count as count_rows
  RESIDENT _MM_SPLIT
  WHERE not Exists(__mm_key, __ms_key);
  DROP TABLE _MM_SPLIT;
END IF
DROP TABLE _MM_XML;

[_TM2]:
NoConcatenate
LOAD *
RESIDENT TEAM_MISMATCH
ORDER BY side, key;
DROP TABLE TEAM_MISMATCH;
RENAME TABLE _TM2 TO TEAM_MISMATCH;

// ---------------------------------------------------------------------------
// SUB ApplySplitDateAware: merge core used by XML (L1599-1694) and REPO
// (L2137-2268) — IDENTICAL semantics in both in the Python (two almost
// identical copies; centralized here to prevent drift).
// Requires in pIn: [RR Team], RRTeam_norm, SplitApplyDateNum, __src_id.
// Produces: <pIn>_MATCHED (with Split_num, Split_raw, Salesperson_split_raw,
//         EffectiveDate_*/ExpirationDate_*, VersionKey) and
//         <pIn>_DROPPED (with drop_reason RRTEAM_EMPTY / SPLIT_MATRIX_NOT_USABLE /
//         RRTEAM_NOT_MAPPED_IN_SPLIT_MATRIX / NO_ACTIVE_SPLIT_FOR_DATE).
// ---------------------------------------------------------------------------
SUB ApplySplitDateAware(pIn)
  // the seed copies the structure of pIn: the alerts read fields even with no drop
  [$(pIn)_DROPPED]:
  NoConcatenate First 1
  LOAD
      *,
      '__SEED__' as drop_reason
  RESIDENT [$(pIn)];

  Concatenate([$(pIn)_DROPPED])
  LOAD
      *,
      'RRTEAM_EMPTY' as drop_reason
  RESIDENT [$(pIn)]
  WHERE Len(Trim([RR Team] & '')) = 0;

  [$(pIn)_REST]:
  NoConcatenate
  LOAD *
  RESIDENT [$(pIn)]
  WHERE Len(Trim([RR Team] & '')) > 0;
  DROP TABLE [$(pIn)];

  IF Alt(NoOfRows('$(pIn)_REST'), 0) > 0 THEN
    IF '$(vSplitOK)' = '0' THEN
      Concatenate([$(pIn)_DROPPED])
      LOAD
          *,
          'SPLIT_MATRIX_NOT_USABLE' as drop_reason
      RESIDENT [$(pIn)_REST];
    ELSE
      // 1-to-N LEFT JOIN on RRTeam_norm (L1639-1655) and window filter (L1657-1662)
      [$(pIn)_MRG]:
      NoConcatenate
      LOAD *
      RESIDENT [$(pIn)_REST];
      Left Join([$(pIn)_MRG])
      LOAD
          __split_row_id,
          RRTeam_norm,
          Split_num,
          Split_raw,
          Salesperson_split_raw,
          EffectiveDate_cmp,
          ExpirationDate_cmp,
          EffectiveDate_raw,
          ExpirationDate_raw,
          VersionKey
      RESIDENT SPLIT_VALID;

      [$(pIn)_MATCHED]:
      NoConcatenate
      LOAD *
      RESIDENT [$(pIn)_MRG]
      WHERE Len(EffectiveDate_cmp & '') > 0
        and SplitApplyDateNum >= EffectiveDate_cmp
        and SplitApplyDateNum <= ExpirationDate_cmp;

      // Exists sees values from earlier calls: the field is exclusive to pIn
      [_MIDS]:
      NoConcatenate
      LOAD
          -1 as [__matched$(pIn)]
      AutoGenerate 1;
      IF Alt(NoOfRows('$(pIn)_MATCHED'), 0) > 0 THEN
        Concatenate(_MIDS)
        LOAD Distinct
            __src_id as [__matched$(pIn)]
        RESIDENT [$(pIn)_MATCHED];
      END IF

      Concatenate([$(pIn)_DROPPED])
      LOAD
          *,
          If(Exists(__valid_team, RRTeam_norm), 'NO_ACTIVE_SPLIT_FOR_DATE', 'RRTEAM_NOT_MAPPED_IN_SPLIT_MATRIX') as drop_reason
      RESIDENT [$(pIn)_REST]
      WHERE not Exists([__matched$(pIn)], __src_id);

      DROP TABLES _MIDS, [$(pIn)_MRG];
    END IF
  END IF
  IF Alt(TableNumber('$(pIn)_REST'), -1) >= 0 THEN
    DROP TABLE [$(pIn)_REST];
  END IF
END SUB


// applies to the XML
[_XMLM]:
NoConcatenate
LOAD
    *,
    $(fNormTeam([RR Team])) as RRTeam_norm,
    RowNo() as __src_id
RESIDENT XML_BASE;
DROP TABLE XML_BASE;

CALL ApplySplitDateAware('_XMLM');

// calculations (L1674-1691): Commission = round10(cost0 + addon0);
// Production = round2(Commission * split) — HALF-TO-EVEN (numpy)
IF Alt(NoOfRows('_XMLM_MATCHED'), 0) > 0 THEN
  [XML_MAPPED]:
  NoConcatenate
  LOAD
      *,
      $(fRound2(Commission_total_numeric * Split_num)) as ProductionEarned;
  LOAD
      *,
      Trim(Salesperson_split_raw) & '' as Salesperson,
      $(fRound10(__comm_raw)) as Commission_total_numeric;
  LOAD
      *,
      Alt(Cost_original_numeric,0) + Alt(AddOn_numeric,0) as __comm_raw
  RESIDENT _XMLM_MATCHED;
  DROP TABLE _XMLM_MATCHED;
ELSEIF Alt(TableNumber('_XMLM_MATCHED'), -1) >= 0 THEN
  DROP TABLE _XMLM_MATCHED;
END IF

LET vXmlRowsMapped = Alt(NoOfRows('XML_MAPPED'), 0);
LET vXmlRowsDropped = Alt(NoOfRows('_XMLM_DROPPED'), 1) - 1;   // -1 for the seed
TRACE [CASTINE] rows_before_split_merge: $(vRowsAfterCancels);
TRACE [CASTINE] rows_mapped: $(vXmlRowsMapped) | rows_dropped_unmapped: $(vXmlRowsDropped);

// split_unmapped alert file (columns main L3521-3546)
[ALERT_SPLIT_UNMAPPED]:
NoConcatenate
LOAD
    If(drop_reason='__SEED__', '__SEED__', TransactionNumber) as TransactionNumber,
    [RR Team],
    '' as Salesperson,
    '' as Split_raw,
    Null() as Split_num,
    Cost_original,
    AddOn_original,
    Cost_original_numeric,
    AddOn_numeric,
    Null() as Commission_total_numeric,
    $(fPrefixApos(CustomerAccountCounterparty)) as CustomerAccountCounterparty,
    MasterAccountName,
    Ticker,
    MaturityDateExpirationDate,
    source_file,
    file_date_token,
    drop_reason
RESIDENT _XMLM_DROPPED;
DROP TABLE _XMLM_DROPPED;
// (the __SEED__ row stays until export, where it is filtered out)
///$tab 07 — XML Official Output & Non-USD
// [FIX-10] CURRENCY
//   WAS (analyst L408, L485, L502): 'USD' AS Currency commented out (Currency
//        empty on XML rows) and Currency = 'USD' applied to the COST lines.
//   PROBLEM: a trade on a non-USD security stayed in the export.
//   NOW (build_official_output L1759, exclude_xml_nonusd_from_output L1781):
//        Currency = SecurityCurrencyISOCode; XML rows whose currency is blank or
//        not USD are excluded to xml_nonusd_excluded_alerts.csv.
// [FIX-11] TRADE DATE (part 1)
//   WAS (analyst L384): Trade Date of the version that survived.
//   NOW (build_official_output L1716-1717): Trade Date of the ORIGINAL version
//        (1st non-empty TradeDate of the chain). Part 2 is in tab 10.
// [FIX-16] OUTPUT LAYOUT (part 1)
//   WAS (analyst L597-628): Sec Type and Sec Type Description commented out,
//        extra technical columns (Gross Comms LEN, key, file name).
//   NOW (OFFICIAL_OUTPUT_COLUMNS L190): the 23 official columns, Sec Type from
//        ExtendedFields SECURITY_TYP / MARKET_SECTOR_DES.
// ============================================================================
// 07 — build_official_output (L1701-1778) + exclude_xml_nonusd (L1781-1808)
// ============================================================================
IF $(vXmlRowsMapped) > 0 and Alt(TableNumber('XML_MAPPED'),-1) >= 0 THEN
  // output dates use the CUSTOM parser (fmt_mdy_no_zeros -> parse_date_to_datetime)
  CALL ParseDateColumn('XML_MAPPED', 'AsOfTradeDate', '__asof_out_dt');

  [_OFF0]:
  NoConcatenate
  LOAD
      *,
      // Trade Date: non-empty OriginalVersionTradeDate else TradeDate (L1714-1717)
      If(Len(Trim(OriginalVersionTradeDate))>0, Trim(OriginalVersionTradeDate), Trim(TradeDate)) as __td_src
  RESIDENT XML_MAPPED;
  DROP TABLE XML_MAPPED;
  CALL ParseDateColumn('_OFF0', '__td_src', '__td_out_dt');

  [XML_PAYOUT]:
  NoConcatenate
  LOAD
      $(fFmtMDY(__asof_out_dt)) as [As of trade date],
      If(Len(Trim(MasterAccountName))>0, Trim(MasterAccountName), Trim(AccountCounterpartyShortName)) as [Client],
      Trim(SecurityIdentifier) as [Security],
      Trim(TransactionNumber) as [Trade Id],
      Salesperson as [Salesperson],
      ProductionEarned as [Production Earned],
      ProductionEarned as [Payout Earned],
      Trim(TraderAccountNumber) as [Trader Team Name],
      '' as [Fidelity #],
      Trim(TraderAccountName) as [ShortDesc],
      Trim(OMReasonCode) as [TradeType],
      $(fFmtMDY(__td_out_dt)) as [Trade Date],
      Trim([RR Team]) as [RR Team],
      'Bloomberg XML' as [Source],
      Trim(SECURITY_TYP) as [Sec Type],
      Trim(MARKET_SECTOR_DES) as [Sec Type Description],
      Trim(Trim(Ticker) & ' ' & Trim(MaturityDateExpirationDate)) as [Security Description],
      $(fRound2(Commission_total_numeric)) as [Gross Comms],
      $(fPrefixApos(CustomerAccountCounterparty)) as [Acct Short Description],
      Trim(SecurityCurrencyISOCode) as [Currency],
      Trim(BuySellCoverShortFlag) as [BuySell],
      Trim(TradeAmount) as [TradeAmount],
      '' as [GLCS CODE],
      If(VersionCount > 1, 1, 0) as [_XML_ModifiedVersionChain]
  RESIDENT _OFF0;
  DROP TABLE _OFF0;

  // exclude_xml_nonusd_from_output (L1781-1808)
  [ALERT_XML_NONUSD]:
  NoConcatenate
  LOAD
      [As of trade date],
      [Client],
      [Security],
      [Trade Id],
      [Salesperson],
      [Production Earned],
      [Payout Earned],
      [Trader Team Name],
      [Fidelity #],
      [ShortDesc],
      [TradeType],
      [Trade Date],
      [RR Team],
      [Source],
      [Sec Type],
      [Sec Type Description],
      [Security Description],
      [Gross Comms],
      [Acct Short Description],
      [Currency],
      [BuySell],
      [TradeAmount],
      [GLCS CODE],
      $(fNormCurrency([Currency])) as Currency_norm,
      If($(fNormCurrency([Currency]))='', 'XML_CURRENCY_BLANK_EXCLUDED', 'XML_CURRENCY_NONUSD_EXCLUDED') as alert_reason
  RESIDENT XML_PAYOUT
  WHERE $(fNormCurrency([Currency])) <> 'USD';

  [_XP2]:
  NoConcatenate
  LOAD *
  RESIDENT XML_PAYOUT
  WHERE $(fNormCurrency([Currency])) = 'USD';
  DROP TABLE XML_PAYOUT;
  IF Alt(TableNumber('_XP2'), -1) >= 0 THEN
    RENAME TABLE _XP2 TO XML_PAYOUT;
  END IF
ELSE
  TRACE [CASTINE][WARN] 0 XML rows mapped — XML part of the payout is empty (L3507-3510).;
  IF Alt(TableNumber('XML_MAPPED'),-1) >= 0 THEN
    DROP TABLE XML_MAPPED;
  END IF
END IF

LET vXmlRowsKept = Alt(NoOfRows('XML_PAYOUT'), 0);
LET vXmlNonUsdExcluded = Alt(NoOfRows('ALERT_XML_NONUSD'), 0);
TRACE [CASTINE] XML rows kept: $(vXmlRowsKept) | NON-USD excluded: $(vXmlNonUsdExcluded);
///$tab 08 — Repo (Broadridge)
// [FIX-13] REPO
//   WAS (analyst L545-569): SalesPerson AS [RR Team] commented out (L557) and a
//        fixed path Reports/<date>/YTDSalesCommission_<date>.csv.
//   PROBLEM: Repo rows had no RR Team, so the split join found nothing and
//        Production Earned was empty.
//   NOW (find_repo_daily_file_in_date_folder L2359, prepare_repo_daily_output
//        L2414, build_repo_official_output L2178): file search by prefix inside
//        the date folder, RR Team from the SalesPerson column, same date-aware
//        split as the XML, unmapped rows to repo_unmapped_alerts.csv.
// ============================================================================
// 08 — REPO: discovery (find_repo_daily_file_in_date_folder L2318-2368),
// read (L1986-2024), column detection (L2027-2072),
// transformation (build_repo_official_output L2137-2314).
// ============================================================================
SET vRepoPath = '';

// 1) exact names: prefix + yyyymmdd + ('', .csv, .txt)  (L2331-2337)
FOR Each _pref in $(vRepoPrefixList)
  FOR Each _extTok in 'NOEXT', '.csv', '.txt'
    LET _ext = If('$(_extTok)'='NOEXT', '', '$(_extTok)');
    IF Len('$(vRepoPath)') = 0 THEN
      LET _cand = '$(vLibRepo)$(vPayoutYYYYMMDD)/$(_pref)$(vPayoutYYYYMMDD)$(_ext)';
      IF Alt(FileSize('$(_cand)'), -1) >= 0 THEN
        LET vRepoPath = '$(_cand)';
      END IF
    END IF
  NEXT _extTok
NEXT _pref

// 2) scan of the date folder: prefix + date in the name digits (L2339-2348)
//    3) relaxes the date requirement (L2350-2358). The LATEST mtime wins (tie: last one).
IF Len('$(vRepoPath)') = 0 THEN
  FOR _pass = 1 to 2
    IF Len('$(vRepoPath)') = 0 THEN
      LET _bestTime = 0;
      FOR Each _vF in FileList('$(vLibRepo)$(vPayoutYYYYMMDD)/*')
        // A file name with an apostrophe would break every '$(_vF)' below.
        // It is tested by variable NAME (no expansion) and the file is ignored.
        IF Index(_vF, Chr(39)) = 0 THEN
          LET _vB = SubField(SubField('$(_vF)','\',-1),'/',-1);
          LET _vExt = If(Index('$(_vB)','.')>0, Lower(Mid('$(_vB)', Index('$(_vB)','.',-1))), '');
          IF Match('$(_vExt)', '', '.csv', '.txt') > 0 THEN
            LET _hasPref = 0;
            FOR Each _pref in $(vRepoPrefixList)
              IF Lower(Left('$(_vB)', Len('$(_pref)'))) = Lower('$(_pref)') THEN
                LET _hasPref = 1;
              END IF
            NEXT _pref
            LET _digOK = If($(_pass)=1, If(Index(KeepChar('$(_vB)','0123456789'), '$(vPayoutYYYYMMDD)')>0, 1, 0), 1);
            IF $(_hasPref) = 1 and $(_digOK) = 1 THEN
              LET _ft = Alt(Num(FileTime('$(_vF)')), 0);
              IF $(_ft) >= $(_bestTime) THEN
                LET _bestTime = $(_ft);
                LET vRepoPath = '$(_vF)';
              END IF
            END IF
          END IF
        ELSE
          TRACE [CASTINE][WARN] File ignored, apostrophe in its name: $(_vF);
        END IF
      NEXT _vF
    END IF
  NEXT _pass
END IF

SET vRepoRowsTotal = 0;
SET vRepoEmptyRR = 0;
SET vRepoWithSplit = 0;
SET vRepoWithoutSplit = 0;
SET vRepoDroppedTotal = 0;

IF Len('$(vRepoPath)') = 0 THEN
  TRACE [CASTINE][WARN] Daily repo not found in $(vLibRepo)$(vPayoutYYYYMMDD)/ (L3561-3563).;
ELSE
  TRACE [CASTINE] Repo file: $(vRepoPath);

  // --- delimiter: heuristic on the 1st non-empty line (Python fallback L1996-2002;
  //     the primary csv.Sniffer has no native equivalent — documented divergence,
  //     covered by the reconciliation).
  CALL DetectCodepage('$(vRepoPath)', 'vRepoCp');
  [_RPROBE]:
  NoConcatenate FIRST 20
  LOAD
      RecNo() as _rn,
      @1:n as _line
  FROM [$(vRepoPath)]
  (fix, $(vRepoCp), no labels, record is line);
  LET vRepoDelim = ',';
  FOR _ri = 0 to Alt(NoOfRows('_RPROBE'),1) - 1
    LET _vLine = Peek('_line', $(_ri), '_RPROBE');
    IF Len(Trim(_vLine)) > 0 THEN
      LET _nC = SubStringCount(_vLine, ',');
      LET _nS = SubStringCount(_vLine, ';');
      LET _nP = SubStringCount(_vLine, '|');
      LET _nT = SubStringCount(_vLine, Chr(9));
      LET _mx = RangeMax($(_nC), $(_nS), $(_nP), $(_nT));
      // tie-break order identical to the Python dict: ',' ';' '|' '\t'
      LET vRepoDelim = If($(_mx)=0, ',', If($(_nC)=$(_mx), ',', If($(_nS)=$(_mx), ';', If($(_nP)=$(_mx), '|', 'TAB'))));
      EXIT FOR
    END IF
  NEXT _ri
  IF Alt(TableNumber('_RPROBE'), -1) >= 0 THEN
    DROP TABLE _RPROBE;
  END IF
  TRACE [CASTINE] Repo delimiter: [$(vRepoDelim)];

  // --- headers (for detect_repo_columns) -----------------------------------
  IF '$(vRepoDelim)' = 'TAB' THEN
    [_RHDR]:
    NoConcatenate FIRST 1
    LOAD *
    FROM [$(vRepoPath)]
    (txt, $(vRepoCp), no labels, delimiter is '\t', msq);
  ELSE
    [_RHDR]:
    NoConcatenate FIRST 1
    LOAD *
    FROM [$(vRepoPath)]
    (txt, $(vRepoCp), no labels, delimiter is '$(vRepoDelim)', msq);
  END IF

  // _pick_repo_col (L2027-2041): EXACT (1st of the exact list in column order)
  // else CONTAINS. Implemented per key:
  SUB PickRepoCol(pExacts, pContains, pOutVar)
    LET $(pOutVar) = '';
    LET $(pOutVar)_ix = 0;
    LET _lstE = Chr(39) & Replace('$(pExacts)', ';', Chr(39) & ',' & Chr(39)) & Chr(39);
    FOR Each _wanted in $(_lstE)
      IF Len('$($(pOutVar))') = 0 THEN
        FOR _ci = 1 to NoOfFields('_RHDR')
          LET _hv = Trim(Peek(FieldName($(_ci),'_RHDR'), 0, '_RHDR'));
          LET _hn = KeepChar(Lower('$(_hv)'), 'abcdefghijklmnopqrstuvwxyz0123456789');
          IF Len('$($(pOutVar))') = 0 and '$(_hn)' = '$(_wanted)' THEN
            LET $(pOutVar) = '$(_hv)';
            LET $(pOutVar)_ix = $(_ci);
          END IF
        NEXT _ci
      END IF
    NEXT _wanted
    IF Len('$($(pOutVar))') = 0 THEN
      LET _lstC = Chr(39) & Replace('$(pContains)', ';', Chr(39) & ',' & Chr(39)) & Chr(39);
      FOR Each _wanted in $(_lstC)
        IF Len('$($(pOutVar))') = 0 THEN
          FOR _ci = 1 to NoOfFields('_RHDR')
            LET _hv = Trim(Peek(FieldName($(_ci),'_RHDR'), 0, '_RHDR'));
            LET _hn = KeepChar(Lower('$(_hv)'), 'abcdefghijklmnopqrstuvwxyz0123456789');
            IF Len('$($(pOutVar))') = 0 and Index('$(_hn)', '$(_wanted)') > 0 THEN
              LET $(pOutVar) = '$(_hv)';
              LET $(pOutVar)_ix = $(_ci);
            END IF
          NEXT _ci
        END IF
      NEXT _wanted
    END IF
  END SUB

  CALL PickRepoCol('td;tradedate;asoftradedate', 'td;tradedate', 'vRC_td');
  CALL PickRepoCol('account;acct;accountname', 'account;acct', 'vRC_account');
  CALL PickRepoCol('cusip', 'cusip', 'vRC_cusip');
  CALL PickRepoCol('trans;transno;transnum;transnumber', 'trans', 'vRC_trans');
  CALL PickRepoCol('salesperson;salespersonname', 'salesperson', 'vRC_sales');
  CALL PickRepoCol('trader;tradername', 'trader', 'vRC_trader');
  CALL PickRepoCol('trtype;tradetype', 'trtype;tradetype', 'vRC_trtype');
  CALL PickRepoCol('assetclass;assettype', 'assetclass', 'vRC_asset');
  CALL PickRepoCol('securitydescription;securitydesc', 'securitydescription;securitydesc', 'vRC_secdesc');
  CALL PickRepoCol('netcredit;commission;grosscommission', 'netcredit', 'vRC_net');
  CALL PickRepoCol('principal;tradeamount;paramount', 'principal;tradeamount', 'vRC_prin');
  DROP TABLE _RHDR;
  TRACE [CASTINE][REPO] td='$(vRC_td)' account='$(vRC_account)' cusip='$(vRC_cusip)' trans='$(vRC_trans)' sales='$(vRC_sales)' trader='$(vRC_trader)' trtype='$(vRC_trtype)' asset='$(vRC_asset)' secdesc='$(vRC_secdesc)' net='$(vRC_net)' principal='$(vRC_prin)';

  // --- load with POSITION labels (@ix) — avoids name collisions ----------
  SUB RepoColExpr(pIxVar, pOut)
    IF Len('$($(pIxVar))') > 0 THEN
      LET vRepoSel = '$(vRepoSel)' & If(Len('$(vRepoSel)')>0, ', ', '') & 'Trim(Text(@' & $($(pIxVar)_ix) & ')) as [' & '$(pOut)' & ']';
    ELSE
      LET vRepoSel = '$(vRepoSel)' & If(Len('$(vRepoSel)')>0, ', ', '') & 'Repeat(Chr(32),0) as [' & '$(pOut)' & ']';
    END IF
  END SUB
  SET vRepoSel = '';
  CALL RepoColExpr('vRC_td', 'T_D');
  CALL RepoColExpr('vRC_account', 'Account');
  CALL RepoColExpr('vRC_cusip', 'Cusip');
  CALL RepoColExpr('vRC_trans', 'Trans');
  CALL RepoColExpr('vRC_sales', 'RepoSalesPerson');
  CALL RepoColExpr('vRC_trader', 'Trader');
  CALL RepoColExpr('vRC_trtype', 'TR_TYPE');
  CALL RepoColExpr('vRC_asset', 'AssetClass');
  CALL RepoColExpr('vRC_secdesc', 'SecurityDescription');
  CALL RepoColExpr('vRC_net', 'NetCredit_raw');
  CALL RepoColExpr('vRC_prin', 'Principal');

  IF '$(vRepoDelim)' = 'TAB' THEN
    [_REPO0]:
    NoConcatenate
    LOAD
        $(vRepoSel),
        RecNo() as __repo_rec
    FROM [$(vRepoPath)]
    (txt, $(vRepoCp), no labels, header is 1 lines, delimiter is '\t', msq);
  ELSE
    [_REPO0]:
    NoConcatenate
    LOAD
        $(vRepoSel),
        RecNo() as __repo_rec
    FROM [$(vRepoPath)]
    (txt, $(vRepoCp), no labels, header is 1 lines, delimiter is '$(vRepoDelim)', msq);
  END IF

  LET vRepoRowsTotal = Alt(NoOfRows('_REPO0'), 0);
  TRACE [CASTINE][REPO] rows_total: $(vRepoRowsTotal);

  IF $(vRepoRowsTotal) = 0 and Alt(TableNumber('_REPO0'), -1) >= 0 THEN
    DROP TABLE _REPO0;
  END IF
  IF $(vRepoRowsTotal) > 0 THEN
  // --- work: dates, keys, values (L2174-2196) --------------------------
  CALL ParseDateColumn('_REPO0', 'T_D', '__td_dt');     // CUSTOM parse_date_to_datetime
  CALL ParseCostColumn('_REPO0', 'NetCredit_raw', 'NetCredit_num');

  [_REPOB]:
  NoConcatenate
  LOAD
      *,
      $(fFmtMDY(SplitApplyDateNum)) as T_D_output;
  LOAD
      *,
      Trim(RepoSalesPerson) as [RR Team],
      $(fNormTeam(RepoSalesPerson)) as RRTeam_norm,
      Alt(Floor(__td_dt), $(vPayoutDateNum)) as SplitApplyDateNum,
      SubField(SubField('$(vRepoPath)','\',-1),'/',-1) as repo_source_file,
      __repo_rec as __src_id
  RESIDENT _REPO0;
  DROP TABLE _REPO0;
  DROP FIELDS __td_dt, __repo_rec FROM _REPOB;

  CALL ApplySplitDateAware('_REPOB');

  // --- repo official output (L2270-2301) -------------------------------------
  IF Alt(NoOfRows('_REPOB_MATCHED'), 0) > 0 THEN
    [REPO_PAYOUT]:
    NoConcatenate
    LOAD
        T_D_output as [As of trade date],
        Account as [Client],
        Cusip as [Security],
        Trans as [Trade Id],
        Trim(Salesperson_split_raw) & '' as [Salesperson],
        $(fRound2(NetCredit_num * Split_num)) as [Production Earned],
        $(fRound2(NetCredit_num * Split_num)) as [Payout Earned],
        Trader as [Trader Team Name],
        '' as [Fidelity #],
        Trader as [ShortDesc],
        TR_TYPE as [TradeType],
        T_D_output as [Trade Date],
        [RR Team],
        '$(vRepoSource)' as [Source],
        AssetClass as [Sec Type],
        AssetClass as [Sec Type Description],
        SecurityDescription as [Security Description],
        $(fRound2(NetCredit_num)) as [Gross Comms],
        $(fPrefixApos(Account)) as [Acct Short Description],
        '$(vRepoCurrency)' as [Currency],
        '$(vRepoBuySell)' as [BuySell],
        Principal as [TradeAmount],
        '' as [GLCS CODE]
    RESIDENT _REPOB_MATCHED;
    LET vRepoWithSplit = NoOfRows('REPO_PAYOUT');
    DROP TABLE _REPOB_MATCHED;
  ELSE
    IF Alt(TableNumber('_REPOB_MATCHED'),-1) >= 0 THEN
      DROP TABLE _REPOB_MATCHED;
    END IF
  END IF

  // --- repo alerts (build_repo_dropped_alerts L2085-2133) ----------------
  IF Alt(TableNumber('_REPOB_DROPPED'), -1) >= 0 THEN
    [ALERT_REPO_UNMAPPED]:
    NoConcatenate
    LOAD
        If(drop_reason='__SEED__', '__SEED__', Trans) as [Trade Id],
        [RR Team],
        '' as [Salesperson],
        '' as [Split_raw],
        Null() as [Split_num],
        NetCredit_raw as [Net Credit],
        NetCredit_num as [Net Credit numeric],
        Account as [Account],
        $(fPrefixApos(Cusip)) as [Cusip],
        Trader as [Trader],
        T_D_output as [T/D],
        TR_TYPE as [TR/TYPE],
        AssetClass as [AssetClass],
        SecurityDescription as [SecurityDescription],
        Principal as [Principal],
        repo_source_file,
        drop_reason
    RESIDENT _REPOB_DROPPED;
    LET vRepoDroppedTotal = NoOfRows('ALERT_REPO_UNMAPPED') - 1;   // -1 for the seed
    [_tmpC]:
    NoConcatenate
    LOAD
        Count(If(drop_reason='RRTEAM_EMPTY',1)) as _c
    RESIDENT ALERT_REPO_UNMAPPED;
    LET vRepoEmptyRR = Alt(Peek('_c',0,'_tmpC'),0);
    DROP TABLE _tmpC;
    LET vRepoWithoutSplit = $(vRepoDroppedTotal) - $(vRepoEmptyRR);
    DROP TABLE _REPOB_DROPPED;
  END IF
  END IF   // repo with rows
END IF

LET vRepoWithSplit = Alt($(vRepoWithSplit), 0);
TRACE [CASTINE][REPO] with_split=$(vRepoWithSplit) empty_rr=$(vRepoEmptyRR) without_split=$(vRepoWithoutSplit) dropped_total=$(vRepoDroppedTotal);
///$tab 09 — Manual Adjustments
// [FIX-14] MANUAL ADJUSTMENTS
//   WAS: not loaded by the analyst script.
//   NOW (find_adjustments_file L2499, prepare_adjustments_output L2601): the
//        "adjustments DailyExportOfPayout_<date>" file is appended as is.
// ============================================================================
// 09 — ADJUSTMENTS (find_adjustments_file L2458-2507, read L2510-2532,
//      align_dataframe_to_final_output_columns L2535-2557,
//      prepare_adjustments_output L2560-2601)
// ============================================================================
SET vAdjPath = '';
SET vAdjRows = 0;

// exact: prefix+date+ext -> prefix+ext (L2471-2481)
FOR Each _pref in $(vAdjPrefixList)
  FOR Each _extTok in 'NOEXT', '.csv', '.txt', '.xlsx', '.xlsm', '.xls'
    LET _ext = If('$(_extTok)'='NOEXT', '', '$(_extTok)');
    IF Len('$(vAdjPath)') = 0 THEN
      LET _cand = '$(vLibSalesData)$(_pref)$(vPayoutYYYYMMDD)$(_ext)';
      IF Alt(FileSize('$(_cand)'), -1) >= 0 THEN
        LET vAdjPath = '$(_cand)';
      END IF
    END IF
  NEXT _extTok
NEXT _pref
IF Len('$(vAdjPath)') = 0 THEN
  FOR Each _pref in $(vAdjPrefixList)
    FOR Each _extTok in 'NOEXT', '.csv', '.txt', '.xlsx', '.xlsm', '.xls'
      LET _ext = If('$(_extTok)'='NOEXT', '', '$(_extTok)');
      IF Len('$(vAdjPath)') = 0 THEN
        LET _cand = '$(vLibSalesData)$(_pref)$(_ext)';
        IF Alt(FileSize('$(_cand)'), -1) >= 0 THEN
          LET vAdjPath = '$(_cand)';
        END IF
      END IF
    NEXT _extTok
  NEXT _pref
END IF
// scan: prefix + date in the digits -> prefix (latest by mtime; L2483-2507)
IF Len('$(vAdjPath)') = 0 THEN
  FOR _pass = 1 to 2
    IF Len('$(vAdjPath)') = 0 THEN
      LET _bestTime = 0;
      FOR Each _vF in FileList('$(vLibSalesData)*')
        // A file name with an apostrophe would break every '$(_vF)' below.
        // It is tested by variable NAME (no expansion) and the file is ignored.
        IF Index(_vF, Chr(39)) = 0 THEN
          LET _vB = SubField(SubField('$(_vF)','\',-1),'/',-1);
          LET _vExt = If(Index('$(_vB)','.')>0, Lower(Mid('$(_vB)', Index('$(_vB)','.',-1))), '');
          IF Match('$(_vExt)', '', '.csv', '.txt', '.xlsx', '.xlsm', '.xls') > 0 THEN
            LET _hasPref = 0;
            FOR Each _pref in $(vAdjPrefixList)
              IF Lower(Left('$(_vB)', Len('$(_pref)'))) = Lower('$(_pref)') THEN
                LET _hasPref = 1;
              END IF
            NEXT _pref
            LET _digOK = If($(_pass)=1, If(Index(KeepChar('$(_vB)','0123456789'), '$(vPayoutYYYYMMDD)')>0, 1, 0), 1);
            IF $(_hasPref) = 1 and $(_digOK) = 1 THEN
              LET _ft = Alt(Num(FileTime('$(_vF)')), 0);
              IF $(_ft) >= $(_bestTime) THEN
                LET _bestTime = $(_ft);
                LET vAdjPath = '$(_vF)';
              END IF
            END IF
          END IF
        ELSE
          TRACE [CASTINE][WARN] File ignored, apostrophe in its name: $(_vF);
        END IF
      NEXT _vF
    END IF
  NEXT _pass
END IF

IF Len('$(vAdjPath)') = 0 THEN
  TRACE [CASTINE][ADJ][WARN] No adjustments file in Sales\Data (L3602-3603). Final = XML + Repo.;
ELSE
  TRACE [CASTINE][ADJ] Adjustments: $(vAdjPath);
  LET _adjExt = Lower(Mid('$(vAdjPath)', Index('$(vAdjPath)','.',-1)));
  SET ErrorMode = 0;
  IF Match('$(_adjExt)', '.xlsx', '.xlsm', '.xls') > 0 THEN
    // .xls is the old Excel format: biff, and its sheet names end with a dollar sign
    LET _adjFmt = If('$(_adjExt)' = '.xls', 'biff', 'ooxml');
    LET _adjSfx = If('$(_adjExt)' = '.xls', Chr(36), '');
    // Python reads sheet_name=0 (the first sheet). Without "table is" Qlik reads the
    // first sheet too; if that does not load, the candidate sheet names are tried.
    [_ADJ0]:
    NoConcatenate
    LOAD *
    FROM [$(vAdjPath)]
    ($(_adjFmt), embedded labels);
    FOR Each _vSheet in $(vAdjSheetList)
      IF Alt(TableNumber('_ADJ0'), -1) < 0 THEN
        [_ADJ0]:
        NoConcatenate
        LOAD *
        FROM [$(vAdjPath)]
        ($(_adjFmt), embedded labels, table is [$(_vSheet)$(_adjSfx)]);
      END IF
    NEXT _vSheet
  ELSE
    // delimiter: same heuristic as the repo (adjustments_csv_delimiter=None -> autodetect)
    CALL DetectCodepage('$(vAdjPath)', 'vAdjCp');
    [_APROBE]:
    NoConcatenate FIRST 20
    LOAD
        RecNo() as _rn,
        @1:n as _line
    FROM [$(vAdjPath)]
    (fix, $(vAdjCp), no labels, record is line);
    LET vAdjDelim = ',';
    FOR _ri = 0 to Alt(NoOfRows('_APROBE'),1) - 1
      LET _vLine = Peek('_line', $(_ri), '_APROBE');
      IF Len(Trim(_vLine)) > 0 THEN
        LET _nC = SubStringCount(_vLine, ',');
        LET _nS = SubStringCount(_vLine, ';');
        LET _nP = SubStringCount(_vLine, '|');
        LET _nT = SubStringCount(_vLine, Chr(9));
        LET _mx = RangeMax($(_nC), $(_nS), $(_nP), $(_nT));
        LET vAdjDelim = If($(_mx)=0, ',', If($(_nC)=$(_mx), ',', If($(_nS)=$(_mx), ';', If($(_nP)=$(_mx), '|', 'TAB'))));
        EXIT FOR
      END IF
    NEXT _ri
    DROP TABLE _APROBE;
    IF '$(vAdjDelim)' = 'TAB' THEN
      CALL BuildTextSel('$(vAdjPath)', 'txt, $(vAdjCp), embedded labels, delimiter is ''\t'', msq', 'vAdjTxt');
      [_ADJ0]:
      NoConcatenate
      LOAD
          $(vAdjTxt)
      FROM [$(vAdjPath)]
      (txt, $(vAdjCp), embedded labels, delimiter is '\t', msq);
    ELSE
      CALL BuildTextSel('$(vAdjPath)', 'txt, $(vAdjCp), embedded labels, delimiter is ''$(vAdjDelim)'', msq', 'vAdjTxt');
      [_ADJ0]:
      NoConcatenate
      LOAD
          $(vAdjTxt)
      FROM [$(vAdjPath)]
      (txt, $(vAdjCp), embedded labels, delimiter is '$(vAdjDelim)', msq);
    END IF
  END IF
  SET ErrorMode = 1;

  IF Alt(TableNumber('_ADJ0'), -1) < 0 THEN
    TRACE [CASTINE][ADJ][ERROR] Failed to read adjustments (L3613-3623). Adjustments empty.;
  ELSE
    // align_dataframe_to_final_output_columns: header_norm -> official column.
    // Collision of 2 columns on the same target = failure (mirrors the Python exception,
    // swallowed at the call site -> empty adjustments).
    SET vAdjSel = '';
    SET vAdjDup = 0;
    FOR Each _target in 'As of trade date','Client','Security','Trade Id','Salesperson','Production Earned','Payout Earned','Trader Team Name','Fidelity #','ShortDesc','TradeType','Trade Date','RR Team','Source','Sec Type','Sec Type Description','Security Description','Gross Comms','Acct Short Description','Currency','BuySell','TradeAmount','GLCS CODE'
      LET _tn = KeepChar(Lower('$(_target)'), 'abcdefghijklmnopqrstuvwxyz0123456789');
      LET _found = '';
      LET _nfound = 0;
      FOR _ci = 1 to NoOfFields('_ADJ0')
        LET _cn = FieldName($(_ci), '_ADJ0');
        LET _cnn = KeepChar(Lower('$(_cn)'), 'abcdefghijklmnopqrstuvwxyz0123456789');
        IF '$(_cnn)' = '$(_tn)' THEN
          LET _nfound = $(_nfound) + 1;
          IF Len('$(_found)') = 0 THEN
            LET _found = '$(_cn)';
          END IF
        END IF
      NEXT _ci
      IF $(_nfound) > 1 THEN
        SET vAdjDup = 1;
      END IF
      LET vAdjSel = '$(vAdjSel)' & If(Len('$(vAdjSel)')>0, ', ', '') &
        If(Len('$(_found)')>0, '[' & '$(_found)' & ']', 'Repeat(Chr(32),0)') & ' as [' & '$(_target)' & ']';
    NEXT _target

    IF '$(vAdjDup)' = '1' THEN
      TRACE [CASTINE][ADJ][ERROR] Duplicate columns after header normalization — adjustments discarded (parity with the exception swallowed in Python).;
      DROP TABLE _ADJ0;
    ELSE
      [ADJ_PAYOUT]:
      NoConcatenate
      LOAD
          $(vAdjSel)
      RESIDENT _ADJ0;
      DROP TABLE _ADJ0;
      // money columns via parse_cost_original_to_float (L2554-2556)
      CALL ParseCostColumn('ADJ_PAYOUT', 'Production Earned', '__adj_pe');
      CALL ParseCostColumn('ADJ_PAYOUT', 'Payout Earned', '__adj_py');
      CALL ParseCostColumn('ADJ_PAYOUT', 'Gross Comms', '__adj_gc');
      [_ADJ2]:
      NoConcatenate
      LOAD
          [As of trade date],
          [Client],
          [Security],
          [Trade Id],
          [Salesperson],
          __adj_pe as [Production Earned],
          __adj_py as [Payout Earned],
          [Trader Team Name],
          [Fidelity #],
          [ShortDesc],
          [TradeType],
          [Trade Date],
          [RR Team],
          [Source],
          [Sec Type],
          [Sec Type Description],
          [Security Description],
          __adj_gc as [Gross Comms],
          [Acct Short Description],
          [Currency],
          [BuySell],
          [TradeAmount],
          [GLCS CODE]
      RESIDENT ADJ_PAYOUT;
      DROP TABLE ADJ_PAYOUT;
      RENAME TABLE _ADJ2 TO ADJ_PAYOUT;
      LET vAdjRows = NoOfRows('ADJ_PAYOUT');
    END IF
  END IF
END IF
TRACE [CASTINE][ADJ] adjustment rows ready: $(vAdjRows);
///$tab 10 — Final Assembly & GLCS
// [FIX-12] FINAL EXCLUSIONS
//   WAS: none of these rules in the analyst script (TEST was tested on
//        MasterAccountName at read time, L415).
//   NOW (exclude_legacy_roll_shortdesc_records L1813): rows with ShortDesc GNCL,
//        MULT or GNPL, Trade Date in 2026 and As of trade date not in 2026 are
//        excluded; (exclude_rrteam_235_and_client_test L2646): RR Team 235 and
//        Client TEST are excluded on the final, normalised values.
// [FIX-11] TRADE DATE (part 2)
//   NOW (force_modified_bloomberg_xml_trade_date_equal_asof L1878): for a trade
//        with more than one XML version, Trade Date = As of trade date.
// ============================================================================
// 10 — EXACT ORDER of main() (L3626-3683):
//   concat(XML+Repo) -> exclude_legacy_roll (GNCL/MULT/GNPL cross-year)
//   -> append adjustments -> force Trade Date=AsOf for modified XML
//   -> exclude RR Team 235 / Client TEST -> populate GLCS CODE
//   -> GLCS email tables -> numeric coercion -> drop internal column.
// ============================================================================

// --- concat XML + Repo (repo has no internal column -> null = not modified)
IF Alt(NoOfRows('XML_PAYOUT'), 0) > 0 THEN
  [FINAL0]:
  NoConcatenate
  LOAD *
  RESIDENT XML_PAYOUT;
  DROP TABLE XML_PAYOUT;
END IF
IF Alt(NoOfRows('REPO_PAYOUT'), 0) > 0 THEN
  IF Alt(TableNumber('FINAL0'), -1) >= 0 THEN
    Concatenate(FINAL0)
    LOAD *
    RESIDENT REPO_PAYOUT;
  ELSE
    [FINAL0]:
    NoConcatenate
    LOAD *
    RESIDENT REPO_PAYOUT;
  END IF
  DROP TABLE REPO_PAYOUT;
END IF

// --- exclude_legacy_roll_shortdesc_records (L1813-1875) ----------------------
// years taken from the formatted TEXT via the CUSTOM parser (includes the documented quirk)
IF Alt(TableNumber('FINAL0'), -1) >= 0 THEN
  CALL ParseDateColumn('FINAL0', 'As of trade date', '__asof_leg');
  CALL ParseDateColumn('FINAL0', 'Trade Date', '__td_leg');

  [FINAL1]:
  NoConcatenate
  LOAD
      *,
      If(Len(__asof_leg)>0, Year(__asof_leg)) as __asof_year,
      If(Len(__td_leg)>0, Year(__td_leg)) as __td_year,
      Upper(Trim([ShortDesc])) as __sd_norm,
      If( (Len(__asof_leg)=0 or Year(__asof_leg) <> $(vLegacyTradeYear))
          and Len(__td_leg)>0 and Year(__td_leg) = $(vLegacyTradeYear)
          and Match(Upper(Trim([ShortDesc])), 'GNCL', 'MULT', 'GNPL') > 0, 1, 0) as __legacy_excl
  RESIDENT FINAL0;
  DROP TABLE FINAL0;

  [ALERT_CROSSYEAR]:
  NoConcatenate
  LOAD
      [As of trade date],
      [Client],
      [Security],
      [Trade Id],
      [Salesperson],
      [Production Earned],
      [Payout Earned],
      [Trader Team Name],
      [Fidelity #],
      [ShortDesc],
      [TradeType],
      [Trade Date],
      [RR Team],
      [Source],
      [Sec Type],
      [Sec Type Description],
      [Security Description],
      [Gross Comms],
      [Acct Short Description],
      [Currency],
      [BuySell],
      [TradeAmount],
      [GLCS CODE],
      If(Len(__asof_leg)>0, Date(__asof_leg,'YYYY-MM-DD'), '') as AsOfTradeDate_parsed,
      If(Len(__td_leg)>0, Date(__td_leg,'YYYY-MM-DD'), '') as TradeDate_parsed,
      __asof_year as AsOfTradeDate_year,
      __td_year as TradeDate_year,
      __sd_norm as ShortDesc_norm,
      'ASOF_NOT_2026_TRADEDATE_2026_SHORTDESC_GNCL_MULT_GNPL_EXCLUDED' as alert_reason
  RESIDENT FINAL1
  WHERE __legacy_excl = 1;

  [FINAL2]:
  NoConcatenate
  LOAD *
  RESIDENT FINAL1
  WHERE __legacy_excl = 0;
  DROP TABLE FINAL1;
  DROP FIELDS __asof_leg, __td_leg, __asof_year, __td_year, __sd_norm, __legacy_excl FROM FINAL2;
END IF

LET vGnclExcluded = Alt(NoOfRows('ALERT_CROSSYEAR'), 0);
LET vCoreRows = Alt(NoOfRows('FINAL2'), 0);
TRACE [CASTINE] Core after GNCL/MULT/GNPL filter: $(vCoreRows) (excluded: $(vGnclExcluded));

// --- append adjustments (L3640) — AFTER the legacy filter, BEFORE the override -----
IF Alt(NoOfRows('ADJ_PAYOUT'), 0) > 0 THEN
  IF Alt(TableNumber('FINAL2'), -1) >= 0 THEN
    Concatenate(FINAL2)
    LOAD *
    RESIDENT ADJ_PAYOUT;
  ELSE
    [FINAL2]:
    NoConcatenate
    LOAD *
    RESIDENT ADJ_PAYOUT;
  END IF
  DROP TABLE ADJ_PAYOUT;
END IF

IF Alt(TableNumber('FINAL2'), -1) < 0 THEN
  TRACE [CASTINE][WARN] Empty final universe (no XML, Repo or Adjustments). Final table will not be created — status recorded in the audit.;
END IF

IF Alt(TableNumber('FINAL2'), -1) >= 0 THEN

// --- force_modified_bloomberg_xml_trade_date_equal_asof (L1878-1911) ---------
// only with the internal column present (non-empty xml); null flag = not modified
IF Alt(FieldNumber('_XML_ModifiedVersionChain', 'FINAL2'), 0) > 0 THEN
  [FINAL3]:
  NoConcatenate
  LOAD
      *,
      If(Upper(Trim([Source])) = 'BLOOMBERG XML' and Alt([_XML_ModifiedVersionChain], 0) = 1,
         Text([As of trade date]) & '', [Trade Date]) as [__TradeDate_final]
  RESIDENT FINAL2;
  DROP TABLE FINAL2;
  [_F3B]:
  NoConcatenate
  LOAD
      [As of trade date],
      [Client],
      [Security],
      [Trade Id],
      [Salesperson],
      [Production Earned],
      [Payout Earned],
      [Trader Team Name],
      [Fidelity #],
      [ShortDesc],
      [TradeType],
      [__TradeDate_final] as [Trade Date],
      [RR Team],
      [Source],
      [Sec Type],
      [Sec Type Description],
      [Security Description],
      [Gross Comms],
      [Acct Short Description],
      [Currency],
      [BuySell],
      [TradeAmount],
      [GLCS CODE]
  RESIDENT FINAL3;
  DROP TABLE FINAL3;
  RENAME TABLE _F3B TO FINAL3;
ELSE
  [FINAL3]:
  NoConcatenate
  LOAD *
  RESIDENT FINAL2;
  DROP TABLE FINAL2;
END IF

// --- exclude_rrteam_235_and_client_test (L2605-2666) -------------------------
[FINAL4]:
NoConcatenate
LOAD
    *,
    $(fNormTeam([RR Team])) as __rr_n,
    $(fNormTeam([Client])) as __cl_n
RESIDENT FINAL3;
DROP TABLE FINAL3;

[ALERT_BUSINESS_EXCLUDED]:
NoConcatenate
LOAD
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    [Production Earned],
    [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE],
    __rr_n as RRTeam_norm_for_filter,
    __cl_n as Client_norm_for_filter,
    If('#' & __rr_n='#235' and __cl_n='TEST', 'RRTEAM_235_EXCLUDED;CLIENT_TEST_EXCLUDED',
       If('#' & __rr_n='#235', 'RRTEAM_235_EXCLUDED', 'CLIENT_TEST_EXCLUDED')) as alert_reason
RESIDENT FINAL4
WHERE '#' & __rr_n = '#235' or __cl_n = 'TEST';

[FINAL5]:
NoConcatenate
LOAD *
RESIDENT FINAL4
WHERE '#' & __rr_n <> '#235' and __cl_n <> 'TEST';
DROP TABLE FINAL4;
DROP FIELDS __rr_n, __cl_n FROM FINAL5;

LET vBusinessExcluded = Alt(NoOfRows('ALERT_BUSINESS_EXCLUDED'), 0);
TRACE [CASTINE] Excluded 235/TEST: $(vBusinessExcluded);
///$tab 10b — Tiara & GLCS
// [FIX-15] GLCS CODE
//   WAS (analyst L153-284, L572): MAP_BBGACCNo_GLCS, MAP_AccountNr_GLCS and
//        MAP_SubAcctNo_AccountNo were built and never applied (tab 09 was empty);
//        Tiara file chosen by FILETIME; FROM $(vFileName_Latest) without brackets.
//   NOW (find_tiara_accounts_file L2796, load_tiara_accounts_glcs_lookup L2917,
//        populate_glcs_code L3098): Tiara file chosen as the Python does, GLCS CODE
//        filled for Bloomberg XML rows (direct match, then subaccount -> account),
//        unmatched rows to glcs_code_unmapped_alerts.csv.
// ============================================================================
// Tiara (L2672-3054) + populate_glcs_code (L3057-3199)
// ============================================================================
SET vTiaraAccountsFile = '';
SET vTiaraAccountsStatus = 'NOT_LOADED';
SET vTiaraSubFile = '';
SET vTiaraSubStatus = 'NOT_LOADED';

// SUB FindTiaraFile: priority (1) exact tiara.<family>*DDMMYYYY* by mtime;
// (2) with a date in the name <= process date (max date, mtime tie-break);
// (3) latest by mtime. (L2697-2752)
SUB FindTiaraFile(pFamily, pOutVar)
  LET $(pOutVar) = '';
  LET _best = '';
  LET _bestTime = -1;
  FOR Each _vF in FileList('$(vLibTiara)*')
    // A file name with an apostrophe would break every '$(_vF)' below.
    // It is tested by variable NAME (no expansion) and the file is ignored.
    IF Index(_vF, Chr(39)) = 0 THEN
      LET _vB = SubField(SubField('$(_vF)','\',-1),'/',-1);
      IF Lower(Left('$(_vB)', Len('tiara.$(pFamily)'))) = 'tiara.$(pFamily)' and Index(KeepChar('$(_vB)','0123456789'), '$(vPayoutDateDDMMYYYY)') > 0 THEN
        LET _ft = Alt(Num(FileTime('$(_vF)')), 0);
        IF $(_ft) >= $(_bestTime) THEN
          LET _bestTime = $(_ft);
          LET _best = '$(_vF)';
        END IF
      END IF
    ELSE
      TRACE [CASTINE][WARN] File ignored, apostrophe in its name: $(_vF);
    END IF
  NEXT _vF
  IF Len('$(_best)') > 0 THEN
    LET $(pOutVar) = '$(_best)';
  ELSE
    // (2) dated <= process: takes the 1st run of 8 digits as DDMMYYYY
    LET _bestDate = -1;
    LET _bestTime = -1;
    LET _best = '';
    LET _fbTime = -1;
    LET _fb = '';
    FOR Each _vF in FileList('$(vLibTiara)*')
      // A file name with an apostrophe would break every '$(_vF)' below.
      // It is tested by variable NAME (no expansion) and the file is ignored.
      IF Index(_vF, Chr(39)) = 0 THEN
        LET _vB = SubField(SubField('$(_vF)','\',-1),'/',-1);
        IF Lower(Left('$(_vB)', Len('tiara.$(pFamily)'))) = 'tiara.$(pFamily)' THEN
          LET _ft = Alt(Num(FileTime('$(_vF)')), 0);
          IF $(_ft) >= $(_fbTime) THEN
            LET _fbTime = $(_ft);
            LET _fb = '$(_vF)';
          END IF
          CALL ExtractToken8('$(_vB)');          // -> vTok8 (1st run of exactly 8 digits)
          LET _fd = Alt(Num(Date#('$(vTok8)', 'DDMMYYYY')), -1);
          IF $(_fd) >= 0 and $(_fd) <= $(vPayoutDateNum) THEN
            IF $(_fd) > $(_bestDate) or ($(_fd) = $(_bestDate) and $(_ft) >= $(_bestTime)) THEN
              LET _bestDate = $(_fd);
              LET _bestTime = $(_ft);
              LET _best = '$(_vF)';
            END IF
          END IF
        END IF
      ELSE
        TRACE [CASTINE][WARN] File ignored, apostrophe in its name: $(_vF);
      END IF
    NEXT _vF
    IF Len('$(_best)') > 0 THEN
      LET $(pOutVar) = '$(_best)';
    ELSEIF Len('$(_fb)') > 0 THEN
      LET $(pOutVar) = '$(_fb)';
    END IF
  END IF
END SUB

// 1st run of EXACTLY 8 digits (regex tiara\.<family>[_\-. ]*(\d{8}))
SUB ExtractToken8(pName)
  LET vTok8 = '';
  LET _run = '';
  FOR _i = 1 to Len('$(pName)') + 1
    LET _ch = Mid('$(pName)', $(_i), 1);
    IF Len('$(_ch)') > 0 and Index('0123456789', '$(_ch)') > 0 THEN
      LET _run = '$(_run)$(_ch)';
    ELSE
      IF Len('$(_run)') = 8 and Len('$(vTok8)') = 0 THEN
        LET vTok8 = '$(_run)';
      END IF
      LET _run = '';
    END IF
  NEXT _i
END SUB

CALL FindTiaraFile('accounts', 'vTiaraAccountsFile');
CALL FindTiaraFile('subaccounts', 'vTiaraSubFile');
TRACE [CASTINE][GLCS] accounts='$(vTiaraAccountsFile)' subaccounts='$(vTiaraSubFile)';

// --- MAP_DIRECT / MAP_ACCTNR (load_tiara_accounts_glcs_lookup L2876-2980) ----
// per-ROW keys in order: acct_base, acct_noz, bbg_base, bbg_noz;
// first wins (Mapping LOAD uses the 1st occurrence). Empty key value: left out.
IF Len('$(vTiaraAccountsFile)') > 0 THEN
  CALL DetectCodepage('$(vTiaraAccountsFile)', 'vTiaCp');
  SET ErrorMode = 0;
  CALL BuildTextSel('$(vTiaraAccountsFile)', 'txt, $(vTiaCp), embedded labels, delimiter is ''|'', no quotes', 'vTiaSel');
  [_TIA0]:
  NoConcatenate
  LOAD
      $(vTiaSel),
      RecNo() as __tia_rec
  FROM [$(vTiaraAccountsFile)]
  (txt, $(vTiaCp), embedded labels, delimiter is '|', no quotes);
  SET ErrorMode = 1;
  IF Alt(TableNumber('_TIA0'), -1) < 0 THEN
    SET vTiaraAccountsStatus = 'READ_ERROR';
  ELSE
    // finds columns by header_norm (EXACT; priority accountnr > accountno)
    SET vTC_ent='';
    SET vTC_anr='';
    SET vTC_bbg='';
    FOR _ci = 1 to NoOfFields('_TIA0')
      LET _cn = FieldName($(_ci), '_TIA0');
      LET _nn = KeepChar(Lower('$(_cn)'), 'abcdefghijklmnopqrstuvwxyz0123456789');
      IF '$(_nn)' = 'entitycode' and Len('$(vTC_ent)') = 0 THEN
        LET vTC_ent = '$(_cn)';
      END IF
      IF Match('$(_nn)', 'accountnr', 'accountno') > 0 and Len('$(vTC_anr)') = 0 THEN
        LET vTC_anr = '$(_cn)';
      END IF
      IF Match('$(_nn)', 'bloombergmasteraccountno', 'masterbloombergaccount') > 0 and Len('$(vTC_bbg)') = 0 THEN
        LET vTC_bbg = '$(_cn)';
      END IF
    NEXT _ci

    IF Len('$(vTC_ent)') = 0 THEN
      SET vTiaraAccountsStatus = 'MISSING_ENTITY_CODE_COLUMN';
      DROP TABLE _TIA0;
    ELSEIF Len('$(vTC_anr)') = 0 and Len('$(vTC_bbg)') = 0 THEN
      SET vTiaraAccountsStatus = 'MISSING_LOOKUP_COLUMNS';
      DROP TABLE _TIA0;
    ELSE
      [_TIA1]:
      NoConcatenate
      LOAD
          __tia_rec,
          Trim(Text([$(vTC_ent)])) as __ent,
          $(=If(Len('$(vTC_anr)')>0, 'Text([' & '$(vTC_anr)' & '])', 'Null()')) as __anr_raw,
          $(=If(Len('$(vTC_bbg)')>0, 'Text([' & '$(vTC_bbg)' & '])', 'Null()')) as __bbg_raw
      RESIDENT _TIA0
      WHERE Len(Trim(Text([$(vTC_ent)]))) > 0;
      DROP TABLE _TIA0;
      CALL NormAcctColumns('_TIA1', '__anr_raw', '__anr_base', '__anr_noz');
      CALL NormAcctColumns('_TIA1', '__bbg_raw', '__bbg_base', '__bbg_noz');

      [_TIAKEYS]:
      NoConcatenate
      LOAD
          0 as __tia_rec,
          0 as __seq,
          '§none§' as __key,
          '' as __ent,
          'ANR' as __src
      AUTOGENERATE 1;
      Concatenate(_TIAKEYS)
      LOAD
          __tia_rec,
          1 as __seq,
          __anr_base as __key,
          __ent,
          'ANR' as __src
      RESIDENT _TIA1
      WHERE Len(__anr_base) > 0;
      Concatenate(_TIAKEYS)
      LOAD
          __tia_rec,
          2 as __seq,
          __anr_noz as __key,
          __ent,
          'ANR' as __src
      RESIDENT _TIA1
      WHERE Len(__anr_noz) > 0;
      Concatenate(_TIAKEYS)
      LOAD
          __tia_rec,
          3 as __seq,
          __bbg_base as __key,
          __ent,
          'BBG' as __src
      RESIDENT _TIA1
      WHERE Len(__bbg_base) > 0;
      Concatenate(_TIAKEYS)
      LOAD
          __tia_rec,
          4 as __seq,
          __bbg_noz as __key,
          __ent,
          'BBG' as __src
      RESIDENT _TIA1
      WHERE Len(__bbg_noz) > 0;
      DROP TABLE _TIA1;

      SET vTiaraAccountsStatus = 'OK';
    END IF
  END IF
ELSE
  SET vTiaraAccountsStatus = 'FILE_NOT_FOUND';
END IF

// single creation point of the accounts maps (seed '§none§' always present)
IF Alt(TableNumber('_TIAKEYS'), -1) < 0 THEN
  [_TIAKEYS]:
  NoConcatenate
  LOAD
      0 as __tia_rec,
      0 as __seq,
      '§none§' as __key,
      '' as __ent,
      'ANR' as __src
  AUTOGENERATE 1;
END IF
[MAP_DIRECT]:
Mapping
LOAD
    __key,
    __ent
RESIDENT _TIAKEYS
ORDER BY __tia_rec, __seq;
[MAP_ACCTNR]:
Mapping
LOAD
    __key,
    __ent
RESIDENT _TIAKEYS
WHERE __src = 'ANR'
ORDER BY __tia_rec, __seq;
DROP TABLE _TIAKEYS;

// --- MAP_SUB (load_tiara_subaccounts_parent_lookup L2983-3054) ---------------
IF Len('$(vTiaraSubFile)') > 0 THEN
  CALL DetectCodepage('$(vTiaraSubFile)', 'vSubCp');
  SET ErrorMode = 0;
  CALL BuildTextSel('$(vTiaraSubFile)', 'txt, $(vSubCp), embedded labels, delimiter is ''|'', no quotes', 'vSubSel');
  [_SUB0]:
  NoConcatenate
  LOAD
      $(vSubSel),
      RecNo() as __sub_rec
  FROM [$(vTiaraSubFile)]
  (txt, $(vSubCp), embedded labels, delimiter is '|', no quotes);
  SET ErrorMode = 1;
  IF Alt(TableNumber('_SUB0'), -1) < 0 THEN
    SET vTiaraSubStatus = 'READ_ERROR';
  ELSE
    SET vTS_acc='';
    SET vTS_sub='';
    FOR _ci = 1 to NoOfFields('_SUB0')
      LET _cn = FieldName($(_ci), '_SUB0');
      LET _nn = KeepChar(Lower('$(_cn)'), 'abcdefghijklmnopqrstuvwxyz0123456789');
      IF Match('$(_nn)', 'accountno', 'accountnr') > 0 and Len('$(vTS_acc)') = 0 THEN
        LET vTS_acc = '$(_cn)';
      END IF
      IF Match('$(_nn)', 'subacctno', 'subaccountno', 'subaccountnr') > 0 and Len('$(vTS_sub)') = 0 THEN
        LET vTS_sub = '$(_cn)';
      END IF
    NEXT _ci
    IF Len('$(vTS_sub)') = 0 THEN
      SET vTiaraSubStatus = 'MISSING_SUBACCT_NO_COLUMN';
      DROP TABLE _SUB0;
    ELSEIF Len('$(vTS_acc)') = 0 THEN
      SET vTiaraSubStatus = 'MISSING_ACCOUNT_NO_COLUMN';
      DROP TABLE _SUB0;
    ELSE
      [_SUB1]:
      NoConcatenate
      LOAD
          __sub_rec,
          Text([$(vTS_sub)]) as __sub_raw,
          Text([$(vTS_acc)]) as __acc_raw
      RESIDENT _SUB0;
      DROP TABLE _SUB0;
      CALL NormAcctColumns('_SUB1', '__sub_raw', '__sub_base', '__sub_noz');
      CALL NormAcctColumns('_SUB1', '__acc_raw', '__acc_base', '__acc_noz');

      // value packs RawSub|RawAcct (alert fields) — L3042-3046
      [_SUBKEYS]:
      NoConcatenate
      LOAD
          0 as __sub_rec,
          0 as __seq,
          '§none§' as __key,
          '@@MISS@@' as __val
      AUTOGENERATE 1;
      Concatenate(_SUBKEYS)
      LOAD
          __sub_rec,
          1 as __seq,
          __sub_base as __key,
          Trim(__sub_raw) & '|§|' & Trim(__acc_raw) as __val
      RESIDENT _SUB1
      WHERE Len(__acc_base) > 0 and Len(__sub_base) > 0;
      Concatenate(_SUBKEYS)
      LOAD
          __sub_rec,
          2 as __seq,
          __sub_noz as __key,
          Trim(__sub_raw) & '|§|' & Trim(__acc_raw) as __val
      RESIDENT _SUB1
      WHERE Len(__acc_base) > 0 and Len(__sub_noz) > 0;
      DROP TABLE _SUB1;
      SET vTiaraSubStatus = 'OK';
    END IF
  END IF
ELSE
  SET vTiaraSubStatus = 'FILE_NOT_FOUND';
END IF

// single creation point of the subaccounts map
IF Alt(TableNumber('_SUBKEYS'), -1) < 0 THEN
  [_SUBKEYS]:
  NoConcatenate
  LOAD
      0 as __sub_rec,
      0 as __seq,
      '§none§' as __key,
      '@@MISS@@' as __val
  AUTOGENERATE 1;
END IF
[MAP_SUB]:
Mapping
LOAD
    __key,
    __val
RESIDENT _SUBKEYS
ORDER BY __sub_rec, __seq;
DROP TABLE _SUBKEYS;
TRACE [CASTINE][GLCS] accounts_status=$(vTiaraAccountsStatus) sub_status=$(vTiaraSubStatus);

// --- populate_glcs_code (L3057-3199) -----------------------------------------
// Only rows with Source='BLOOMBERG XML'. Letters -> copy; numeric -> direct -> sub.
// No match: KEEPS the pre-existing GLCS and raises an alert.
IF Alt(NoOfRows('FINAL5'), 0) > 0 THEN
CALL NormAcctColumns('FINAL5', 'Acct Short Description', '__g_base', '__g_noz');

[FINAL6B]:
NoConcatenate
LOAD
    *,
    If(__g_is_xml = 1,
       If(Len(__g_clean)>0 and Len(KeepChar(Upper(__g_clean),'ABCDEFGHIJKLMNOPQRSTUVWXYZ'))>0,
          __g_clean,                                                   // alphanumeric: direct copy
          If(Len(__g_base)=0, [GLCS CODE],                             // no numeric key: unchanged
             If(__g_direct <> '@@MISS@@', __g_direct,
                If(__g_subent <> '@@MISS@@', __g_subent, [GLCS CODE])))),
       [GLCS CODE]) as [__GLCS_final],
    If(__g_is_xml = 1 and Len(__g_base)>0 and __g_direct = '@@MISS@@' and __g_subent = '@@MISS@@'
       and not (Len(__g_clean)>0 and Len(KeepChar(Upper(__g_clean),'ABCDEFGHIJKLMNOPQRSTUVWXYZ'))>0), 1, 0) as __g_unmatched;
LOAD
    *,
    // step 2: subaccounts -> ACCOUNT_NO -> accounts ACCOUNTNR (base0/noz0 variants)
    If(__g_is_xml = 1 and Len(__g_sub_acct_base0)>0,
       ApplyMap('MAP_ACCTNR', __g_sub_acct_base0,
          ApplyMap('MAP_ACCTNR', __g_sub_acct_noz0, '@@MISS@@')),
       '@@MISS@@') as __g_subent;
LOAD
    *,
    If(Len(__g_sub_acct_base0)=0, '',
       If(FindOneOf(__g_sub_acct_base0,'123456789')=0, '0',
          Mid(__g_sub_acct_base0, FindOneOf(__g_sub_acct_base0,'123456789')))) as __g_sub_acct_noz0;
LOAD
    *,
    // normalizes the subaccount ACCOUNT_NO (same as _numeric_account_lookup_variants)
    If(Len(__g_sub_acct_c)=0 or Len(KeepChar(Upper(__g_sub_acct_c),'ABCDEFGHIJKLMNOPQRSTUVWXYZ'))>0, '',
       KeepChar(If(SubStringCount(__g_sub_acct_c,'.')=1
                   and Len(SubField(__g_sub_acct_c,'.',1))>0
                   and Len(KeepChar(SubField(__g_sub_acct_c,'.',1),'0123456789'))=Len(SubField(__g_sub_acct_c,'.',1))
                   and Len(SubField(__g_sub_acct_c,'.',2))>0
                   and Len(PurgeChar(SubField(__g_sub_acct_c,'.',2),'0'))=0,
                   SubField(__g_sub_acct_c,'.',1), __g_sub_acct_c), '0123456789')) as __g_sub_acct_base0;
LOAD
    *,
    If(__g_subraw <> '@@MISS@@',
       Trim(PurgeChar(Trim(Replace(Replace(Replace(SubField(__g_subraw,'|§|',2),Chr(160),' '),Chr(8203),''),Chr(65279),'')), '"'&Chr(39))),
       '') as __g_sub_acct_c,
    If(__g_subraw <> '@@MISS@@', SubField(__g_subraw, '|§|', 1), '') as __g_sub_no,
    If(__g_subraw <> '@@MISS@@', SubField(__g_subraw, '|§|', 2), '') as __g_sub_acct;
LOAD
    *,
    // step 1: direct lookup (base variants, then noz) — map first-wins
    If(__g_is_xml = 1 and Len(__g_base)>0,
       ApplyMap('MAP_DIRECT', __g_base, ApplyMap('MAP_DIRECT', __g_noz, '@@MISS@@')),
       '@@MISS@@') as __g_direct,
    // fallback: subaccounts by the same variants
    If(__g_is_xml = 1 and Len(__g_base)>0,
       ApplyMap('MAP_SUB', __g_base, ApplyMap('MAP_SUB', __g_noz, '@@MISS@@')),
       '@@MISS@@') as __g_subraw;
LOAD
    *,
    If(Upper(Trim([Source])) = 'BLOOMBERG XML', 1, 0) as __g_is_xml,
    // _clean_account_short_description_for_glcs (L2844-2860)
    If(Len(Trim(Text([Acct Short Description])))=0
       or Match(Lower(Trim(Text([Acct Short Description]))),'nan','none','null','nat')>0, '',
       Trim(PurgeChar(Trim(Replace(Replace(Replace(Text([Acct Short Description]),Chr(160),' '),Chr(8203),''),Chr(65279),'')), '"'&Chr(39)))) as __g_clean
RESIDENT FINAL5;
DROP TABLE FINAL5;

// GLCS unmapped alert (columns L3082-3096; Direct* always empty — faithful)
[ALERT_GLCS_UNMAPPED]:
NoConcatenate
LOAD
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    [Production Earned],
    [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [__GLCS_final] as [GLCS CODE],
    Text([Acct Short Description]) as LookupAccountShortDescription,
    __g_base as LookupAccountNormalized,
    'TIARA_ACCOUNTS_DIRECT_THEN_TIARA_SUBACCOUNTS_FALLBACK' as LookupPathTried,
    '' as DirectTiaraMatchField,
    '' as DirectTiaraMatchValue,
    __g_sub_no as SubacctNoMatched,
    __g_sub_acct as SubacctAccountNo,
    __g_sub_acct_base0 as SubacctAccountNoNormalized,
    '$(vTiaraAccountsFile)' as TiaraAccountsFile,
    '$(vTiaraAccountsStatus)' as TiaraAccountsLookupStatus,
    '$(vTiaraSubFile)' as TiaraSubaccountsFile,
    '$(vTiaraSubStatus)' as TiaraSubaccountsLookupStatus,
    If(Len(__g_sub_no)>0,
       'SUBACCOUNT_FOUND_BUT_PARENT_ACCOUNT_NO_NOT_FOUND_IN_TIARA_ACCOUNTS_ACCOUNTNR',
       'NUMERIC_XML_ACCOUNT_SHORT_DESCRIPTION_NOT_FOUND_IN_TIARA_ACCOUNTS_OR_TIARA_SUBACCOUNTS') as alert_reason
RESIDENT FINAL6B
WHERE __g_unmatched = 1;

// pre-official final table
[FINAL7]:
NoConcatenate
LOAD
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    [Production Earned],
    [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [__GLCS_final] as [GLCS CODE]
RESIDENT FINAL6B;
DROP TABLE FINAL6B;

// --- GLCS email tables (L3202-3275) --------------------------------------
[GLCS_EMAIL_UNMATCHED]:
NoConcatenate
LOAD Distinct
    Trim([Client]) as [Client Short Name],
    Trim(Text([Acct Short Description])) as [Master Account Number]
RESIDENT FINAL7
WHERE Upper(Trim([Source])) = 'BLOOMBERG XML'
  and Len(Trim(Text([GLCS CODE]))) = 0
  and Len(Trim(Text([Acct Short Description]))) > 0
  and Len(KeepChar(
        If(Len(Trim(Text([Acct Short Description])))=0 or Match(Lower(Trim(Text([Acct Short Description]))),'nan','none','null','nat')>0, '',
           Trim(PurgeChar(Trim(Replace(Replace(Replace(Text([Acct Short Description]),Chr(160),' '),Chr(8203),''),Chr(65279),'')), '"'&Chr(39)))),
        '0123456789'))
      = Len(If(Len(Trim(Text([Acct Short Description])))=0 or Match(Lower(Trim(Text([Acct Short Description]))),'nan','none','null','nat')>0, '',
           Trim(PurgeChar(Trim(Replace(Replace(Replace(Text([Acct Short Description]),Chr(160),' '),Chr(8203),''),Chr(65279),'')), '"'&Chr(39)))))
  and Len(If(Len(Trim(Text([Acct Short Description])))=0 or Match(Lower(Trim(Text([Acct Short Description]))),'nan','none','null','nat')>0, '',
           Trim(PurgeChar(Trim(Replace(Replace(Replace(Text([Acct Short Description]),Chr(160),' '),Chr(8203),''),Chr(65279),'')), '"'&Chr(39))))) > 0;

[GLCS_EMAIL_SUSPICIOUS]:
NoConcatenate
LOAD Distinct
    Trim([Client]) as [Client Short Name],
    Trim(Text([Acct Short Description])) as [Master Account Number],
    Trim(Replace(Replace(Trim(Text([GLCS CODE])), Chr(39), ''), '"', '')) as [GLCS CODE],
    'GLCS code does not appear to be correct in Tiara: numeric and longer than 8 digits' as [Issue]
RESIDENT FINAL7
WHERE Upper(Trim([Source])) = 'BLOOMBERG XML'
  and Len(Trim(Replace(Replace(Trim(Text([GLCS CODE])), Chr(39), ''), '"', ''))) >= 9
  and Len(KeepChar(Trim(Replace(Replace(Trim(Text([GLCS CODE])), Chr(39), ''), '"', '')), '0123456789'))
      = Len(Trim(Replace(Replace(Trim(Text([GLCS CODE])), Chr(39), ''), '"', '')));

// ============================================================================
// FINAL TABLE — BLOOMBERG_FINAL_PYTHON_PARITY (23 official columns, L3678-3683)
// Numeric money columns (pd.to_numeric coercion) — the reference CSV uses %.2f.
// ============================================================================
[BLOOMBERG_FINAL_PYTHON_PARITY]:
NoConcatenate
LOAD
    [As of trade date],
    [Client],
    [Security],
    [Trade Id],
    [Salesperson],
    Num#(Text([Production Earned])) as [Production Earned],
    Num#(Text([Payout Earned])) as [Payout Earned],
    [Trader Team Name],
    [Fidelity #],
    [ShortDesc],
    [TradeType],
    [Trade Date],
    [RR Team],
    [Source],
    [Sec Type],
    [Sec Type Description],
    [Security Description],
    Num#(Text([Gross Comms])) as [Gross Comms],
    [Acct Short Description],
    [Currency],
    [BuySell],
    [TradeAmount],
    [GLCS CODE]
RESIDENT FINAL7;
DROP TABLE FINAL7;

LET vFinalRows = Alt(NoOfRows('BLOOMBERG_FINAL_PYTHON_PARITY'), 0);
TRACE [CASTINE] FINAL rows: $(vFinalRows);
END IF   // FINAL5 with rows
END IF   // non-empty final universe (guard F19d)
///$tab 11 — Audit & Export
// [FIX-16] OUTPUT LAYOUT (part 2)
//   WAS (analyst L638): STORE of the working table, raw numbers.
//   NOW (main L3826): 23 official columns in order, money columns with 2 decimals
//        (float_format="%.2f"). Every stored file carries the prefix vOutTag.
// ============================================================================
// 11 — AUDIT_ETAPAS: counters 1:1 with the Python stdout (prompt §12).
// The reconciliation compares with tests/expected/stage_counts.json to find
// the FIRST diverging stage. Optional STOREs mirror the Python CSVs.
// ============================================================================
LET vSplitDistinctTeams = 0;
IF '$(vSplitOK)' = '1' THEN
  [_tmpD]:
  NoConcatenate
  LOAD
      Count(Distinct RRTeam_norm) as _d
  RESIDENT SPLIT_VALID;
  LET vSplitDistinctTeams = Alt(Peek('_d',0,'_tmpD'),0);
  DROP TABLE _tmpD;
END IF
LET vSplitConfigAlertsN = Alt(NoOfRows('SPLIT_CONFIG_ALERTS'),1) - 1;              // -1 for the seed
LET vTeamMismatchKeys  = If(Alt(TableNumber('TEAM_MISMATCH'),-1)<0, 0, NoOfRows('TEAM_MISMATCH') - 1);   // -1 for the seed
LET vGlcsUnmappedN     = If(Alt(TableNumber('ALERT_GLCS_UNMAPPED'),-1)<0, 0, NoOfRows('ALERT_GLCS_UNMAPPED'));
LET vGlcsEmailN        = If(Alt(TableNumber('GLCS_EMAIL_UNMATCHED'),-1)<0, 0, NoOfRows('GLCS_EMAIL_UNMATCHED'));
LET vGlcsSuspN         = If(Alt(TableNumber('GLCS_EMAIL_SUSPICIOUS'),-1)<0, 0, NoOfRows('GLCS_EMAIL_SUSPICIOUS'));
LET vCrossyearN        = If(Alt(TableNumber('ALERT_CROSSYEAR'),-1)<0, 0, NoOfRows('ALERT_CROSSYEAR'));
LET vFinalRows         = If(Alt(TableNumber('BLOOMBERG_FINAL_PYTHON_PARITY'),-1)<0, 0, NoOfRows('BLOOMBERG_FINAL_PYTHON_PARITY'));
LET vReloadTs          = Timestamp(Now(), 'YYYY-MM-DD hh:mm:ss');

[AUDIT_ETAPAS]:
NoConcatenate
LOAD *
INLINE [audit_ordem, audit_etapa, audit_valor
1, payout_yyyymmdd, $(vPayoutYYYYMMDD)
2, arquivos_xml_processados, $(vNumXmlFiles)
3, total_trades_parsed_raw, $(vTotalTradesParsed)
4, rows_loaded_df_raw, $(vTotalTradesParsed)
5, rows_after_versioning, $(vRowsAfterVersioning)
6, rows_after_remove_cancels, $(vRowsAfterCancels)
7, cancels_removed, $(vCancelsRemoved)
8, split_ok, $(vSplitOK)
9, split_rows_read, $(vSplitRowsRead)
10, split_usable_rows, $(vSplitUsableRows)
11, split_valid_rows, $(vSplitValidRows)
12, split_distinct_teams, $(vSplitDistinctTeams)
13, split_config_alerts, $(vSplitConfigAlertsN)
14, xml_rows_before_split_merge, $(vRowsAfterCancels)
15, xml_rows_mapped, $(vXmlRowsMapped)
16, xml_rows_dropped_unmapped, $(vXmlRowsDropped)
17, repo_rows_total, $(vRepoRowsTotal)
18, repo_rows_empty_rr, $(vRepoEmptyRR)
19, repo_rows_with_split, $(vRepoWithSplit)
20, repo_rows_without_split, $(vRepoWithoutSplit)
21, adj_rows_appended, $(vAdjRows)
22, xml_rows_kept, $(vXmlRowsKept)
23, xml_rows_nonusd_excluded, $(vXmlNonUsdExcluded)
24, repo_rows_kept, $(vRepoWithSplit)
25, core_rows_after_gncl_filter, $(vCoreRows)
26, gncl_mult_excluded, $(vCrossyearN)
27, adjustments_rows_appended, $(vAdjRows)
28, final_rows, $(vFinalRows)
29, xml_dropped_alerts, $(vXmlRowsDropped)
30, repo_dropped_alerts, $(vRepoDroppedTotal)
31, team_mismatch_keys, $(vTeamMismatchKeys)
32, business_excluded_235_test, $(vBusinessExcluded)
33, glcs_unmapped_alerts, $(vGlcsUnmappedN)
34, glcs_email_rows, $(vGlcsEmailN)
35, glcs_suspicious_rows, $(vGlcsSuspN)
36, tiara_accounts_status, $(vTiaraAccountsStatus)
37, tiara_subaccounts_status, $(vTiaraSubStatus)
38, reload_timestamp, $(vReloadTs)
];

// Load status: do NOT report success with a material error (prompt §12)
LET vParityStatus = If($(vFinalRows) > 0, 'LOADED_OK_PENDING_RECONCILIATION', 'LOADED_EMPTY_CHECK_INPUTS');
Concatenate(AUDIT_ETAPAS)
LOAD
    99 as audit_ordem,
    'status_carga' as audit_etapa,
    '$(vParityStatus)' as audit_valor
AUTOGENERATE 1;
TRACE [CASTINE] STATUS: $(vParityStatus);

// ---------------------------------------------------------------------------
// EXPORT (vStoreOutputs=1): mirrors the Python files (main L3722-3786)
// Final: money columns with 2 decimals (%.2f). Alerts: same file names.
// Alert CSV sort order follows the pandas keys; text collation differences
// are cosmetic — the comparator is key-based (see 04_DATA_RECONCILIATION).
// ---------------------------------------------------------------------------
IF '$(vStoreOutputs)' = '1' THEN
  IF $(vFinalRows) > 0 THEN
    [_EXPORT_FINAL]:
    NoConcatenate
    LOAD
        [As of trade date],
        [Client],
        [Security],
        [Trade Id],
        [Salesperson],
        If(Len([Production Earned])=0, '', Text(Num($(fRound2([Production Earned])), '0.00', '.', ''))) as [Production Earned],
        If(Len([Payout Earned])=0, '', Text(Num($(fRound2([Payout Earned])), '0.00', '.', ''))) as [Payout Earned],
        [Trader Team Name],
        [Fidelity #],
        [ShortDesc],
        [TradeType],
        [Trade Date],
        [RR Team],
        [Source],
        [Sec Type],
        [Sec Type Description],
        [Security Description],
        If(Len([Gross Comms])=0, '', Text(Num($(fRound2([Gross Comms])), '0.00', '.', ''))) as [Gross Comms],
        [Acct Short Description],
        [Currency],
        [BuySell],
        [TradeAmount],
        [GLCS CODE]
    RESIDENT BLOOMBERG_FINAL_PYTHON_PARITY;
    STORE _EXPORT_FINAL INTO [$(vLibOutput)$(vOutTag)PPT_DailyExportOfPayout_$(vPayoutYYYYMMDD).csv] (txt);
    DROP TABLE _EXPORT_FINAL;
    STORE BLOOMBERG_FINAL_PYTHON_PARITY INTO [$(vLibOutput)$(vOutTag)BLOOMBERG_FINAL_PYTHON_PARITY.qvd] (qvd);
  END IF

  SUB StoreAlert(pTable, pFile, pSeedField)
    IF Alt(TableNumber('$(pTable)'), -1) >= 0 THEN
      [_EXP_A]:
      NoConcatenate
      LOAD *
      RESIDENT [$(pTable)]
      WHERE [$(pSeedField)] <> '__SEED__';
      IF Alt(NoOfRows('_EXP_A'), 0) > 0 THEN
        STORE _EXP_A INTO [$(vLibOutput)$(vOutTag)$(pFile)] (txt);
      ELSE
        STORE [$(pTable)] INTO [$(vLibOutput)$(vOutTag)$(pFile)] (txt);
      END IF
      IF Alt(TableNumber('_EXP_A'), -1) >= 0 THEN
        DROP TABLE _EXP_A;
      END IF
    END IF
  END SUB

  CALL StoreAlert('ALERT_SPLIT_UNMAPPED', 'split_unmapped_alerts.csv', 'drop_reason');
  CALL StoreAlert('ALERT_REPO_UNMAPPED', 'repo_unmapped_alerts.csv', 'drop_reason');
  CALL StoreAlert('SPLIT_CONFIG_ALERTS', 'split_matrix_config_alerts.csv', 'alert_type');
  IF Alt(TableNumber('TEAM_MISMATCH'),-1) >= 0 THEN
    CALL StoreAlert('TEAM_MISMATCH', 'split_team_mismatch_alerts.csv', 'side');
  END IF
  IF Alt(TableNumber('ALERT_XML_NONUSD'),-1) >= 0 THEN
    STORE ALERT_XML_NONUSD INTO [$(vLibOutput)$(vOutTag)xml_nonusd_excluded_alerts.csv] (txt);
  END IF
  IF Alt(TableNumber('ALERT_CROSSYEAR'),-1) >= 0 THEN
    STORE ALERT_CROSSYEAR INTO [$(vLibOutput)$(vOutTag)crossyear_gncl_mult_excluded_alerts.csv] (txt);
  END IF
  IF Alt(TableNumber('ALERT_BUSINESS_EXCLUDED'),-1) >= 0 THEN
    STORE ALERT_BUSINESS_EXCLUDED INTO [$(vLibOutput)$(vOutTag)final_payout_business_excluded_alerts.csv] (txt);
  END IF
  IF Alt(TableNumber('ALERT_GLCS_UNMAPPED'),-1) >= 0 THEN
    STORE ALERT_GLCS_UNMAPPED INTO [$(vLibOutput)$(vOutTag)glcs_code_unmapped_alerts.csv] (txt);
  END IF
  IF Alt(TableNumber('GLCS_EMAIL_UNMATCHED'),-1) >= 0 THEN
    STORE GLCS_EMAIL_UNMATCHED INTO [$(vLibOutput)$(vOutTag)glcs_code_unmatched_names_email.csv] (txt);
  END IF
  IF Alt(TableNumber('GLCS_EMAIL_SUSPICIOUS'),-1) >= 0 THEN
    STORE GLCS_EMAIL_SUSPICIOUS INTO [$(vLibOutput)$(vOutTag)glcs_code_suspicious_numeric_alerts.csv] (txt);
  END IF
  STORE AUDIT_ETAPAS INTO [$(vLibOutput)$(vOutTag)audit_etapas_$(vPayoutYYYYMMDD).csv] (txt);
  TRACE [CASTINE] Export completed in $(vLibOutput);
END IF

// GLCS email (send_glcs_unmatched_names_email L3304-3387): no native equivalent
// in Qlik script. The GLCS_EMAIL_* tables reproduce the content; sending
// is done by Qlik Application Automation / NPrinting (see 06_DEPLOYMENT_GUIDE).
// cleanup_previous_final_payouts (L273-324): file deletion does not exist in
// Sense script — run it outside the app (see 06_DEPLOYMENT_GUIDE §post-reload).
///$tab 11b_Fix_Log
// ============================================================================
// 11b — FIX_LOG: where the problem was, measured on the data of THIS reload.
// One row per metric: [Fix Id], [Fix Metric], [Fix Value]. The same lines go to
// the reload log as TRACE [FIX-nn]. "old rule" = what the analyst script did.
// ============================================================================
SUB LogFix(pId, pMetric, pValue)
  TRACE [$(pId)] $(pMetric) = $(pValue);
  IF Alt(TableNumber('FIX_LOG'), -1) < 0 THEN
    [FIX_LOG]:
    NoConcatenate
    LOAD
        '$(pId)' as [Fix Id],
        '$(pMetric)' as [Fix Metric],
        '$(pValue)' as [Fix Value]
    AUTOGENERATE 1;
  ELSE
    Concatenate(FIX_LOG)
    LOAD
        '$(pId)' as [Fix Id],
        '$(pMetric)' as [Fix Metric],
        '$(pValue)' as [Fix Value]
    AUTOGENERATE 1;
  END IF
END SUB

// files the old pattern (f392fd1.ext.<date>.4) would not have read
[_DGF]:
NoConcatenate
LOAD
    Count(If(not (Lower(file_name) like 'f392fd1.ext.*' and SubField(file_name, '.', -1) = '4'), 1)) as n_new
RESIDENT XML_FILES;
LET vDiagFilesNotOld = Alt(Peek('n_new', 0, '_DGF'), 0);
DROP TABLE _DGF;

// RR Teams with more than one date window in the valid split matrix
LET vDiagTeamsMultiWindow = 0;
IF Alt(TableNumber('SPLIT_VALID'), -1) >= 0 THEN
  [_DGS0]:
  NoConcatenate
  LOAD
      RRTeam_norm as __dg_team,
      Count(Distinct VersionKey) as __dg_nv
  RESIDENT SPLIT_VALID
  GROUP BY RRTeam_norm;
  [_DGS1]:
  NoConcatenate
  LOAD
      Count(If(__dg_nv > 1, 1)) as n_multi
  RESIDENT _DGS0;
  LET vDiagTeamsMultiWindow = Alt(Peek('n_multi', 0, '_DGS1'), 0);
  DROP TABLES _DGS0, _DGS1;
END IF
LET vDiagVersionsCollapsed = $(vTotalTradesParsed) - $(vRowsAfterVersioning);

CALL LogFix('FIX-02', 'XML files loaded (highest version of each)', '$(vNumXmlFiles)');
CALL LogFix('FIX-02', 'XML files the old pattern f392fd1.ext.<date>.4 would not read', '$(vDiagFilesNotOld)');
CALL LogFix('FIX-03', 'TradeFeeds read without read-time filters', '$(vTotalTradesParsed)');
CALL LogFix('FIX-03', 'TradeFeeds with empty SalespersonName (now dropped at the split merge with an alert)', '$(vDiagNoSalesperson)');
CALL LogFix('FIX-03', 'TradeFeeds with MasterAccountName TEST (now excluded on the final Client)', '$(vDiagTestMaster)');
CALL LogFix('FIX-03', 'TradeFeeds with empty MasterAccountName (Client falls back to AccountCounterpartyShortName)', '$(vDiagNoMaster)');
CALL LogFix('FIX-04', 'rows after versioning by TransactionNumber', '$(vRowsAfterVersioning)');
CALL LogFix('FIX-04', 'older versions collapsed', '$(vDiagVersionsCollapsed)');
CALL LogFix('FIX-04', 'trades with more than one XML version', '$(vDiagModifiedTrades)');
CALL LogFix('FIX-04', 'TradeFeeds with empty OriginalTktId (old rule grouped by this field)', '$(vDiagNoOrigTkt)');
CALL LogFix('FIX-04', 'old rule: rows entering versioning (X and empty Salesperson removed first)', '$(vDiagOldRuleInput)');
CALL LogFix('FIX-04', 'old rule: rows kept by MAX(TradeDate) per OriginalTktId', '$(vDiagOldRuleRows)');
CALL LogFix('FIX-05', 'rows after removing cancels (after versioning)', '$(vRowsAfterCancels)');
CALL LogFix('FIX-05', 'cancelled trades removed', '$(vCancelsRemoved)');
CALL LogFix('FIX-05', 'cancelled trades with earlier versions (old rule kept the previous version)', '$(vDiagCancelWithHistory)');
CALL LogFix('FIX-06', 'TradeFeeds whose Gross Comms differs from the old rule', '$(vDiagGrossDiff)');
CALL LogFix('FIX-06', 'Gross Comms total over all TradeFeeds - old rule', '$(vDiagGrossOld)');
CALL LogFix('FIX-06', 'Gross Comms total over all TradeFeeds - Castine.py rule', '$(vDiagGrossNew)');
CALL LogFix('FIX-07', 'split matrix rows read / usable / valid', '$(vSplitRowsRead) / $(vSplitUsableRows) / $(vSplitValidRows)');
CALL LogFix('FIX-07', 'split matrix configuration alerts (rows left out)', '$(vSplitConfigAlertsN)');
CALL LogFix('FIX-08', 'RR Teams with more than one date window (old join duplicated their trades)', '$(vDiagTeamsMultiWindow)');
CALL LogFix('FIX-08', 'XML rows mapped to the split matrix (one per Salesperson)', '$(vXmlRowsMapped)');
CALL LogFix('FIX-08', 'XML rows dropped as unmapped (alert file)', '$(vXmlRowsDropped)');
CALL LogFix('FIX-10', 'XML rows excluded because the security currency is not USD', '$(vXmlNonUsdExcluded)');
CALL LogFix('FIX-11', 'trades with more than one version (Trade Date = As of trade date)', '$(vDiagModifiedTrades)');
CALL LogFix('FIX-12', 'rows excluded by the GNCL/MULT/GNPL cross-year rule', '$(vCrossyearN)');
CALL LogFix('FIX-12', 'rows excluded as RR Team 235 or Client TEST', '$(vBusinessExcluded)');
CALL LogFix('FIX-13', 'Repo rows total / with split / without split', '$(vRepoRowsTotal) / $(vRepoWithSplit) / $(vRepoWithoutSplit)');
CALL LogFix('FIX-14', 'manual adjustment rows appended', '$(vAdjRows)');
CALL LogFix('FIX-15', 'Bloomberg XML rows left without GLCS CODE', '$(vGlcsUnmappedN)');
CALL LogFix('FIX-15', 'Tiara accounts / subaccounts status', '$(vTiaraAccountsStatus) / $(vTiaraSubStatus)');
CALL LogFix('FIX-16', 'final rows exported (23 official columns)', '$(vFinalRows)');

IF '$(vStoreOutputs)' = '1' THEN
  STORE FIX_LOG INTO [$(vLibOutput)$(vOutTag)fix_log_$(vPayoutYYYYMMDD).csv] (txt);
END IF
///$tab 12 — Model Cleanup
// ============================================================================
// 12 — removes staging/auxiliary audit and, by default, the alert tables
// (already stored) to avoid accidental synthetic keys in the model.
// Final model: BLOOMBERG_FINAL_PYTHON_PARITY + AUDIT_ETAPAS + AUDIT_XML_SCAN.
// ============================================================================
FOR Each _t in 'XML_FILES', '_VTEAMS', 'SPLIT_VALID', 'FINAL5', 'XML_PAYOUT', 'REPO_PAYOUT', 'ADJ_PAYOUT'
  IF Alt(TableNumber('$(_t)'), -1) >= 0 THEN
    DROP TABLE [$(_t)];
  END IF
NEXT _t

IF '$(vKeepAlertTables)' = '1' THEN
  // keeps alerts in the model with qualified fields (no accidental associations)
  SUB QualifyTable(pT)
    IF Alt(TableNumber('$(pT)'), -1) >= 0 THEN
      // QUALIFY, not RENAME FIELD: a field name is global, so RENAME FIELD would also
      // rename the columns of the final table and of every other alert table.
      RENAME TABLE [$(pT)] TO [__q_src];
      QUALIFY *;
      [$(pT)]:
      NoConcatenate
      LOAD *
      RESIDENT [__q_src];
      UNQUALIFY *;
      DROP TABLE [__q_src];
    END IF
  END SUB
  FOR Each _t in 'ALERT_SPLIT_UNMAPPED','ALERT_REPO_UNMAPPED','ALERT_XML_NONUSD','ALERT_CROSSYEAR','ALERT_BUSINESS_EXCLUDED','ALERT_GLCS_UNMAPPED','SPLIT_CONFIG_ALERTS','TEAM_MISMATCH','GLCS_EMAIL_UNMATCHED','GLCS_EMAIL_SUSPICIOUS'
    CALL QualifyTable('$(_t)');
  NEXT _t
ELSE
  FOR Each _t in 'ALERT_SPLIT_UNMAPPED','ALERT_REPO_UNMAPPED','ALERT_XML_NONUSD','ALERT_CROSSYEAR','ALERT_BUSINESS_EXCLUDED','ALERT_GLCS_UNMAPPED','SPLIT_CONFIG_ALERTS','TEAM_MISMATCH','GLCS_EMAIL_UNMATCHED','GLCS_EMAIL_SUSPICIOUS'
    IF Alt(TableNumber('$(_t)'), -1) >= 0 THEN
      DROP TABLE [$(_t)];
    END IF
  NEXT _t
END IF

TRACE [CASTINE] Load finished. Final table: BLOOMBERG_FINAL_PYTHON_PARITY ($(vFinalRows) rows) | status=$(vParityStatus);

///$tab 13_Python_Comparison
// ============================================================================
// [FIX-01] SCRIPT FLOW
//   WAS (analyst L28-151): the comparison was the 2nd tab and ended with
//        EXIT SCRIPT (L151, no semicolon): the reload stopped there and none of
//        the load tabs ran.
//   NOW: the comparison is the last tab and has a switch (vRunCompare).
// [FIX-18] COMPARISON
//   WAS (analyst L147-149): Python CSV read as codepage 28591 although Castine.py
//        writes UTF-8; only Source = 'Bloomberg XML' was compared.
//   NOW: UTF-8, every Source, result per key and totals.
// 13 — QLIK x PYTHON COMPARISON (from the analyst "January Comparison" tab)
// Three sides, same key (CompNum, as defined by the analyst L40-51):
//   New     = the export written by THIS reload      ($(vOutTag)PPT_DailyExportOfPayout_<date>.csv)
//   Python  = the Castine.py export                  (PPT_DailyExportOfPayout_<date>.csv)
//   Current = the export of the analyst script today (QLIK_PPT_DailyExportOfPayout_<date>.csv), if present
// Changes vs the analyst tab (L28-151):
//   - it runs AFTER the export; the analyst tab ended with EXIT SCRIPT (L151) and
//     stopped the reload before any load tab ran;
//   - the Python CSV is UTF-8 (Castine.py to_csv encoding="utf-8"); it was read as
//     codepage 28591, so names with accents never matched;
//   - all Sources are compared (the analyst compared Bloomberg XML only);
//   - result per key in COMPARE_BY_KEY and totals in COMPARE_SUMMARY.
// ============================================================================
// One row per key and side: rows, Production Earned, GLCS CODE.
// Defined at the top level of the tab (not inside the IF) so that the definition
// never depends on a condition. fCompNum / fCmpNum are expanded when it is called.
SUB LoadCompareSide(pFile, pSide, pGlcs)
  [_SIDE_$(pSide)]:
  NoConcatenate
  LOAD
      CompNum,
      MaxString(__src) as [Source $(pSide)],
      Count(CompNum) as [Rows $(pSide)],
      Sum(__prod) as [Production $(pSide)],
      Concat(Distinct __glcs, ';') as [GLCS $(pSide)]
  GROUP BY CompNum;
  LOAD
      $(fCompNum) as CompNum,
      Source as __src,
      $(fCmpNum([Production Earned])) as __prod,
      $(pGlcs) as __glcs
  FROM [$(pFile)]
  (txt, utf8, embedded labels, delimiter is ',', msq);
END SUB

IF '$(vRunCompare)' = '1' THEN
  LET vCmpDate = If(Len('$(vCompare_Date)') > 0, '$(vCompare_Date)', '$(vPayoutYYYYMMDD)');
  LET vCmpNewFile = '$(vLibOutput)$(vOutTag)PPT_DailyExportOfPayout_$(vCmpDate).csv';
  LET vCmpCurFile = '$(vLibOutput)QLIK_PPT_DailyExportOfPayout_$(vCmpDate).csv';
  LET vCmpPyFile  = '';
  LET _cn = 0;
  LET _cc = 0;
  FOR Each _f in FileList('$(vCmpNewFile)')
    LET _cn = 1;
  NEXT _f
  FOR Each _f in FileList('$(vCmpCurFile)')
    LET _cc = 1;
  NEXT _f
  // Python export: first folder of vPythonExportLibs that has the file
  FOR _pi = 1 to SubStringCount('$(vPythonExportLibs)', ';') + 1
    LET _pl = SubField('$(vPythonExportLibs)', ';', $(_pi));
    IF Len('$(vCmpPyFile)') = 0 and Len('$(_pl)') > 0 THEN
      FOR Each _f in FileList('$(_pl)PPT_DailyExportOfPayout_$(vCmpDate).csv')
        LET vCmpPyFile = '$(_f)';
      NEXT _f
    END IF
  NEXT _pi
  TRACE [COMPARE] date=$(vCmpDate) new_file=$(_cn) current_file=$(_cc) python_file=$(vCmpPyFile);

  IF $(_cn) = 1 and Len('$(vCmpPyFile)') > 0 THEN
    // Key of the analyst (L40-51). Dates are normalised to M/D/YYYY on every side.
    SET fCompNum = Date(Alt(Date#(Text([As of trade date]), 'M/D/YYYY'), Num([As of trade date])), 'M/D/YYYY') & '|' & Upper(Client) & '|' & Security & '|' & Text([Trade Id]) & '|' & [Trader Team Name] & '|' & ShortDesc & '|' & Date(Alt(Date#(Text([Trade Date]), 'M/D/YYYY'), Num([Trade Date])), 'M/D/YYYY') & '|' & [RR Team] & '|' & [Security Description] & '|' & BuySell & '|' & [Acct Short Description] & '|' & TradeAmount;
    SET fCmpNum = Alt(Num#(Text($1), '0.##########', '.', ','), Num($1), 0);

    CALL LoadCompareSide('$(vCmpNewFile)', 'New', '[GLCS CODE]');
    CALL LoadCompareSide('$(vCmpPyFile)', 'Python', '[GLCS CODE]');

    [COMPARE_BY_KEY]:
    NoConcatenate
    LOAD *
    RESIDENT [_SIDE_New];
    Outer Join(COMPARE_BY_KEY)
    LOAD *
    RESIDENT [_SIDE_Python];
    DROP TABLES [_SIDE_New], [_SIDE_Python];

    IF $(_cc) = 1 THEN
      // The current analyst export has no GLCS CODE column, and its layout is not
      // under the control of this script: if it cannot be read with the official
      // column names, the comparison goes on without the Current side.
      SET ErrorMode = 0;
      CALL LoadCompareSide('$(vCmpCurFile)', 'Current', 'Null()');
      SET ErrorMode = 1;
      IF Alt(TableNumber('_SIDE_Current'), -1) < 0 THEN
        TRACE [COMPARE][WARN] Current export could not be read with the official columns - Current side left out.;
        LET _cc = 0;
      END IF
    END IF
    IF $(_cc) = 1 THEN
      Outer Join(COMPARE_BY_KEY)
      LOAD
          CompNum,
          [Source Current],
          [Rows Current],
          [Production Current]
      RESIDENT [_SIDE_Current];
      DROP TABLE [_SIDE_Current];
    ELSE
      Left Join(COMPARE_BY_KEY)
      LOAD Distinct
          CompNum,
          Null() as [Source Current],
          Null() as [Rows Current],
          Null() as [Production Current]
      RESIDENT COMPARE_BY_KEY;
    END IF

    [_CMP]:
    NoConcatenate
    LOAD
        *,
        If(Len([Source New] & '') > 0, [Source New], If(Len([Source Python] & '') > 0, [Source Python], [Source Current])) as [Compare Source],
        // New (this reload) against Python: the target is MATCH on every key
        If(Alt([Rows New], 0) = 0 and Alt([Rows Python], 0) = 0, 'ONLY_CURRENT',
          If(Alt([Rows Python], 0) = 0, 'ONLY_NEW',
          If(Alt([Rows New], 0) = 0, 'ONLY_PYTHON',
          If([Rows New] <> [Rows Python], 'DIFF_ROWS',
          If(Fabs(Alt([Production New],0) - Alt([Production Python],0)) > 0.005, 'DIFF_AMOUNT',
          If((Chr(126) & [GLCS New]) <> (Chr(126) & [GLCS Python]), 'DIFF_GLCS', 'MATCH')))))) as [Status New vs Python],
        // Current (analyst script today) against Python: where the problem was
        If(Alt([Rows Current], 0) = 0 and Alt([Rows Python], 0) = 0, 'NOT_IN_BOTH',
          If(Alt([Rows Python], 0) = 0, 'ONLY_CURRENT',
          If(Alt([Rows Current], 0) = 0, 'ONLY_PYTHON',
          If([Rows Current] <> [Rows Python], 'DIFF_ROWS',
          If(Fabs(Alt([Production Current],0) - Alt([Production Python],0)) > 0.005, 'DIFF_AMOUNT', 'MATCH'))))) as [Status Current vs Python]
    RESIDENT COMPARE_BY_KEY;
    DROP TABLE COMPARE_BY_KEY;
    RENAME TABLE _CMP TO COMPARE_BY_KEY;

    // own field names: no association with COMPARE_BY_KEY (no synthetic key)
    [COMPARE_SUMMARY]:
    NoConcatenate
    LOAD
        'New vs Python' as [Summary Pair],
        [Compare Source] as [Summary Source],
        [Status New vs Python] as [Summary Status],
        Count(CompNum) as [Summary Keys],
        Num(Sum(Alt([Production New],0)), '0.00') as [Summary Production Qlik],
        Num(Sum(Alt([Production Python],0)), '0.00') as [Summary Production Python]
    RESIDENT COMPARE_BY_KEY
    GROUP BY [Compare Source], [Status New vs Python];
    IF $(_cc) = 1 THEN
      Concatenate(COMPARE_SUMMARY)
      LOAD
          'Current vs Python' as [Summary Pair],
          [Compare Source] as [Summary Source],
          [Status Current vs Python] as [Summary Status],
          Count(CompNum) as [Summary Keys],
          Num(Sum(Alt([Production Current],0)), '0.00') as [Summary Production Qlik],
          Num(Sum(Alt([Production Python],0)), '0.00') as [Summary Production Python]
      RESIDENT COMPARE_BY_KEY
      WHERE [Status Current vs Python] <> 'NOT_IN_BOTH'
      GROUP BY [Compare Source], [Status Current vs Python];
    END IF

    LET _nok = 0;
    FOR _r = 0 to NoOfRows('COMPARE_SUMMARY') - 1
      LET _pair = Peek('Summary Pair', $(_r), 'COMPARE_SUMMARY');
      LET _st   = Peek('Summary Status', $(_r), 'COMPARE_SUMMARY');
      LET _src  = Peek('Summary Source', $(_r), 'COMPARE_SUMMARY');
      LET _k    = Peek('Summary Keys', $(_r), 'COMPARE_SUMMARY');
      LET _pq   = Peek('Summary Production Qlik', $(_r), 'COMPARE_SUMMARY');
      LET _pp   = Peek('Summary Production Python', $(_r), 'COMPARE_SUMMARY');
      TRACE [COMPARE] $(_pair) | $(_src) | $(_st): $(_k) key(s) | qlik=$(_pq) python=$(_pp);
      IF '$(_pair)' = 'New vs Python' and '$(_st)' <> 'MATCH' THEN
        LET _nok = $(_nok) + $(_k);
      END IF
    NEXT _r
    IF $(_nok) = 0 THEN
      TRACE [COMPARE] RESULT: this reload is IDENTICAL to the Python export on every key.;
    ELSE
      TRACE [COMPARE] RESULT: $(_nok) key(s) of this reload differ from the Python export - see COMPARE_BY_KEY.;
    END IF

    IF '$(vStoreOutputs)' = '1' THEN
      STORE COMPARE_BY_KEY INTO [$(vLibOutput)$(vOutTag)compare_by_key_$(vCmpDate).csv] (txt);
      STORE COMPARE_SUMMARY INTO [$(vLibOutput)$(vOutTag)compare_summary_$(vCmpDate).csv] (txt);
    END IF
    LET _r =;
    LET _pair =;
    LET _st =;
    LET _src =;
    LET _k =;
    LET _pq =;
    LET _pp =;
  ELSE
    TRACE [COMPARE][WARN] Comparison skipped: new export or Python export not found for $(vCmpDate).;
  END IF
  LET _cn =;
  LET _cc =;
  LET _f =;
  LET _pi =;
  LET _pl =;
END IF

TRACE [CASTINE] Reload finished (v11 rev 4).;
// ============================================================================
// END — QLIK_PPT_SalesCredit_DailyExport v11
// ============================================================================
